/* One-shot WIMP poll (Wimp_PollIdle + Event_Process), returns immediately.
   Used to keep the desktop -- and AcornSSL's certificate-confirmation
   prompt -- alive while the TLS handshake is being pumped. */
extern int RDPClient_PollNull(void);

#ifndef FIONBIO
#define FIONBIO 0x8004667e	/* BSD _IOW('f', 126, int) */
#endif

/* AcornSSL drives the TLS handshake lazily on the first ssl_send/ssl_recv
   and returns ENOTCONN for every handshake step that is not yet complete;
   it is a "call me again", not a fatal error. */
#ifndef ENOTCONN
#define ENOTCONN 57
#endif


#ifdef _WIN32
#define socklen_t int
#define TCP_CLOSE(_sck) closesocket(_sck)
#define TCP_STRERROR "tcp error"
#define TCP_BLOCKS (WSAGetLastError() == WSAEWOULDBLOCK)
#else
/* *** START *** AJS 26/12/2007 *** */
/* #define TCP_CLOSE(_sck) close(_sck) */
#define TCP_CLOSE(_sck) socketclose(_sck)
/* *** END *** AJS 26/12/2007 *** */
#define TCP_STRERROR strerror(errno)
#define TCP_BLOCKS (errno == EWOULDBLOCK)
#endif

#ifndef INADDR_NONE
#define INADDR_NONE ((unsigned long) -1)
#endif

#ifdef WITH_SCARD
#define STREAM_COUNT 8
#else
#define STREAM_COUNT 1
#endif

static int g_sock;
static int g_ssl = -1;	/* AcornSSL handle when a TLS session is active, else -1 */
static struct stream g_in;
static struct stream g_out[STREAM_COUNT];
int g_tcp_port_rdp = TCP_PORT_RDP;
extern RD_BOOL g_user_quit;

/* wait till socket is ready to write or timeout */
static RD_BOOL
tcp_can_send(int sck, int millis)
{
	struct timeval time;
	int sel_count;
	fd_set wfds;

	time.tv_sec = millis / 1000;
	time.tv_usec = (millis * 1000) % 1000000;
	FD_ZERO(&wfds);
	FD_SET(sck, &wfds);
	sel_count = select(sck + 1, 0, &wfds, 0, &time);
	if (sel_count > 0)
	{
		return True;
	}
	return False;
}

/* Initialise TCP transport data packet */
STREAM
tcp_init(uint32 maxlen)
{
	static int cur_stream_id = 0;
	STREAM result = NULL;

#ifdef WITH_SCARD
	scard_lock(SCARD_LOCK_TCP);
#endif
	result = &g_out[cur_stream_id];
	cur_stream_id = (cur_stream_id + 1) % STREAM_COUNT;

	if (maxlen > result->size)
	{
		result->data = (uint8 *) xrealloc(result->data, maxlen);
		result->size = maxlen;
	}

	result->p = result->data;
	result->end = result->data + result->size;
#ifdef WITH_SCARD
	scard_unlock(SCARD_LOCK_TCP);
#endif
	return result;
}

/* Is the AcornSSL module present? TLS is only offered when it is. */
RD_BOOL
tcp_tls_available(void)
{
	return (ssl_socketversion() >= 0) ? True : False;
}

/* Upgrade the already-connected socket to a TLS session via AcornSSL.
   Called after the RDP negotiation selects PROTOCOL_SSL, before any MCS
   traffic. The handshake and all subsequent traffic run with the SSL
   session in blocking mode; tcp_recv() calls ui_select() on the raw
   socket first to keep the WIMP poll loop alive, then does a blocking
   ssl_recv(). */
RD_BOOL
tcp_tls_connect(void)
{
	g_ssl = ssl_createsession(g_sock, CreateSession_New, 0);
	if (g_ssl < 0)
	{
		error("AcornSSL: CreateSession failed (%X) %s\n", errno, _inet_err());
		return False;
	}
	/* Non-blocking steady-state I/O: tcp_recv() drains AcornSSL's buffered
	   plaintext first and only waits (WIMP-cooperatively) on the raw socket
	   when the SSL layer actually needs more wire data. The lazy handshake
	   on the first send still completes (it is retried on ENOTCONN). */
	{
		int nonblock = 1;
		ssl_socketioctl(g_ssl, FIONBIO, &nonblock);
	}
#ifdef TLS_NEG_DEBUG
	warning("NEG: AcornSSL_CreateSession OK -- TLS handle %d\n", g_ssl);
#endif
	return True;
}

/* True while a TLS session is active on the connection. */
RD_BOOL
tcp_tls_active(void)
{
	return (g_ssl >= 0) ? True : False;
}

/* Send TCP transport data packet */
void
tcp_send(STREAM s)
{
	int length = s->end - s->data;
	int sent, total = 0;

#ifdef WITH_SCARD
	scard_lock(SCARD_LOCK_TCP);
#endif
	while (total < length)
	{
		if (g_ssl >= 0)
			sent = ssl_send(g_ssl, s->data + total, length - total, 0);
		else
			sent = send(g_sock, s->data + total, length - total, 0);
		if (sent <= 0)
		{
			if (sent == -1 && g_ssl >= 0 && errno == ENOTCONN)
			{
				/* TLS handshake still completing (see note above).
				   Pump the WIMP so AcornSSL's certificate prompt stays
				   responsive, then retry to advance the handshake. */
				RDPClient_PollNull();
				sent = 0;
			}
			else if (sent == -1 && TCP_BLOCKS)
			{
				tcp_can_send(g_sock, 100);
				sent = 0;
			}
			else
			{
/* *** START *** AJS 25/10/2005 *** */
/*				error("send: %s\n", TCP_STRERROR); */
				error("send: (%X) %s\n", errno, _inet_err());
/* *** END *** AJS 25/10/2005 *** */
				return;
			}
		}
		total += sent;
	}
#ifdef WITH_SCARD
	scard_unlock(SCARD_LOCK_TCP);
#endif
}

/* Receive a message on the TCP layer */
STREAM
tcp_recv(STREAM s, uint32 length)
{
	uint32 new_length, end_offset, p_offset;
	int rcvd = 0;

	if (s == NULL)
	{
		/* read into "new" stream */
		if (length > g_in.size)
		{
			g_in.data = (uint8 *) xrealloc(g_in.data, length);
			g_in.size = length;
		}
		g_in.end = g_in.p = g_in.data;
		s = &g_in;
	}
	else
	{
		/* append to existing stream */
		new_length = (s->end - s->data) + length;
		if (new_length > s->size)
		{
			p_offset = s->p - s->data;
			end_offset = s->end - s->data;
			s->data = (uint8 *) xrealloc(s->data, new_length);
			s->size = new_length;
			s->p = s->data + p_offset;
			s->end = s->data + end_offset;
		}
	}

	while (length > 0)
	{
		if (g_ssl >= 0)
		{
			/* TLS: read decrypted data FIRST. AcornSSL buffers whole TLS
			   records, so plaintext can be waiting even when the raw socket
			   shows nothing readable -- selecting on the socket first would
			   stall mid-PDU. Only when the SSL layer needs more wire data
			   (EWOULDBLOCK) do we wait, WIMP-cooperatively, on the raw
			   socket. ENOTCONN means the handshake is still completing. */
			rcvd = ssl_recv(g_ssl, s->end, length, 0);
			if (rcvd < 0)
			{
				if (errno == ENOTCONN)
				{
					/* handshake step pending -- pump WIMP and retry */
					RDPClient_PollNull();
					rcvd = 0;
				}
				else if (TCP_BLOCKS)
				{
					/* SSL layer wants more wire data -- wait for it while
					   keeping the desktop responsive. */
					if (!ui_select(g_sock))
					{
						g_user_quit = True;
						return NULL;
					}
					rcvd = 0;
				}
				else
				{
					error("recv: (%X) %s\n", errno, _inet_err());
					return NULL;
				}
			}
			else if (rcvd == 0)
			{
				error("Connection closed\n");
				return NULL;
			}
		}
		else
		{
			if (!ui_select(g_sock))
			{
				/* User quit */
				g_user_quit = True;
				return NULL;
			}

			rcvd = recv(g_sock, s->end, length, 0);
			if (rcvd < 0)
			{
				if (rcvd == -1 && TCP_BLOCKS)
				{
					rcvd = 0;
				}
				else
				{
					error("recv: (%X) %s\n", errno, _inet_err());
					return NULL;
				}
			}
			else if (rcvd == 0)
			{
				error("Connection closed\n");
				return NULL;
			}
		}

		s->end += rcvd;
		length -= rcvd;
	}

	return s;
}

/* Establish a connection on the TCP layer */
RD_BOOL
tcp_connect(char *server)
{
	struct hostent *nslookup;
	struct sockaddr_in servaddr;
/* *** START *** AJS 26/12/2007 *** */
/*	socklen_t option_len; */
	int option_len;
/* *** END *** AJS 26/12/2007 *** */
	uint32 option_value;
	int i;

#ifdef IPv6

	int n;
	struct addrinfo hints, *res, *ressave;
	char tcp_port_rdp_s[10];

	snprintf(tcp_port_rdp_s, 10, "%d", g_tcp_port_rdp);

	memset(&hints, 0, sizeof(struct addrinfo));
	hints.ai_family = AF_UNSPEC;
	hints.ai_socktype = SOCK_STREAM;

	if ((n = getaddrinfo(server, tcp_port_rdp_s, &hints, &res)))
	{
		error("getaddrinfo: %s\n", gai_strerror(n));
		return False;
	}

	ressave = res;
	g_sock = -1;
	while (res)
	{
		g_sock = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
		if (!(g_sock < 0))
		{
			if (connect(g_sock, res->ai_addr, res->ai_addrlen) == 0)
				break;
			TCP_CLOSE(g_sock);
			g_sock = -1;
		}
		res = res->ai_next;
	}
	freeaddrinfo(ressave);

	if (g_sock == -1)
	{
		error("%s: unable to connect\n", server);
		return False;
	}

#else /* no IPv6 support */


	if ((nslookup = gethostbyname(server)) != NULL)
	{
/* *** START *** AJS 27/01/2004 *** */
		if(strchr(server, '.') != NULL)
			Status_SetServername(nslookup->h_name);
/* *** END *** AJS 27/01/2004 *** */
		memcpy(&servaddr.sin_addr, nslookup->h_addr, sizeof(servaddr.sin_addr));
	}
	else if ((servaddr.sin_addr.s_addr = inet_addr(server)) == INADDR_NONE)
	{
		error("%s: unable to resolve host\n", server);
		return False;
	}

/* *** START *** AJS 27/01/2004 *** */
	Status_SetServeraddress(inet_ntoa(servaddr.sin_addr));
/* *** END *** AJS 27/01/2004 *** */

	if ((g_sock = socket(AF_INET, SOCK_STREAM, 0)) < 0)
	{
		error("socket: %s\n", TCP_STRERROR);
		return False;
	}

	servaddr.sin_family = AF_INET;
	servaddr.sin_port = htons((uint16) g_tcp_port_rdp);

	if (connect(g_sock, (struct sockaddr *) &servaddr, sizeof(struct sockaddr)) < 0)
	{
		error("connect: %s\n", TCP_STRERROR);
		TCP_CLOSE(g_sock);
		return False;
	}

#endif /* IPv6 */

	option_value = 1;
	option_len = sizeof(option_value);
	setsockopt(g_sock, IPPROTO_TCP, TCP_NODELAY, (void *) &option_value, option_len);
	/* receive buffer must be a least 16 K */
	if (getsockopt(g_sock, SOL_SOCKET, SO_RCVBUF, (void *) &option_value, &option_len) == 0)
	{
		if (option_value < (1024 * 16))
		{
			option_value = 1024 * 16;
			option_len = sizeof(option_value);
			setsockopt(g_sock, SOL_SOCKET, SO_RCVBUF, (void *) &option_value,
				   option_len);
		}
	}

	g_in.size = 4096;
	g_in.data = (uint8 *) xmalloc(g_in.size);

	for (i = 0; i < STREAM_COUNT; i++)
	{
		g_out[i].size = 4096;
		g_out[i].data = (uint8 *) xmalloc(g_out[i].size);
	}

	return True;
}

/* Disconnect on the TCP layer */
void
tcp_disconnect(void)
{
	if (g_ssl >= 0)
	{
		ssl_socketclose(g_ssl);	/* AcornSSL owns and closes the socket */
		g_ssl = -1;
	}
	else
	{
		TCP_CLOSE(g_sock);
	}
}

char *
tcp_get_address()
{
	static char ipaddr[32];
	struct sockaddr_in sockaddr;
/* *** START *** AJS 21/03/2004 *** */
/*	socklen_t len = sizeof(sockaddr); */
	int len = sizeof(sockaddr);
/* *** END *** AJS 21/03/2004 *** */

	if (getsockname(g_sock, (struct sockaddr *) &sockaddr, &len) == 0)
	{
		uint8 *ip = (uint8 *) & sockaddr.sin_addr;
		sprintf(ipaddr, "%d.%d.%d.%d", ip[0], ip[1], ip[2], ip[3]);
	}
	else
		strcpy(ipaddr, "127.0.0.1");
	return ipaddr;
}

/* reset the state of the tcp layer */
/* Support for Session Directory */
void
tcp_reset_state(void)
{
	int i;

	g_sock = -1;		/* reset socket */
	g_ssl = -1;		/* reset TLS session */

	/* Clear the incoming stream */
	if (g_in.data != NULL)
		xfree(g_in.data);
	g_in.p = NULL;
	g_in.end = NULL;
	g_in.data = NULL;
	g_in.size = 0;
	g_in.iso_hdr = NULL;
	g_in.mcs_hdr = NULL;
	g_in.sec_hdr = NULL;
	g_in.rdp_hdr = NULL;
	g_in.channel_hdr = NULL;

	/* Clear the outgoing stream(s) */
	for (i = 0; i < STREAM_COUNT; i++)
	{
		if (g_out[i].data != NULL)
			xfree(g_out[i].data);
		g_out[i].p = NULL;
		g_out[i].end = NULL;
		g_out[i].data = NULL;
		g_out[i].size = 0;
		g_out[i].iso_hdr = NULL;
		g_out[i].mcs_hdr = NULL;
		g_out[i].sec_hdr = NULL;
		g_out[i].rdp_hdr = NULL;
		g_out[i].channel_hdr = NULL;
	}
}
