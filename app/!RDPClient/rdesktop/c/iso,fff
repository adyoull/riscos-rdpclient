#include "rdesktop.h"

/* RDP Negotiation (MS-RDPBCGR 2.2.1.1.1 request / 2.2.1.2.1 response) */
#define TYPE_RDP_NEG_REQ      0x01
#define TYPE_RDP_NEG_RSP      0x02
#define TYPE_RDP_NEG_FAILURE  0x03
#define PROTOCOL_RDP          0x00000000
#define PROTOCOL_SSL          0x00000001
#define PROTOCOL_HYBRID       0x00000002


/* Send a self-contained ISO PDU */
static void
iso_send_msg(uint8 code)
{
	STREAM s;

	s = tcp_init(11);

	out_uint8(s, 3);	/* version */
	out_uint8(s, 0);	/* reserved */
	out_uint16_be(s, 11);	/* length */

	out_uint8(s, 6);	/* hdrlen */
	out_uint8(s, code);
	out_uint16(s, 0);	/* dst_ref */
	out_uint16(s, 0);	/* src_ref */
	out_uint8(s, 0);	/* class */

	s_mark_end(s);
	tcp_send(s);
}

static void
iso_send_connection_request(char *username)
{
	STREAM s;
	RD_BOOL offer_ssl = tcp_tls_available();
	int neg_len = offer_ssl ? 8 : 0;
	int length = 30 + strlen(username) + neg_len;

#ifdef TLS_NEG_DEBUG
	warning("NEG: AcornSSL %s -- %s TLS in RDP negotiation\n",
	        offer_ssl ? "present" : "NOT present",
	        offer_ssl ? "offering" : "not offering");
#endif

	s = tcp_init(length);

	out_uint8(s, 3);	/* version */
	out_uint8(s, 0);	/* reserved */
	out_uint16_be(s, length);	/* length */

	out_uint8(s, length - 5);	/* hdrlen */
	out_uint8(s, ISO_PDU_CR);
	out_uint16(s, 0);	/* dst_ref */
	out_uint16(s, 0);	/* src_ref */
	out_uint8(s, 0);	/* class */

	out_uint8p(s, "Cookie: mstshash=", strlen("Cookie: mstshash="));
	out_uint8p(s, username, strlen(username));

	out_uint8(s, 0x0d);	/* Unknown */
	out_uint8(s, 0x0a);	/* Unknown */

	if (offer_ssl)
	{
		/* RDP Negotiation Request: offer TLS. RDP standard security (0) is
		   implicit, so a server that will not do TLS still selects it and we
		   stay on the plaintext path. Only sent when AcornSSL is present. */
		out_uint8(s, TYPE_RDP_NEG_REQ);	/* type */
		out_uint8(s, 0);		/* flags */
		out_uint16_le(s, 8);		/* length */
		out_uint32_le(s, PROTOCOL_SSL);	/* requestedProtocols */
	}

	s_mark_end(s);
	tcp_send(s);
}

/* Receive a message on the ISO layer, return code */
static STREAM
iso_recv_msg(uint8 * code, uint8 * rdpver)
{
	STREAM s;
	uint16 length;
	uint8 version;

	s = tcp_recv(NULL, 4);
	if (s == NULL)
		return NULL;
	in_uint8(s, version);
	if (rdpver != NULL)
		*rdpver = version;
	if (version == 3)
	{
		in_uint8s(s, 1);	/* pad */
		in_uint16_be(s, length);
	}
	else
	{
		in_uint8(s, length);
		if (length & 0x80)
		{
			length &= ~0x80;
			next_be(s, length);
		}
	}
	if (length < 4)
	{
		error("Bad packet header\n");
		return NULL;
	}
	s = tcp_recv(s, length - 4);
	if (s == NULL)
		return NULL;
	if (version != 3)
		return s;
	in_uint8s(s, 1);	/* hdrlen */
	in_uint8(s, *code);
	if (*code == ISO_PDU_DT)
	{
		in_uint8s(s, 1);	/* eot */
		return s;
	}
	in_uint8s(s, 5);	/* dst_ref, src_ref, class */
	return s;
}

/* Initialise ISO transport data packet */
STREAM
iso_init(int length)
{
	STREAM s;

	s = tcp_init(length + 7);
	s_push_layer(s, iso_hdr, 7);

	return s;
}

/* Send an ISO data PDU */
void
iso_send(STREAM s)
{
	uint16 length;

	s_pop_layer(s, iso_hdr);
	length = s->end - s->p;

	out_uint8(s, 3);	/* version */
	out_uint8(s, 0);	/* reserved */
	out_uint16_be(s, length);

	out_uint8(s, 2);	/* hdrlen */
	out_uint8(s, ISO_PDU_DT);	/* code */
	out_uint8(s, 0x80);	/* eot */

	tcp_send(s);
}

/* Receive ISO transport data packet */
STREAM
iso_recv(uint8 * rdpver)
{
	STREAM s;
	uint8 code = 0;

	s = iso_recv_msg(&code, rdpver);
	if (s == NULL)
		return NULL;
	if (rdpver != NULL)
		if (*rdpver != 3)
			return s;
	if (code != ISO_PDU_DT)
	{
		error("expected DT, got 0x%x\n", code);
		return NULL;
	}
	return s;
}

/* Establish a connection up to the ISO layer */
RD_BOOL
iso_connect(char *server, char *username, RD_BOOL reconnect)
{
	uint8 code = 0;
	STREAM s;

	if (!tcp_connect(server))
		return False;

	if (reconnect)
	{
		iso_send_msg(ISO_PDU_CR);
	}
	else
	{
		iso_send_connection_request(username);
	}

	s = iso_recv_msg(&code, NULL);
	if (s == NULL)
		return False;

	if (code != ISO_PDU_CC)
	{
		error("expected CC, got 0x%x\n", code);
		tcp_disconnect();
		return False;
	}

	/* Optional RDP Negotiation Response follows the X.224 CC. If the server
	   selected TLS, upgrade the connection now, before any MCS traffic. */
	if (!reconnect && s_check_rem(s, 8))
	{
		uint8 neg_type;
		uint32 selected;

		in_uint8(s, neg_type);
		in_uint8s(s, 3);		/* flags (1) + length (2) */
		in_uint32_le(s, selected);

#ifdef TLS_NEG_DEBUG
		warning("NEG: server response type=%u selectedProtocol=%u\n",
		        (unsigned) neg_type, (unsigned) selected);
#endif

		if (neg_type == TYPE_RDP_NEG_FAILURE)
		{
			error("server refused RDP negotiation (failure code %u)\n", (unsigned) selected);
			tcp_disconnect();
			return False;
		}

		if (neg_type == TYPE_RDP_NEG_RSP && selected == PROTOCOL_SSL)
		{
			if (!tcp_tls_connect())
			{
				tcp_disconnect();
				return False;
			}
#ifdef TLS_NEG_DEBUG
			warning("NEG: TLS session is now ACTIVE\n");
#endif
		}
		else if (neg_type == TYPE_RDP_NEG_RSP && selected == PROTOCOL_HYBRID)
		{
			error("server requires NLA/CredSSP, which this client does not support\n");
			tcp_disconnect();
			return False;
		}
#ifdef TLS_NEG_DEBUG
		else
			warning("NEG: server selected standard RDP security (plaintext)\n");
#endif
	}
#ifdef TLS_NEG_DEBUG
	else if (!reconnect)
		warning("NEG: no negotiation response -- plaintext standard RDP\n");
#endif

	return True;
}

/* Disconnect from the ISO layer */
void
iso_disconnect(void)
{
	iso_send_msg(ISO_PDU_DR);
	tcp_disconnect();
}

/* reset the state to support reconnecting */
void
iso_reset_state(void)
{
	tcp_reset_state();
}
