static mouse_button_block saved_buttons;
static wimp_point saved_position;
static BOOL click_position;

static unsigned int motion_update_interval;
static unsigned int next_motion_update;

/*
 * (C) 2026 Andrew Youll -- scroll-wheel support.
 *
 * OS_Pointer 2 (SWI &64) returns the accumulated position of the "alternate
 * positioning device" (the scroll wheel) in R1 (signed 32-bit Y). We remember
 * the last value and forward the difference to the remote each poll. The
 * counter is unbounded and may wrap; a wrap shows up as an implausibly large
 * jump, which we ignore.
 */
#ifndef SWI_OS_Pointer
#define SWI_OS_Pointer                  0x000064
#endif

/*
 * Scroll-wheel calibration:
 *   WHEEL_UNITS_PER_NOTCH -- OS_Pointer alternate-Y units that make up one
 *                            "step" of wheel movement.
 *   WHEEL_MAX_STEP        -- cap steps detected in a single poll so a large
 *                            accumulated jump can't flood the remote.
 *   WHEEL_WRAP_LIMIT      -- deltas larger than this are treated as a counter
 *                            wrap (or first-run garbage) and ignored.
 *
 * User-adjustable settings (iconbar menu -> Scroll; saved to Choices):
 *   wheel_invert -- 0 = normal, 1 = reverse the scroll direction.
 *   wheel_speed  -- remote wheel notches sent per detected step,
 *                   WHEEL_SPEED_MIN..WHEEL_SPEED_MAX (1 = the original 1:1).
 */
#define WHEEL_UNITS_PER_NOTCH           1
#define WHEEL_MAX_STEP                  4
#define WHEEL_WRAP_LIMIT                1000000

#define WHEEL_SPEED_MIN                 1
#define WHEEL_SPEED_MAX                 5
#define WHEEL_SPEED_DEFAULT             1

#define WHEEL_CHOICES_READ              "Choices:RDPClientWheel"
#define WHEEL_CHOICES_WRITE             "<Choices$Write>.RDPClientWheel"

static int  wheel_last_y;
static BOOL wheel_have_last;
static int  wheel_accum;

static int  wheel_invert = 0;                  /* (C) 2026 Andrew Youll */
static int  wheel_speed  = WHEEL_SPEED_DEFAULT; /* (C) 2026 Andrew Youll */

static void get_mouse_state(mouse_button_block *buttons, wimp_point *position);
static void update_mouse(mouse_button_block *current_buttons, wimp_point *current_position,
                         BOOL force);
static BOOL read_pointer_enabled_state(void);
static void set_pointer_enabled_state(BOOL enabled);
static void poll_wheel(void);
static void send_wheel_notch(BOOL up);
static void load_wheel_choices(void);
static void save_wheel_choices(void);

