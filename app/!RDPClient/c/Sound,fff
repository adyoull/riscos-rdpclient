extern struct audio_driver *Sound_Register(char *options)
{
	static struct audio_driver riscos_driver;

	memset(&riscos_driver, 0, sizeof(riscos_driver));

	riscos_driver.name = "RISCOS";
	riscos_driver.description = "RISC OS output driver";

	riscos_driver.add_fds = riscos_sound_add_fds;
	riscos_driver.check_fds = riscos_sound_check_fds;

	riscos_driver.wave_out_open = riscos_sound_out_open;
	riscos_driver.wave_out_close = riscos_sound_out_close;
	riscos_driver.wave_out_format_supported = riscos_sound_out_format_supported;
	riscos_driver.wave_out_set_format = riscos_sound_out_set_format;
	riscos_driver.wave_out_volume = riscos_sound_out_volume;

	riscos_driver.need_byteswap_on_be = 0;
	riscos_driver.need_resampling = 0;

	return (&riscos_driver);
}

