static BOOL ssb_returnstreamhandle(int handle, int *stream)
{
  BOOL success;
  _kernel_swi_regs r;
  success = FALSE;

  *stream = 0;

  r.r[0] = (int)handle;

  if(_kernel_swi(SWI_XOS_Bit | SWI_SharedSoundBuffer_ReturnStreamHandle, &r, &r) == 0)
     success = TRUE;

  *stream = r.r[0];

  return(success);
}

/******************************************************************************/

static BOOL sm_addblock(int stream, unsigned char *block, int length)
{
  BOOL success;
  _kernel_swi_regs r;
  success = FALSE;

  r.r[0] = (int)stream;
  r.r[1] = (int)block;
  r.r[2] = (int)length;

  if(_kernel_swi(SWI_XOS_Bit | SWI_StreamManager_AddBlock, &r, &r) == NULL)
     success = TRUE;

  return(success);
}

/******************************************************************************/

static BOOL sm_addblock_flex(int stream, unsigned char **block, int length)
{
  BOOL success;
  _kernel_swi_regs r;
  success = FALSE;

  r.r[0] = (int)stream;
  r.r[1] = (int)*block;
  r.r[2] = (int)length;

  if(_kernel_swi(SWI_XOS_Bit | SWI_StreamManager_AddBlock, &r, &r) == NULL)
     success = TRUE;

  return(success);
}

