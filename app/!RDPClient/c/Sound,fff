static RD_BOOL riscos_sound_out_format_supported(RD_WAVEFORMATEX *pwfx)
{
#ifdef SOUND_DEBUG
  fprintf(stderr, "wave_out_format_supported(bits=%i, channels=%i, rate=%i, format=%i)\n",
          pwfx->wBitsPerSample, pwfx->nChannels, pwfx->nSamplesPerSec, pwfx->wFormatTag);
#endif

  Sound_Startup();

//  if((pwfx->wFormatTag != WAVE_FORMAT_PCM) && (pwfx->wFormatTag != 353))
//     return(FALSE);

  if(pwfx->wFormatTag != WAVE_FORMAT_PCM)
     return(FALSE);

//  if((pwfx->nChannels != 1) && (pwfx->nChannels != 2))
//     return(FALSE);

  if(pwfx->nChannels != 2)
     return(FALSE);

//  if((pwfx->nChannels != 1))
//     return(FALSE);

//  if((pwfx->wBitsPerSample != 8) && (pwfx->wBitsPerSample != 16))
//     return(FALSE);

  if(pwfx->wBitsPerSample != 16)
     return(FALSE);

#ifdef SOUND_DEBUG
  fprintf(stderr, "  returned TRUE\n");
#endif
  return(TRUE);
}

/******************************************************************************/

static RD_BOOL riscos_sound_out_set_format(RD_WAVEFORMATEX * pwfx)
{
#ifdef SOUND_DEBUG
  fprintf(stderr, "wave_out_set_format(bits=%i, channels=%i, rate=%i, format=%i)\n",
          pwfx->wBitsPerSample, pwfx->nChannels, pwfx->nSamplesPerSec,
          pwfx->wFormatTag);
#endif
  
  Sound_Startup();

  if(sound_initialised){

     sound_channels = (int)pwfx->nChannels;
     Status_SetSoundChannels(sound_channels);
     
     sound_bits = (int)pwfx->wBitsPerSample;
     Status_SetSoundBits(sound_bits);

     //ssb_samplerate(sound_handle, pwfx->nSamplesPerSec * 1019);  /* 1024 * 0.995 = 1019 */
     ssb_samplerate(sound_handle, pwfx->nSamplesPerSec * 1024);
     Status_SetSoundRate(pwfx->nSamplesPerSec); 

  }

  samplewidth = pwfx->wBitsPerSample / 8;

  if(sound_channels == 2)
     samplewidth *= 2;

  snd_rate = pwfx->nSamplesPerSec;

  return(TRUE);
}

/******************************************************************************/

static void riscos_sound_play(void)
{
  struct audio_packet *packet;
  STREAM s;
  int delay_bytes;
  unsigned long delay_us;
  int buffer_length;
  BOOL success;
  BOOL data_in_buffer;
#ifdef SOUND_DEBUG
  fprintf(stderr, "wave_out_write(s->size=%i, tick=%i, index=%i)\n", s->size, tick, index);
#endif

  ssize_t len;
/*
  FILE *testfile;
*/

  /* We shouldn't be called if the queue is empty, but still */
  if(rdpsnd_queue_empty())
     return;

  Sound_Startup();

  if(sound_initialised){

     packet = rdpsnd_queue_current_packet();
     s = &packet->s;

     len = s->end - s->p;

     buffer_length = sound_buffer_length((int)len);
     data_in_buffer = FALSE;

     if(sound_buffer_required() || (int)len != buffer_length){

        data_in_buffer = TRUE;

        if(buffer_length > sound_global_buffer_length){

           if(sound_global_buffer_data != NULL){
               MemMan_Free((memman_ptr) &sound_global_buffer_data);
               sound_global_buffer_data = NULL;
               sound_global_buffer_length = 0;
           }
           
           MemMan_Alloc((memman_ptr) &sound_global_buffer_data, buffer_length);

           if(sound_global_buffer_data != NULL)
              sound_global_buffer_length = buffer_length;
        }

        if(sound_global_buffer_data == NULL)
           buffer_length = 0;
        else
           copy_sound_to_buffer((unsigned char *)s->p,
                                &sound_global_buffer_data, buffer_length);
     }

     if(buffer_length > 0){
/*
        testfile = fopen("<RDPClient$Dir>.^.SoundTest.RDP", "ab");
        if(testfile != NULL){
           fwrite(sound_data, 1, len, testfile);

           fclose(testfile);
        }
*/
        if(data_in_buffer)
           success = sm_addblock_flex(sound_stream, &sound_global_buffer_data, buffer_length);
        else
           success = sm_addblock(sound_stream, (unsigned char *)s->p, buffer_length);
     }
     else
        success = FALSE;

     if(success){

        /* all of packet could be written to buffer */
        s->p += len;

        //delay_bytes = s->size;
        delay_bytes = 0;

        delay_us = delay_bytes * (1000000 / (samplewidth * snd_rate));
        rdpsnd_queue_next(delay_us);
     }
  }
}

