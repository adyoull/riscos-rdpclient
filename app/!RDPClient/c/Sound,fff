extern STREAM rdpsnd_dsp_process(unsigned char *data, unsigned int size,
                                 struct audio_driver *current_driver,
                                 RD_WAVEFORMATEX * format)
{
  static struct stream out;

  out.data = (unsigned char *)xmalloc(size);
  memcpy(out.data, data, size);
  out.size = size;

  out.p = out.data;
  out.end = out.p + out.size;

  return(&out);
}

