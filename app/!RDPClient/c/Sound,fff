extern int gettimeofday(struct timeval *tv, struct timezone *tzp)
{
  unsigned int time;
  unsigned int time_sec;

  while((time = Time_Monotonic()) == 0);

  time_sec = time / 1000;

  tv->tv_sec = time_sec;
  tv->tv_usec = (time - (time_sec * 1000)) * 1000;
}

