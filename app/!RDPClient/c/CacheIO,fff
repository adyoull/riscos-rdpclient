/******************************************************************************/

static BOOL add_open_file(file_handle channel)
{
  open_file_block *item;

  item = malloc(sizeof(open_file_block));

  if(item == NULL)
     return(FALSE);

  LinkList_InitItem(&(item->header));

  item->channel = channel;

  LinkList_AddToTail(&(open_files_list), &(item->header));

  return(TRUE);
}

/******************************************************************************/

static BOOL remove_open_file(file_handle channel)
{
  open_file_block *item;

  item = LinkList_NextItem(&(open_files_list));

  while(item != NULL && item->channel != channel)
     item = LinkList_NextItem(&(item->header));

  if(item != NULL && item->channel == channel){
     LinkList_Unlink(&(open_files_list), &(item->header));
     free(item);
     return(TRUE);
  }
  else
     return(FALSE);
}

/******************************************************************************/

static void close_open_files(void)
{
  open_file_block *item;

  item = LinkList_NextItem(&(open_files_list));

  while(item != NULL){

     LinkList_Unlink(&(open_files_list), &(item->header));

     File_Close(item->channel);
     free(item);

     item = LinkList_NextItem(&(open_files_list));
  }
}
