extern void error(char *format, ...);

#define WIMP_SCRAP_DIR    "<Wimp$ScrapDir>"

static char app_session_temp_dir[256];
static linklist_header open_files_list;

typedef struct {
    linklist_header   header;
    file_handle       channel;
} open_file_block;

static void atexit_handler(void);
static void cache_directory_error(os_error *err, char *name);
static void cache_file_open_error(os_error *err, char *name);
static void cache_file_close_error(os_error *err);
static void cache_file_read_error(os_error *err);
static void cache_file_write_error(os_error *err);
static void cache_file_seek_error(os_error *err);
static BOOL add_open_file(file_handle channel);
static BOOL remove_open_file(file_handle channel);
static void close_open_files(void);


