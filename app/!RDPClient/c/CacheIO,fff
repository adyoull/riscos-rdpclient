 *                                  handlers                                  *
 ******************************************************************************/

static void atexit_handler(void)
{
 /*
  * Clean up cache directory on closedown
  */
//fprintf(stderr, "Called CacheIO_atexit_handler()\n");

  char command[255];

  close_open_files();

  if(app_session_temp_dir[0] != '\0'){

     sprintf(command, "wipe %s ~CFR~V", app_session_temp_dir);

     OS_CLI(command);
      
  }
}

