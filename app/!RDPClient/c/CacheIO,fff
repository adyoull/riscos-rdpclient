 *                            extern routines                                 *
 ******************************************************************************/

extern void CacheIO_Init(void)
{
 /*
  * initialisation to be done on startup
  */

  app_session_temp_dir[0] = '\0';

  LinkList_InitItem(&(open_files_list));

  atexit(atexit_handler);

}

/******************************************************************************/

extern BOOL CacheIO_CreateCacheDirectory(void)
{
 /*
  * Create unique session cache directory
  */
  os_error *err = NULL;
  char app_dir[256];
  char *name;

  if(!OS_ReadVarVal("RDPClient$PstCacheDir", app_dir, 255))
     sprintf(app_dir, "%s.%s", WIMP_SCRAP_DIR, event_taskname);

  err = File_CreateDir(app_dir);
  name = app_dir;

  if(err == NULL){

     sprintf(app_session_temp_dir, "%s.%i", app_dir, event_taskhandle);

     err = File_CreateDir(app_session_temp_dir);
     name = app_session_temp_dir;

  }

  if(err != NULL)
     cache_directory_error(err, name);

  return(err == NULL);
}

/******************************************************************************/

extern int CacheIO_OpenCacheFile(char *filename)
{
 /*
  * Open file in session cache directory, ignoring any UNIX style directory
  * name prefix.
  * Return file handle or -1 if fails.
  */
//fprintf(stderr, "Called CacheIO_OpenCacheFile(filename='%s')\n", filename);
  
  char *leaf_name;
  file_handle channel;
  char file_name[256];

  leaf_name = filename + strlen(filename);

  while(leaf_name > filename){

     if(*leaf_name == '/' || *leaf_name == '\\'){
        leaf_name++;
        break;
     }

     leaf_name--;

  }

  sprintf(file_name, "%s.%s", app_session_temp_dir, leaf_name);

  channel = File_Open(file_name, file_WRITE);

  if(channel != NULL)
     add_open_file(channel);
  else
     cache_file_open_error(file_lasterror, leaf_name);

//fprintf(stderr, "return(%i)\n", (channel == NULL ? -1 : (int)channel));

  if(channel == NULL)
     return(-1);
  else
     return((int)channel);
}

/******************************************************************************/

extern void CacheIO_CloseCacheFile(int fd)
{
 /*
  * Close cache file
  */
//fprintf(stderr, "Called CacheIO_CloseCacheFile(fd=%i\n", fd);

  file_handle channel = (file_handle)fd;
  os_error *err = NULL;

  err = File_Close(channel);

  remove_open_file(channel);
  
  if(err != NULL)
     cache_file_close_error(err);
}

/******************************************************************************/

extern int CacheIO_ReadCacheFile(int fd, void *ptr, int len)
{
 /*
  * Read 'len' bytes into 'ptr' from file 'fd'
  * Return number of bytes read.
  */
//fprintf(stderr, "Called CacheIO_ReadCacheFile(fd=%i, ptr=%li, len=%i)\n", fd, ptr, len);

  file_handle channel = (file_handle)fd;
  int bytes_read;

  bytes_read = File_ReadBytes(channel, ptr, len);

  if(bytes_read != len)
     cache_file_read_error(file_lasterror);

  return(bytes_read);
}

/******************************************************************************/

extern int CacheIO_WriteCacheFile(int fd, void *ptr, int len)
{
 /*
  * Write 'len' bytes into 'ptr' from file 'fd'
  * Return number of bytes read.
  */
//fprintf(stderr, "Called CacheIO_WriteCacheFile(fd=%i, ptr=%li, len=%i)\n", fd, ptr, len);

  file_handle channel = (file_handle)fd;
  os_error *err;

  err = File_WriteBytes(channel, ptr, len);

  if(err == NULL)
     return(len);
  else{
     cache_file_write_error(err);
     return(0);
  }
}

/******************************************************************************/

extern int CacheIO_SeekCacheFile(int fd, int offset)
{
 /*
  * Seek file pointer to 'offset' in file 'fd'
  */
//fprintf(stderr, "Called CacheIO_SeekCacheFile(fd=%i, offset=%i)\n", fd, offset);

  file_handle channel = (file_handle)fd;
  os_error *err;

  err = File_Seek(channel, (file_position)offset);

  if(err == NULL)
     return(offset);
  else{
     cache_file_seek_error(err);
     return((int)File_ReturnPos(channel));
  }
}

