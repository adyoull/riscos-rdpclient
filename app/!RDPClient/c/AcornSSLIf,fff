int ssl_socketioctl(int sslhandle, unsigned long cmd, ...)
{
    _kernel_swi_regs r;
    _kernel_oserror *err;
    va_list args;
    int data;

    va_start(args, cmd);
    data = va_arg(args, int);
    va_end(args);

    r.r[0] = sslhandle;
    r.r[1] = (int)cmd;
    r.r[2] = data;
    err = _kernel_swi(AcornSSL_Ioctl | XOS_Bit, &r, &r);
    if (err) { errno = GETDCI4ERRNO(err->errnum); ssl_capture_err(err); return -1; }
    return 0;
}

