/* AcornSSL C interface for !RDPClient.
 *
 * Thin C veneers over the RISC OS AcornSSL module SWIs (TLS via mbedTLS).
 *
 * Based on Colin Granville's AcornSSL C wrapper for FTPc:
 *     Copyright (C) Colin Granville.
 * The original wrapper was made freely available by its author for reuse in
 * the RISC OS Open forum thread "Using AcornSSL from C"
 * (riscosopen.org/forum/forums/3/topics/16381); source:
 * http://ftpc.iconbar.com/acornssllib.zip
 *
 * Colin's original called the SWIs with __asm inline assembler; the online
 * build service's Norcroft cc 5.18 does not accept that syntax, so the veneers
 * are re-expressed here with _kernel_swi() (the SWI-call convention used
 * elsewhere in this project). SWI numbers/constants come from Castle's exported
 * AcornSSL header (see h.AcornSSL, Castle base licence). Renamed
 * (ssl.h -> AcornSSLIf.h, acornssl.h -> AcornSSL.h) to avoid clashing with
 * rdesktop's own crypto ssl.c/ssl.h, and integrated into !RDPClient for
 * RDP-over-TLS.
 */
#include "AcornSSLIf.h"
#include "AcornSSL.h"
#include "sys/errno.h"
#include "sys/dcistructs.h"
#include <stdarg.h>
#include <stdio.h>
#include <string.h>

/* Error-returning (X) form of the SWIs, so a failure returns an error block
   rather than aborting. On error we map the DCI4 error number to errno and
   return -1, matching the BSD-socket contract of the original wrapper. */
#ifndef XOS_Bit
#define XOS_Bit 0x20000
#endif

/* Most recent AcornSSL error message, captured on any failing veneer so the
   caller can report the real reason (e.g. a TLS handshake / mbedTLS error)
   instead of the meaningless errno that GETDCI4ERRNO() yields for non-socket
   errors. */
static char g_ssl_errmess[252] = "";

const char *ssl_last_errmess(void)
{
    return g_ssl_errmess;
}

static void ssl_capture_err(_kernel_oserror *err)
{
    if (err != NULL && err->errmess[0] != '\0')
    {
        strncpy(g_ssl_errmess, err->errmess, sizeof(g_ssl_errmess) - 1);
        g_ssl_errmess[sizeof(g_ssl_errmess) - 1] = '\0';
    }
}

int ssl_connect(int sslhandle, const struct sockaddr *name, int namelen)
{
    _kernel_swi_regs r;
    _kernel_oserror *err;
    r.r[0] = sslhandle;
    r.r[1] = (int)name;
    r.r[2] = namelen;
    err = _kernel_swi(AcornSSL_Connect | XOS_Bit, &r, &r);
    if (err) { errno = GETDCI4ERRNO(err->errnum); ssl_capture_err(err); return -1; }
    return 0;
}

