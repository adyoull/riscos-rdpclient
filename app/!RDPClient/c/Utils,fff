extern void Utils_TaskNameFromHandle(char *taskname, int length, int taskhandle)
{
 /*
  * Returns name of task corresponding to supplied taskhandle
  */
  _kernel_swi_regs r;

  r.r[0] = (int)taskhandle;

  if(_kernel_swi(SWI_XOS_Bit | SWI_TaskManager_TaskNameFromHandle, &r, &r) == NULL)
     Utils_CopyStringNL(taskname, (char *)r.r[0], length);
  else
     taskname[0] = '\0';
}

