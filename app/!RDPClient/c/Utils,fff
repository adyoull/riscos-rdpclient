extern BOOL Utils_IsTaskRunning(char *taskname, task_handle ignore_taskhandle)
{
 /*
  * Returns TRUE if taskname is running
  */
  BOOL task_found = FALSE;
  taskmanager_taskinfo tasklist[20];
  char running_taskname[256];
  int index;
  int state = 0;
  int number = 0;

  number = Utils_EnumerateTasks(&state, tasklist, sizeof(tasklist));

  while(number > 0 && !task_found){

     for(index = 0; index < number; index++){

        if(tasklist[index].taskhandle != ignore_taskhandle){

           Utils_CopyStringNL(running_taskname, tasklist[index].taskname,
                              sizeof(running_taskname));

           if(strcmp(running_taskname, taskname) == 0){

              task_found = TRUE;
              break;

           }
        }
     }

     number = Utils_EnumerateTasks(&state, tasklist, sizeof(tasklist));
  }

  return(task_found);
}

/******************************************************************************/

extern task_handle Utils_TaskHandleFromName(char *taskname, task_handle ignore_taskhandle)
{
 /*
  * Returns task handle from first task matching taskname
  */
  BOOL task_found = FALSE;
  taskmanager_taskinfo tasklist[20];
  char running_taskname[256];
  int index;
  int state = 0;
  int number = 0;
  task_handle taskhandle = 0;

  number = Utils_EnumerateTasks(&state, tasklist, sizeof(tasklist));

  while(number > 0 && !task_found){

     for(index = 0; index < number; index++){

        if(tasklist[index].taskhandle != ignore_taskhandle){

           Utils_CopyStringNL(running_taskname, tasklist[index].taskname,
                              sizeof(running_taskname));

           if(strcmp(running_taskname, taskname) == 0){

              task_found = TRUE;
              taskhandle = tasklist[index].taskhandle;
              break;

           }
        }
     }

     number = Utils_EnumerateTasks(&state, tasklist, sizeof(tasklist));
  }

  return(taskhandle);
}
