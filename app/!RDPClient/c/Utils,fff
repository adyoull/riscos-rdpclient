extern BOOL Utils_IsModuleLoaded(char *module_name)
{
  BOOL loaded;
 /*
  * Returns TRUE if module is loaded otherwise FALSE
  */
  _kernel_swi_regs r;
  loaded = FALSE;

  r.r[0] = 18;           /* lookup module name */
  r.r[1] = (int)module_name;

  if(_kernel_swi(SWI_XOS_Bit | SWI_OS_Module, &r, &r) == NULL){
     if(r.r[1] > 0)
        loaded = TRUE;
  }

  return(loaded);
}

