extern void Utils_CRLF2LF(char *data, unsigned int *length)
{
 /*
  * Remove CRs in place and update length
  */
  char *dest, *src;
  src = dest = data;

  while(src < data + *length){

     if(*src != '\x0d')
        *dest++ = *src;

     src++;
  }

  *length = dest - data;
}

/******************************************************************************/

extern void Utils_LF2CRLF(char *data, unsigned int *length)
{
 /*
  * Replace LFs with CRLF inplace and update length.
  * Memory must already be allocated to account for string increasing in length
  */
  unsigned int number_lfs;
  char *p, *p2, *end;

  number_lfs = 0;
  end = data + *length;
  p = data;

  while(p < end){

    if(*p == '\x0a'){
       if(p == data)
          number_lfs++;
       else if(*(p - 1) != '\x0d')
          number_lfs++;
    }
    p++;

  }

  if(number_lfs > 0){

     p = (data + *length) - 1;
     p2 = p + number_lfs;

     while(p >= data && p2 >= data){

        *p2 = *p--;

        if(*p2-- == '\x0a'){
           if(p < data)
              *p2-- = '\x0d';
           else if(*p != '\x0d')
              *p2-- = '\x0d';
        }

     }

     *length += number_lfs;
  }
}

