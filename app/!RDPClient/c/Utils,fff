extern int Utils_WimpTextLength(char *text)
{
  int length;
  BOOL system_font;
 /*
  * Returns length of text in OS units when plotted using the Desktop Font
  */
  int swi_wimp_textop;
  _kernel_swi_regs r;

  system_font = TRUE;

  if(OS_SWINumberFromString("Wimp_TextOp", &swi_wimp_textop) == NULL){

   /*
    * Use Wimp_TextOp to calculate width of text as may be Outline Font
    * or System font
    */
    r.r[0] = 1;         /* calculate width of string */
    r.r[1] = (int)text; /* string */
    r.r[2] = 0;         /* scan whole string */

    if(_kernel_swi(SWI_XOS_Bit | swi_wimp_textop, &r, &r) == NULL){

      system_font = FALSE;
      length = r.r[0];

    }
  }

  if(system_font){

   /*
    * Wimp_TextOp not available so assume is System font
    * Each system font character is 16 OS units wide
    */
    length = strlen(text) << 4;

  }

  return(length);
}

