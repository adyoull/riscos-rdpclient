extern void Utils_ViewFinderFlags(BOOL *vf_enabled, BOOL *vf_output_mode)
{
  int flags;
 /*
  * Returns vf_enabled = TRUE if ViewFinder is present and enabled, otherwise FALSE
  * Returns vf_output_mode = TRUE if ViewFinder is active, or FALSE if VIDC is active
  */
  int swi_viewfinder_info;
  _kernel_swi_regs r;

  *vf_enabled = FALSE;
  *vf_output_mode = FALSE;

  if(OS_SWINumberFromString("ViewFinder_Info", &swi_viewfinder_info) == NULL){

    r.r[0] = 0;           /* return miscellaneous flags */
    r.r[1] = (int)&flags; /* buffer for flags */

    if(_kernel_swi(SWI_XOS_Bit | swi_viewfinder_info, &r, &r) == NULL){

      if(flags & 1)
         *vf_enabled = TRUE;
      else
         *vf_enabled = FALSE;

      if(flags & 2)
         *vf_output_mode = FALSE;
      else
         *vf_output_mode = TRUE;
    }
  }
}

