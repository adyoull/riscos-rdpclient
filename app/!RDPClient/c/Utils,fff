extern void *Utils_MemMove(void *dest, void *src, unsigned int size)
{
 /*
  * Version of memmove() which does not use a temporary area
  */
  char *destc = (char *)dest;
  char *srcc = (char *)src;
  unsigned int *desti = (unsigned int *)dest;
  unsigned int *srci = (unsigned int *)src;
  unsigned int length4;
  unsigned int loop;
  unsigned int loop2;
/*
  unsigned int c4 = 0;
  unsigned int c1 = 0;
*/

  if(destc < srcc){

     /* copy down */

     length4 = size >> 2;

     /* copy as 4 byte segments */
     for(loop = 0; loop < length4; loop++){
         *desti++ = *srci++;
         /*c4--;*/
     }

     srcc = (char *)srci;
     destc = (char *)desti;

     /* copy remaining bytes */
     for(loop = (length4 << 2); loop < size; loop++){
         *destc++ = *srcc++;
         /*c1--;*/
     }

  }
  else{

     /* copy up - start at end and work down to avoid corrupting source on overlap */

     /* copy bytes until word aligned */
     for(loop = size; (loop > 0) && ((loop & 0x3) != 0); loop--){
         loop2 = loop - 1;
         destc[loop2] = srcc[loop2];
         /*c1++;*/
     }

     /* copy rest as 4 byte segments */
     length4 = loop >> 2;
     for(loop = length4; loop > 0; loop--){
         loop2 = loop - 1;
         desti[loop2] = srci[loop2];
         /*c4++;*/
     }

  }

  /*fprintf(stderr, "copy length %i  c1 %i c4 %i\n", size, c1, c4);*/

  return(dest);
}

/******************************************************************************/

extern void Utils_MemMove_Flex(unsigned int dest_offset, unsigned int source_offset,
                               void **dest, void **src, unsigned int size)
{
 /*
  * Version of memmove() which does not use a temporary area and works with
  * flex anchors.
  */
  char *destc = ((char *)*dest) + dest_offset;
  char *srcc = ((char *)*src) + source_offset;
  unsigned int loop;

  if(size == 0)
     return;
     
  if(destc < srcc){

     /* copy down */

     for(loop = 0; loop < size; loop++){
         *destc++ = *srcc++;
     }

  }
  else{

     /* copy up - start at end and work down to avoid corrupting source on overlap */

     destc = destc + (size - 1);
     srcc = srcc + (size - 1);

     for(loop = size; loop > 0; loop--){
         *destc-- = *srcc--;
     }

  }

}

