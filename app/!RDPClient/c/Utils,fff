#define BARICON_XSIZE 68
#define BARICON_YSIZE 88

extern icon_handle Utils_BarIconText(char *validation_ptr, char *text_ptr,
                                     unsigned int text_maxlen, window_handle pos)
{
 /*
  * Place a sprite from a USER sprite area on the icon bar with text underneath
  * Returns icon handle.
  */
  icon_createblock icreate;
  icon_handle icon;
  int textlength;
  int width;

  icreate.window = pos;
  icreate.icondata.flags.value = 0x1700310B;    /* Click-able validated sprite icon */

  icreate.icondata.data.indirecttext.bufflen = text_maxlen;
  icreate.icondata.data.indirecttext.buffer = text_ptr;
  icreate.icondata.data.indirecttext.validstring = validation_ptr;

  icreate.icondata.workarearect.min.x = 0;
  icreate.icondata.workarearect.min.y = -16;

  textlength = Utils_WimpTextLength(text_ptr);
  if(textlength < BARICON_XSIZE)
    width = BARICON_XSIZE;
  else
    width = textlength;

  icreate.icondata.workarearect.max.x = width;
  icreate.icondata.workarearect.max.y = BARICON_YSIZE;

  Wimp_CreateIcon(&icreate, &icon);
  
  return(icon);
}

