extern int Utils_EnumerateTasks(int *state, taskmanager_taskinfo *info_buffer, int buffer_size)
{
  int number_tasks;
  unsigned int start_address;
  unsigned int end_address;
 /*
  * Enumerates running tasks.
  * state must be 0 for first call and passed in for subsequent calls
  * Number of task blocks obtained is returned.
  */
  _kernel_swi_regs r;
  number_tasks = 0;
  start_address = (unsigned int)info_buffer;
  end_address = start_address;

  if(*state >= 0){

     r.r[0] = (int)*state;
     r.r[1] = (int)info_buffer;
     r.r[2] = (int)buffer_size;

     if(_kernel_swi(SWI_XOS_Bit | SWI_TaskManager_EnumerateTasks, &r, &r) == NULL){

        *state = (int)r.r[0];

        end_address = (unsigned int)r.r[1];

        number_tasks = (end_address - start_address) / sizeof(taskmanager_taskinfo);
     }
  }

  return(number_tasks);
}

