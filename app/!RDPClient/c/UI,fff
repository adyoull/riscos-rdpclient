extern RD_HCOLOURMAP ui_create_colourmap(COLOURMAP * colours)
{
  palette_entry *palette, *palette_p;
  size_t size;
  int maxcol;
  int colour;
  COLOURENTRY *colours_p;

//fprintf(stderr, "Called ui_create_colourmap(%li)  colours.ncolours = %i\n", colours, colours->ncolours);

  size = 256 * sizeof(palette_entry);
  palette = malloc(size);
  if(palette == NULL)
     return(NULL);

  memset(palette, 0, size);

  if(colours->ncolours > 256)
     maxcol = 256;
  else
     maxcol = (int)colours->ncolours;

  palette_p = palette;
  colours_p = colours->colours;

  for(colour = 0; colour < maxcol; colour++){

     palette_p->data.red = colours_p->red;
     palette_p->data.green = colours_p->green;
     palette_p->data.blue = colours_p->blue;

/*
fprintf(stderr, "  colour %i   red %i  green %i  blue %i\n", colour,
        palette_p->data.red, palette_p->data.green, palette_p->data.blue);
*/

     palette_p++;
     colours_p++;

  }

//fprintf(stderr, " ui_create_colourmap() returns %li\n", palette);

  return((RD_HCOLOURMAP)palette);
}

