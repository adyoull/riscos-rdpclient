  BOOL set_background = !(mixmode == MIX_TRANSPARENT);
//fprintf(stderr, "ui_draw_glyph(mixmode=%i, x=%i, y=%i, cx=%i, cy=%i, srcx=%i, srcy=%i, bgcolour=%i, fgcolour=%i)\n",mixmode, x, y, cx, cy, srcx, srcy, bgcolour, fgcolour);

  current_foreground_colour = fgcolour;
  current_background_colour = bgcolour;  

  Display_PlotSpriteBitMask(SpriteLib_GXcopy, x, y, (spritelib_block *)glyph, srcx, srcy,
                            x, y, cx, cy, fgcolour, bgcolour, set_background, FALSE);
}

/******************************************************************************/

#define DO_GLYPH(ttext,idx) \
{\
  glyph = cache_get_font (font, ttext[idx]);\
  if (!(flags & TEXT2_IMPLICIT_X))\
    {\
      xyoffset = ttext[++idx];\
      if ((xyoffset & 0x80))\
	{\
	  if (flags & TEXT2_VERTICAL) \
	    y += ttext[idx+1] | (ttext[idx+2] << 8);\
	  else\
	    x += ttext[idx+1] | (ttext[idx+2] << 8);\
	  idx += 2;\
	}\
      else\
	{\
	  if (flags & TEXT2_VERTICAL) \
	    y += xyoffset;\
	  else\
	    x += xyoffset;\
	}\
    }\
  if (glyph != NULL)\
    {\
      ui_draw_glyph (mixmode, x + glyph->offset,\
		     y + glyph->baseline,\
		     glyph->width, glyph->height,\
		     glyph->pixmap, 0, 0, bgcolour, fgcolour);\
      if (flags & TEXT2_IMPLICIT_X)\
	x += glyph->width;\
    }\
}

/******************************************************************************/

extern void ui_draw_text(uint8 font, uint8 flags, uint8 opcode, int mixmode, int x, int y,
                         int clipx, int clipy, int clipcx, int clipcy,
                         int boxx, int boxy, int boxcx, int boxcy, BRUSH *brush,
                         int bgcolour, int fgcolour, uint8 *text, uint8 length)
{
//fprintf(stderr, "Called ui_draw_text(font=%i, flags=%i, mixmode=%i, x=%i, y=%i, clipx=%i, clipy=%i, clipcx=%i, clipcy=%i, boxx=%i, boxy=%i, boxcx=%i, boxcy=%i, bgcolour=%i, fgcolour%i, text='%s', length=%i)\n", font, flags, mixmode, x, y, clipx, clipy, clipcx, clipcy, boxx, boxy, boxcx, boxcy, bgcolour, fgcolour, (char *)text, length);

  /* TODO: use brush appropriately */
  
  FONTGLYPH *glyph;
  int i, j, xyoffset;
  DATABLOB *entry;

  if(current_server_bpp != g_server_depth)
     reinit_display();

 /*
  * Draw background rectangle which goes behind text
  */
  if(boxcx > 1)
     Display_PlotRectangle(SpriteLib_GXcopy, boxx, boxy, boxcx, boxcy, bgcolour, FALSE);
  else if(mixmode == MIX_OPAQUE)
     Display_PlotRectangle(SpriteLib_GXcopy, clipx, clipy, clipcx, clipcy, bgcolour, FALSE);

  /*
   * Paint text, character by character
   * (Magic taken from rdesktop\xwin.c)
   */
  for(i = 0; i < length;){

     switch (text[i])
     {
       case 0xff:
         if(i + 2 < length)
            cache_put_text(text[i + 1], text, text[i + 2]);
         else{
            error("this shouldn't be happening\n");
            exit(1);
         }

         /* this will move pointer from start to first character after FF command */
         length -= i + 3;
         text = &(text[i + 3]);
         i = 0;
         break;

       case 0xfe:
         entry = cache_get_text(text[i + 1]);
         if(entry != NULL){
            if((((uint8 *) (entry->data))[1] == 0) && (!(flags & TEXT2_IMPLICIT_X))){
               if(flags & TEXT2_VERTICAL)
                  y += text[i + 2];
               else
                  x += text[i + 2];
            }
            for(j = 0; j < entry->size; j++)
               DO_GLYPH(((uint8 *) (entry->data)), j);
         }

         if(i + 2 < length)
            i += 3;
         else
            i += 2;

         length -= i;

         /* this will move pointer from start to first character after FE command */
         text = &(text[i]);
         i = 0;
         break;

       default:
         DO_GLYPH(text, i);
         i++;
         break;
     }
  }

 /*
  * Update display with drawn text as calls above only write to the
  * backing store Sprite
  */
  if(boxcx > 1)
     Display_Update(boxx, boxy, boxcx, boxcy);
  else
     Display_Update(clipx, clipy, clipcx, clipcy);

}

