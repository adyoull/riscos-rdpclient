extern uint16 ui_get_numlock_state(unsigned int state)
{
  uint16 lock_state = 0;
  keyboard_state_block state_block;

  state_block.value = (int)state;

  if(state_block.data.num_lock == 1)
     lock_state |= KBD_FLAG_NUMLOCK;

  if(state_block.data.caps_lock == 1)
     lock_state |= KBD_FLAG_CAPITAL;

  if(state_block.data.scroll_lock == 1)
     lock_state |= KBD_FLAG_SCROLL;
     
//fprintf(stderr, "send lock state flag %i\n", lock_state);
  return(lock_state);
}

