static int sprite_count = 0;

extern void ui_patblt(uint8 opcode,
                      /* dest */ int x, int y, int cx, int cy,
                      /* brush */ BRUSH * brush, int bgcolour, int fgcolour)
{
//if(cx == 1){
//fprintf(stderr, "Called ui_patblt(opcode=%X, x=%i, y=%i, cx=%i, cy=%i, brush=%li brush->style=%i, brush->xorigin=%i, brush->yorigin=%i, bgcolour=%i, fgcolour=%i)\n", opcode, x, y, cx, cy, brush, brush->style, brush->xorigin, brush->yorigin, bgcolour, fgcolour);
//}

  spritelib_block *sprite;
  uint8 i, ipattern[8];

  if(current_server_bpp != g_server_depth)
     reinit_display();

  current_foreground_colour = fgcolour;
  current_background_colour = bgcolour;

  switch(brush->style)
  {
    case 0: /* solid fill */
      current_foreground_colour = fgcolour;

      Display_PlotRectangle(opcode, x, y, cx, cy, fgcolour, TRUE);
      break;

    case 2: /* predefined pattern fill */
//fprintf(stderr, "Called ui_patblt(opcode=%X, x=%i, y=%i, cx=%i, cy=%i, brush=%li brush->style=%i, bgcolour=%i, fgcolour=%i)\n", opcode, x, y, cx, cy, brush, brush->style, bgcolour, fgcolour);
      current_foreground_colour = fgcolour;
      current_background_colour = bgcolour;

      sprite = SpriteLib_Create(8, 8, 1, FALSE, FALSE);

      if(sprite != NULL){

         SpriteLib_SetImageData(sprite,
                                (unsigned char *)(hatch_patterns + brush->pattern[0] * 8),
                                FALSE);

         Display_PlotSpriteBitMask(opcode, x, y, sprite, 0, 0, brush->xorigin, brush->yorigin,
                                   cx, cy, fgcolour, bgcolour, TRUE, TRUE);

         SpriteLib_Destroy(sprite);
      }
      break;

    case 3: /* custom pattern fill */
//if(cx == 1){
//fprintf(stderr, "Called ui_patblt(opcode=%X, x=%i, y=%i, cx=%i, cy=%i, brush=%li brush->style=%i, bgcolour=%i, fgcolour=%i)\n", opcode, x, y, cx, cy, brush, brush->style, bgcolour, fgcolour);
//}
      if(brush->bd == 0){ /* rdp4 brush */

         current_foreground_colour = bgcolour;
         current_background_colour = fgcolour;

         for(i = 0; i < 8; i++){
            ipattern[7 - i] = brush->pattern[i];
         }

         sprite = SpriteLib_Create(8, 8, 1, FALSE, FALSE);

         if(sprite != NULL){

            SpriteLib_SetImageData(sprite, (unsigned char *)ipattern, FALSE);
            
            Display_PlotSpriteBitMask(opcode, x, y, sprite, 0, 0, brush->xorigin, brush->yorigin,
                                      cx, cy, bgcolour, fgcolour, TRUE, TRUE);

            SpriteLib_Destroy(sprite);
         }
      }
      else if(brush->bd->colour_code > 1){ /* > 1 bpp */
//fprintf(stderr, "Called ui_patblt(opcode=%X, x=%i, y=%i, cx=%i, cy=%i, brush=%li brush->style=%i, bgcolour=%i, fgcolour=%i, bruch->bd->colour_code=%i)\n", opcode, x, y, cx, cy, brush, brush->style, bgcolour, fgcolour, brush->bd->colour_code);
         sprite = SpriteLib_Create(8, 8, g_server_depth, (g_server_depth == 8), FALSE);

         if(sprite != NULL){
            char filename[255];
            SpriteLib_SetImageData(sprite, (unsigned char *)brush->bd->data, FALSE);

sprite_count++;
sprintf(filename, "RAM::RamDisc0.$.%i", sprite_count);
Sprite_Save(sprite->spritearea, filename);

            Display_PlotSpriteTiled(opcode, x, y, sprite, 0, 0, brush->xorigin, brush->yorigin,
                                    cx, cy, TRUE);
                                                           
            SpriteLib_Destroy(sprite);
         }
      }
      else{

         current_foreground_colour = bgcolour;
         current_background_colour = fgcolour;

         sprite = SpriteLib_Create(8, 8, 1, FALSE, FALSE);

         if(sprite != NULL){

            SpriteLib_SetImageData(sprite, (unsigned char *)brush->bd->data, FALSE);
            
            Display_PlotSpriteBitMask(opcode, x, y, sprite, 0, 0, brush->xorigin, brush->yorigin,
                                      cx, cy, bgcolour, fgcolour, TRUE, TRUE);

            SpriteLib_Destroy(sprite);
         }
      }
      break;

    default:
      unimpl("brush %d\n", brush->style);
  }

}

