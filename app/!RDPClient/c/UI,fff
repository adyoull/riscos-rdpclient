extern RD_HCURSOR ui_create_cursor(unsigned int x, unsigned int y, int width, int height,
                                   uint8 * andmask, uint8 * xormask, int bpp)
{
  pointer_block *pointer;
  unsigned char *mask_buffer;
//fprintf(stderr, "Called ui_create_cursor(x=%i, y=%i, width=%i, height=%i, andmask=%li, xormask=%i, bpp=%i)\n", x, y, width, height, andmask, xormask, bpp);

  mask_buffer = Pointer_PrepMaskData(width, height, (unsigned char *)andmask, (bpp != 1));

  pointer = Pointer_Create(width, height, x, y, (mask_buffer != NULL));

  if(pointer != NULL){
     Pointer_SetData(pointer, bpp, (unsigned char *)xormask, mask_buffer);
     free(mask_buffer);
  }

  return((RD_HCURSOR)pointer);
}

