extern int ui_select(int rdp_socket)
{
  int n;
  struct timeval wait;
  event_type event;
  unsigned int time;
  BOOL found_data;
  int select_result;
 /*
  * Returns 0 after user quit, 1 otherwise
  */
#ifdef WITH_DEBUG_AJS
	printf("\ncall ui_select(rdp_socket={%li})\n", rdp_socket);
#endif
  fd_set rfds, wfds;

  called_poll = TRUE;

 /*
  * Make select poll (return immediately)
  */
  wait.tv_sec = 0;
  wait.tv_usec = 0;

  while (True){
    n = rdp_socket;

   /*
    * Process any events already waiting
    */
    Display_Poll();
    Keyboard_Poll();
    Mouse_Poll();
    Display_Poll();
    MemMan_PollMemoryManagement();
    Clipboard_Poll();

    if(rdpclient_quit){
#ifdef WITH_DEBUG_AJS
       printf("return=0 (rdpclient_quit == TRUE : user quit)\n\n");
#endif
       return(0);
    }

   /*
    * Check for present of incomming data
    */
    FD_ZERO(&rfds);
    FD_ZERO(&wfds);
    FD_SET(rdp_socket, &rfds);

#ifdef WITH_RDPSND
    rdpsnd_add_fds(&n, &rfds, &wfds, &wait);
#endif

    /* add redirection handles */
/* NOT ON RISC OS
    rdpdr_add_fds(&n, &rfds, &wfds, &tv, &s_timeout);
    seamless_select_timeout(&tv);
*/
    n++;

    found_data = FALSE;

#ifdef WITH_DEBUG_AJS
	printf("   about to call select(n {%li}, &rfds {%li}, NULL, NULL, &wait {%li});\n", n, &rfds, &wait);
	printf("%s - before select() call\n", current_time_date());
#endif

/*
    select_result = select(n, &rfds, NULL, NULL, &wait);
*/
    select_result = select(n, &rfds, &wfds, NULL, &wait);

#ifdef WITH_DEBUG_AJS
	printf("%s - after select() call\n", current_time_date());
	printf("   select_result = %i;\n", select_result);
#endif
    
/* Blocking poll
    select_result = select(n, &rfds, NULL, NULL, NULL);
*/
    if(select_result == -1){

       error("select: %s\n", strerror(errno));

    }
    else if(select_result > 0){

       if(FD_ISSET(rdp_socket, &rfds)){
#ifdef WITH_DEBUG_AJS
          printf("   FD_ISSET(rdp_socket {%li}, &rfds {%li}) == TRUE;\n", rdp_socket, &rfds);
#endif
          found_data = TRUE;
       }
       else
       {
#ifdef WITH_DEBUG_AJS
          printf("   FD_ISSET(rdp_socket {%li}, &rfds {%li}) == FALSE;\n", rdp_socket, &rfds);
#endif
       }
    }

    if(!Display_SingleTask()){

       while((time = Time_Monotonic()) == 0);

       if(!found_data || time > next_poll_time){
//if(found_data && time > next_poll_time)
//   fprintf(stderr, "Poll timeout with data   time %i  timeout %i\n", time, next_poll_time);
   
         /*
          * Only poll if the process time has run out
          * or there is no data waiting
          */
       
          event = RDPClient_PollNull();
          while(event != event_NULL)
             event = RDPClient_PollNull();

          while((time = Time_Monotonic()) == 0);

          next_poll_time = time + MAX_PROCESS_TIME;
       }
    }

#ifdef WITH_RDPSND
    rdpsnd_check_fds(&rfds, &wfds);
#endif

/* NOT ON RISCOS
    rdpdr_check_fds(&rfds, &wfds, (RD_BOOL) False);
*/


#ifdef WITH_DEBUG_AJS
	printf("   if(found_data {%li}) return(1);\n", found_data);
#endif
    if(found_data){
#ifdef WITH_DEBUG_AJS
	printf("return=1\n\n");
#endif
       return(1);
    }
  }
}

