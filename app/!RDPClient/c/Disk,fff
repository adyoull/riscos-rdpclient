/* Map a Windows-relative path (already '/'-separated) to a full RISC OS path
   under the share root. RISC OS foreign-name convention: swap '.' and '/'. */
static int disk_ext_to_type(const char *e);
static const char *disk_type_to_ext(int t);
static int disk_filetype_of(int load);

/* Map a Windows-relative path to a full RISC OS path under the share root
   (swap '.'<->'/'). If the final leaf ends in a known extension, that extension
   is stripped (it is carried as the RISC OS filetype instead) and the filetype
   is returned; otherwise -1. */
static int disk_win_to_riscos(uint32 device, const char *win, char *out,
                              int outsz, int strip)
{
  const char *root = g_rdpdr_device[device].local_path;
  char wbuf[PATH_MAX];
  char *leaf, *dot;
  int o = 0, i, ftype = -1;

  while(*win == '/') win++;
  strncpy(wbuf, win, sizeof(wbuf) - 1);
  wbuf[sizeof(wbuf) - 1] = '\0';

  /* strip a known extension from the final leaf (encoded as a filetype instead) */
  if(strip){
     leaf = strrchr(wbuf, '/');
     leaf = (leaf != NULL) ? leaf + 1 : wbuf;
     dot  = strrchr(leaf, '.');
     if(dot != NULL && dot[1] != '\0'){
        ftype = disk_ext_to_type(dot + 1);
        if(ftype >= 0)
           *dot = '\0';              /* drop ".ext" - encoded as filetype */
     }
  }

  for(i = 0; root != NULL && root[i] != '\0' && o < outsz - 1; i++)
     out[o++] = root[i];

  if(wbuf[0] != '\0' && o < outsz - 1) out[o++] = '.';

  for(i = 0; wbuf[i] != '\0' && o < outsz - 1; i++){
     char c = wbuf[i];
     if(c == '/') c = '.';
     else if(c == '.') c = '/';
     else if(c == ' ') c = (char)0xA0;   /* RISC OS hard space */
     out[o++] = c;
  }
  out[o] = '\0';
  return(ftype);
}

/* Back-compat wrapper: map a Windows name to a RISC OS path, stripping a known
   trailing extension (carried as the filetype) and returning that filetype. */
static int disk_riscos_path(uint32 device, const char *win, char *out, int outsz)
{
  return disk_win_to_riscos(device, win, out, outsz, 1);
}

/* Read catalogue info. Returns object type (0 none,1 file,2 dir,3 image) or -1. */
static int disk_stat(const char *path, int *length, int *attr, int *load, int *exec)
{
  _kernel_osfile_block b;
  int type = _kernel_osfile(5, path, &b);
  if(type == _kernel_ERROR) return(-1);
  if(length != NULL) *length = b.start;
  if(attr   != NULL) *attr   = b.end;
  if(load   != NULL) *load   = b.load;
  if(exec   != NULL) *exec   = b.exec;
  return(type);
}

/* Add the 64-bit value (vhi:vlo) into the accumulator (*hi:*lo). */
static void disk_add64(uint32 *hi, uint32 *lo, uint32 vhi, uint32 vlo)
{
  uint32 nlo = *lo + vlo;
  *lo = nlo;
  *hi = *hi + vhi + (nlo < vlo ? 1u : 0u);
}

/* RISC OS load/exec (5-byte centiseconds since 1900) -> Windows FILETIME
   (100ns since 1601), returned as two 32-bit words. Non-dated files -> 0.
   64-bit maths done by hand in 32-bit pieces (no C99 long long). */
#define FT1900_LO 0xFDE04000u
#define FT1900_HI 0x014F373Bu
static void disk_filetime(int load, int exec, uint32 *ftlow, uint32 *fthigh)
{
  uint32 hi = 0, lo = 0;
  uint32 cs_lo, cs_hi, bytes[5];
  int i;

  if(((uint32)load & 0xFFF00000u) != 0xFFF00000u){  /* not typed+dated */
     *ftlow = 0; *fthigh = 0;
     return;
  }

  cs_lo = (uint32)exec;
  cs_hi = (uint32)load & 0xFFu;
  bytes[0] =  cs_lo        & 0xFF;
  bytes[1] = (cs_lo >> 8)  & 0xFF;
  bytes[2] = (cs_lo >> 16) & 0xFF;
  bytes[3] = (cs_lo >> 24) & 0xFF;
  bytes[4] =  cs_hi        & 0xFF;

  for(i = 0; i < 5; i++){
     uint32 pp = bytes[i] * 100000u;   /* centisecond byte * 10^5 ns/cs units */
     int sh = 8 * i;
     uint32 vhi, vlo;
     if(sh == 0)       { vlo = pp;        vhi = 0; }
     else if(sh < 32)  { vlo = pp << sh;  vhi = pp >> (32 - sh); }
     else              { vlo = 0;         vhi = pp << (sh - 32); }
     disk_add64(&hi, &lo, vhi, vlo);
  }
  disk_add64(&hi, &lo, FT1900_HI, FT1900_LO);

  *ftlow  = lo;
  *fthigh = hi;
}

/* case-insensitive string compare */
static int disk_ieq(const char *a, const char *b)
{
  while(*a != '\0' && *b != '\0'){
     if(tolower((unsigned char)*a) != tolower((unsigned char)*b)) return(0);
     a++; b++;
  }
  return(*a == *b);
}

/* RISC OS filetype held in a load address, or -1 if the file is untyped. */
static int disk_filetype_of(int load)
{
  if(((unsigned)load & 0xFFF00000u) == 0xFFF00000u)
     return(((unsigned)load >> 8) & 0xFFF);
  return(-1);
}

/* filetype -> DOS extension (NULL if we should not add one). */
static const char *disk_type_to_ext(int t)
{
  static char mmret[16];       /* returned to the caller (persists) */
  char mmbuf[132];             /* MimeMap output buffer (needs >= 128 bytes) */
  _kernel_swi_regs r;

  /* Prefer the system MimeMap table (matches the rest of RISC OS). */
  r.r[0] = MMM_TYPE_RISCOS;    /* input:  RISC OS filetype (int)        */
  r.r[1] = t;
  r.r[2] = MMM_TYPE_DOT_EXTN;  /* output: filename extension (no dot)   */
  r.r[3] = (int) mmbuf;        /* output buffer (mandatory for strings) */
  mmbuf[0] = '\0';
  if(_kernel_swi(MimeMap_Translate | XOS_Bit, &r, &r) == NULL && r.r[3] != 0){
     const char *sp = (const char *)r.r[3];
     int i = 0;
     if(*sp == '.') sp++;      /* defensive: format 3 has no dot */
     while(sp[i] != '\0' && i < (int)sizeof(mmret) - 1){ mmret[i] = sp[i]; i++; }
     mmret[i] = '\0';
     if(mmret[0] != '\0') return(mmret);
  }

  /* fallback: built-in common types */
  switch(t){
     case 0xFFF: return("txt");
     case 0xFF5: return("ps");
     case 0xADF: return("pdf");
     case 0xFAF: return("html");
     case 0xF80: return("xml");
     case 0xDFE: return("csv");
     case 0xDDC: return("zip");
     case 0xC85: return("jpg");
     case 0xB60: return("png");
     case 0x695: return("gif");
     case 0x69C: return("bmp");
     case 0xAFF: return("draw");
     case 0xFF9: return("spr");
     case 0xBBC: return("bas");
     case 0xFB4: return("doc");
     case 0xDB0: return("rtf");
     default:    return(NULL);
  }
}

/* DOS extension -> filetype, or -1 if unknown. */
static int disk_ext_to_type(const char *e)
{
  char obuf[132];              /* output buffer (unused for an int result) */
  _kernel_swi_regs r;

  /* Prefer the system MimeMap table. */
  r.r[0] = MMM_TYPE_DOT_EXTN;   /* input:  filename extension (no dot), ptr */
  r.r[1] = (int)e;
  r.r[2] = MMM_TYPE_RISCOS;     /* output: RISC OS filetype (int)           */
  r.r[3] = (int) obuf;          /* buffer supplied for safety               */
  if(_kernel_swi(MimeMap_Translate | XOS_Bit, &r, &r) == NULL)
     return(r.r[3] & 0xFFF);

  /* fallback: built-in common types */
  if(disk_ieq(e,"txt") || disk_ieq(e,"text") || disk_ieq(e,"log")) return(0xFFF);
  if(disk_ieq(e,"ps")  || disk_ieq(e,"eps"))  return(0xFF5);
  if(disk_ieq(e,"pdf"))                        return(0xADF);
  if(disk_ieq(e,"htm") || disk_ieq(e,"html"))  return(0xFAF);
  if(disk_ieq(e,"xml"))                        return(0xF80);
  if(disk_ieq(e,"csv"))                        return(0xDFE);
  if(disk_ieq(e,"zip"))                        return(0xDDC);
  if(disk_ieq(e,"jpg") || disk_ieq(e,"jpeg"))  return(0xC85);
  if(disk_ieq(e,"png"))                        return(0xB60);
  if(disk_ieq(e,"gif"))                        return(0x695);
  if(disk_ieq(e,"bmp"))                        return(0x69C);
  if(disk_ieq(e,"draw"))                       return(0xAFF);
  if(disk_ieq(e,"spr"))                        return(0xFF9);
  if(disk_ieq(e,"rtf"))                        return(0xDB0);
  if(disk_ieq(e,"doc"))                        return(0xFB4);
  return(-1);
}

/* Write a NUL-less UTF-16LE rendering of an 8-bit string; returns bytes. */
static int disk_out_unistr(STREAM out, const char *s)
{
  int n = 0;
  while(*s != '\0'){
     out_uint8(out, (uint8)*s);
     out_uint8(out, 0);
     s++;
     n += 2;
  }
  return(n);
}

static int disk_get_free_handle(void)
{
  int i;
  for(i = 1; i < MAX_OPEN_FILES; i++)
     if(!g_disk_inuse[i]) return(i);
  return(-1);
}

