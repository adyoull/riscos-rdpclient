extern void Disk_Init(void)
{
  int i;
  for(i = 0; i < MAX_OPEN_FILES; i++){
     g_disk_inuse[i] = 0;
     g_disk_osfh[i]  = 0;
     g_disk_isdir[i] = 0;
     g_disk_diroff[i] = 0;
     g_disk_settype[i] = -1;
     g_disk_fp[i] = NULL;
  }
}

/* -r disk:NAME=<riscos-path>  e.g.  -r disk:RISCOS=ADFS::4.$.RDPShare */
int disk_enum_devices(uint32 *id, char *optarg)
{
  char *eq, *name, *path;
  char l[128];

  if(*optarg == ':') optarg++;

  eq = strchr(optarg, '=');
  if(eq == NULL) return(0);          /* need NAME=path */
  *eq = '\0';
  name = optarg;
  path = eq + 1;

  if(*name == '\0' || *path == '\0') return(0);

  memset(g_rdpdr_device[*id].name, 0, 8);
  strncpy(g_rdpdr_device[*id].name, name, 7);

  g_rdpdr_device[*id].device_type  = DEVICE_TYPE_DISK;
  g_rdpdr_device[*id].pdevice_data = NULL;
  g_rdpdr_device[*id].local_path   = xstrdup(path);
  g_rdpdr_device[*id].handle       = 0;

  /* log to the directory ABOVE the share (writable disc, not inside the share) */
  {
     char *lastdot;
     strncpy(g_disk_logpath, path, sizeof(g_disk_logpath) - 12);
     g_disk_logpath[sizeof(g_disk_logpath) - 12] = '\0';
     lastdot = strrchr(g_disk_logpath, '.');
     if(lastdot != NULL) *lastdot = '\0';
     strcat(g_disk_logpath, ".RDPDiskLog");
  }

  sprintf(l, "enum: disk '%s' -> '%s' (device %lu)",
          g_rdpdr_device[*id].name, path, (unsigned long)*id);
  disk_log(l);

  (*id)++;
  return(1);
}

