/******************************************************************************/

extern RD_NTSTATUS disk_query_information(RD_NTHANDLE handle, uint32 info_class, STREAM out)
{
  int h = (int)handle, type, len = 0, attr = 0, load = 0, exec = 0;
  uint32 fattr, ftlow, fthigh;

  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h]){
     out_uint8(out, 0);
     return(RD_STATUS_INVALID_HANDLE);
  }

  type = disk_stat(g_fileinfo[h].path, &len, &attr, &load, &exec);
  if(type < 0){
     out_uint8(out, 0);
     return(RD_STATUS_ACCESS_DENIED);
  }

  fattr = 0;
  if(type == 2 || type == 3) fattr |= FILE_ATTRIBUTE_DIRECTORY;
  else if(attr & 0x08)       fattr |= FILE_ATTRIBUTE_READONLY;   /* locked file */
  if(!fattr)                 fattr |= FILE_ATTRIBUTE_NORMAL;

  disk_filetime(load, exec, &ftlow, &fthigh);

  switch(info_class){
     case FileBasicInformation:
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* creation */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* access   */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* write    */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* change   */
        out_uint32_le(out, fattr);
        break;

     case FileStandardInformation:
        out_uint32_le(out, (uint32)len); out_uint32_le(out, 0);  /* alloc  */
        out_uint32_le(out, (uint32)len); out_uint32_le(out, 0);  /* eof    */
        out_uint32_le(out, 1);                                   /* nlinks */
        out_uint8(out, 0);                                       /* delete pending */
        out_uint8(out, (type == 2 || type == 3) ? 1 : 0);        /* directory */
        break;

     default:
        return(RD_STATUS_INVALID_PARAMETER);
  }
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

extern RD_NTSTATUS disk_set_information(RD_NTHANDLE handle, uint32 info_class, STREAM in, STREAM out)
{
  int h = (int)handle;
  uint32 length;
  char newname[PATH_MAX], fullpath[PATH_MAX];

  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h])
     return(RD_STATUS_INVALID_HANDLE);

  {
     char l[96];
     sprintf(l, "setinfo: h=%d ic=%lu", h, (unsigned long)info_class);
     disk_log(l);
  }

  switch(info_class){
     case FileBasicInformation:
     case FileAllocationInformation:
        return(RD_STATUS_SUCCESS);            /* accept, no-op */

     case FileRenameInformation:
        in_uint8s(in, 4);                     /* replace-if-exists + root dir */
        in_uint8s(in, 0x1a);                  /* padding */
        in_uint32_le(in, length);
        if(length == 0 || (length / 2) >= (PATH_MAX - 1))
           return(RD_STATUS_INVALID_PARAMETER);
        rdp_in_unistr(in, newname, sizeof(newname), length);
        {
           char *p;
           while((p = strchr(newname, '\\')) != NULL) *p = '/';
        }
        disk_riscos_path(g_fileinfo[h].device_id, newname, fullpath, sizeof(fullpath));
        if(rename(g_fileinfo[h].path, fullpath) != 0)
           return(RD_STATUS_ACCESS_DENIED);
        strncpy(g_fileinfo[h].path, fullpath, PATH_MAX - 1);
        g_fileinfo[h].path[PATH_MAX - 1] = '\0';
        break;

     case FileDispositionInformation:
        g_fileinfo[h].delete_on_close = True;
        break;

     case FileEndOfFileInformation:
        in_uint8s(in, 28);
        in_uint32_le(in, length);
        /* pre-extend so Windows' out-of-order writes land within the file */
        if(g_disk_fp[h] != NULL && length > 0){
           clearerr(g_disk_fp[h]);
           if(fseek(g_disk_fp[h], (long)length - 1, SEEK_SET) == 0){
              fputc(0, g_disk_fp[h]);
              fflush(g_disk_fp[h]);
           }
        }
        return(RD_STATUS_SUCCESS);

     default:
        return(RD_STATUS_INVALID_PARAMETER);
  }
  return(RD_STATUS_SUCCESS);
}

