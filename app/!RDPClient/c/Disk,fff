/******************************************************************************/

extern RD_NTSTATUS disk_query_information(RD_NTHANDLE handle, uint32 info_class, STREAM out)
{
  int h = (int)handle, type, len = 0, attr = 0, load = 0, exec = 0;
  uint32 fattr, ftlow, fthigh;

  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h]){
     out_uint8(out, 0);
     return(RD_STATUS_INVALID_HANDLE);
  }

  type = disk_stat(g_fileinfo[h].path, &len, &attr, &load, &exec);
  if(type < 0){
     out_uint8(out, 0);
     return(RD_STATUS_ACCESS_DENIED);
  }

  {
     char ql[PATH_MAX + 96];
     sprintf(ql, "qinfo: h=%d ic=%lu type=%d len=%d attr=0x%x '%s'",
             h, (unsigned long)info_class, type, len, (unsigned)attr,
             g_fileinfo[h].path);
     disk_log(ql);
  }

  fattr = 0;
  if(type == 2) fattr |= FILE_ATTRIBUTE_DIRECTORY;   /* image file (3) is a file */
  else if(attr & 0x08)       fattr |= FILE_ATTRIBUTE_READONLY;   /* locked file */
  if(!fattr)                 fattr |= FILE_ATTRIBUTE_NORMAL;

  disk_filetime(load, exec, &ftlow, &fthigh);

  switch(info_class){
     case FileBasicInformation:
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* creation */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* access   */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* write    */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* change   */
        out_uint32_le(out, fattr);
        break;

     case FileStandardInformation:
        out_uint32_le(out, (uint32)len); out_uint32_le(out, 0);  /* alloc  */
        out_uint32_le(out, (uint32)len); out_uint32_le(out, 0);  /* eof    */
        out_uint32_le(out, 1);                                   /* nlinks */
        out_uint8(out, 0);                                       /* delete pending */
        out_uint8(out, (type == 2) ? 1 : 0);                     /* directory (image file 3 = file) */
        break;

     case FileAttributeTagInformation:   /* Windows 11 queries this on every file */
        out_uint32_le(out, fattr);                               /* FileAttributes */
        out_uint32_le(out, 0);                                   /* ReparseTag (none) */
        break;

     case FileNetworkOpenInformation:    /* Windows 11 CopyFile metadata probe */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* creation */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* access   */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* write    */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* change   */
        out_uint32_le(out, (uint32)len); out_uint32_le(out, 0);  /* allocation */
        out_uint32_le(out, (uint32)len); out_uint32_le(out, 0);  /* end of file */
        out_uint32_le(out, fattr);                               /* attributes */
        out_uint32_le(out, 0);                                   /* reserved   */
        break;

     default:
     {
        char l[64];
        sprintf(l, "queryinfo: UNHANDLED class %lu", (unsigned long)info_class);
        disk_warn(l);
        return(RD_STATUS_INVALID_PARAMETER);
     }
  }
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

/* Copy a file byte-for-byte (rename fallback when FileSwitch will not rename
   in place). Returns 0 on success, -1 on failure. */
static int disk_copy_file(const char *src, const char *dst)
{
  FILE *in, *out;
  char buf[4096];
  size_t n;
  in = fopen(src, "rb");
  if(in == NULL) return(-1);
  out = fopen(dst, "wb");
  if(out == NULL){ fclose(in); return(-1); }
  while((n = fread(buf, 1, sizeof(buf), in)) > 0){
     if(fwrite(buf, 1, n, out) != n){ fclose(in); fclose(out); return(-1); }
  }
  fclose(in);
  if(fclose(out) != 0) return(-1);
  return(0);
}

extern RD_NTSTATUS disk_set_information(RD_NTHANDLE handle, uint32 info_class, STREAM in, STREAM out)
{
  int h = (int)handle;
  uint32 length;
  char newname[PATH_MAX], fullpath[PATH_MAX];

  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h])
     return(RD_STATUS_INVALID_HANDLE);

  {
     char l[96];
     sprintf(l, "setinfo: h=%d ic=%lu", h, (unsigned long)info_class);
     disk_log(l);
  }

  switch(info_class){
     case FileBasicInformation:
     case FileAllocationInformation:
        return(RD_STATUS_SUCCESS);            /* accept, no-op */

     case FileRenameInformation:
        in_uint8s(in, 4);                     /* replace-if-exists + root dir */
        in_uint8s(in, 0x1a);                  /* padding */
        in_uint32_le(in, length);
        if(length == 0 || (length / 2) >= (PATH_MAX - 1))
           return(RD_STATUS_INVALID_PARAMETER);
        rdp_in_unistr(in, newname, sizeof(newname), length);
        {
           char *p;
           while((p = strchr(newname, '\\')) != NULL) *p = '/';
        }
        disk_riscos_path(g_fileinfo[h].device_id, newname, fullpath, sizeof(fullpath));
        {
           /* Windows renames via an OPEN handle (FileRenameInformation).
              RISC OS FileSwitch refuses to rename an open object, so close
              the underlying file first, rename, then reopen so further
              writes on this handle still land.  If the native rename() is
              refused, fall back to copy-then-delete. */
           long savedpos = -1;
           int  rr;
           if(g_disk_fp[h] != NULL){
              savedpos = ftell(g_disk_fp[h]);
              fclose(g_disk_fp[h]);
              g_disk_fp[h] = NULL;
           }
           rr = rename(g_fileinfo[h].path, fullpath);
           if(rr != 0){
              if(disk_copy_file(g_fileinfo[h].path, fullpath) == 0){
                 remove(g_fileinfo[h].path);
                 rr = 0;
              }
           }
           {
              char rl[2 * PATH_MAX + 112];
              sprintf(rl, "RENAME '%s' -> '%s' : rc=%d",
                      g_fileinfo[h].path, fullpath, rr);
              disk_warn(rl);
           }
           if(rr != 0){
              /* Reopen the original so the handle stays usable, then fail. */
              if(savedpos >= 0){
                 g_disk_fp[h] = fopen(g_fileinfo[h].path, "r+b");
                 if(g_disk_fp[h] != NULL && savedpos > 0)
                    fseek(g_disk_fp[h], savedpos, SEEK_SET);
              }
              return(RD_STATUS_ACCESS_DENIED);
           }
           strncpy(g_fileinfo[h].path, fullpath, PATH_MAX - 1);
           g_fileinfo[h].path[PATH_MAX - 1] = '\0';
           if(savedpos >= 0){
              g_disk_fp[h] = fopen(g_fileinfo[h].path, "r+b");
              if(g_disk_fp[h] != NULL && savedpos > 0)
                 fseek(g_disk_fp[h], savedpos, SEEK_SET);
           }
        }
        break;

     case FileDispositionInformation:
        g_fileinfo[h].delete_on_close = True;
        break;

     case FileEndOfFileInformation:
        in_uint8s(in, 28);
        in_uint32_le(in, length);
        /* pre-extend so Windows' out-of-order writes land within the file */
        if(g_disk_fp[h] != NULL && length > 0){
           clearerr(g_disk_fp[h]);
           if(fseek(g_disk_fp[h], (long)length - 1, SEEK_SET) == 0){
              fputc(0, g_disk_fp[h]);
              fflush(g_disk_fp[h]);
           }
        }
        return(RD_STATUS_SUCCESS);

     default:
     {
        char l[64];
        sprintf(l, "setinfo: UNHANDLED class %lu", (unsigned long)info_class);
        disk_warn(l);
        return(RD_STATUS_INVALID_PARAMETER);
     }
  }
  return(RD_STATUS_SUCCESS);
}

