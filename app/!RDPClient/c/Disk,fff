static RD_NTSTATUS Disk_Create(uint32 device_id, uint32 accessmask, uint32 sharemode,
                               uint32 create_disposition, uint32 flags_and_attributes,
                               char *filename, RD_NTHANDLE *handle)
{
  char path[PATH_MAX];
  char l[PATH_MAX + 64];
  int type, h, isdir = 0, ftype, created = 0;
  RD_BOOL want_dir, want_write;
  FILE *fp = NULL;

  /* Windows NTFS alternate data streams ("name:Zone.Identifier") - not real
     files; RISC OS has no equivalent, report as absent. */
  if(strchr(filename, ':') != NULL)
  {
     char l[PATH_MAX + 32];
     sprintf(l, "reject stream/ADS create: '%s'", filename);
     disk_warn(l);
     return(RD_STATUS_NO_SUCH_FILE);
  }

  ftype = disk_riscos_path(device_id, filename, path, sizeof(path));
  type = disk_stat(path, NULL, NULL, NULL, NULL);

  /* Some RISC OS files hold the extension in their leafname (e.g. "MyFile/pdf",
     shown to Windows as "MyFile.pdf") rather than as a filetype.  Retry with the
     extension kept so these files open when:
       (a) the extension-stripped name does not exist, OR
       (b) the stripped name is a DIRECTORY but the extension-kept name is a real
           file.  This resolves the collision where a "Revert-0921" folder (e.g.
           left by a previous extraction) sits beside "Revert-0921/zip": opening
           "Revert-0921.zip" must map to the FILE, not the coincidentally-named
           directory (else macOS reads a folder as an archive -> "unsupported
           format").  The name already carries the type, so don't re-stamp. */
  if(type == 0 || type == 2){
     char rawpath[PATH_MAX];
     int  rawtype;
     disk_win_to_riscos(device_id, filename, rawpath, sizeof(rawpath), 0);
     rawtype = disk_stat(rawpath, NULL, NULL, NULL, NULL);
     if(rawtype != 0 && (type == 0 || rawtype != 2) &&
        strcmp(rawpath, path) != 0){
        strncpy(path, rawpath, sizeof(path) - 1);
        path[sizeof(path) - 1] = '\0';
        type  = rawtype;
        ftype = -1;
     }
  }

  want_dir = (flags_and_attributes & (FILE_DIRECTORY_FILE | FILE_FLAG_BACKUP_SEMANTICS)) ? True : False;
  if(type == 2) want_dir = True;   /* type 3 = image file (zip/archive) -> a FILE */

  want_write = (accessmask & (GENERIC_WRITE | GENERIC_ALL |
                              FILE_WRITE_DATA | FILE_APPEND_DATA)) ? True : False;

  if(want_dir || filename[0] == '\0' ||
     (filename[0] == '/' && filename[1] == '\0')){
     _kernel_osfile_block b;
     isdir = 1;
     if(type == 0 &&
        (create_disposition == CREATE_NEW || create_disposition == CREATE_ALWAYS ||
         create_disposition == OPEN_ALWAYS)){
        b.start = 0;
        _kernel_osfile(8, path, &b);       /* create directory */
     }
  }
  else{
     switch(create_disposition){
        case CREATE_NEW:
           if(type != 0) return(RD_STATUS_OBJECT_NAME_COLLISION);
           fp = fopen(path, "w+b"); created = 1;
           break;
        case CREATE_ALWAYS:
           fp = fopen(path, "w+b"); created = 1;
           break;
        case OPEN_EXISTING:
           if(type == 0) return(RD_STATUS_NO_SUCH_FILE);
           fp = fopen(path, want_write ? "r+b" : "rb");
           break;
        case OPEN_ALWAYS:
           if(type == 0){ fp = fopen(path, "w+b"); created = 1; }
           else           fp = fopen(path, want_write ? "r+b" : "rb");
           break;
        case TRUNCATE_EXISTING:
           if(type == 0) return(RD_STATUS_NO_SUCH_FILE);
           fp = fopen(path, "w+b");
           break;
        default:
           fp = fopen(path, want_write ? "r+b" : "rb");
           break;
     }
     if(fp == NULL) fp = fopen(path, "rb");   /* fall back read-only */
     if(fp == NULL){
        char le[PATH_MAX + 128];
        _kernel_oserror *e = _kernel_last_oserror();
        sprintf(le, "create: OPEN FAILED '%s' disp=%lu ww=%d err=%d '%s'",
                path, (unsigned long)create_disposition, (int)want_write,
                e ? e->errnum : 0, e ? e->errmess : "(none)");
        disk_warn(le);
        return(RD_STATUS_ACCESS_DENIED);
     }
  }

  h = disk_get_free_handle();
  if(h < 0){
     if(fp != NULL) fclose(fp);
     return(RD_STATUS_ACCESS_DENIED);
  }

  g_disk_inuse[h]  = 1;
  g_disk_fp[h]     = fp;
  g_disk_isdir[h]  = isdir;
  g_disk_diroff[h] = 0;
  g_disk_settype[h] = (isdir || !created) ? -1 : ftype;  /* stamp only new files */

  g_fileinfo[h].device_id            = device_id;
  g_fileinfo[h].accessmask           = accessmask;
  g_fileinfo[h].flags_and_attributes = flags_and_attributes;
  g_fileinfo[h].delete_on_close      = False;
  g_fileinfo[h].pattern[0]           = '\0';
  strncpy(g_fileinfo[h].path, path, PATH_MAX - 1);
  g_fileinfo[h].path[PATH_MAX - 1]   = '\0';

  *handle = (RD_NTHANDLE)h;

  {
     char lr[2 * PATH_MAX + 96];
     sprintf(lr, "create: raw='%s' -> '%s' type=%d disp=%lu fa=0x%lx am=0x%lx -> handle %d%s",
             filename, path, type, (unsigned long)create_disposition,
             (unsigned long)flags_and_attributes, (unsigned long)accessmask, h,
             isdir ? " [dir]" : "");
     disk_log(lr);
  }

  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Disk_Close(RD_NTHANDLE handle)
{
  int h = (int)handle;

  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h])
     return(RD_STATUS_INVALID_HANDLE);

  if(g_disk_fp[h] != NULL){
     fclose(g_disk_fp[h]);
     g_disk_fp[h] = NULL;
  }

  /* stamp the RISC OS filetype derived from the Windows extension */
  if(!g_disk_isdir[h] && g_disk_settype[h] >= 0){
     _kernel_osfile_block b;
     b.load = g_disk_settype[h];
     _kernel_osfile(18, g_fileinfo[h].path, &b);   /* set filetype */
     g_disk_settype[h] = -1;
  }

  if(g_fileinfo[h].delete_on_close){
     int j, forced = 0;
     _kernel_osfile_block b;
     int rc;
     _kernel_oserror *de;
     char dl[PATH_MAX + 300];
     /* macOS Archive Utility's writable-temp probe opens each scratch file
        MANY times, marks delete-on-close on only ONE handle, closes it, then
        immediately re-enumerates expecting the object GONE.  RISC OS FileSwitch
        cannot delete an object that still has open handles, so deferring the
        delete to a "last handle closes" moment (which macOS never gives before
        it re-checks) left the 0-byte probe files piled up -> Error 45.
        Instead, force-close the shim's OTHER open handles on the same path
        (safe: delete-on-close marks a throwaway temp that is never written with
        real archive data) and delete the object NOW. */
     for(j = 0; j < MAX_OPEN_FILES; j++){
        if(j != h && g_disk_inuse[j] &&
           strcmp(g_fileinfo[j].path, g_fileinfo[h].path) == 0){
           if(g_disk_fp[j] != NULL){
              fclose(g_disk_fp[j]);
              g_disk_fp[j] = NULL;
           }
           g_fileinfo[j].delete_on_close = True;   /* keep intent on the slot */
           forced++;
        }
     }
     rc = _kernel_osfile(6, g_fileinfo[h].path, &b);   /* delete file/dir now */
     de = (rc == _kernel_ERROR) ? _kernel_last_oserror() : NULL;
     sprintf(dl, "DELCLOSE '%s' rc=%d forced=%d%s%s", g_fileinfo[h].path, rc,
             forced, de ? " err=" : "", de ? de->errmess : "");
     disk_log(dl);
  }

  {
     char l[80];
     sprintf(l, "close: h=%d", h);
     disk_log(l);
  }

  g_disk_inuse[h] = 0;
  g_fileinfo[h].device_id = 0xFFFFFFFF;   /* invalidate for rdpdr_handle_ok */
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Disk_Read(RD_NTHANDLE handle, uint8 *data, uint32 length, uint32 offset,
                             uint32 *result)
{
  int h = (int)handle;
  FILE *fp;

  *result = 0;
  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h] || g_disk_fp[h] == NULL)
     return(RD_STATUS_INVALID_HANDLE);

  fp = g_disk_fp[h];
  clearerr(fp);
  if(fseek(fp, (long)offset, SEEK_SET) != 0)
     return(RD_STATUS_ACCESS_DENIED);
  *result = (uint32)fread(data, 1, (size_t)length, fp);

  {
     char l[96];
     sprintf(l, "read: h=%d len=%lu off=%lu got=%lu",
             h, (unsigned long)length, (unsigned long)offset, (unsigned long)*result);
     disk_log(l);
  }
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Disk_Write(RD_NTHANDLE handle, uint8 *data, uint32 length, uint32 offset,
                              uint32 *result)
{
  int h = (int)handle;
  FILE *fp;

  *result = 0;
  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h] || g_disk_fp[h] == NULL)
     return(RD_STATUS_INVALID_HANDLE);

  fp = g_disk_fp[h];
  clearerr(fp);
  if(fseek(fp, (long)offset, SEEK_SET) != 0)
     return(RD_STATUS_ACCESS_DENIED);
  *result = (uint32)fwrite(data, 1, (size_t)length, fp);
  fflush(fp);

  {
     char l[96];
     sprintf(l, "write: h=%d len=%lu off=%lu put=%lu",
             h, (unsigned long)length, (unsigned long)offset, (unsigned long)*result);
     if(*result < length) disk_warn(l); else disk_log(l);
  }
  return(RD_STATUS_SUCCESS);
}

