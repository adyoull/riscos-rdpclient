#define MimeMap_Translate 0x50B00   /* SWI: RISC OS filetype <-> MIME <-> extn */
/* MimeMap_Translate formats (per 3QD RISC OS docs): R0=in fmt, R1=in data/ptr,
   R2=out fmt, R3=pointer to a >=128-byte output buffer for string results (and
   the result on exit).  Getting R3 wrong (uninitialised) makes the module write
   the result string to a stray address -> data abort. */
#define MMM_TYPE_RISCOS   0   /* RISC OS filetype, passed/returned as an int   */
#define MMM_TYPE_DOT_EXTN 3   /* file extension (NO dot), passed as a pointer   */

