extern RD_NTSTATUS disk_query_volume_information(RD_NTHANDLE handle, uint32 info_class, STREAM out)
{
  int h = (int)handle;
  const char *label;
  int lblbytes, typebytes, devid;

  /* macOS/NuoRDS issues QueryVolumeInformation without (or before) a live file
     handle -- right after connect and repeatedly while browsing.  Rejecting
     these with INVALID_HANDLE (seen 324x in one trace) leaves macOS unable to
     read free space / volume attributes, which blocks Archive Utility.  The
     rdpdr dispatcher has already confirmed this is the disk device, so answer
     for it regardless: derive the device from the handle when it is live, else
     default to the sole disk device (0). */
  if(h >= 0 && h < MAX_OPEN_FILES && g_disk_inuse[h])
     devid = g_fileinfo[h].device_id;
  else
     devid = 0;

  label = g_rdpdr_device[devid].name;

  {
     char vl[96];
     sprintf(vl, "qvol: h=%d ic=%lu", h, (unsigned long)info_class);
     disk_log(vl);
  }

  switch(info_class){
     case FileFsVolumeInformation:
        lblbytes = 2 * strlen(label);
        out_uint32_le(out, 0); out_uint32_le(out, 0);   /* creation time */
        out_uint32_le(out, 0x52495343);                 /* serial 'RISC' */
        out_uint32_le(out, (uint32)lblbytes);
        out_uint8(out, 0);                               /* supports objects */
        disk_out_unistr(out, label);
        break;

     case FileFsSizeInformation:
        out_uint32_le(out, 0x00100000); out_uint32_le(out, 0);   /* total units */
        out_uint32_le(out, 0x00080000); out_uint32_le(out, 0);   /* free units  */
        out_uint32_le(out, 1);                                   /* sec/unit    */
        out_uint32_le(out, 0x200);                               /* bytes/sec   */
        break;

     case FileFsFullSizeInformation:
        out_uint32_le(out, 0x00100000); out_uint32_le(out, 0);   /* total       */
        out_uint32_le(out, 0x00080000); out_uint32_le(out, 0);   /* caller avail */
        out_uint32_le(out, 0x00080000); out_uint32_le(out, 0);   /* free        */
        out_uint32_le(out, 1);
        out_uint32_le(out, 0x200);
        break;

     case FileFsAttributeInformation:
        typebytes = 2 * strlen("RISCOS");
        /* RISC OS FileSwitch is case-INSENSITIVE + case-preserving; advertise that
           (not CASE_SENSITIVE, which was wrong) plus UNICODE_ON_DISK, matching what
           a normal network volume reports, so macOS treats it as a fully capable
           destination. */
        out_uint32_le(out, FS_CASE_IS_PRESERVED | FS_UNICODE_ON_DISK);
        out_uint32_le(out, 255);                         /* max component len */
        out_uint32_le(out, (uint32)typebytes);
        disk_out_unistr(out, "RISCOS");
        break;

     case FileFsDeviceInformation:
        out_uint32_le(out, 0x00000007);                  /* FILE_DEVICE_DISK */
        out_uint32_le(out, 0);                           /* characteristics  */
        break;

     default:
        return(RD_STATUS_INVALID_PARAMETER);
  }
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

extern RD_NTSTATUS disk_query_directory(RD_NTHANDLE handle, uint32 info_class, char *pattern, STREAM out)
{
  int h = (int)handle, r;
  _kernel_osgbpb_block blk;
  char entrybuf[300];
  char winname[300];
  char childpath[PATH_MAX * 2];
  char *name;
  int elen, eattr, etype, eload, eexec, i;
  uint32 fattr, namelen, ftlow, fthigh;

  if(h < 0 || h >= MAX_OPEN_FILES || !g_disk_inuse[h])
     return(RD_STATUS_INVALID_HANDLE);

  if(pattern != NULL && pattern[0] != '\0'){
     char *leaf = strrchr(pattern, '/');
     int i, o = 0;
     leaf = (leaf != NULL) ? leaf + 1 : pattern;
     for(i = 0; leaf[i] != '\0' && o < (int)sizeof(g_fileinfo[h].pattern) - 1; i++){
        char c = leaf[i];
        if(c == '.') c = '/';
        else if(c == '?') c = '#';
        g_fileinfo[h].pattern[o++] = c;
     }
     g_fileinfo[h].pattern[o] = '\0';
     g_disk_diroff[h] = 0;
  }

  if(g_disk_diroff[h] == -1)
     return(RD_STATUS_NO_MORE_FILES);

  /* Read one leaf NAME at a time (OS_GBPB 9), then stat the child for its
     type/size/attributes. Robust vs the raw reason-10 record layout. Loop
     past any non-matching batch so we do not stop the listing early. */
  do {
     memset(entrybuf, 0, sizeof(entrybuf));
     blk.dataptr  = entrybuf;
     blk.nbytes   = 1;                    /* one name */
     blk.fileptr  = g_disk_diroff[h];     /* continuation offset */
     blk.buf_len  = sizeof(entrybuf);
     blk.wild_fld = (g_fileinfo[h].pattern[0] != '\0' &&
                     strcmp(g_fileinfo[h].pattern, "*") != 0)
                    ? g_fileinfo[h].pattern : NULL;

     r = _kernel_osgbpb(9, (unsigned)g_fileinfo[h].path, &blk);   /* names only */
     if(r == _kernel_ERROR)
        return(RD_STATUS_NO_SUCH_FILE);
     g_disk_diroff[h] = blk.fileptr;
  } while(entrybuf[0] == '\0' && g_disk_diroff[h] != -1);

  if(entrybuf[0] == '\0')
     return(RD_STATUS_NO_MORE_FILES);

  /* stat the child (path uses the RISC OS leaf, i.e. with '/') */
  sprintf(childpath, "%s.%s", g_fileinfo[h].path, entrybuf);
  eload = 0;
  etype = disk_stat(childpath, &elen, &eattr, &eload, &eexec);
  if(etype < 0){ etype = 1; elen = 0; eattr = 3; eload = 0; }

  /* name Windows sees: RISC OS leaf ('/'->'.'), plus a DOS extension derived
     from the RISC OS filetype so Windows can honour it (mimetype). */
  {
     int wi = 0;
     const char *ext;
     for(i = 0; entrybuf[i] != '\0' && wi < (int)sizeof(winname) - 8; i++){
        char c = entrybuf[i];
        if(c == '/') c = '.';
        else if((unsigned char)c == 0xA0) c = ' ';   /* hard space -> space */
        winname[wi++] = c;
     }
     winname[wi] = '\0';
     if(etype == 1){
        ext = disk_type_to_ext(disk_filetype_of(eload));
        if(ext != NULL){
           int el = (int)strlen(ext);
           int bl = wi;
           /* only append if not already ending in ".ext" */
           if(!(bl > el && winname[bl - el - 1] == '.' &&
                disk_ieq(winname + bl - el, ext))){
              winname[wi++] = '.';
              strcpy(winname + wi, ext);
              wi += el;
           }
        }
     }
  }
  name = winname;

  {
     char l[PATH_MAX * 3];
     sprintf(l, "qdir: leaf='%s' -> win='%s' type=%d len=%d nextoff=%d",
             entrybuf, name, etype, elen, g_disk_diroff[h]);
     disk_log(l);
  }

  fattr = 0;
  if(etype == 2) fattr |= FILE_ATTRIBUTE_DIRECTORY;   /* image file (3) listed as a file */
  else if(eattr & 0x08)        fattr |= FILE_ATTRIBUTE_READONLY;   /* locked */
  if(!fattr)                   fattr |= FILE_ATTRIBUTE_NORMAL;
  namelen = 2 * strlen(name);

  disk_filetime(eload, eexec, &ftlow, &fthigh);

  out_uint32_le(out, 0);   /* NextEntryOffset */
  out_uint32_le(out, 0);   /* FileIndex       */

  switch(info_class){
     case FileBothDirectoryInformation:
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* create */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* access */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* write  */
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);   /* change */
        out_uint32_le(out, (uint32)elen); out_uint32_le(out, 0);   /* eof   */
        out_uint32_le(out, (uint32)elen); out_uint32_le(out, 0);   /* alloc */
        out_uint32_le(out, fattr);
        out_uint32_le(out, namelen);
        out_uint32_le(out, 0);          /* EaSize */
        out_uint8(out, 0);              /* ShortNameLength */
        out_uint8s(out, 24);            /* ShortName */
        disk_out_unistr(out, name);
        break;

     case FileDirectoryInformation:
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, (uint32)elen); out_uint32_le(out, 0);
        out_uint32_le(out, (uint32)elen); out_uint32_le(out, 0);
        out_uint32_le(out, fattr);
        out_uint32_le(out, namelen);
        disk_out_unistr(out, name);
        break;

     case FileFullDirectoryInformation:
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, ftlow); out_uint32_le(out, fthigh);
        out_uint32_le(out, (uint32)elen); out_uint32_le(out, 0);
        out_uint32_le(out, (uint32)elen); out_uint32_le(out, 0);
        out_uint32_le(out, fattr);
        out_uint32_le(out, namelen);
        out_uint32_le(out, 0);          /* EaSize */
        disk_out_unistr(out, name);
        break;

     case FileNamesInformation:
        out_uint32_le(out, namelen);
        disk_out_unistr(out, name);
        break;

     default:
        return(RD_STATUS_INVALID_PARAMETER);
  }
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/
