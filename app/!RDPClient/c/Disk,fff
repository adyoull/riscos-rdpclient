/* Two-level disk logging, gated on -v / RDPClient$Debug:
   - routine chatter (create/read/write/close/qdir) -> RDPDiskLog file only;
   - issues (open failures, short writes, unhandled info classes, rejected
     ':' metadata streams) -> ALSO the on-screen Log window, so the window
     shows only problems instead of being flooded by every read. */
static void disk_logf(const char *line, int issue)
{
  FILE *f = NULL;
  /* Issues surface in the on-screen Log window only when tracing is on.  The
     RDPDiskLog FILE trace is likewise gated behind tracing (-v or
     RDPClient$Debug): a normal release run writes no log file; enable tracing to
     capture the full shared-drive trace when diagnosing a server. */
  if(issue && g_debug_trace) messagetext("DISK: %s", line);
  if(!g_debug_trace) return;
  if(g_disk_logpath[0] != '\0') f = fopen(g_disk_logpath, "a");
  if(f == NULL) f = fopen("<Wimp$ScrapDir>.RDPDiskLog", "a");
  if(f == NULL) f = fopen("<RDPClient$Dir>.RDPDiskLog", "a");
  if(f != NULL){ fputs(line, f); fputc('\n', f); fclose(f); }
}
static void disk_log(const char *line)  { disk_logf(line, 0); }   /* routine -> file */
static void disk_warn(const char *line) { disk_logf(line, 1); }   /* issue -> window+file */

/* External entry so the rdpdr IRP dispatcher can log into RDPDiskLog too. */
extern void disk_extlog(const char *line) { disk_log(line); }

static void disk_log_hex(const char *tag, const unsigned char *p, int n)
{
  char line[160];
  int i, o;
  o = sprintf(line, "%s:", tag);
  for(i = 0; i < n && o < (int)sizeof(line) - 4; i++)
     o += sprintf(line + o, " %02X", p[i]);
  disk_log(line);
}

