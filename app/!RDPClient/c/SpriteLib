static void set_palette(spritelib_block *block, BOOL initialise)
{
  palette_entry *source_palette;
  palette_entry *image_palette;
  int colour;

  if(!block->has_palette)
     return;

  if(initialise || (custom_palette && custom_palette_version > block->custom_palette_version)){

     block->custom_palette_version = custom_palette_version;

     if(custom_palette)
        source_palette = CustomPalette;
     else
        source_palette = ColourPalette;

     if(initialise){
        image_palette = (void *) ((char *)block->spritearea +
                                  (block->spritearea)->firstoffset +
                                  sizeof(sprite_header));
     }
     else
        image_palette = (void *) ((char *)block->spritearea + block->palette);

    /*
     * set palette
     */
     for(colour = 0; colour < 256; colour++){

         image_palette->value = source_palette[colour].value;
         image_palette++;
         image_palette->value = source_palette[colour].value;
         image_palette++;
     }

  }
}

/******************************************************************************/

static BOOL clip_dest(spritelib_block *block,
                      int *clip_origin_x, int *clip_origin_y,
                      int *clip_size_x, int *clip_size_y)
{
  int orig_top_left_x;
  int orig_top_left_y;
  int orig_bottom_right_x;
  int orig_bottom_right_y;

  int clip_top_left_x;
  int clip_top_left_y;
  int clip_bottom_right_x;
  int clip_bottom_right_y;

  int image_bottom_right_x = block->clip_origin.x + block->clip_size.x - 1;
  int image_bottom_right_y = block->clip_origin.y + block->clip_size.y - 1;

  orig_top_left_x = *clip_origin_x;
  orig_top_left_y = *clip_origin_y;
  orig_bottom_right_x = *clip_origin_x + *clip_size_x - 1;
  orig_bottom_right_y = *clip_origin_y + *clip_size_y - 1;

  clip_top_left_x = orig_top_left_x;
  clip_top_left_y = orig_top_left_y;
  clip_bottom_right_x = orig_bottom_right_x;
  clip_bottom_right_y = orig_bottom_right_y;

 /*
  * Clip top left to image clip box
  */
  if(clip_top_left_x < block->clip_origin.x)
     clip_top_left_x = block->clip_origin.x;

  if(clip_top_left_y < block->clip_origin.y)
     clip_top_left_y = block->clip_origin.y;

 /*
  * Clip bottom right to image clip box
  */
  if(clip_bottom_right_x > image_bottom_right_x)
     clip_bottom_right_x = image_bottom_right_x;

  if(clip_bottom_right_y > image_bottom_right_y)
     clip_bottom_right_y = image_bottom_right_y;

 /*
  * Check if outside
  */
  if(clip_top_left_x > clip_bottom_right_x || clip_top_left_y > clip_bottom_right_y)
     return(FALSE);

 /*
  * Calculate new clip origin and size
  */
  *clip_origin_x += clip_top_left_x - orig_top_left_x;
  *clip_origin_y += clip_top_left_y - orig_top_left_y;

  if((clip_top_left_x - orig_top_left_x) >= *clip_size_x ||
     (clip_top_left_y - orig_top_left_y) >= *clip_size_y)
     return(FALSE);

  *clip_size_x -= (clip_top_left_x - orig_top_left_x) +
                  (orig_bottom_right_x - clip_bottom_right_x);
  *clip_size_y -= (clip_top_left_y - orig_top_left_y) +
                  (orig_bottom_right_y - clip_bottom_right_y);

  if(*clip_size_x <= 0 || *clip_size_y <= 0)
     return(FALSE);

  return(TRUE);
}

/******************************************************************************/

static BOOL clip_source_dest(spritelib_block *block,
                             int *clip_dest_origin_x, int *clip_dest_origin_y,
                             int *clip_dest_size_x, int *clip_dest_size_y,
                             int *clip_source_origin_x, int *clip_source_origin_y)
{
  int dest_origin_x;
  int dest_origin_y;
  int dest_size_x;
  int dest_size_y;
  int source_origin_x;
  int source_origin_y;

  dest_origin_x = *clip_dest_origin_x;
  dest_origin_y = *clip_dest_origin_y;
  dest_size_x = *clip_dest_size_x;
  dest_size_y = *clip_dest_size_y;
  source_origin_x = *clip_source_origin_x;
  source_origin_y = *clip_source_origin_y;

 /*
  * Clip destination plot rectangle to clip rectangle
  */
  if(!clip_dest(block, &dest_origin_x, &dest_origin_y, &dest_size_x, &dest_size_y))
     return(FALSE);

 /*
  * Adjust source origin as nessesary
  */
  source_origin_x += dest_origin_x - *clip_dest_origin_x;
  source_origin_y += dest_origin_y - *clip_dest_origin_y;

 /*
  * Should be OK if we get here
  */
  *clip_dest_origin_x = dest_origin_x;
  *clip_dest_origin_y = dest_origin_y;
  *clip_dest_size_x = dest_size_x;
  *clip_dest_size_y = dest_size_y;
  *clip_source_origin_x = source_origin_x;
  *clip_source_origin_y = source_origin_y;

  return(TRUE);
}

