extern void SpriteLib_Init(void)
{
  int colour;
 /*
  * initialisation to be done on startup
  */
  int osver, r2;
  _kernel_swi_regs r;

 /*
  * check for RISC OS 3.5 or later and enable greater than 8bit sprites
  */
  allow_15bpp_plus = FALSE;

  OS_Byte(osbyte_READOSIDENTIFIER, 0, 0xFF, &osver, &r2);
  if(osver >= 0xA5){
    /* RISC OS 3.5 and above */
    allow_15bpp_plus = TRUE;

    if(!allow_15bpp_plus){
     /*
      * check if Deeper module is loaded
      */
      r.r[0] = 18;
      r.r[1] = (int) "Deeper";
      if(_kernel_swi(SWI_XOS_Bit | SWI_OS_Module, &r, &r) == NULL)
        allow_15bpp_plus = TRUE;
    }
  }

  custom_palette = FALSE;
  custom_palette_version = 0;

  total_sprites = 0;
  total_sprites_1 = 0;
  total_sprites_2 = 0;
  total_sprites_8 = 0;
  total_sprites_15_16 = 0;
  total_sprites_24 = 0;

 /*
  * initialise 256 level greyscale sprite palette
  */
  for(colour = 0; colour < 256; colour++){

      GreyscalePalette[colour].data.gcol = 0;
      GreyscalePalette[colour].data.red = colour;
      GreyscalePalette[colour].data.green = colour;
      GreyscalePalette[colour].data.blue = colour;

  }

 /*
  * read 256 colour palette
  */
  r.r[0] = 21; /* read palette of mode 21 */
  r.r[1] = 0; /* default palette */
  r.r[2] = (int) &ColourPalette;
  r.r[3] = 256 * sizeof(palette_entry); /* size of buffer */
  r.r[4] = 0; /* flags */
  Error_Check((os_error *)
              _kernel_swi(SWI_XOS_Bit | SWI_ColourTrans_ReadPalette, &r, &r ));

 /*
  * Initialise custom palette to be the same as the Acorn palette
  */
  memcpy(CustomPalette, ColourPalette, 256 * sizeof(palette_entry));
}

