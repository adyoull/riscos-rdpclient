extern void SpriteLib_CreateImageBlock(spritelib_block *block)
{
 /*
  * sets up the spritelib_block for the image
  */
  sprite_header *header;
  palette_entry *palette;
  char *image;
  int masklinebytes;
  /* screen_modeval spritemode; */

 /*
  * 'header' points to start of sprite header
  * 'image' points to start of image pixel data
  */
  header = (void *) ((char *)block->spritearea + (block->spritearea)->firstoffset);
  palette = (void *) ((char *)header + sizeof(sprite_header));
  image = (void *) ((char *)header + header->imageoffset);

  /* spritemode.screen_mode = 18; */
  masklinebytes = (block->has_mask ?
                          Sprite_MemorySize(block->size.x, 1, __cl_screen_modeval_3,
                          sprite_HASNOMASKPAL) - sizeof(sprite_header) : 0);
 /*
  * initialise rest of image bank info block
  */
  block->header = (char *) header - (char *) block->spritearea;
  block->palette = (char *) palette - (char *) block->spritearea;
  block->image = (char *) image - (char *) block->spritearea;
  block->linebytes = (header->width + 1) * 4;
  block->mask = (block->has_mask ?
                 block->image + (header->maskoffset - header->imageoffset) : 0);
  block->masklinebytes = masklinebytes;
}

