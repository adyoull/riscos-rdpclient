extern spritelib_block *SpriteLib_Create(int width, int height, int bpp, BOOL palette, BOOL mask)
{
 /*
  * Create a sprite at the requested width and height and bpp.
  */
  spritelib_block *block;
//unsigned int start, end;
//while((start = Time_Monotonic()) == 0);

 /*
  * check for colour depth support
  */
  if(bpp > 8 && !allow_15bpp_plus)
     return(NULL);

 /*
  * allocate memory for spritelib block
  * return NULL if fails
  */
  block = malloc(sizeof(spritelib_block));
  if(block == NULL){
     return(NULL);
  }

  block->spritearea = NULL;
  block->size.x = width;
  block->size.y = height;
  block->bpp = bpp;
  if(bpp == 8){
     block->has_palette = palette;
     block->custom_palette_version = custom_palette_version;
  }
  else if(bpp == 2){
     block->has_palette = palette;
     block->custom_palette_version = 0;
  }
  else{
     block->has_palette = FALSE;
     block->custom_palette_version = 0;
  }
  if(bpp == 24 || bpp == 32)
     block->has_mask = mask;
  else
     block->has_mask = FALSE;

  if(!SpriteLib_CreateImageMemory(block)){
     free(block);
     return(NULL);
  }

  SpriteLib_CreateImageBlock(block);

  SpriteLib_ResetClipArea(block);

  total_sprites++;

  switch(bpp)
  {
    case 1:
      total_sprites_1++;
      break;

    case 2:
      total_sprites_2++;
      break;
      
    case 8:
      total_sprites_8++;
      break;

    case 15: case 16:
      total_sprites_15_16++;
      break;

    case 24: case 32:
      total_sprites_24++;
      break;
  }

//while((end = Time_Monotonic()) == 0);
//if(end - start > 0)
//   fprintf(stderr, "create %i\n", end - start);
  return(block);
}

/******************************************************************************/

extern void SpriteLib_Destroy(spritelib_block *block)
{
 /*
  * Deallocate image.
  */
  if(block == NULL)
     return;
//unsigned int start, end;
//while((start = Time_Monotonic()) == 0);

  if(block->spritearea != NULL)
     MemMan_Free((memman_ptr)&(block->spritearea));
  block->spritearea = NULL;

  total_sprites--;

  switch(block->bpp)
  {
    case 1:
      total_sprites_1--;
      break;

    case 2:
      total_sprites_2--;
      break;
      
    case 8:
      total_sprites_8--;
      break;

    case 15: case 16:
      total_sprites_15_16--;
      break;

    case 24: case 32:
      total_sprites_24--;
      break;
  }

  free(block);

//while((end = Time_Monotonic()) == 0);
//if(end - start > 0)
//   fprintf(stderr, "destroy %i\n", end - start);

}

