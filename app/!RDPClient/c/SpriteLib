extern void SpriteLib_ImageMemory(wimp_point *res, int bpp, BOOL palette, BOOL mask,
                                  int *size, int *imagesize, int *masksize)
{
 /*
  * returns memory in bytes of whole sprite (size) and image data (imagesize)
  */
  /* screen_modeval spritemode; */

  *masksize = 0;

  if(bpp == 24 || bpp == 32){

     *imagesize = (res->x * 4) * res->y; /* 1 pixel is 1 word */

     *size = *imagesize + sizeof(sprite_header);
     *size += sizeof(sprite_areainfo); /* add sprite area header size */

     /* new format 24bit sprite has 1bpp mask - same format as image data of 1bb sprite */
     if(mask){
        /* spritemode.screen_mode = 18; */
        *masksize = Sprite_MemorySize(res->x, res->y, __cl_screen_modeval_3,
                    sprite_HASNOMASKPAL) - sizeof(sprite_header);
        *size += *masksize;
     }
  }
  else{

     if(bpp == 15 || bpp == 16){
        /* simulate 16bit pixels by doubling x res of 8bit image */
        /* spritemode.screen_mode = 21; */
        *size = Sprite_MemorySize(res->x*2, res->y, __cl_screen_modeval_1, sprite_HASNOMASKPAL);
     }
     else if(bpp == 8){
        /* spritemode.screen_mode = 21; */
        *size = Sprite_MemorySize(res->x, res->y, __cl_screen_modeval_1, sprite_HASNOMASKPAL);
     }
     else if(bpp == 2){
        /* spritemode.screen_mode = 19; */
        *size = Sprite_MemorySize(res->x, res->y, __cl_screen_modeval_2, sprite_HASNOMASKPAL);
     }
     else if(bpp == 1){
        /* spritemode.screen_mode = 18; */
        *size = Sprite_MemorySize(res->x, res->y, __cl_screen_modeval_3, sprite_HASNOMASKPAL);
     }
     else{
       *size = 0;
     }

     *imagesize = *size - sizeof(sprite_header);
     *size += sizeof(sprite_areainfo); /* add sprite area header size */

     if(bpp == 8 && palette){
        /* 8bit image has a palette */
        *size += sizeof_256PALETTE; /* add 256 colour palette size */
     }
     else if(bpp == 2 && palette){
        *size += sizeof_4PALETTE; /* add 4 colour palette size */
     }
  }
}


