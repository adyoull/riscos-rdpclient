static void set_tile_offset(int *offset, int size)
{
  int remainder;

  remainder = *offset % size;

  if(remainder < 0)
     remainder = size - remainder;

  if(remainder < 0)
     remainder = 0;

  if(remainder >= size)
     remainder = 0;
     
  *offset = remainder;
}
