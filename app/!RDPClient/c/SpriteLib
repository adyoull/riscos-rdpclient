extern void SpriteLib_SetImageDataTrans(spritelib_block *block,
                                        int imagedatabpp, unsigned char *imagedata,
                                        palette_entry *imagedatapalette,
                                        BOOL flip_vertical)
{
 /*
  * Fill sprite with image data of variable bpp (which may not equal the target bpp)
  */
  int pixel_size = SpriteLib_RawDataPixelSize(imagedatabpp);
  int source_linebytes = ((imagedatabpp == 1) ? ((block->size.x + 7) / 8) :
                                                (block->size.x * pixel_size));
  int dest_linebytes = block->linebytes;
  int source_start = 0;
  int dest_start = block->image;
//unsigned int start, end;
//while((start = Time_Monotonic()) == 0);

  if(flip_vertical){

     switch(block->bpp)
     {
       case 24: case 32:
         GFXLib_PlotDataToSpriteTrans_FlipVertical_24_Copy(source_linebytes,
                                                           dest_linebytes,
