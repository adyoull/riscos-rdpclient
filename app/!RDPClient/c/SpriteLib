/******************************************************************************/

extern void SpriteLib_PlotLineToSprite(int gfx_op,
                                       spritelib_block *sprite,
                                       BOOL sprite_is_screen,
                                       int start_x, int start_y,
                                       int finish_x, int finish_y,
                                       int colour)
{
  int plot_action;
  int colour_value;
  unsigned int colour_value32;
  int origin_x;
  int origin_y;
  BOOL success;
  int bound_min_x;
  int bound_min_y;
  int bound_max_x;
  int bound_max_y;
 /*
  * Plot single pixel line of colour 'colour'
  * If screen is TRUE then output is to the screen
  */
  _kernel_swi_regs saver;
  _kernel_swi_regs r;

 /*
  * switch output to sprite
  */
  if(!sprite_is_screen){
     saver.r[0] = 60 + 512; /* switch output to sprite */
     saver.r[1] = (int)sprite->spritearea;
     saver.r[2] = (int)((char *)sprite->spritearea + (sprite->spritearea)->firstoffset);
     saver.r[3] = 0;
     if(_kernel_swi(SWI_XOS_Bit | SWI_OS_SpriteOp , &saver, &saver) != NULL)
        return;
  }

 /*
  * set foreground graphics colour
  */
  success = TRUE;
  switch(gfx_op)
  {
    case SpriteLib_GXandInverted:
      plot_action = 6;
      colour_value = colour;
      break;

    case SpriteLib_GXinvert:
      plot_action = 4;
      colour_value = colour;
      break;

    case SpriteLib_GXxor:
      plot_action = 3;
      colour_value = colour;
      break;

    case SpriteLib_GXand:
      plot_action = 2;
      colour_value = colour;
      break;

    case SpriteLib_GXequiv:
      plot_action = 3;         /* src XOR dest */
      colour_value = ~colour;  /* NOT src XOR desc */
      break;

    case SpriteLib_GXnoop:
      plot_action = 5;
      colour_value = colour;
      break;

    case SpriteLib_GXorInverted:
      plot_action = 7;
      colour_value = colour;
      break;

    case SpriteLib_GXcopy:
      plot_action = 0;
      colour_value = colour;
      break;

    case SpriteLib_GXor:
      plot_action = 1;
      colour_value = colour;
      break;

    default:
      success = FALSE;
      break;
  }

  switch(sprite->bpp)
  {
    case 8:
      colour_value32 = colour_value & 0x000000FF;
      break;

    case 15:
      if(iyonix_15bpp_colour_swap && sprite_is_screen)
         colour_value32 = GFXLib_TranslateColour_15S((unsigned int)colour_value);
      else
         colour_value32 = GFXLib_TranslateColour_15((unsigned int)colour_value);
      break;

    case 16:
      if(iyonix_15bpp_colour_swap && sprite_is_screen)
         colour_value32 = GFXLib_TranslateColour_16S((unsigned int)colour_value);
      else
         colour_value32 = GFXLib_TranslateColour_16((unsigned int)colour_value);
      break;

    case 24:
    case 32:
      colour_value32 = (unsigned int)colour_value && 0x00FFFFFF;
      break;
  }

  r.r[0] = plot_action;
  r.r[1] = colour_value32;
  _kernel_swi( SWI_XOS_Bit | SWI_OS_SetColour , &r, &r );


  if(success){

    /*
     * set graphics origin to bottom left corner
     */
     origin_x = 0;
     origin_y = 0;
     GFX_VDU(29);
     GFX_VDU((char) origin_x & 0xFF);
     GFX_VDU((char) (origin_x >> 8) & 0xFF);
     GFX_VDU((char) origin_y & 0xFF);
     GFX_VDU((char) (origin_y >> 8) & 0xFF);

    /*
     * set graphics window to bounding box
     */
     bound_min_x = sprite->clip_origin.x;
     bound_min_y = sprite->clip_origin.y + sprite->clip_size.y - 1; /* lower when reversed */
     bound_max_x = sprite->clip_origin.x + sprite->clip_size.x - 1;
     bound_max_y = sprite->clip_origin.y;

     bound_min_x = bound_min_x << 1;
     bound_max_x = bound_max_x << 1;
     bound_min_y = sprite->size.y - bound_min_y - 1;
     bound_min_y = bound_min_y << 1;
     bound_max_y = sprite->size.y - bound_max_y - 1;
     bound_max_y = bound_max_y << 1;

     GFX_VDU(24); /* set graphics window */
     GFX_VDU((char) bound_min_x & 0xff);
     GFX_VDU((char) (bound_min_x >> 8) & 0xff);
     GFX_VDU((char) bound_min_y & 0xff);
     GFX_VDU((char) (bound_min_y >> 8) & 0xff);
     GFX_VDU((char) bound_max_x & 0xff);
     GFX_VDU((char) (bound_max_x >> 8) & 0xff);
     GFX_VDU((char) bound_max_y & 0xff);
     GFX_VDU((char) (bound_max_y >> 8) & 0xff);

    /*
     * modify coords from top left 0,0 to bottom left 0,0 and from
     * pixels to OS units
     */
     start_x = start_x << 1;
     finish_x = finish_x << 1;
     start_y = sprite->size.y - start_y - 1;
     start_y = start_y << 1;
     finish_y = sprite->size.y - finish_y - 1;
     finish_y = finish_y << 1;

     GFX_Move(start_x, start_y);
     GFX_Draw(finish_x, finish_y);
     
  }

 /*
  * restore output
  */
  if(!sprite_is_screen){
     _kernel_swi(SWI_XOS_Bit | SWI_OS_SpriteOp, &saver, &saver);
  }

  if(!success)
     unimpl("SpriteLib_PlotLineToSprite(gfx_op=%X)\n", gfx_op);

}

