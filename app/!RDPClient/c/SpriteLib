extern void SpriteLib_CopyRectangleSprite(int gfx_op,
                                         spritelib_block *sprite,
                                         int dest_x, int dest_y,
                                         int source_x, int source_y,
                                         int source_width, int source_height)
{
  int pixel_size;
  int linebytes;
  int source_start;
  int dest_start;
  int plot_length;
 /*
  * Copy rectangle area of sprite source_x, source_y, source_width, source_height to
  * coordinate dest_x, dest_y
  */
  if(!clip_source_dest(sprite,
                       &dest_x, &dest_y, &source_width, &source_height,
                       &source_x, &source_y))
     return;

  pixel_size = SpriteLib_PixelSize(sprite);
  linebytes = sprite->linebytes;
  source_start = sprite->image + (source_x * pixel_size) + (source_y * linebytes);
  dest_start = sprite->image + (dest_x * pixel_size) + (dest_y * linebytes);
  plot_length = source_width * pixel_size;

  switch(sprite->bpp)
  {
    case 8:
      switch(gfx_op)
      {
        case SpriteLib_GXcopy:
          GFXLib_CopyRectangleSprite_8_Copy(linebytes,
                                            source_width,
                                            source_height,
                                            (unsigned char **)&(sprite->spritearea),
                                            source_start,
                                            dest_start);
          break;

        default:
          unimpl("SpriteLib_CopyRectangleSprite(gfx_op=%X)\n", gfx_op);
          break;
      }
      break;

    case 15:
    case 16:
      switch(gfx_op)
      {
        case SpriteLib_GXcopy:
          GFXLib_CopyRectangleSprite_8_Copy(linebytes,
                                            plot_length,
                                            source_height,
                                            (unsigned char **)&(sprite->spritearea),
                                            source_start,
                                            dest_start);
          break;

        default:
          unimpl("SpriteLib_CopyRectangleSprite(gfx_op=%X)\n", gfx_op);
          break;
      }
      break;

    case 24:
    case 32:
      switch(gfx_op)
      {
        case SpriteLib_GXcopy:
          GFXLib_CopyRectangleSprite_8_Copy(linebytes,
                                            plot_length,
                                            source_height,
                                            (unsigned char **)&(sprite->spritearea),
                                            source_start,
                                            dest_start);
          break;

        default:
          unimpl("SpriteLib_CopyRectangleSprite(gfx_op=%X)\n", gfx_op);
          break;
      }
      break;

    default:
      unimpl("SpriteLib_CopyRectangleSprite(bpp=%i)\n", sprite->bpp);
      break;
  }
  
}

/******************************************************************************/

extern int SpriteLib_PixelSize(spritelib_block *block)
{
 /*
  * Returns pixel size in bytes for sprite
  */
  int pixelsize = 1;

  switch(block->bpp)
  {
    case 1:
      pixelsize = 0;
      break;

    case 8:
      pixelsize = 1;
      break;

    case 15:
    case 16:
      pixelsize = 2;
      break;

    case 24:
    case 32:
      pixelsize = 4;
      break;
  }

  return(pixelsize);
}

/******************************************************************************/

extern int SpriteLib_DataPixelSize(spritelib_block *block)
{
 /*
  * Returns pixel size in bytes for raw data with same bpp as sprite 
  */
  int pixelsize = 1;

  pixelsize = SpriteLib_RawDataPixelSize(block->bpp);

  return(pixelsize);
}

/******************************************************************************/

extern int SpriteLib_RawDataPixelSize(int bpp)
{
 /*
  * Returns pixel size in bytes for raw data
  */
  int pixelsize = 1;

  switch(bpp)
  {
    case 1:
      pixelsize = 0;
      break;

    case 8:
      pixelsize = 1;
      break;

    case 15:
    case 16:
      pixelsize = 2;
      break;

    case 24:
      pixelsize = 3;
      break;

    case 32:
      pixelsize = 4;
      break;
  }

  return(pixelsize);
}

