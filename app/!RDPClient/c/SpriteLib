extern void SpriteLib_SetClipArea(spritelib_block *block,
                                  int clip_origin_x, int clip_origin_y,
                                  int clip_size_x, int clip_size_y)
{
 /*
  * Set clip area of a sprite - this sets a limiting rectangle where output
  * can only be drawn to
  */
  int origin_x;
  int origin_y;
  int size_x;
  int size_y;

  origin_x = clip_origin_x;
  origin_y = clip_origin_y;
  size_x = clip_size_x;
  size_y = clip_size_y;

 /*
  * Clip origin to image
  */
  if(origin_x < 0)
     origin_x = 0;

  if(origin_y < 0)
     origin_y = 0;

  if(origin_x >= block->size.x)
     origin_x = block->size.x - 1;

  if(origin_y >= block->size.y)
     origin_y = block->size.y - 1;

 /*
  * Resize clip size to match origin changes
  */
  size_x -= (origin_x - clip_origin_x);
  size_y -= (origin_y - clip_origin_y);

  if(size_x <= 0)
     size_x = 1;

  if(size_y <= 0)
     size_y = 1;

 /*
  * Resize clip size to fit in image
  */
  if((origin_x + size_x) > block->size.x)
     size_x = block->size.x - origin_x;

  if((origin_y + size_y) > block->size.y)
     size_y = block->size.y - origin_y;

  block->clip_origin.x = origin_x;
  block->clip_origin.y = origin_y;
  block->clip_size.x = size_x;
  block->clip_size.y = size_y;
}                                  

/******************************************************************************/

extern void SpriteLib_ResetClipArea(spritelib_block *block)
{
 /*
  * Reset clip area to whole of sprite
  */
  SpriteLib_SetClipArea(block, 0, 0, block->size.x, block->size.y);

}                                  
 
