extern void SpriteLib_PlotSpriteBitMaskToSprite(int gfx_op,
                                                spritelib_block *dest_sprite,
                                                int dest_x, int dest_y,
                                                BOOL dest_is_screen,
                                                spritelib_block *source_sprite,
                                                int source_x, int source_y,
                                                int plot_origin_x, int plot_origin_y,
                                                int plot_width, int plot_height,
                                                int foreground_colour,
                                                int background_colour, BOOL set_background)
{
  int pixel_size;
  int source_initial_x;
  int source_initial_y;
  int dest_start;
  int fgcolour_value;
  int bgcolour_value;
  int source_start;
  unsigned int fgcolour_value32;
  unsigned int bgcolour_value32;
 /*
  * Plot 1 bit per pixel source_sprite onto dest_sprite.
  * source_sprite is tiled to fill the space dest_x, dest_y to plot_width, plot_height.
  * The top left of source_sprite is lined up with plot_origin_x, plot_origin_y which
  * may not be in the plot area.
  * Where the source_sprite is 1, the dest_sprite is set to foreground_colour.
  * If set_background is TRUE, where the source_sprite is 0, the dest_sprite is set
  * to background_colour.
  */
//if(plot_width == 1){
//fprintf(stderr, "SpriteLib_PlotSpriteBitMaskToSprite(gfx_op=%i, dest_sprite->size.x=%i, dest_sprite->size.y=%i, dest_x=%i, dest_y=%i, source_sprite->size.x=%i, source_sprite->size.y=%i, source_x=%i, source_y=%i, plot_origin_x=%i, plot_origin_y=%i, plot_width=%i, plot_height=%i, foreground_colour=%i, background_colour=%i, set_background=%i)\n", gfx_op, dest_sprite->size.x, dest_sprite->size.y, dest_x, dest_y, source_sprite->size.x, source_sprite->size.y, source_x, source_y, plot_origin_x, plot_origin_y, plot_width, plot_height, foreground_colour, background_colour, set_background);
//}

  if(!clip_source_dest(dest_sprite,
                       &dest_x, &dest_y, &plot_width, &plot_height,
                       &source_x, &source_y))
     return;

//if(plot_width == 1){
//fprintf(stderr, "clip_source_dest(dest_x=%i, dest_y=%i, plot_width=%i, plot_height=%i, source_x=%i, source_y=%i)\n", dest_x, dest_y, plot_width, plot_height, source_x, source_y);
//}
  if(source_sprite->bpp != 1)
     return;

  pixel_size = SpriteLib_PixelSize(dest_sprite);
  source_initial_x = source_x;
  source_initial_y = source_y;
  dest_start = dest_sprite->image + (dest_x * pixel_size) + (dest_y * dest_sprite->linebytes);

  if(source_initial_x != 0){
     set_tile_offset(&source_initial_x, source_sprite->size.x);
//fprintf(stderr, "set_tile_offset(source_initial_x=%i (before), source_initial_x=%i (after))\n", source_x, source_initial_x);
  }

  if(source_initial_y != 0){
     set_tile_offset(&source_initial_y, source_sprite->size.y);
//fprintf(stderr, "set_tile_offset(source_initial_y=%i (before), source_initial_y=%i (after))\n", source_y, source_initial_y);
  }
  
  switch(dest_sprite->bpp)
  {
    case 8:
      switch(gfx_op)
      {

        case SpriteLib_GXxor:
          if(set_background)
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Bg_Xor(source_sprite->linebytes,
                                                          source_initial_x,
                                                          source_initial_y,
                                                          dest_sprite->linebytes,
                                                          plot_width,
                                                          plot_height,
                                                          (unsigned char)foreground_colour,
                                                          (unsigned char)background_colour,
                                                          source_sprite->size.x,
                                                          source_sprite->size.y,
                                                          (unsigned char **)
                                                                  &(source_sprite->spritearea),
                                                          source_sprite->image,
                                                          (unsigned char **)
                                                                  &(dest_sprite->spritearea),
                                                          dest_start);
          else
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Xor(source_sprite->linebytes,
                                                       source_initial_x,
                                                       source_initial_y,
                                                       dest_sprite->linebytes,
                                                       plot_width,
                                                       plot_height,
                                                       (unsigned char)foreground_colour,
                                                       source_sprite->size.x,
                                                       source_sprite->size.y,
                                                       (unsigned char **)
                                                                  &(source_sprite->spritearea),
                                                       source_sprite->image,
                                                       (unsigned char **)
                                                                  &(dest_sprite->spritearea),
                                                       dest_start);
          break;

        case SpriteLib_GXequiv:
          fgcolour_value = ~foreground_colour;
          bgcolour_value = ~background_colour;
          if(set_background)
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Bg_Xor(source_sprite->linebytes,
                                                          source_initial_x,
                                                          source_initial_y,
                                                          dest_sprite->linebytes,
                                                          plot_width,
                                                          plot_height,
                                                          (unsigned char)fgcolour_value,
                                                          (unsigned char)bgcolour_value,
                                                          source_sprite->size.x,
                                                          source_sprite->size.y,
                                                          (unsigned char **)
                                                                  &(source_sprite->spritearea),
                                                          source_sprite->image,
                                                          (unsigned char **)
                                                                  &(dest_sprite->spritearea),
                                                          dest_start);
          else
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Xor(source_sprite->linebytes,
                                                       source_initial_x,
                                                       source_initial_y,
                                                       dest_sprite->linebytes,
                                                       plot_width,
                                                       plot_height,
                                                       (unsigned char)fgcolour_value,
                                                       source_sprite->size.x,
                                                       source_sprite->size.y,
                                                       (unsigned char **)
                                                                  &(source_sprite->spritearea),
                                                       source_sprite->image,
                                                       (unsigned char **)
                                                                  &(dest_sprite->spritearea),
                                                       dest_start);
          break;

        case SpriteLib_GXand:
          if(set_background)
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Bg_And(source_sprite->linebytes,
                                                          source_initial_x,
                                                          source_initial_y,
                                                          dest_sprite->linebytes,
                                                          plot_width,
                                                          plot_height,
                                                          (unsigned char)foreground_colour,
                                                          (unsigned char)background_colour,
                                                          source_sprite->size.x,
                                                          source_sprite->size.y,
                                                          (unsigned char **)
                                                                  &(source_sprite->spritearea),
                                                          source_sprite->image,
                                                          (unsigned char **)
                                                                  &(dest_sprite->spritearea),
                                                          dest_start);
          else
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_And(source_sprite->linebytes,
                                                       source_initial_x,
                                                       source_initial_y,
                                                       dest_sprite->linebytes,
                                                       plot_width,
                                                       plot_height,
                                                       (unsigned char)foreground_colour,
                                                       source_sprite->size.x,
                                                       source_sprite->size.y,
                                                       (unsigned char **)
                                                                  &(source_sprite->spritearea),
                                                       source_sprite->image,
                                                       (unsigned char **)
                                                                  &(dest_sprite->spritearea),
                                                       dest_start);
          break;

        case SpriteLib_GXcopy:
          if(source_initial_x == 0 && plot_width <= 8 &&
             source_initial_y + plot_height <= source_sprite->size.y){

             source_start = source_sprite->image + (source_initial_y * source_sprite->linebytes);
             
             if(set_background)
                GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Bg_Copy_Byte(source_sprite->linebytes,
                                                                dest_sprite->linebytes,
                                                                plot_width,
                                                                plot_height,
                                                                (unsigned char)foreground_colour,
                                                                (unsigned char)background_colour,
                                                                (unsigned char **)
                                                                    &(source_sprite->spritearea),
                                                                source_start,
                                                                (unsigned char **)
                                                                    &(dest_sprite->spritearea),
                                                                dest_start);
             else
                GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Copy_Byte(source_sprite->linebytes,
                                                                dest_sprite->linebytes,
                                                                plot_width,
                                                                plot_height,
                                                                (unsigned char)foreground_colour,
                                                                (unsigned char **)
                                                                    &(source_sprite->spritearea),
                                                                source_start,
                                                                (unsigned char **)
                                                                    &(dest_sprite->spritearea),
                                                                dest_start);
          }
          else{

             if(set_background)
                GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Bg_Copy(source_sprite->linebytes,
                                                              source_initial_x,
                                                              source_initial_y,
                                                              dest_sprite->linebytes,
                                                              plot_width,
                                                              plot_height,
                                                              (unsigned char)foreground_colour,
                                                              (unsigned char)background_colour,
                                                              source_sprite->size.x,
                                                              source_sprite->size.y,
                                                              (unsigned char **)
                                                                    &(source_sprite->spritearea),
                                                              source_sprite->image,
                                                              (unsigned char **)
                                                                    &(dest_sprite->spritearea),
                                                              dest_start);
             else
                GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Copy(source_sprite->linebytes,
                                                           source_initial_x,
                                                           source_initial_y,
                                                           dest_sprite->linebytes,
                                                           plot_width,
                                                           plot_height,
                                                           (unsigned char)foreground_colour,
                                                           source_sprite->size.x,
                                                           source_sprite->size.y,
                                                           (unsigned char **)
                                                                    &(source_sprite->spritearea),
                                                           source_sprite->image,
                                                           (unsigned char **)
                                                                    &(dest_sprite->spritearea),
                                                           dest_start);
          }
          break;

        case SpriteLib_GXorInverted:
          fgcolour_value = ~foreground_colour;
          bgcolour_value = ~background_colour;
          if(set_background)
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Bg_Or(source_sprite->linebytes,
                                                         source_initial_x,
                                                         source_initial_y,
                                                         dest_sprite->linebytes,
                                                         plot_width,
                                                         plot_height,
                                                         (unsigned char)fgcolour_value,
                                                         (unsigned char)bgcolour_value,
                                                         source_sprite->size.x,
                                                         source_sprite->size.y,
                                                         (unsigned char **)
                                                                 &(source_sprite->spritearea),
                                                         source_sprite->image,
                                                         (unsigned char **)
                                                                 &(dest_sprite->spritearea),
                                                         dest_start);
          else
             GFXLib_PlotSpriteBitMaskToSprite_8_Fg_Or(source_sprite->linebytes,
                                                      source_initial_x,
                                                      source_initial_y,
                                                      dest_sprite->linebytes,
                                                      plot_width,
                                                      plot_height,
                                                      (unsigned char)fgcolour_value,
                                                      source_sprite->size.x,
                                                      source_sprite->size.y,
