extern void SpriteLib_SetMaskData(spritelib_block *block, unsigned char *maskdata,
                                  BOOL flip_vertical)
{
  int source_linebytes;
  int dest_linebytes;
  int source_start;
  int dest_start;
  int plot_bytes;
 /*
  * Fill sprite with mask data
  */
  if(!block->has_mask)
     return;

  source_linebytes = ((block->size.x + 7) / 8);
  dest_linebytes = block->masklinebytes;
  source_start = 0;
  dest_start = block->mask;
  plot_bytes = source_linebytes;

  if(flip_vertical){

     switch(block->bpp)
     {
       case 24: case 32: /* 24bit image has 1 bpp mask */
         GFXLib_PlotSpriteToSprite_FlipVertical_8_Copy(source_linebytes,
                                                       dest_linebytes,
                                                       plot_bytes,
                                                       block->size.y,
                                                       (unsigned char **)&maskdata,
                                                       source_start,
                                                       (unsigned char **)&(block->spritearea),
                                                       dest_start);
         break;

       default:
         unimpl("SpriteLib_SetMaskData(bpp=%i)\n", block->bpp);
         break;

     }

  }
  else{

     switch(block->bpp)
     {
       case 24: case 32: /* 24bit image has 1 bpp mask */
         GFXLib_PlotSpriteToSprite_8_Copy(source_linebytes,
                                          dest_linebytes,
                                          plot_bytes,
                                          block->size.y,
                                          (unsigned char **)&maskdata,
