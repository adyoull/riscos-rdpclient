extern void SpriteLib_SetImageData(spritelib_block *block, unsigned char *imagedata,
                                   BOOL flip_vertical)
{
 /*
  * Fill sprite with image data
  */
  int pixel_size = SpriteLib_DataPixelSize(block);
  int source_linebytes = ((block->bpp == 1) ? ((block->size.x + 7) / 8) :
                                              (block->size.x * pixel_size));
  int dest_linebytes = block->linebytes;
  int source_start = 0;
  int dest_start = block->image;
  int plot_bytes = source_linebytes;
//unsigned int start, end;
//while((start = Time_Monotonic()) == 0);

  if(flip_vertical){

     switch(block->bpp)
     {
       case 1: /* 1 bpp image is copied as a whole number of bytes */
       case 8:
         GFXLib_PlotSpriteToSprite_FlipVertical_8_Copy(source_linebytes,
                                                       dest_linebytes,
                                                       plot_bytes,
                                                       block->size.y,
                                                       (unsigned char **)&imagedata,
                                                       source_start,
                                                       (unsigned char **)&(block->spritearea),
                                                       dest_start);
         break;

       case 15:
         GFXLib_PlotSpriteToSprite_FlipVertical_8_Copy(source_linebytes,
                                                       dest_linebytes,
                                                       plot_bytes,
                                                       block->size.y,
                                                       (unsigned char **)&imagedata,
                                                       source_start,
                                                       (unsigned char **)&(block->spritearea),
                                                       dest_start);
         break;

       case 16:
         GFXLib_PlotSpriteToSprite_FlipVertical_8_Copy(source_linebytes,
                                                       dest_linebytes,
                                                       plot_bytes,
