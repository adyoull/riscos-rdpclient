extern BOOL SpriteLib_CreateImageMemory(spritelib_block *block)
{
 /*
  * allocates memory for sprite area and puts sprite of res into it
  */
  int size;
  sprite_header *header;
  palette_entry *palette;
  char *image;
  int imagesize;
  int masksize;
  os_error *err = NULL;
  /* screen_modeval spritemode; */

 /*
  * return if image already used
  */
  if(block->spritearea != NULL)
     return(FALSE);

 /*
  * work out the memory required for the sprite area
  * total memory is 'size' bytes for sprite area
  * 'imagesize' is size of image pixel data in bytes
  */
  SpriteLib_ImageMemory(&(block->size), block->bpp, block->has_palette, block->has_mask,
                        &size, &imagesize, &masksize);

 /*
  * allocate memory for sprite area
  */
  MemMan_Alloc((memman_ptr)&(block->spritearea), size + 64);
  if(block->spritearea == NULL){
     return(FALSE);
  }

 /*
  * initialise sprite area header for no sprites
  */
  (block->spritearea)->areasize = size;
  (block->spritearea)->numsprites = 0;
  (block->spritearea)->firstoffset = 16;
  (block->spritearea)->freeoffset = 16;

 /*
  * 'header' points to start of sprite header
  * 'palette' points to start of sprite palette
  * 'image' points to start of image pixel data
  * 'mask' points to start of mask pixel data
  */
  header = (void *) ((char *)block->spritearea + (block->spritearea)->firstoffset);
  palette = (void *) ((char *)header + sizeof(sprite_header));
  if((block->bpp == 32) || (block->bpp == 24) || (block->bpp == 15) || (block->bpp == 16) ||
     (block->bpp == 1)){
     /* 1bit, 16bit and 24bit images do not have a palette */
     image = (void *) (char *)palette;
  }
  else if(block->bpp == 8){
     if(block->has_palette)
        image = (void *) ((char *)palette + sizeof_256PALETTE);
     else
        image = (void *) (char *)palette;
  }
  else if(block->bpp == 2){
     if(block->has_palette)
        image = (void *) ((char *)palette + sizeof_4PALETTE);
     else
        image = (void *) (char *)palette;
  }
  else{
    /* unsupported bpp */
    error("SpriteLib_CreateImageMemory() unsupported bpp %i", block->bpp);
    MemMan_Free((memman_ptr)&(block->spritearea));
    return(FALSE);
  }

 /*
  * create blank sprite with no palette in sprite area
  */
  if(block->bpp == 24 || block->bpp == 32){
     header->offset_next = size - sizeof(sprite_areainfo);
     (block->spritearea)->numsprites = 1;
     (block->spritearea)->freeoffset = (block->spritearea)->areasize;
     strncpy(header->name, SpriteName, sprite_MAXNAME);
     header->width = block->size.x - 1;
     header->height = block->size.y - 1;
     header->leftbit = 0;
     header->rightbit = 31;
     header->imageoffset = sizeof(sprite_header);
     header->maskoffset = header->imageoffset + (block->has_mask ? imagesize : 0);
     /*                 type = 24bit     y dpi       x dpi     */
     /* header->screenmode = (6 << 27) | (90 << 14) | (90 << 1) | 1; */
     header->screenmode.sprite_mode.istype = 1;
     header->screenmode.sprite_mode.horz_dpi = 90;
     header->screenmode.sprite_mode.vert_dpi = 90;
     header->screenmode.sprite_mode.type = 6;

     memset(image, 0, imagesize);

     if(block->has_mask)
        memset(((char *)image) + imagesize, 0xFF, masksize);
  }
  else if(block->bpp == 15 || block->bpp == 16){
     /*
      * 16bit image is created by creating an 8bit image with double the width
      */
     /* spritemode.screen_mode = 21; */
     err = Sprite_Create(block->spritearea, SpriteName, sprite_HASNOMASKPAL,
                         block->size.x * 2, block->size.y, __cl_screen_modeval_1);
     /*
      * set new format mode parameter to 16bit
      */
     /*                 type = 16bit     y dpi       x dpi     */
     /* header->screenmode = (5 << 27) | (90 << 14) | (90 << 1) | 1; */
     header->screenmode.sprite_mode.istype = 1;
     header->screenmode.sprite_mode.horz_dpi = 90;
     header->screenmode.sprite_mode.vert_dpi = 90;
     header->screenmode.sprite_mode.type = 5;
  }
  else if(block->bpp == 8){
     /* spritemode.screen_mode = 21; */
     Sprite_Create(block->spritearea, SpriteName, sprite_HASNOMASKPAL,
                   block->size.x, block->size.y, __cl_screen_modeval_1);
  }
  else if(block->bpp == 2){
     /* spritemode.screen_mode = 19; */
     if(block->has_palette)
        err = Sprite_Create(block->spritearea, SpriteName, sprite_HASPAL,
                            block->size.x, block->size.y, __cl_screen_modeval_2);
     else
        err = Sprite_Create(block->spritearea, SpriteName, sprite_HASNOMASKPAL,
                            block->size.x, block->size.y, __cl_screen_modeval_2);
  }
  else if(block->bpp == 1){
     /* spritemode.screen_mode = 18; */
     err = Sprite_Create(block->spritearea, SpriteName, sprite_HASNOMASKPAL,
                         block->size.x, block->size.y, __cl_screen_modeval_3);
  }

  if(block->bpp == 8){
    /*
     * insert 256 entry palette
     */
     if(block->has_palette){

        if(imagesize < sizeof_256PALETTE)
           memmove(image, image - sizeof_256PALETTE, imagesize);
        else
           memmove(image + imagesize - sizeof_256PALETTE,
                   image + imagesize - (2 * sizeof_256PALETTE),
                   sizeof_256PALETTE);

        header->imageoffset += sizeof_256PALETTE;
        header->maskoffset += sizeof_256PALETTE;
        header->offset_next += sizeof_256PALETTE;
        block->spritearea->freeoffset += sizeof_256PALETTE;

        set_palette(block, TRUE);

     }
  }

  if(err != NULL){
     error(" - %i:%s", err->errnum, err->errmess);
     error("SpriteLib_CreateImageMemory() %ix%i:%i pal %i mask %i size %i image %i mask %i",
           block->size.x, block->size.y, block->bpp, block->has_palette, block->has_mask,
           size, imagesize, masksize);
     return(FALSE);
  }
  else
     return(TRUE);
}

