extern void Clipboard_SetMode(int mode)
{
 /*
  * Set mode of clipboard redirection
  */
  if(mode == clipboard_OFF || mode == clipboard_PASSIVE || mode == clipboard_ACTIVE){

     clipboard_redirection_mode = mode;

     Status_SetClipboardMode(mode);
  }
}

/******************************************************************************/

extern int Clipboard_GetMode(void)
{
 /*
  * Return mode of clipboard redirection
  */

  return(clipboard_redirection_mode);
}

/******************************************************************************/

extern void Clipboard_SetBufferSize(int size)
{
 /*
  * Set maximum size of clipboard data buffer in K
  * (mimimum value possible is 16K, 0 sets buffer as unlimited)
  */
  if(size == 0)
     clipboard_maximum_data_size = INT_MAX;
  else if (size < 16)
     clipboard_maximum_data_size = 16 * 1024;
  else
     clipboard_maximum_data_size = size * 1024;

  Status_SetClipboardBufferSize(size);
}

/******************************************************************************/

extern int Clipboard_GetBufferSize(void)
{
 /*
  * Return maximum size of clipboard data buffer in K
  * (0 = unlimited)
  */
  if(clipboard_maximum_data_size == INT_MAX)
     return(0);
  else
     return(clipboard_maximum_data_size / 1024);
}

/******************************************************************************/

extern void Clipboard_Poll(void)
{
 /*
  * Called frequently
  */
  unsigned int time = 0;

  if(!clipboard_enabled || !client_clipboard_request_active)
     return;

  while((time = Time_Monotonic()) == 0);

  if(time >= client_clipboard_request_timeout_time){

     client_clipboard_request_active = FALSE;

     clipboard_message_reference = 0;

#ifdef clipboard_DEBUG
     fprintf(stderr, "Timeout getting clipboard data, calling cliprdr_send_data(NULL, 0)\n");
#endif
    /*
     * Timed out getting clipboard data from client to paste to
     * server so send it nothing to release the lock on the
     * app running on the server
     */
     cliprdr_send_data(NULL, 0);

  }
}

