static BOOL event_message_clip_claimentity(event_pollblock *event, void *reference)
{
  char task_name[64];
  int flags;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called event_message_clip_claimentity(action=%i)\n",
          event->data.message.header.action);
#endif

  if(event->data.message.header.action != message_CLIP_CLAIMENTITY)
     return(FALSE);


#ifdef clipboard_DEBUG
  Utils_TaskNameFromHandle(task_name, sizeof(task_name), (int)event->data.message.header.sender);
  fprintf(stderr, "sender='%i'\n", (int)event->data.message.header.sender);
  fprintf(stderr, "task name='%s'\n", task_name);
  fprintf(stderr, "have_clipboard=%s\n", (have_clipboard ? "TRUE" : "FALSE"));
  fprintf(stderr, "actually_have_clipboard=%s\n", (actually_have_clipboard ? "TRUE" : "FALSE"));
#endif

  if(event->data.message.header.sender != event_taskhandle){

     flags = event->data.message.data.words[0];
#ifdef clipboard_DEBUG
     fprintf(stderr, "flags='%i'\n", (int)flags);
#endif
     if(flags & 4){
       /*
        * If bit 3 is set, message is clipboard claim
        */

     
       /*
        * Another app has claimed to have the clipboard.
        * Ignore the Clipboard Holder if it was after ourselves
        * gaining the clipboard (as we really still have it)
        */
        Utils_TaskNameFromHandle(task_name, sizeof(task_name),
                                 (int)event->data.message.header.sender);

#ifdef clipboard_DEBUG
        fprintf(stderr, "clipboard claimed by '%s'\n", task_name);
#endif

        if(strcmp(task_name, clipboardholder_TASKNAME) == 0 ||
           strcmp(task_name, clipboardstore_TASKNAME) == 0){
          /*
           * Only loose clipboard for messages from the
           * Clipboard Holder (i.e. ignore other apps)
           * to prevent double processing loosing the
           * clipboard - but not the first time after
           * gaining the clipboard ourselves
           */
           if(ignore_clipboard_holder)
              ignore_clipboard_holder = FALSE;
           else
              set_have_clipboard(FALSE);
        }
        else
           set_have_clipboard(FALSE);
     }
  }
     
  return(TRUE);
}

/******************************************************************************/

static BOOL event_message_clip_datarequest(event_pollblock *event, void *reference)
{
  char task_name[64];
  int flags;
  int index;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called event_message_clip_datarequest(type=%i, action=%i)\n",
          event->type, event->data.message.header.action);
#endif
 /*
  * Called when another task wants the clipboard data (to paste into itself)
  */
  if(event->data.message.header.action != message_CLIP_DATAREQUEST)
     return(FALSE);

#ifdef clipboard_DEBUG
  Utils_TaskNameFromHandle(task_name, sizeof(task_name), (int)event->data.message.header.sender);
  fprintf(stderr, "size='%i'\n", event->data.message.header.size);
  fprintf(stderr, "sender='%i'\n", (int)event->data.message.header.sender);
  fprintf(stderr, "sender task name='%s'\n", task_name);
  fprintf(stderr, "my ref='%i'\n", event->data.message.header.myref);
  fprintf(stderr, "your ref='%i'\n", event->data.message.header.yourref);
  fprintf(stderr, "window handle (0)='%i'\n", event->data.message.data.words[0]);
  fprintf(stderr, "internal handle (1)='%i'\n", event->data.message.data.words[1]);
  fprintf(stderr, "position x (2)='%i'\n", event->data.message.data.words[2]);
  fprintf(stderr, "position y (3)='%i'\n", event->data.message.data.words[3]);
  fprintf(stderr, "op code (4)='%i'\n", event->data.message.data.words[4]);
  fprintf(stderr, "first filetype (5)='%i'\n", event->data.message.data.words[5]);
  fprintf(stderr, "filetype(s)\n");
  index = 5;
  while(event->data.message.data.words[index] != -1 && index < 32)
     fprintf(stderr, "  %03x\n", event->data.message.data.words[index++]);
#endif

  if(event->data.message.header.sender != event_taskhandle){

     if(actually_have_clipboard){

       /*
        * Send datasave to start save process
        */
        clipboard_message_reference = clipboard_datasave(event);

     }
  }
  else{
#ifdef clipboard_DEBUG
     fprintf(stderr, "our message back\n");
     fprintf(stderr, "clipboard_message_reference=%i, yourref=%i, myref=%i\n",
             clipboard_message_reference, event->data.message.header.yourref,
             event->data.message.header.myref);
#endif

     if(event->type == event_USERMESSAGEACK){
        if(query_clipboard_operation){
           query_clipboard_result(FALSE, NULL);
        }
        else{
          /*
           * We thought we had the clipboard but we don't
           * The server must be sent something
           */
           client_clipboard_request_active = FALSE;
           cliprdr_send_data(NULL, 0);
           return(TRUE);
        }
     }
  }
  
  return(TRUE);
}

/******************************************************************************/

static BOOL event_message_datasave(event_pollblock *event, void *reference)
{
  char transfer_filename[256];
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called event_message_datasave(action=%i)\n",
          event->data.message.header.action);
#endif
 /*
  * Called in response to us sending out clip_datarequest when another task
  * wants to save the clipboard data to us
  */
  if(event->data.message.header.action != message_DATASAVE)
     return(FALSE);

  if(clipboard_message_reference == 0 ||
     (event->data.message.header.yourref != clipboard_message_reference &&
      event->data.message.header.myref != clipboard_message_reference) ||
      event->data.message.header.sender == event_taskhandle){
     return(FALSE);
  }

#ifdef clipboard_DEBUG
  fprintf(stderr, "filetype=%03x\n", event->data.message.data.datasave.filetype);
#endif

  if(query_clipboard_operation){
     query_clipboard_result(TRUE, &(event->data.message.data.datasave));
     return(TRUE);
  }

  if(event->data.message.data.datasave.filetype == filetype_TEXT){
    /*
     * Sent response back to client app to save clipboard data to us
     */
     choose_receive_method(event->data.message.data.datasave.estsize, transfer_filename);
     clipboard_message_reference = clipboard_datasaveack(event, transfer_filename);
  }
  else{
    /*
     * Clipboard contains data that is not supported so send NULL
     * to the server and abort the data transfer
     */
#ifdef clipboard_DEBUG
     fprintf(stderr, "clipboard does not contain TEXT data, sending NULL to server\n");
#endif
     clipboard_message_reference = 0;
     client_clipboard_request_active = FALSE;
     cliprdr_send_data(NULL, 0);
  }
  
  return(TRUE);
}

/******************************************************************************/

static BOOL event_message_datasaveack(event_pollblock *event, void *reference)
{
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called event_message_datasaveack(action=%i)\n",
          event->data.message.header.action);
#endif
 /*
  * Called when another task has accepted the save of clipboard data (to paste into itself)
  */
  if(event->data.message.header.action != message_DATASAVEACK)
     return(FALSE);

  if(clipboard_message_reference == 0 ||
     (event->data.message.header.yourref != clipboard_message_reference &&
      event->data.message.header.myref != clipboard_message_reference) ||
      event->data.message.header.sender == event_taskhandle){
     return(FALSE);
  }

  clipboard_message_reference = 0;

  Utils_CopyStringNL(clipboard_save_filename, event->data.message.data.datasaveack.filename,
                     sizeof(clipboard_save_filename));

#ifdef clipboard_DEBUG
  fprintf(stderr, "filename='%s'\n", clipboard_save_filename);
#endif

  memcpy(&clipboard_save_event, event, sizeof(event_pollblock));

 /*
  * Acknowledge datasaveack message as we will call Wimp_Poll()
  * and message would otherwise be send back to sending task
  */
  clipboard_datasaveack_acknowledge(event);
  
 /*
  * Need to save data to specified file.
  * First, ask server for clipboard data.
  * On receipt of data, will be written to file and acknowledged
  */
  request_clipboard_data_from_server();
  
  return(TRUE);
}

/******************************************************************************/

static BOOL event_message_dataload(event_pollblock *event, void *reference)
{
  char filename[256];
  char *clipboard_data;
  unsigned int clipboard_data_size;
  BOOL sent_clipboard_data;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called event_message_dataload(action=%i)\n",
          event->data.message.header.action);
#endif
 /*
  * Sent when client app presents us with the clipboard data we requested
  */
  if(event->data.message.header.action != message_DATALOAD)
     return(FALSE);

  if(clipboard_message_reference == 0 ||
     (event->data.message.header.yourref != clipboard_message_reference &&
      event->data.message.header.myref != clipboard_message_reference) ||
      event->data.message.header.sender == event_taskhandle){
     return(FALSE);
  }

  
  clipboard_message_reference = 0;

  client_clipboard_request_active = FALSE;

  Utils_CopyStringNL(filename, event->data.message.data.datasaveack.filename, sizeof(filename));
#ifdef clipboard_DEBUG
  fprintf(stderr, "filename='%s'\n", filename);
#endif

  sent_clipboard_data = FALSE;

#ifdef clipboard_DEBUG
  fprintf(stderr, "filetype=%03x\n", event->data.message.data.dataload.filetype);
#endif

  if(event->data.message.data.dataload.filetype == filetype_TEXT){
#ifdef clipboard_DEBUG
     fprintf(stderr, "clipboard contains TEXT data, sending to server\n");
#endif

     clipboard_data = load_clipboard_data(filename, &clipboard_data_size, TRUE);

     if(clipboard_data != NULL){

#ifdef clipboard_DEBUG
        fhexdump(stderr, (uint8 *)clipboard_data, clipboard_data_size);
#endif
        sent_clipboard_data = TRUE;
        cliprdr_send_data((uint8 *)clipboard_data, clipboard_data_size);

        free(clipboard_data);
     }
  }

  if(!sent_clipboard_data){
    /*
     * Did not send any data so as must send something, send NULL instead
     */
#ifdef clipboard_DEBUG
     fprintf(stderr, "clipboard does not contain TEXT data, sending NULL to server\n");
#endif
     cliprdr_send_data(NULL, 0);
  }

 /*
  * Remove temporary file if nessesary
  */
  remove_temp_file(filename);

 /*
  * Send response back to acknowledge load of clipboad data
  */
  clipboard_dataloadack(event);
  
  return(TRUE);
}

