static BOOL event_message_dataloadack(event_pollblock *event, void *reference)
{
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called event_message_dataloadack(action=%i)\n",
          event->data.message.header.action);
#endif
 /*
  * Called when another task has acknowledged the load of data saved to it
  */
  if(event->data.message.header.action != message_DATALOADACK)
     return(FALSE);

  if(clipboard_message_reference == 0 ||
     (event->data.message.header.yourref != clipboard_message_reference &&
      event->data.message.header.myref != clipboard_message_reference) ||
      event->data.message.header.sender == event_taskhandle){
     return(FALSE);
  }

  clipboard_message_reference = 0;

  return(TRUE);  
}


