extern void ui_clip_format_announce(uint8 * data, uint32 length)
{
  int size;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called ui_clip_format_annouce(data=%li, length=%li)\n", data, length);
  fhexdump(stderr, data, length);
#endif
 /*
  * Called when copy to clipboard is issued on the server.
  * 'data' holds the formats that are available.
  */


  if(clipboard_format_data != NULL){

     if(length <= FORMAT_MAX_SIZE)
        size = (int)length;
     else
        size = FORMAT_MAX_SIZE;

     memcpy(clipboard_format_data, data, size);
     clipboard_format_data_size = (int)size;

  }

  clipboard_claim();  /* claim in all modes, including single-task */
}

