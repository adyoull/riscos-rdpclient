static void query_clipboard_result(BOOL clipboard_has_data, message_datasave *datasave)
{
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called query_clipboard_result(clipboard_has_data=%s)\n",
          (clipboard_has_data ? "TRUE" : "FALSE"));
#endif
 /*
  * Called in response to query of client clipboard contents
  * If clipboard has data, 'clipboard_has_data' is TRUE and 'datasave'
  * points to a datasave_block identifying the clipboard data available.
  */
  client_clipboard_request_active = FALSE;
  query_clipboard_operation = FALSE;
  clipboard_message_reference = 0;

  if(clipboard_has_data || query_clipboard_send_on_empty){

    /*
     * Tell the server we have data
     */
     set_have_clipboard(FALSE);
  }

  query_clipboard_send_on_empty = FALSE;
}

