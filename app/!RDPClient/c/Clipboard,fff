extern void ui_clip_handle_data(uint8 * data, uint32 length)
{
  int actual_length;
  uint8 *firstnull;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called ui_clip_handle_data(data=%li, length=%li)\n", data, length);
  fhexdump(stderr, data, length);
#endif
 /*
  * Called in response to cliprdr_send_data_request() call with data from server
  * clipboard.
  * Note: won't be called if cliprdr_send_data_request() call is made with format
  * that is not available in server clipboard.
  */

 /*
  * xrdp (and Windows) frequently return CF_UNICODETEXT (UTF-16LE) even for a
  * CF_TEXT request. Detect interleaved-NUL wide text and collapse it to Latin-1
  * in place, so RISC OS is not handed "mostly NULLs". Codepoints outside
  * Latin-1 become '?'. Runs before the CF_TEXT handling below.
  */
  {
     BOOL is_wide;
     uint32 start = 0;

     /* Skip a UTF-16LE byte-order mark (FF FE) if present. */
     if(length >= 2 && data[0] == 0xFF && data[1] == 0xFE)
        start = 2;

     is_wide = (requested_clipboard_format == CF_UNICODETEXT)
               || (start == 2)
               || (length - start >= 2 && ((length - start) & 1) == 0
                   && data[start + 1] == 0);

     if(is_wide){
        uint32 wi, wo = 0;
        for(wi = start; wi + 1 < length; wi += 2){
           if(data[wi] == 0 && data[wi + 1] == 0)
              break;                     /* UTF-16 NUL terminator */
           data[wo++] = (data[wi + 1] == 0) ? data[wi] : '?';
        }
        length = wo;
     }
  }

  if(requested_clipboard_format == CF_TEXT || requested_clipboard_format == CF_UNICODETEXT){

     actual_length = length;
    
    /*
     * Translate CRLF newlines into LF newlines
     */
     Utils_CRLF2LF((char *)data, (unsigned int *)&actual_length);

    /*
     * Only send data up to (but not including) NULL byte, if any
     */
     firstnull = (uint8 *)memchr((char *) data, '\0', actual_length);
     if(firstnull != NULL)
        actual_length = firstnull - data;

  }
  else
     actual_length = length;

 /*
  * Save clipboard data to client side app that requested a paste from the server
  * clipboard.
  */
  save_client_paste_data(data, actual_length);
}

