extern void Clipboard_Init(void)
{
 /*
  * initialisation to be done on startup
  */
  clipboard_format_data_size = 0;
  clipboard_format_data = NULL;

  clipboard_message_reference = 0;

  clipboard_save_filename[0] = '\0';
  requested_clipboard_format = 0;

  ignore_clipboard_holder = FALSE;
  connected_to_server = FALSE;
  clipboard_enabled = FALSE;
  query_clipboard_operation = FALSE;
  query_clipboard_send_on_empty = FALSE;

  Clipboard_SetBufferSize(16);
  Clipboard_SetMode(clipboard_OFF);

  set_have_clipboard(FALSE);

}

/******************************************************************************/

extern BOOL Clipboard_Startup(void)
{
 /*
  * Start up clipboard handling, called by RDesktop_Main
  * Must be called only once
  */
  int clipboard_message_list[] = {message_CLIP_CLAIMENTITY,
                                  message_CLIP_DATAREQUEST,
                                  0};
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called Clipboard_Startup()\n");
#endif

  clipboard_format_data_size = 0;
  clipboard_message_reference = 0;

  if(clipboard_redirection_mode != clipboard_OFF){
  
     clipboard_format_data = malloc(FORMAT_MAX_SIZE);
     if(clipboard_format_data == NULL)
        return(FALSE);
   
     if(!cliprdr_init()){
        free(clipboard_format_data);
        return(FALSE);
     }
     
     Wimp_AddMessages(clipboard_message_list);
   
     EventMsg_Claim((message_action)message_CLIP_CLAIMENTITY, event_ANY,
                    event_message_clip_claimentity, NULL);
     EventMsg_Claim((message_action)message_CLIP_DATAREQUEST, event_ANY,
                    event_message_clip_datarequest, NULL);
   
     EventMsg_Claim(message_DATALOAD, event_ANY, event_message_dataload, NULL);
     EventMsg_Claim(message_DATALOADACK, event_ANY, event_message_dataloadack, NULL);
     EventMsg_Claim(message_DATASAVE, event_ANY, event_message_datasave, NULL);
     EventMsg_Claim(message_DATASAVEACK, event_ANY, event_message_datasaveack, NULL);
   
     clipboard_enabled = TRUE;

     load_clipstore();
  }
  
  return(TRUE);
}

