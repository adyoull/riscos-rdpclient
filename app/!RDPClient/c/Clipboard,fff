static unsigned int clipboard_datasave(event_pollblock *event)
{
  message_block block;
  os_error *err;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called clipboard_datasave()\n");
#endif
 /*
  * Send datasave in response to clip_datarequest
  */

  memcpy(&block, &(event->data), sizeof(message_block));
  
  block.header.size = 60;
  block.header.yourref = event->data.message.header.myref;
  block.header.action = message_DATASAVE;
  block.data.datasave.estsize = -1;
  block.data.datasave.filetype = filetype_TEXT;
  strcpy(block.data.datasave.leafname, "Clipboard");

  err = Wimp_SendMessage(event_USERMESSAGERECORDED, &block,
                         event->data.message.header.sender, 0);

  if(err != NULL)
     error("clipboard_datasave() %i '%s'", err->errnum, err->errmess);

  return(block.header.myref);  
}

