static void set_client_clipboard_request_timeout(void)
{
  unsigned int time;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called set_client_clipboard_request_timeout()\n");
#endif
 /*
  * Setup timeout of client clipboard request
  */
  time = 0;

  while((time = Time_Monotonic()) == 0);

  client_clipboard_request_active = TRUE;
     
  client_clipboard_request_timeout_time = time + CLIENT_CLIPBOARD_REQUEST_TIMEOUT;
}

