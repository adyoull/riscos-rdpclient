static void load_clipstore(void)
{
 /*
  * Load ClipStore application if required
  */
  BOOL load = TRUE;

  if(Utils_SWINumberFromString("ClipboardHolder_Copy") != 0)
     load = FALSE; /* Select Clipboard Holder module is present */

  if(load && Utils_IsTaskRunning("Clipboard Holder", 0))
     load = FALSE; /* Select Clipboard Holder module is running */

  if(load && Utils_IsTaskRunning("Clipboard Store", 0))
     load = FALSE; /* An instance of ClipStore is already running */

  if(load)
     Wimp_StartTask("<RDPClient$Dir>.ClipStore.!Run");
}
