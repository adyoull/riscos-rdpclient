static void set_have_clipboard(BOOL state)
{
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called set_have_clipboard(state=%s)\n", (state ? "TRUE" : "FALSE"));
#endif

  have_clipboard = state;
  actually_have_clipboard = state;

  if(!have_clipboard && connected_to_server){
#ifdef clipboard_DEBUG
     fprintf(stderr, "Called cliprdr_send_text_format_announce()\n");
#endif
     /* tell server that client machine has clipboard */
     cliprdr_send_simple_native_format_announce(RDP_CF_TEXT);
  }
}

/******************************************************************************/

static BOOL check_clipboard_format(char *format_block, int size, unsigned int format)
{
  BOOL found;
  unsigned int *block;
  int total_words;
  int index;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called check_clipboard_format(format_block=%li, size=%i, format=%i)\n",
          format_block, size, format);
#endif
 /*
  * Check if 'format' is one of the formats present in 'format_block'.
  * If found, TRUE is returned.
  */
  found = FALSE;
  block = (unsigned int *)format_block;
  total_words = size >> 2;

  if(size > 0){

     index = 0;

     while(index < total_words){

#ifdef clipboard_DEBUG
        fprintf(stderr, "checking %i against %i\n", format, block[index]);
#endif
        if(block[index] == format){
           found = TRUE;
           break;
        }

        index += 9;

     }

  }

  return(found);
}

/******************************************************************************/

static void request_clipboard_data_from_server(void)
{
  char null_char[1] = {'\0'};
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called request_clipboard_data_from_server()\n");
#endif
 /*
  * Called to request clipboard data from server to send to client for a paste
  */

 /*
  * Check clipboard has data that can be pasted
  */
  if(check_clipboard_format(clipboard_format_data, clipboard_format_data_size, CF_TEXT)){
    /*
     * Clipboard has data we can paste, so ask the server to send it to us.
     * On receipt of data, will be written to file and acknowledged.
     */
#ifdef clipboard_DEBUG
     fprintf(stderr, "data found that's OK\n");
#endif
     requested_clipboard_format = CF_TEXT;
     cliprdr_send_data_request(CF_TEXT);
  }
  else if(check_clipboard_format(clipboard_format_data, clipboard_format_data_size, CF_UNICODETEXT)){
     requested_clipboard_format = CF_UNICODETEXT;
     cliprdr_send_data_request(CF_UNICODETEXT);
  }
  else{
    /*
     * Clipboard does not have data we can paste, so send nothing straight away.
     */
#ifdef clipboard_DEBUG
     fprintf(stderr, "no data found that can be used\n");
#endif
     save_client_paste_data(&null_char, 0);
  }
}

/******************************************************************************/

static void save_client_paste_data(void *data, int length)
{
  file_handle channel;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called save_client_paste_data(data=%li, length=%i)\n", data, length);
#endif
 /*
  * Save supplied 'data' to data file for client side paste and acknowledge
  * save operation.
  */

  if(clipboard_save_filename[0] != '\0'){

     channel = File_Open(clipboard_save_filename, file_WRITE);

     if(channel != NULL){
     
         File_WriteBytes(channel, data, length);
         
         File_Close(channel);

     }

     clipboard_save_filename[0] = '\0';

    /*
     * Send acknowledgement dataload
     */
     clipboard_message_reference = clipboard_dataload(&clipboard_save_event);

  }
}

/******************************************************************************/

static void *load_clipboard_data(char *filename, unsigned int *data_size, BOOL convert_lf_crlf)
{
  int file_size;
  char *data;
  file_handle channel;
  int not_read;
  BOOL success;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called load_clipboad_data(filename='%s')\n", filename);
#endif
 /*
  * Load data from supplied 'filename' into memory and return pointer to
  * data and 'data_size'
  */

  success = FALSE;
  
  file_size = File_Size(filename);

  if(file_size != 0){

     if(file_size > clipboard_maximum_data_size)
        file_size = clipboard_maximum_data_size;

     data = malloc((convert_lf_crlf ? file_size * 2 : file_size) + 1);

     if(data != NULL){

        not_read = file_size;

        channel = File_Open(filename, file_READ);

        if(channel != NULL){

           not_read =  File_ReadBytes(channel, data, file_size);

           File_Close(channel);
           
        }

        file_size -= not_read;
        
        if(file_size == 0)
           free(data);
        else{
           data[file_size] = '\0';
           file_size++;

           if(convert_lf_crlf)
              Utils_LF2CRLF(data, (unsigned int *)&file_size);

           success = TRUE;
           *data_size = file_size;
        }
     }
  }

  if(success)
     return(data);
  else
     return(NULL);
}

/******************************************************************************/

static void clipboard_claim(void)
{
  message_block block;
  os_error *err;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called clipboard_claim()\n");
#endif


  set_have_clipboard(TRUE);

  block.header.size = 24;
  block.header.yourref = 0;
  block.header.action = (message_action)message_CLIP_CLAIMENTITY;
  block.data.words[0] = 4;               /* flags */

  err = Wimp_SendMessage(event_USERMESSAGERECORDED, &block, 0, 0);

  if(err != NULL)
     error("clipboard_claim() %i '%s'", err->errnum, err->errmess);
  else{
    /*
     * Clipboard Holder will capture the data so ignore first
     * message saying that it now has our data as we still
     * really have the clipboard (as far as the server is
     * concerned).
     */
     ignore_clipboard_holder = TRUE;
  }

}

/******************************************************************************/

static unsigned int clipboard_datarequest(BOOL query, BOOL send_on_empty)
{
  message_block block;
  os_error *err;
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called clipboard_datarequest(query=%s, send_on_empty=%s)\n",
          (query ? "TRUE" : "FALSE"), (send_on_empty ? "TRUE" : "FALSE"));
#endif


  block.header.size = 52;
  block.header.yourref = 0;
  block.header.action = (message_action)message_CLIP_DATAREQUEST;
  block.data.words[0] = Display_CurrentWindowHandle(); /* window_handle */
  block.data.words[1] = 0;                             /* internal_handle */
  block.data.words[2] = 0;                             /* pos.x */
  block.data.words[3] = 0;                             /* pos.y */
  block.data.words[4] = 4;                             /* opcode */
  block.data.words[5] = filetype_TEXT;                 /* types[0] */
  block.data.words[6] = -1;                            /* types[1] */

  err = Wimp_SendMessage(event_USERMESSAGERECORDED, &block, 0, 0);

  query_clipboard_operation = FALSE;
  query_clipboard_send_on_empty = FALSE;

  if(err != NULL)
     error("clipboard_datarequest() %i '%s'", err->errnum, err->errmess);
  else{
     set_client_clipboard_request_timeout();
     query_clipboard_operation = query;
     query_clipboard_send_on_empty = send_on_empty;
  }

  return(block.header.myref);
}

