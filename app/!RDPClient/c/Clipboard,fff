extern void ui_clip_request_data(uint32 format)
{
#ifdef clipboard_DEBUG
  fprintf(stderr, "Called ui_clip_request_data(format=%li)\n", format);
#endif
 /*
  * Called when past from clipboard is issued on the server
  */

  if(!have_clipboard){
    /*
     * Request clipboard data from current holder
     */
     clipboard_message_reference = clipboard_datarequest(FALSE, FALSE);
  }
  else{
    /*
     * The server already has the clipboard so no data is available
     * or we are in single tasking mode and can't get it anyway
     */
     cliprdr_send_data(NULL, 0);
  }
}

