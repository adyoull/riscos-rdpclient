extern BOOL Display_EnsureWindowOnTopWhenFullscreen(int method)
{
  window_handle open_behind;
 /*
  * Ensures that the window is on top of the stack.
  * Return TRUE if action performed.
  */
  window_state windowstate;
  open_behind = (window_handle)-1;

  if(displayblock == NULL)
     return(FALSE);

  if(displayblock->display_mode != display_mode_FULLSCREEN)
     return(FALSE);
     
  if(displayblock->current_window == NULL || !displayblock->window_open)
     return(FALSE);

  if(method != fullscreen_bringtofront)
     return(FALSE);

  Wimp_GetWindowState(displayblock->current_window, &windowstate);

  if(windowstate.flags.data.open == 1){

     if(Log_OpenWindowBehind(TRUE, &open_behind)){
  
        windowstate.openblock.behind = open_behind;

        Wimp_OpenWindow(&windowstate.openblock);

     }
     else{

        if(windowstate.openblock.behind != -1){

           windowstate.openblock.behind = -1;

           Wimp_OpenWindow(&windowstate.openblock);
        
        }
     }
  }
  return(TRUE);  
}

