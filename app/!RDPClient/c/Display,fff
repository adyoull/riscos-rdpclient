extern void Display_Init(void)
{
 /*
  * initialisation to be done on startup
  */
  int index;

  redraw_info_next = 0;

  for(index = 0; index < REDRAW_RECTANGLE_TOTAL; index++)
     redraw_rectangle[index].used = FALSE;

  redraw_rectangle_count = 0;

  called_display = FALSE;
  
  while((next_display_poll_time = Time_Monotonic()) == 0);

  display_mode = display_mode_WINDOW;
}

