static BOOL ModeChange(event_pollblock *event, void *reference)
{
  if(displayblock == NULL)
     return(FALSE);

  update_screenscale(displayblock);

  if(displayblock->display_mode == display_mode_FULLSCREEN){

     if(screen_size.x == ((displayblock->sprite)->size.x << screen_eig.x) &&
        screen_size.y == ((displayblock->sprite)->size.y << screen_eig.y)){

        if(displayblock->requested_modechange){

           if(!displayblock->window_open)
              open_window_fullscreen();
        }
     }
     else{

        if(displayblock->requested_modechange || displayblock->window_open){

          /*
           * Don't change mode back to original, just revert
           * to Window mode
           */
           displayblock->requested_modechange = FALSE;
           displayblock->window_open = TRUE;
           Display_SetDisplayMode(display_mode_WINDOW);
        }
     }

  }

  return(FALSE);
}

