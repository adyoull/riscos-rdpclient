extern BOOL Display_Create(int width, int height, int bpp)
{
 /*
  * Initialise display environment for supplied image type
  */
/*
  window_info windowinfo;
  wimp_box newworkarea;
*/
  int total_size, image_size, mask_size;
  window_block *windowblock;

  if(displayblock != NULL)
     Display_Destroy();

  displayblock = malloc(sizeof(display_block));

  if(displayblock == NULL)
     return(FALSE);

  displayblock->display_mode = display_mode;
  displayblock->update_palette = FALSE;
  displayblock->window = NULL;
  displayblock->fullscreen = NULL;
  displayblock->window_open = FALSE;
  displayblock->window_opened_before = FALSE;
  displayblock->input_focus = FALSE;
  displayblock->requested_modechange = FALSE;
  displayblock->sprite = NULL;
  displayblock->display_sprite = NULL;
  displayblock->screen_sprite = 0;
  displayblock->singletask = FALSE;
  displayblock->cache = NULL;
  displayblock->cache_size = 0;
  displayblock->pointer_coord.x = 0;
  displayblock->pointer_coord.y = 0;
  displayblock->pointer = NULL;
  displayblock->pixtransbuffer = NULL;
  displayblock->pixtransbuffer_size = 0;
  displayblock->pointer_pixtransbuffer = NULL;
  displayblock->pointer_pixtransbuffer_size = 0;

 /*
  * set up dummy sprite block for DSA
  */
  displayblock->screen_sprite = create_dsa_sprite(width, height, bpp);

  if(displayblock->screen_sprite == NULL){
     free(displayblock);
     displayblock = NULL;
     return(FALSE);
  }

 /*
  * create real display sprite
  */
  displayblock->display_sprite = SpriteLib_Create(width, height, bpp, (bpp == 8), FALSE);

  if(displayblock->display_sprite == NULL){
     free(displayblock->screen_sprite);
     free(displayblock);
     displayblock = NULL;
     return(FALSE);
  }

  displayblock->sprite = displayblock->display_sprite;

 /*
  * set up cache to be able to store complete image
  */
  SpriteLib_ImageMemory(&((displayblock->sprite)->size),
                         (displayblock->sprite)->bpp,
                         (displayblock->sprite)->has_palette,
                         (displayblock->sprite)->has_mask,
                         &total_size, &image_size, &mask_size);
  displayblock->cache_size = total_size;

  MemMan_Alloc((memman_ptr)&(displayblock->cache), total_size);
  if(displayblock->cache == NULL){
     free(displayblock->screen_sprite);
     SpriteLib_Destroy(displayblock->sprite);
     free(displayblock);
     displayblock = NULL;
     return(FALSE);
  }

 /*
  * create window, set size
  */
  windowblock = Template_Find("Display");
  if(windowblock != NULL){
     windowblock->workarearect.min.y = 0 - ((displayblock->sprite)->size.y * 2);
     windowblock->workarearect.max.x = (displayblock->sprite)->size.x * 2;

     windowblock->screenrect.max.x = windowblock->screenrect.min.x +
                                     windowblock->workarearect.max.x;
     windowblock->screenrect.max.y = windowblock->screenrect.min.y -
                                     windowblock->workarearect.min.y;
  } 

  displayblock->window = Window_Create("Display", template_TITLEMIN);

/*
  Window_GetInfo(displayblock->window, &windowinfo);
  newworkarea = windowinfo.block.workarearect;
  newworkarea.min.y = 0 - ((displayblock->sprite)->size.y * 2);
  newworkarea.max.x = (displayblock->sprite)->size.x * 2;
  Wimp_SetExtent(displayblock->window, &newworkarea);
*/

  windowblock = Template_Find("FullScreen");
  if(windowblock != NULL){
     windowblock->workarearect.min.y = 0 - ((displayblock->sprite)->size.y * 2);
     windowblock->workarearect.max.x = (displayblock->sprite)->size.x * 2;

     windowblock->screenrect.max.x = windowblock->screenrect.min.x +
                                     windowblock->workarearect.max.x;
     windowblock->screenrect.max.y = windowblock->screenrect.min.y -
                                     windowblock->workarearect.min.y;
  }
  
  displayblock->fullscreen = Window_Create("FullScreen", template_TITLEMIN);

  set_current_window();
  
 /*
  * plot position in window and set so that image is lined up with edges
  */
  update_screenscale(displayblock);
  displayblock->plotcoord.x = 0;
  displayblock->plotcoord.y = -((displayblock->sprite)->size.y * 2);

 /*
  * initialise pixel translation table for current screen palette
  */
  build_pixtranstable(displayblock->sprite,
                      &(displayblock->pixtranstable),
                      &(displayblock->pixtransbuffer),
                      &(displayblock->pixtransbuffer_size));

  displayblock->pointer_pixtranstable = (char *)-1;

 /*
  * install event handlers and display window
  */
  Event_Claim(event_REDRAW, displayblock->window, event_ANY, Redraw, displayblock);
  Event_Claim(event_CLOSE, displayblock->window, event_ANY, CloseWindow, displayblock);
  Event_Claim(event_OPEN, displayblock->window, event_ANY, OpenWindow, displayblock);
  Event_Claim(event_CLICK, displayblock->window, event_ANY, Click, displayblock);
  Event_Claim(event_KEY, displayblock->window, event_ANY, Key, displayblock);
  Event_Claim(event_LOSECARET, displayblock->window, event_ANY, LooseCaret, displayblock);
  Event_Claim(event_GAINCARET, displayblock->window, event_ANY, GainCaret, displayblock);
  Event_Claim(event_PTRLEAVE, displayblock->window, event_ANY, PointerLeave, displayblock);
  Event_Claim(event_PTRENTER, displayblock->window, event_ANY, PointerEnter, displayblock);

  Event_Claim(event_REDRAW, displayblock->fullscreen, event_ANY, Redraw, displayblock);
  Event_Claim(event_CLOSE, displayblock->fullscreen, event_ANY, CloseWindow, displayblock);
  Event_Claim(event_OPEN, displayblock->fullscreen, event_ANY, OpenWindow, displayblock);
  Event_Claim(event_CLICK, displayblock->fullscreen, event_ANY, Click, displayblock);
  Event_Claim(event_KEY, displayblock->fullscreen, event_ANY, Key, displayblock);
  Event_Claim(event_LOSECARET, displayblock->fullscreen, event_ANY, LooseCaret, displayblock);
  Event_Claim(event_GAINCARET, displayblock->fullscreen, event_ANY, GainCaret, displayblock);
  Event_Claim(event_PTRLEAVE, displayblock->fullscreen, event_ANY, PointerLeave, displayblock);
  Event_Claim(event_PTRENTER, displayblock->fullscreen, event_ANY, PointerEnter, displayblock);

  EventMsg_Claim(message_PALETTECHANGE, event_ANY, BuildPixTransTable, NULL);
  EventMsg_Claim(message_MODECHANGE, event_ANY, BuildPixTransTable, NULL);
  EventMsg_Claim(message_MODECHANGE, event_ANY, ModeChange, NULL);

  return(TRUE);
}

