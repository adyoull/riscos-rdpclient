extern void Display_SetCustomPalette(palette_entry *palette)
{
 /*
  * Set custom 8bit image palette colours
  */
  SpriteLib_SetCustomPalette(palette);

  SpriteLib_EnsurePalette(displayblock->display_sprite);

  if(displayblock->singletask){
     if((displayblock->display_sprite)->bpp == 8)
        ScreenMode_SetPalette(SpriteLib_GetCustomPalette());
  }
  else
     build_pixtranstable(displayblock->sprite,
                        &(displayblock->pixtranstable),
                        &(displayblock->pixtransbuffer),
                        &(displayblock->pixtransbuffer_size));
}

