extern BOOL Display_OpenWindow(void)
{
 /*
  * Open display window
  */
  BOOL success = FALSE;

//fprintf(stderr, "Called Display_OpenWindow() Show Display Window\n");

  if(displayblock != NULL){

     switch(displayblock->display_mode)
     {
       case display_mode_WINDOW:
         success = open_window();
         break;

       case display_mode_FULLSCREEN:
         success = open_fullscreen();
         break;

       case display_mode_SINGLETASK:
         success = open_singletask();
         break;
     }
     
  }
  return(success);
}

/******************************************************************************/

extern void Display_CloseWindow(void)
{
 /*
  * Close display window
  */
  if(displayblock != NULL){

     switch(displayblock->display_mode)
     {
       case display_mode_WINDOW:
         close_window();
         break;

       case display_mode_FULLSCREEN:
         close_fullscreen();
         break;

       case display_mode_SINGLETASK:
         close_singletask();
         break;
     }
  }
}

/******************************************************************************/

extern void Display_Destroy(void)
{
 /*
  * Destroy everything
  */
  if(displayblock != NULL){

     if(displayblock->window_open)
        Display_CloseWindow();

     displayblock->window_open = FALSE;
     
     if(displayblock->window != NULL){
        Window_Delete(displayblock->window);
        displayblock->window = NULL;
     }

     if(displayblock->fullscreen != NULL){
        Window_Delete(displayblock->fullscreen);
        displayblock->fullscreen = NULL;
     }

     if(displayblock->sprite != NULL){
        SpriteLib_Destroy(displayblock->sprite);
        displayblock->sprite = NULL;
     }

     if(displayblock->cache != NULL){
        MemMan_Free((memman_ptr)&(displayblock->cache));
        displayblock->cache = NULL;
     }

     /* free the dynamically-sized pixel trans tables */
     if(displayblock->pixtransbuffer != NULL){
        free(displayblock->pixtransbuffer);
        displayblock->pixtransbuffer = NULL;
        displayblock->pixtransbuffer_size = 0;
     }
     if(displayblock->pointer_pixtransbuffer != NULL){
        free(displayblock->pointer_pixtransbuffer);
        displayblock->pointer_pixtransbuffer = NULL;
        displayblock->pointer_pixtransbuffer_size = 0;
     }

     EventMsg_Release(message_PALETTECHANGE, event_ANY, BuildPixTransTable);
     EventMsg_Release(message_MODECHANGE, event_ANY, BuildPixTransTable);
     EventMsg_Release(message_MODECHANGE, event_ANY, ModeChange);

     free(displayblock);
     displayblock = NULL;

  }
}

