extern void Display_SetDisplayMode(int mode)
{
 /*
  * Set display mode
  */
  BOOL reopen = FALSE;

  if(mode == display_mode_WINDOW || mode == display_mode_FULLSCREEN ||
     mode == display_mode_SINGLETASK){

     display_mode = mode;

     if(displayblock != NULL){

        if(displayblock->window_open){
           Display_CloseWindow();
           reopen = TRUE;
        }

        displayblock->display_mode = display_mode;

        set_current_window();

        if(reopen)
           Display_OpenWindow();          
     }

     RDPClient_MenuSetDisplayMode(display_mode);
  }
}

