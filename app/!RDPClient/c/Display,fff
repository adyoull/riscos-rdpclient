extern void Display_Test(void)
{
  int index;
  unsigned int start, end;
  window_redrawblock redraw;
  BOOL more;

  while((start = Time_Monotonic()) == 0);

  for(index = 1; index <= 50; index++){

     redraw.window = displayblock->current_window;

     redraw.rect.min.x = 0 << 1;
     redraw.rect.max.x = (displayblock->sprite)->size.x << 1;
     redraw.rect.min.y = -( (displayblock->sprite)->size.y << 1);
     redraw.rect.max.y = -(0 << 1);

     Wimp_UpdateWindow(&redraw, &more);

     if(more)
        redraw_loop(&redraw, displayblock);

  }

  while((end = Time_Monotonic()) == 0);
  fprintf(stderr, "normal %g\n", (double)(end - start) / 50.);

}

