static void update_screenscale(display_block *block)
{
  Screen_CacheModeInfo();

  switch(screen_eig.x)
  {
    case 0:
      block->screenscale.multiply.x = 2;
      block->screenscale.divide.x = 1;
      break;

    case 1:
      block->screenscale.multiply.x = 1;
      block->screenscale.divide.x = 1;
      break;

    case 2:
      block->screenscale.multiply.x = 1;
      block->screenscale.divide.x = 2;
      break;

    case 3:
      block->screenscale.multiply.x = 1;
      block->screenscale.divide.x = 4;
      break;
      
  }

  switch(screen_eig.y)
  {
    case 0:
      block->screenscale.multiply.y = 2;
      block->screenscale.divide.y = 1;
      break;

    case 1:
      block->screenscale.multiply.y = 1;
      block->screenscale.divide.y = 1;
      break;

    case 2:
      block->screenscale.multiply.y = 1;
      block->screenscale.divide.y = 2;
      break;

    case 3:
      block->screenscale.multiply.y = 1;
      block->screenscale.divide.y = 4;
      break;
  }

}

/******************************************************************************/

static void redraw_display(int x, int y, int width, int height)
{
  redraw_rectangle_block new_rectangle;
  unsigned int time;
  int index;
  BOOL merged;
  BOOL added;
  unsigned int oldest_number;
  int oldest_index;
  int inner_index;
//fprintf(stderr, "Called redraw_display(x=%i, y=%i, width=%i, height=%i\n", x, y, width,height);
  if(!displayblock->window_open)
     return;

  if(displayblock->singletask)
     return;

//  update_window(x, y, width, height);

//return; /* * * * * * * * * * * * */

  

  new_rectangle.used = TRUE;
  new_rectangle.number = ++redraw_rectangle_count;
  new_rectangle.top_left.x = x;
  new_rectangle.top_left.y = y;
  new_rectangle.bottom_right.x = x + width;
  new_rectangle.bottom_right.y = y + height;
  new_rectangle.size.x = width;
  new_rectangle.size.y = height;
  new_rectangle.area = width * height;
  while((time = Time_Monotonic()) == 0);
  new_rectangle.time = time;

 /*
  * Merge new rectangle into existing rectangles
  */
  merged = FALSE;
  for(index = 0; index < REDRAW_RECTANGLE_TOTAL; index++){

     if(redraw_rectangle[index].used){

        if(merge_rectangles(&redraw_rectangle[index], &new_rectangle)){

           merged = TRUE;
           break;

        }
     }
  }

 /*
  * If did not merge, add to rectangle list if we can
  */
  if(!merged){

     added = FALSE;
     for(index = 0; index < REDRAW_RECTANGLE_TOTAL; index++){

        if(!redraw_rectangle[index].used){

           memcpy(&redraw_rectangle[index], &new_rectangle, sizeof(redraw_rectangle_block));

           added = TRUE;
           break;

        }
     }

    /*
     * If not added, flush oldest rectangle and replace with new rectangle
     */
     if(!added){

        oldest_number = UINT_MAX;
        oldest_index = -1;

        for(index = 0; index < REDRAW_RECTANGLE_TOTAL; index++){

           if(redraw_rectangle[index].used){

              if(redraw_rectangle[index].number < oldest_number){

                 oldest_number = redraw_rectangle[index].number;
                 oldest_index = index;

              }
           }
        }

        if(oldest_index >= 0){

           update_redraw_rectangle(&redraw_rectangle[oldest_index]);

           memcpy(&redraw_rectangle[oldest_index],&new_rectangle,sizeof(redraw_rectangle_block));

        }
     }
  }

 /*
  * Merge any existing rectangles with each other
  */
  for(index = 0; index < REDRAW_RECTANGLE_TOTAL; index++){

     if(redraw_rectangle[index].used){

        for(inner_index = 0; inner_index < REDRAW_RECTANGLE_TOTAL; inner_index++){

           if(inner_index != index && redraw_rectangle[inner_index].used){

              if(merge_rectangles(&redraw_rectangle[index], &redraw_rectangle[inner_index])){

                 redraw_rectangle[inner_index].used = FALSE;

              }
           }
        }
     }
  }

 /*
  * Redraw any rectangles which have expired
  */
  redraw_expired_rectangles();

}

/******************************************************************************/

static BOOL merge_rectangles(redraw_rectangle_block *existing,
                             redraw_rectangle_block *newrect)
{
 /*
  * If the 'new' rectangle is close enough and the resultant rectangle
  * is not too large, merge it into the 'existing' rectangle
  */
  BOOL merged = FALSE;
  wimp_point merged_top_left;
  wimp_point merged_bottom_right;
  wimp_point merged_size;
  int merged_area;

  if( (existing->top_left.x - newrect->bottom_right.x < MERGE_RECTANGLE_CLOSENESS) &&
      (existing->top_left.y - newrect->bottom_right.y < MERGE_RECTANGLE_CLOSENESS) &&
      (newrect->top_left.x - existing->bottom_right.x < MERGE_RECTANGLE_CLOSENESS) &&
      (newrect->top_left.y - existing->bottom_right.y < MERGE_RECTANGLE_CLOSENESS) ){

     if(newrect->top_left.x < existing->top_left.x)
        merged_top_left.x = newrect->top_left.x;
     else
        merged_top_left.x = existing->top_left.x;

     if(newrect->top_left.y < existing->top_left.y)
        merged_top_left.y = newrect->top_left.y;
     else
        merged_top_left.y = existing->top_left.y;

     if(newrect->bottom_right.x > existing->bottom_right.x)
        merged_bottom_right.x = newrect->bottom_right.x;
     else
        merged_bottom_right.x = existing->bottom_right.x;

     if(newrect->bottom_right.y > existing->bottom_right.y)
        merged_bottom_right.y = newrect->bottom_right.y;
     else
        merged_bottom_right.y = existing->bottom_right.y;


     merged_size.x = merged_bottom_right.x - merged_top_left.x;
     merged_size.y = merged_bottom_right.y - merged_top_left.y;
      
     merged_area = merged_size.x * merged_size.y;

     if(merged_area - newrect->area - existing->area < MERGE_RECTANGLE_AREA_GROWTH)
        merged = TRUE;
     else if((merged_area * 100) / (newrect->area + existing->area) <
             MERGE_RECTANGLE_GROWTH_PERCENTAGE)
        merged = TRUE;

  }

  if(merged){

     if(newrect->number < existing->number)
        existing->number = newrect->number;

     existing->top_left.x = merged_top_left.x;
     existing->top_left.y = merged_top_left.y;

     existing->bottom_right.x = merged_bottom_right.x;
     existing->bottom_right.y = merged_bottom_right.y;

     existing->size.x = merged_size.x;
     existing->size.y = merged_size.y;
     
     existing->area = merged_area;

     if(newrect->time < existing->time)
        existing->time = newrect->time;
  }

  return(merged);
}

/******************************************************************************/

static void update_redraw_rectangle(redraw_rectangle_block *rectangle)
{
 /*
  * Update screen with redraw rectangle
  */
  update_window(rectangle->top_left.x, rectangle->top_left.y,
                rectangle->size.x, rectangle->size.y);

#ifdef DISPLAY_INFO
  display_count_redraw_count++;
#endif
}

/******************************************************************************/

static void redraw_expired_rectangles(void)
{
  unsigned int time;
  int index;
  int count;
  if(displayblock->singletask)
     return;

#ifdef DISPLAY_INFO
  count = 0;
#endif

  while((time = Time_Monotonic()) == 0);

  time = time - RECTANGLE_REDRAW_FLUSH_TIME;

  for(index = 0; index < REDRAW_RECTANGLE_TOTAL; index++){

     if(redraw_rectangle[index].used){

#ifdef DISPLAY_INFO
        count++;
#endif
        if(redraw_rectangle[index].time < time){

           update_redraw_rectangle(&redraw_rectangle[index]);
           redraw_rectangle[index].used = FALSE;

        }
     }
  }

#ifdef DISPLAY_INFO
  if(count > display_count_redraw_queue_max)
     display_count_redraw_queue_max = count;
#endif     
}

/******************************************************************************/

static void redraw_overlapping_rectangle(wimp_rect *area)
{
  int index;
 /*
  * redraw any rectangles in queue which overlap with 'area'
  */
  if(displayblock->singletask)
     return;


  for(index = 0; index < REDRAW_RECTANGLE_TOTAL; index++){

     if(redraw_rectangle[index].used){

        if( (redraw_rectangle[index].top_left.x - area->max.x < 0) &&
            (redraw_rectangle[index].top_left.y - area->max.y < 0) &&
            (area->min.x - redraw_rectangle[index].bottom_right.x < 0) &&
            (area->min.y - redraw_rectangle[index].bottom_right.y < 0) ){

           update_redraw_rectangle(&redraw_rectangle[index]);
           redraw_rectangle[index].used = FALSE;
        }
     }
  }  
}

