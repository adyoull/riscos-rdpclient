extern BOOL Display_ScreenToDisplayCoords(wimp_point *screen_coord, wimp_point *display_coord)
{
  wimp_point bottom_left;
  wimp_point coord;
  BOOL in_window;
 /*
  * Converts screen coords (origin bottom left) to Display coords
  * (origin top left of Display).
  * TRUE is returned if the coords are within the visible area of the display
  */
  window_state state;
     
  in_window = TRUE;

  coord.x = screen_coord->x;
  coord.y = screen_coord->y;

  if(!displayblock->singletask){

    /*
     * calculate bottom left corner of sprite in screen coords
     */
     Wimp_GetWindowState(displayblock->current_window, &state);
     bottom_left.x = (displayblock->plotcoord.x - state.openblock.scroll.x) +
                     state.openblock.screenrect.min.x;
     bottom_left.y = (displayblock->plotcoord.y - state.openblock.scroll.y) +
                     state.openblock.screenrect.max.y;

    /*
     * clip screen coords to window's visible area
     */
     if(coord.y > state.openblock.screenrect.max.y){
        coord.y = state.openblock.screenrect.max.y;
        in_window = FALSE;
     }

     if(coord.y < state.openblock.screenrect.min.y){
        coord.y = state.openblock.screenrect.min.y;
        in_window = FALSE;
     }

     if(coord.x > state.openblock.screenrect.max.x){
        coord.x = state.openblock.screenrect.max.x;
        in_window = FALSE;
     }

     if(coord.x < state.openblock.screenrect.min.x){
        coord.x = state.openblock.screenrect.min.x;
        in_window = FALSE;
     }

    /*
     * scaled sprite coords (in screen sprite size units)
     */
     coord.x = coord.x - bottom_left.x;
     coord.y = coord.y - bottom_left.y;
  }

 /*
  * set to pixels with 0,0 top left
  */
  coord.x = coord.x >> 1;
  coord.y = ((displayblock->sprite)->size.y - 1) - (coord.y >> 1);

 /*
  * re-clip pixel coords as it is posible to still be outside the image
  */
  if(coord.x < 0){
     coord.x = 0;
     in_window = displayblock->singletask; /* if single tasking, pointer is always in window */
  }

  if(coord.x >= (displayblock->sprite)->size.x){
     coord.x = (displayblock->sprite)->size.x - 1;
     in_window = displayblock->singletask; /* if single tasking, pointer is always in window */
  }

  if(coord.y < 0){
     coord.y = 0;
     in_window = displayblock->singletask; /* if single tasking, pointer is always in window */
  }

  if(coord.y >= (displayblock->sprite)->size.y){
     coord.y = (displayblock->sprite)->size.y - 1;
     in_window = displayblock->singletask; /* if single tasking, pointer is always in window */
  }

  display_coord->x = coord.x;
  display_coord->y = coord.y;

  return(in_window);
}

/******************************************************************************/

extern void Display_DisplayToScreenCoords(wimp_point *display_coord, wimp_point *screen_coord)
{
  wimp_point bottom_left;
  wimp_point coord;
 /*
  * Converts Display coords (origin top left of Display) to screen coords
  * (origin bottom left).
  */
  window_state state;
     
  coord.x = display_coord->x;
  coord.y = display_coord->y;

 /*
  * clip pixel coords as it is posible to still be outside the image
  */
  if(coord.x < 0){
     coord.x = 0;
  }

  if(coord.x >= (displayblock->sprite)->size.x){
     coord.x = (displayblock->sprite)->size.x - 1;
  }

  if(coord.y < 0){
     coord.y = 0;
  }

  if(coord.y >= (displayblock->sprite)->size.y){
     coord.y = (displayblock->sprite)->size.y - 1;
  }


 /*
  * set to os units with 0,0 bottom left
  */
  coord.x = coord.x << 1;
  coord.y = ((displayblock->sprite)->size.y - 1) - coord.y;
  coord.y = coord.y << 1;

  if(!displayblock->singletask){

    /*
     * calculate bottom left corner of sprite in screen coords
     */
     Wimp_GetWindowState(displayblock->current_window, &state);
     bottom_left.x = (displayblock->plotcoord.x - state.openblock.scroll.x) +
                     state.openblock.screenrect.min.x;
     bottom_left.y = (displayblock->plotcoord.y - state.openblock.scroll.y) +
                     state.openblock.screenrect.max.y;

    /*
     * scaled sprite coords (in screen sprite size units)
     */
     coord.x = coord.x + bottom_left.x;
     coord.y = coord.y + bottom_left.y;
  }

  screen_coord->x = coord.x;
  screen_coord->y = coord.y;
}

