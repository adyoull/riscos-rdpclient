/******************************************************************************/

static void update_window(int x, int y, int width, int height)
{
  window_redrawblock redraw;
  BOOL more;
 /*
  * redraw a region of the window directly (not through Wimp_Poll)
  */
  if(!displayblock->window_open)
     return;

  if(displayblock->singletask)
     return;

//fprintf(stderr, "Called update_window(x=%i, y=%i, width=%i, height=%i)\n", x, y, width, height);

  redraw.window = displayblock->current_window;

  redraw.rect.min.x = x << 1;
  redraw.rect.max.x = (x + width) << 1;
  redraw.rect.min.y = -((y + height) << 1);
  redraw.rect.max.y = -(y << 1);

  Wimp_UpdateWindow(&redraw, &more);

  if(more)
     redraw_loop(&redraw, displayblock);
}

/******************************************************************************/

static void redraw_loop(window_redrawblock *redraw, display_block *block)
{
  wimp_point bottomleft;
  spritelib_block *sprite;
  wimp_point pointer_bottomleft;
  BOOL plot_pointer;
  spritelib_block *pointer_sprite;
  sprite_header *pointer_header;
  int pointer_plotaction;
 /*
  * redraw rectangles of the Display sprite and Pointer sprite in the Window
  */
  BOOL more;
  sprite_header *header;
  _kernel_swi_regs r;

  plot_pointer = FALSE;

  bottomleft.x = (block->plotcoord.x - redraw->scroll.x) + redraw->rect.min.x;
  bottomleft.y = (block->plotcoord.y - redraw->scroll.y) + redraw->rect.max.y;

  if(block->pointer != NULL){
     pointer_sprite = (block->pointer)->base_sprite;

     pointer_bottomleft.x = (block->pointer_coord.x - (block->pointer)->origin.x) << 1;
     pointer_bottomleft.x = (pointer_bottomleft.x - redraw->scroll.x) + redraw->rect.min.x;

     pointer_bottomleft.y = -(block->pointer_coord.y - (block->pointer)->origin.y +
                              pointer_sprite->size.y) << 1;
     pointer_bottomleft.y = (pointer_bottomleft.y - redraw->scroll.y) + redraw->rect.max.y;

     if((block->pointer)->plot_mask)
        pointer_plotaction = 8; /* overwrite using sprite mask */
     else
        pointer_plotaction = 3; /* xor without using the mask */
        
     plot_pointer = TRUE;
  }

  sprite = block->sprite;

  SpriteLib_EnsurePalette(sprite);

  header = (void *) ((char *)sprite->spritearea + (sprite->spritearea)->firstoffset);

  if(plot_pointer){
     pointer_header = (void *) ((char *)pointer_sprite->spritearea +
                                (pointer_sprite->spritearea)->firstoffset);
  }

  more = TRUE;

  while (more)
  {
    /*
     * plot sprite
     */
     r.r[0] = 52 + 512;
     r.r[1] = (int)sprite->spritearea;
     r.r[2] = (int)header;
     r.r[3] = bottomleft.x;
     r.r[4] = bottomleft.y;
     r.r[5] = 0;
     r.r[6] = (int)&displayblock->screenscale;
     r.r[7] = (int)displayblock->pixtranstable;

     Error_Check((os_error *)
                 _kernel_swi(SWI_XOS_Bit | SWI_OS_SpriteOp, &r, &r));

    /*
     * plot pointer
     */
     if(plot_pointer){
        r.r[0] = 52 + 512;
        r.r[1] = (int)pointer_sprite->spritearea;
        r.r[2] = (int)pointer_header;
        r.r[3] = pointer_bottomleft.x;
        r.r[4] = pointer_bottomleft.y;
        r.r[5] = pointer_plotaction;
        r.r[6] = (int)&displayblock->screenscale;
        r.r[7] = (int)displayblock->pointer_pixtranstable;

        Error_Check((os_error *)
                    _kernel_swi(SWI_XOS_Bit | SWI_OS_SpriteOp, &r, &r));

     }

     Wimp_GetRectangle(redraw, &more);

  }

}

/******************************************************************************/

static void gain_inputfocus(display_block *block)
{
  caret_block caret;
  if(displayblock->singletask)
     return;


  caret.window = displayblock->current_window;
  caret.icon = -1;
  caret.offset.x = 0;
  caret.offset.y = 0;
  caret.height = (1 << 25); /* invisible */
  caret.index = -1;

  Wimp_SetCaretPosition(&caret);

  block->input_focus = TRUE;
  
}

/******************************************************************************/

static void loose_inputfocus(display_block *block)
{
  caret_block caret;
  if(displayblock->singletask)
     return;


  caret.window = -1; /* loose caret */
  caret.icon = -1;
  caret.offset.x = 0;
  caret.offset.y = 0;
  caret.height = (1 << 25); /* invisible */
  caret.index = -1;

  Wimp_SetCaretPosition(&caret);

  block->input_focus = FALSE;

}

/******************************************************************************/

static void window_open_below_log(void)
{
  window_handle open_behind;
  window_state windowstate;

  Wimp_GetWindowState(displayblock->current_window, &windowstate);

  if(Log_OpenWindowBehind(TRUE, &open_behind)){
  
     windowstate.openblock.behind = open_behind;

     Wimp_OpenWindow(&windowstate.openblock);

  }
}

/******************************************************************************/

static void set_current_window(void)
{
  switch(displayblock->display_mode)
  {
    case display_mode_WINDOW:
      displayblock->current_window = displayblock->window;
      break;

    case display_mode_FULLSCREEN:
      displayblock->current_window = displayblock->fullscreen;      
      break;

    default:
      displayblock->current_window = displayblock->window;
      break;
  }

}

/******************************************************************************/

static BOOL open_window(void)
{
  if(displayblock->current_window != NULL){

     Mouse_SetMotionUpdateInterval(mouse_MOTION_INTERVAL_MULTITASK);

     if(displayblock->window_opened_before){
        Window_Show(displayblock->current_window, open_WHEREVER);
        window_open_below_log();
     }
     else{
        displayblock->window_opened_before = TRUE;
        Window_Show(displayblock->current_window, open_CENTERED);
        window_open_below_log();
     }

     RDPClient_PollNull();
     gain_inputfocus(displayblock);
     return(TRUE);
  }

  return(FALSE);
}

/******************************************************************************/

static void close_window(void)
{
  if(displayblock->current_window != NULL){

     loose_inputfocus(displayblock);

     displayblock->window_open = FALSE;
     
     Window_Hide(displayblock->current_window);

  }
}

/******************************************************************************/

static BOOL open_fullscreen(void)
{
  mode_select_block *wimpmode;
  
  if(displayblock->current_window != NULL){

     if(!displayblock->window_open){

        if(ScreenMode_ReadCurrent(&(displayblock->wimpmode))){

           wimpmode = &(displayblock->wimpmode);

           if(wimpmode->block.x_res == (displayblock->sprite)->size.x &&
              wimpmode->block.y_res == (displayblock->sprite)->size.y &&
              wimpmode->block.depth >= ScreenMode_BppToDepth((displayblock->sprite)->bpp)){

             /*
              * Don't need change mode as existing one is OK
              */
              displayblock->requested_modechange = FALSE;

              open_window_fullscreen();
           }
           else{
             /*
              * Try and change mode to one that matches remote screen
              * (Open window after mode change)
              */
              displayblock->requested_modechange = TRUE;

              change_mode_to_display(TRUE);
           }

        }
     }
     else
        open_window_fullscreen();

     return(TRUE);
  }

  return(FALSE);
}

/******************************************************************************/

static void open_window_fullscreen(void)
{
  int width;
  int height;
  window_state windowstate;

  if(displayblock->current_window != NULL){

     Mouse_SetMotionUpdateInterval(mouse_MOTION_INTERVAL_MULTITASK);
     
     Wimp_GetWindowState(displayblock->current_window, &windowstate);

     windowstate.openblock.behind = -1;
     
     width = windowstate.openblock.screenrect.max.x - windowstate.openblock.screenrect.min.x;
     height = windowstate.openblock.screenrect.max.y - windowstate.openblock.screenrect.min.y;

     windowstate.openblock.screenrect.min.x = 0;
     windowstate.openblock.screenrect.max.x = width;

     windowstate.openblock.screenrect.min.y = 0;
     windowstate.openblock.screenrect.max.y = height;

     Wimp_OpenWindow(&(windowstate.openblock));

     window_open_below_log();

     RDPClient_PollNull();

     gain_inputfocus(displayblock);

  }

}

/******************************************************************************/

static BOOL change_mode_to_display(BOOL wimpmode)
{
  mode_select_block mode;
  BOOL success = FALSE;

  mode.number = -1;

  mode.block.flags = 1;

  mode.block.x_res = (displayblock->sprite)->size.x;

  mode.block.y_res = (displayblock->sprite)->size.y;

  mode.block.depth = ScreenMode_BppToDepth((displayblock->sprite)->bpp);

  /* request max frame rate */
  mode.block.frame_rate = -1;

  /* request programmable palette if 8bit and not wimp mode */
  mode.block.mode_flags_number = 0;
  mode.block.mode_flags = (!wimpmode && (displayblock->sprite)->bpp == 8) ? 0x80 : 0x00;

  mode.block.colours_number = 3;
  mode.block.colours = ScreenMode_BppToColours((!wimpmode && (displayblock->sprite)->bpp == 8),
                                               (displayblock->sprite)->bpp);

  mode.block.x_eig_factor_number = 4;
  mode.block.x_eig_factor = 1;

  mode.block.y_eig_factor_number = 5;
  mode.block.y_eig_factor = 1;
  
  mode.block.terminator = -1;

  success = ScreenMode_SetCurrent(wimpmode, &mode);

  return(success);
}

/******************************************************************************/

static BOOL change_mode_to_display_verify(BOOL wimpmode, BOOL palette)
{
  mode_select_block requestedmode;
  mode_select_block actualmode;
  BOOL success = FALSE;
  BOOL palette_256 = (palette && (displayblock->sprite)->bpp == 8);

  requestedmode.number = -1;

  requestedmode.block.flags = 1;

  requestedmode.block.x_res = (displayblock->sprite)->size.x;

  requestedmode.block.y_res = (displayblock->sprite)->size.y;

  requestedmode.block.depth = ScreenMode_BppToDepth((displayblock->sprite)->bpp);

  /* request max frame rate */
  requestedmode.block.frame_rate = -1;

  /* request programmable palette if 8bit */
  requestedmode.block.mode_flags_number = 0;
  if(palette_256)
     requestedmode.block.mode_flags = 0x80;
  else
     requestedmode.block.mode_flags = 0x00;

  requestedmode.block.colours_number = 3;
  requestedmode.block.colours = ScreenMode_BppToColours(palette_256,
                                                        (displayblock->sprite)->bpp);

  requestedmode.block.x_eig_factor_number = 4;
  requestedmode.block.x_eig_factor = 1;

  requestedmode.block.y_eig_factor_number = 5;
  requestedmode.block.y_eig_factor = 1;
  
  requestedmode.block.terminator = -1;

  success = ScreenMode_SetCurrent(wimpmode, &requestedmode);

  if(success){

     success = FALSE;

     if(ScreenMode_ReadCurrent(&actualmode)){

        if(requestedmode.block.x_res == actualmode.block.x_res &&
           requestedmode.block.y_res == actualmode.block.y_res &&
           requestedmode.block.depth == actualmode.block.depth &&
           (requestedmode.block.mode_flags & 0x80) == (actualmode.block.mode_flags & 0x80) &&
           requestedmode.block.colours == actualmode.block.colours &&
           requestedmode.block.x_eig_factor == actualmode.block.x_eig_factor &&
           requestedmode.block.y_eig_factor == actualmode.block.y_eig_factor){

           success = TRUE;
        }
     }
  }

  return(success);
}

/******************************************************************************/

static void close_fullscreen(void)
{
  if(displayblock->current_window != NULL){

     loose_inputfocus(displayblock);

     displayblock->window_open = FALSE;

     Window_Hide(displayblock->current_window);

     if(displayblock->requested_modechange){

        displayblock->requested_modechange = FALSE;

       /*
        * Need to poll as Wimp does not like doing a mode change when
        * a window is being closed
        */
        RDPClient_PollNullLoop(3);

        ScreenMode_SetCurrent(TRUE, &(displayblock->wimpmode));

        RDPClient_PollNullLoop(3);

     }
  }
}

/******************************************************************************/

static BOOL open_singletask(void)
{
  BOOL success = FALSE;
  
  if(displayblock->current_window != NULL){

     if(!displayblock->window_open){

        RDPClient_PollNullLoop(3);

        if(ScreenMode_ReadCurrent(&(displayblock->wimpmode))){

           displayblock->requested_modechange = FALSE;

           if(change_mode_to_display_verify(TRUE, TRUE)){

             /*
              * Mode change was successfull
              */
              Die_SetReturnMode(&(displayblock->wimpmode));

              success = switch_to_singletask();

              if(success){
                 displayblock->window_open = TRUE;
                 displayblock->singletask = TRUE;
              }
              else
                 Die_ClearReturnMode();
           }
           else{
         
             /*
              * Mode change was not successfull, go back to original Wimp mode
              */

              ScreenMode_SetCurrent(TRUE, &(displayblock->wimpmode));

              RDPClient_PollNullLoop(3);
           }

        }
     }
  }

  return(success);
}

/******************************************************************************/

static void close_singletask(void)
{
  if(displayblock->current_window != NULL){

     if(displayblock->singletask)
        switch_from_singletask();

     displayblock->window_open = FALSE;
     displayblock->singletask = FALSE;

     Die_ClearReturnMode();
     
     ScreenMode_SetCurrent(TRUE, &(displayblock->wimpmode));

     RDPClient_PollNullLoop(3);

  }

}

/******************************************************************************/

static BOOL switch_to_singletask(void)
{
  BOOL success = FALSE;
  char *start_address;
  int line_length;
  int total_size;
  spritelib_block *display_sprite;
  spritelib_block *screen_sprite;
  
  if(ScreenMode_ReadScreenHardware(&start_address, &line_length, &total_size)){

     display_sprite = displayblock->display_sprite;
     screen_sprite = displayblock->screen_sprite;
     
     if(total_size >= display_sprite->size.y * display_sprite->linebytes){

       /*
        * set up screen parameters in sprite
        */
        screen_sprite->spritearea = (sprite_area)start_address;
        screen_sprite->image = 0;

        screen_sprite->linebytes = line_length;

       /*
        * copy whole display sprite to screen
        */
        SpriteLib_ResetClipArea(screen_sprite);

        SpriteLib_PlotSpriteToSprite(SpriteLib_GXcopy,
                                     screen_sprite, 0, 0,
                                     TRUE,
                                     display_sprite, 0, 0,
                                     display_sprite->size.x, display_sprite->size.y);

       /*
        * set up current clip region
        */
        screen_sprite->clip_origin.x = display_sprite->clip_origin.x;
        screen_sprite->clip_origin.y = display_sprite->clip_origin.y;

        screen_sprite->clip_size.x = display_sprite->clip_size.x;
        screen_sprite->clip_size.y = display_sprite->clip_size.y;

       /*
        * everything is OK so switch current output to screen
        */
        displayblock->sprite = displayblock->screen_sprite;

       /*
        * set up screen palette
        */
        if((displayblock->screen_sprite)->bpp == 8)
           ScreenMode_SetPalette(SpriteLib_GetCustomPalette());

       /*
        * set up keyboard
        */
        Keyboard_SingleTask();

       /*
        * set up hardware pointer
        */
        Pointer_SingleTask();
        Pointer_MoveHardwarePointer(displayblock->pointer_coord.x,
                                    displayblock->pointer_coord.y);
        Pointer_SetHardwarePointer(displayblock->pointer);

        Mouse_SetMotionUpdateInterval(mouse_MOTION_INTERVAL_SINGLETASK);

         
        success = TRUE;
     }
  }

  return(success);
}

/******************************************************************************/

static void switch_from_singletask(void)
{
  spritelib_block *display_sprite;
  spritelib_block *screen_sprite;

  display_sprite = displayblock->display_sprite;
  screen_sprite = displayblock->screen_sprite;

 /*
  * copy whole screen back to display sprite
  */
  SpriteLib_ResetClipArea(display_sprite);

  SpriteLib_PlotSpriteToSprite(SpriteLib_GXcopy,
                               display_sprite, 0, 0,
                               TRUE,
                               screen_sprite, 0, 0,
                               screen_sprite->size.x, screen_sprite->size.y);

 /*
  * set up current clip region
  */
  display_sprite->clip_origin.x = screen_sprite->clip_origin.x;
  display_sprite->clip_origin.y = screen_sprite->clip_origin.y;

  display_sprite->clip_size.x = screen_sprite->clip_size.x;
  display_sprite->clip_size.y = screen_sprite->clip_size.y;

 /*
  * everything is OK so switch current output back to display sprite
  */
  displayblock->sprite = displayblock->display_sprite;

  Keyboard_MultiTask();
}

/******************************************************************************/

static spritelib_block *create_dsa_sprite(int width, int height, int bpp)
{
  spritelib_block *sprite = NULL;

  sprite = malloc(sizeof(spritelib_block));

  if(sprite != NULL){

     sprite->spritearea = NULL;
     sprite->header = 0;
     sprite->palette = 0;
     sprite->image = 0;
     sprite->linebytes = 0;
     sprite->mask = 0;
     sprite->masklinebytes = 0;
     sprite->size.x = width;
     sprite->size.y = height;
     sprite->bpp = bpp;
     sprite->has_palette = FALSE;
     sprite->has_mask = FALSE;
     sprite->custom_palette_version = 0;

     SpriteLib_ResetClipArea(sprite);

  }
  
  return(sprite);
}

