extern void Display_Poll(void)
{
  unsigned int time;
 /*
  * Called frequently
  */
  if(displayblock == NULL)
     return;		/* no display yet (e.g. during connect / reconnect) */
  if(displayblock->singletask)
     return;


  while((time = Time_Monotonic()) == 0);

  if(time >= next_display_poll_time){

     next_display_poll_time = time + DISPLAY_POLL_INTERNVAL;

#ifdef DISPLAY_INFO
     display_count_poll++;
#endif

    /*
     * Redraw any rectangles which have expired
     */
     redraw_expired_rectangles();

#ifdef DISPLAY_INFO
     display_redraw_info();
#endif
  }
}

