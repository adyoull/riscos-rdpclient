extern void Display_PlotLine(int gfx_op,
                             int start_x, int start_y,
                             int finish_x, int finish_y,
                             int colour,
                             BOOL update)
{
 /*
  * Plot a single pixel wide line of colour 'colour'
  */
  int temp;

  called_display = TRUE;

  if((start_x != finish_x) && (start_y != finish_y))
     SpriteLib_PlotLineToSprite(gfx_op, displayblock->sprite, displayblock->singletask,
                                start_x, start_y,
                                finish_x, finish_y,
                                colour);

 /*
  * Ensure that start is always before finish.
  *
  * Non horizontal or vertical line must not have coords changed.
  * Horizontal and vertical lines must and also must be done for
  * the bounding box for the screen redraw.
  */
  if(start_x > finish_x){
     temp = finish_x;
     finish_x = start_x;
     start_x = temp;
  }

  if(start_y > finish_y){
     temp = finish_y;
     finish_y = start_y;
     start_y = temp;
  }
  
  if(start_x == finish_x)
     SpriteLib_PlotVerticalLineToSprite(gfx_op, displayblock->sprite,
                                        displayblock->singletask,
                                        start_x, start_y,
                                        finish_y - start_y + 1,
                                        colour);
  else if(start_y == finish_y)
     SpriteLib_PlotHorizontalLineToSprite(gfx_op, displayblock->sprite,
                                          displayblock->singletask,
                                          start_x, start_y,
                                          finish_x - start_x + 1,
                                          colour);

#ifdef DISPLAY_INFO
  display_count_plotline++;
#endif

  if(update)
     redraw_display(start_x, start_y, finish_x - start_x + 1, finish_y - start_y + 1);  
}

