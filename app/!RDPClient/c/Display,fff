extern void Display_SaveToCache(unsigned int offset,
                                int x, int y, int width, int height)
{
 /*
  * Save area of screen into display cache at offset
  */
  int pixel_size = SpriteLib_PixelSize(displayblock->sprite);
  int length = width * height * pixel_size; 
  int cache_start;

  called_display = TRUE;

#ifdef DISPLAY_INFO
  display_count_savetocache++;
#endif

  cache_start = (int)offset * pixel_size;

  if(cache_start >= displayblock->cache_size)
     cache_start = 0;

  if((cache_start + length) <= displayblock->cache_size){

     SpriteLib_PlotSpriteToFlexData(SpriteLib_GXcopy,
                                    &(displayblock->cache),
                                    cache_start, 0,  0,
                                    width, height,
                                    displayblock->sprite,
                                    x, y, width, height,
                                    displayblock->singletask);

  }
  else{
     /*
      * not enough space in cache
      */
      error("put desktop %d:%d\n", cache_start, length);
  }

}

/******************************************************************************/

extern void Display_RestoreFromCache(unsigned int offset,
                                     int x, int y, int width, int height)
{
 /*
  * Restore area of screen from display cache at offset
  */
  int pixel_size = SpriteLib_PixelSize(displayblock->sprite);
  int length = width * height * pixel_size;
  int cache_start;

  called_display = TRUE;

#ifdef DISPLAY_INFO
  display_count_restorefromcache++;
#endif

  cache_start = (int)offset * pixel_size;

  if(cache_start >= displayblock->cache_size)
     cache_start = 0;

  if((cache_start + length) <= displayblock->cache_size){

      SpriteLib_PlotFlexDataToSprite(SpriteLib_GXcopy,
                                     displayblock->sprite,
                                     x, y,
                                     displayblock->singletask,
                                     &(displayblock->cache),
                                     cache_start, 0,  0,
                                     width, height,
                                     width, height);

      redraw_display(x, y, width, height);
  }
  else{
    /*
     * offset outside cache
     */
     error("get desktop %d:%d\n", offset, length);
  }

}

