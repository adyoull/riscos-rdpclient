static BOOL BuildPixTransTable(event_pollblock *event, void *reference)
{
 /*
  * called on palette change to recalculate pixel translation table
  */
  if(displayblock == NULL)
     return(FALSE);

  if(displayblock->display_sprite != NULL)
     build_pixtranstable(displayblock->display_sprite, &(displayblock->pixtranstable),
                         &(displayblock->pixtransbuffer),
                         &(displayblock->pixtransbuffer_size));

  if(displayblock->pointer != NULL){

     if((displayblock->pointer)->base_sprite != NULL)
        build_pixtranstable((displayblock->pointer)->base_sprite,
                            &(displayblock->pointer_pixtranstable),
                            &(displayblock->pointer_pixtransbuffer),
                            &(displayblock->pointer_pixtransbuffer_size));

  }

  return(FALSE);
}

/******************************************************************************/

static void build_pixtranstable(spritelib_block *sprite,
                                char **pixtranstable, char **pixtransbuffer,
                                int *pixtransbuffer_size)
{
  int requiredsize;
  palette_entry palettebuff[300];
  int grab;
  char *buf;
 /*
  * calculates pixel translation table for current screen palette
  * code taken from PRMs Vol. 1 Page 834
  */
  sprite_header *header;
  palette_entry *sprpalette;
  palette_entry *palette;
  int q;
  _kernel_swi_regs r;


  header = (void *) ((char *)sprite->spritearea + (sprite->spritearea)->firstoffset);
  sprpalette = (void *) ((char *)header + sizeof(sprite_header));

  r.r[0] = (int) sprite->spritearea;
  r.r[1] = (int) header;
  r.r[2] = -1;
  r.r[3] = -1;
  r.r[4] = 0;
  r.r[5] = 1;
  Error_Check((os_error *)
              _kernel_swi(SWI_XOS_Bit | SWI_ColourTrans_SelectTable, &r, &r));
  requiredsize = r.r[4];

 /*
  * if required table size is 0 then table not needed
  */
  if(requiredsize == 0){
     /* no table needed */
     *pixtranstable = (char *)-1;
     return;
  }

 /*
  * the translation table size depends on the SOURCE
  * image depth (2^bpp entries), not a fixed 256 bytes. A >8bpp image plotted to
  * an 8bpp screen needs a table of up to 64K; writing it into a fixed 256-byte
  * field overran (and corrupted) the malloc heap in 8bpp screen modes. Grow the
  * buffer to the size ColourTrans actually asked for. It is freed in
  * Display_Destroy.
  */
  if(requiredsize > *pixtransbuffer_size){
     char *nb = realloc(*pixtransbuffer, requiredsize);
     if(nb == NULL){
        /* out of memory: fall back to "no table" rather than crash */
        *pixtranstable = (char *)-1;
        return;
     }
     *pixtransbuffer = nb;
     *pixtransbuffer_size = requiredsize;
  }
  buf = *pixtransbuffer;

 /*
  * if 8bit image then get image palette
  */
  if(sprite->bpp == 8){
     for(grab = 0; grab < 256; grab++){

         palettebuff[grab].value = sprpalette->value;
         sprpalette++;
         sprpalette++;
/*
         fprintf(stderr, "grey %i  red %i green %i blue %i\n",
                 grab,
                 palettebuff[grab].data.red,
                 palettebuff[grab].data.green,
                 palettebuff[grab].data.blue);
*/
      }

      palette = (palette_entry *)&palettebuff;

  }

 /*
  * calculate pixel translation table
  */
  r.r[0] = (int) sprite->spritearea;
  r.r[1] = (int) header;
  r.r[2] = -1;
  r.r[3] = -1;
  r.r[4] = (int)buf;
  r.r[5] = 1;
  Error_Check((os_error *)
              _kernel_swi(SWI_XOS_Bit | SWI_ColourTrans_SelectTable, &r, &r));
  *pixtranstable = buf;

 /*
  * check if it is needed
  */
  if(sprite->bpp == 8) {
     *pixtranstable = (char *)-1;
     for(q = 0; q < 256; q++){

         if(buf[q] != q)
            *pixtranstable = buf;
     }
  }
}

