extern void Display_PlotSprite(int gfx_op,
                               int dest_x, int dest_y,
                               spritelib_block *source_sprite,
                               int source_x, int source_y,
                               int source_width, int source_height)
{
 /*
  * Plot area of sprite from source_x, source_y to source_width, source_height
  * to display at coords dest_x, dest_y
  */
  called_display = TRUE;

/*
fprintf(stderr, "Display_PlotSprite(gfx_op=%i, dest_x=%i, dest_y=%i, source_sprite=%i, source_x=%i, source_y=%i, source_width=%i, source_height=%i\n", gfx_op, dest_x, dest_y, source_sprite, source_x, source_y, source_width, source_height);
*/

  SpriteLib_PlotSpriteToSprite(gfx_op, displayblock->sprite, dest_x, dest_y,
                               displayblock->singletask,
                               source_sprite, source_x, source_y, source_width, source_height);

