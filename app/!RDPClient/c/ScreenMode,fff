static BOOL cmd_wimpmode_block(mode_block *modeblock, BOOL vf_enabled)
{
  char command[50];
  char *colours;
  BOOL success = FALSE;
  os_error *err = NULL;
  int frame_rate = modeblock->frame_rate;

  colours = ScreenMode_DepthToColoursText(modeblock->depth);

  if(vf_enabled && frame_rate == -1){
     frame_rate = get_vf_framerate(modeblock);
  }

  if(frame_rate == -1)
     sprintf(command, "WimpMode %sX%i Y%i %c%s EX%i EY%i",
             (vf_enabled ? "V " : ""),
             modeblock->x_res, modeblock->y_res,
             ((modeblock->mode_flags & 0x80) ? 'G' : 'C'), colours,
             modeblock->x_eig_factor, modeblock->y_eig_factor);
  else
     sprintf(command, "WimpMode %sX%i Y%i %c%s EX%i EY%i F%i",
             (vf_enabled ? "V " : ""),
             modeblock->x_res, modeblock->y_res,
             ((modeblock->mode_flags & 0x80) ? 'G' : 'C'), colours,
             modeblock->x_eig_factor, modeblock->y_eig_factor,
             frame_rate);

  if((err = OS_CLI(command)) == NULL)
     success = TRUE;
  else
     error("cmd_wimpmode_block() %i:%s", err->errnum, err->errmess);

  return(success);
}

/******************************************************************************/

static int get_vf_framerate(mode_block *modeblock)
{
 /*
  * Get framerate to use for ViewFinder as it otherwise selects the lowest
  * framerate for the chosen mode
  */
  int frame_rate = -1;
  int bpp = ScreenMode_DepthToBpp(modeblock->depth);
  
  if(mode_frame_rate_select_cache.x_res == modeblock->x_res &&
     mode_frame_rate_select_cache.y_res == modeblock->y_res &&
     mode_frame_rate_select_cache.bpp == bpp &&
     mode_frame_rate_select_cache.x_eig == modeblock->x_eig_factor &&
     mode_frame_rate_select_cache.y_eig == modeblock->y_eig_factor){

     frame_rate = mode_frame_rate_select_cache.frame_rate;
  }
  else{

     frame_rate = find_vf_framerate(modeblock);

     mode_frame_rate_select_cache.x_res = modeblock->x_res;
     mode_frame_rate_select_cache.y_res = modeblock->y_res;
     mode_frame_rate_select_cache.bpp = bpp;
     mode_frame_rate_select_cache.x_eig = modeblock->x_eig_factor;
     mode_frame_rate_select_cache.y_eig = modeblock->y_eig_factor;
     mode_frame_rate_select_cache.frame_rate = frame_rate;     
  }

  return(frame_rate);
}

/******************************************************************************/

static int find_vf_framerate(mode_block *modeblock)
{
 /*
  * Find framerate to use for ViewFinder as it otherwise selects the lowest
  * framerate for the chosen mode
  */
  int frame_rate = -1;
  int current_frame_rate = -1;
  int max_frame_rate = -1;
  BOOL current_frame_rate_found = FALSE;
  mode_block *current_mode;
  char block[256];
  int blocksize = 256;
  int vf_mode_count = blocksize / sizeof(vf_mode_block);
  int vf_block_size = vf_mode_count * sizeof(vf_mode_block);
  int vf_blocks_read;
  file_handle vf_mode_file;
  vf_mode_block *vf_mode;
  
  current_mode = os_screenmode_read();

  if(current_mode != (mode_block *)-1)
     if(!((int)current_mode >= (int)0 && (int)current_mode <= (int)255))
        current_frame_rate = current_mode->frame_rate;
/*
  fprintf(stderr, "mode x %i y %i depth %i\n", modeblock->x_res, modeblock->y_res,
          modeblock->depth);

  fprintf(stderr, "current frame rate %i\n", current_frame_rate);
*/
  vf_mode_file = File_Open("Choices:ViewFinder.Modes", file_READ);

  if(vf_mode_file != NULL){

     while((vf_blocks_read =
            ((vf_block_size - File_ReadBytes(vf_mode_file, block, vf_block_size)) /
            sizeof(vf_mode_block))) > 0){

        vf_mode = (vf_mode_block *)block;

        while(vf_blocks_read > 0){

           if(vf_mode->x_res == modeblock->x_res && vf_mode->y_res == modeblock->y_res){

              if(ScreenMode_VFDepthToDepth(vf_mode->depth_flags) == modeblock->depth){

                 if(vf_mode->frame_rate == current_frame_rate)
                    current_frame_rate_found = TRUE;

                 if(vf_mode->frame_rate > max_frame_rate)
                    max_frame_rate = vf_mode->frame_rate;
              }
           }

           vf_blocks_read -= 1;
           vf_mode+= 1;
        }
     }
     File_Close(vf_mode_file);
  }

  if(current_frame_rate_found)
     frame_rate = current_frame_rate;
  else
     frame_rate = max_frame_rate;
/*
  fprintf(stderr, "max frame rate %i\n", max_frame_rate);
  fprintf(stderr, "selected frame rate %i\n", frame_rate);
*/  
  return(frame_rate);
}

