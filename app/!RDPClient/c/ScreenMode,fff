extern int ScreenMode_BppToColours(BOOL program_palette, int bpp)
{
 /*
  * Return number for colours mode variable based on bpp
  */
  int colours;

  switch(bpp)
  {
    case 1:
      colours = 1;
      break;

    case 2:
      colours = 3;
      break;

    case 4:
      colours = 15;
      break;

    case 8:
      if(program_palette)
         colours = 255;
      else
         colours = 63;
      break;

    case 15: case 16:
      colours = 65535;
      break;

    case 24: case 32:
      colours = -1;
      break;

    default:
      colours = -1;
      break;
  }

  return(colours);
}

/******************************************************************************/

extern int ScreenMode_BppToDepth(int bpp)
{
 /*
  * Return depth number for given bpp
  */
  int depth;

  switch(bpp)
  {
    case 1:
      depth = 0;
      break;

    case 2:
      depth = 1;
      break;

    case 4:
      depth = 2;
      break;

    case 8:
      depth = 3;
      break;

    case 15: case 16:
      depth = 4;
      break;

    case 24: case 32:
      depth = 5;
      break;

    default:
      depth = -1;
  }

  return(depth);
}

/******************************************************************************/

extern int ScreenMode_DepthToBpp(int depth)
{
 /*
  * Return bpp of depth number
  */
  int bpp;

  switch(depth)
  {
    case 0:
      bpp = 1;
      break;

    case 1:
      bpp = 2;
      break;

    case 2:
      bpp = 4;
      break;

    case 3:
      bpp = 8;
      break;

    case 4:
      bpp = 16;
      break;

    case 5:
      bpp = 24;
      break;

    default:
      bpp = -1;
  }

  return(bpp);
}

