extern BOOL ScreenMode_ReadCurrentResBpp(int *x_res, int *y_res, int *bpp)
{
 /*
  * Returns current screen mode's resolution and bpp.
  */
  mode_select_block modeselectblock;
  BOOL success = FALSE;

  if(ScreenMode_ReadCurrent(&modeselectblock)){

     *x_res = modeselectblock.block.x_res;
     *y_res = modeselectblock.block.y_res;
     *bpp = ScreenMode_DepthToBpp(modeselectblock.block.depth);

     if(*bpp == 16)
        *bpp = 15;
        
     success = TRUE;
  }

  return(TRUE);
}

/******************************************************************************/

extern BOOL ScreenMode_SetCurrent(BOOL wimpmode, mode_select_block *block)
{
 /*
  * Set current screen mode to that defined in block.
  * If wimpmode is TRUE, mode change is made using *WimpMode rather than
  * OS_ScreenMode
  */
  BOOL success = FALSE;
  BOOL vf_enabled = FALSE;
  BOOL vf_output_mode = FALSE;
  BOOL vf_patch_enabled = FALSE;

  Utils_ViewFinderFlags(&vf_enabled, &vf_output_mode);

  if(vf_enabled)
     vf_patch_enabled = Utils_ViewFinderModePatchLoaded();
/*
fprintf(stderr, "enabled %i  patch %i\n", vf_enabled, vf_patch_enabled);
*/
/*
  fprintf(stderr, "set current vf_enabled %i vf_output_mode %i\n", vf_enabled, vf_output_mode);
  display_mode_info(block);
*/
  if(block->number == -1){
    /*
     * use mode block
     */
     if(wimpmode || vf_enabled){
/*
        success = wimp_setmode(&(block->block));
*/
        success = cmd_wimpmode_block(&(block->block), (vf_enabled && !vf_patch_enabled));
     }
     else
        success = os_screenmode_select(&(block->block));
  }
  else{
    /*
     * use mode number
     */
     if(wimpmode){
/*
        success = wimp_setmode((mode_block *)block->number);
*/
        success = cmd_wimpmode_number(block->number);        
     }
     else
        success = os_screenmode_select((mode_block *)block->number);
  }

  return(success);
}

