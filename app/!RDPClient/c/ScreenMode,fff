extern BOOL ScreenMode_ReadScreenHardware(char **start_address, int *line_length,
                                          int *total_size)
{
 /*
  * Return information about current screen memory
  */
  BOOL success = FALSE;
  unsigned int value;

  *start_address = NULL;
  *line_length = 0;
  *total_size = 0;

  if(os_readvduvariable(148, &value)){

     *start_address = (char *)value;

     os_readmodevariable((mode_block *)-1, 6, line_length);

     os_readmodevariable((mode_block *)-1, 7, total_size);

     if(*start_address != NULL && *line_length != 0 && *total_size != 0)
        success = TRUE;
  }

  return(TRUE);
}

