static BOOL cmd_wimpmode_number(int modenumber)
{
  char command[20];
  BOOL success = FALSE;
  os_error *err = NULL;

  sprintf(command , "WimpMode %i", modenumber);

  if((err = OS_CLI(command)) == NULL)
     success = TRUE;
  else
     error("cmd_wimpmode_number() %i:%s", err->errnum, err->errmess);

  return(success);
}

/******************************************************************************/

static BOOL colourtrans_writepalette(palette_entry *palette)
{
  BOOL success;
  os_error *err;
  _kernel_swi_regs r;
  success = FALSE;
  err = NULL;

  r.r[0] = -1;
  r.r[1] = -1;
  r.r[2] = (int)palette;
  r.r[3] = 0;
  r.r[4] = 0;
  if((err = (os_error *)_kernel_swi(SWI_XOS_Bit | SWI_ColourTrans_WritePalette, &r, &r)) == NULL)
     success = TRUE;
  else
     error("colourtrans_writepalette() %i:%s", err->errnum, err->errmess);     

  return(success);
}

/******************************************************************************/

static BOOL is256entry_palette(void)
{
 /*
  * returns TRUE when current mode has 256 entry palette
  */
  int largestlogicalcolour;

  os_readmodevariable((mode_block *)-1, 3, &largestlogicalcolour);

  return(largestlogicalcolour == 255);
}

