extern BOOL ScreenMode_ReadCurrent(mode_select_block *block)
{
 /*
  * Return details of current mode in block
  */
  mode_block *current_mode;
  BOOL success = FALSE;
  int temp;

  current_mode = os_screenmode_read();

  if(current_mode != (mode_block *)-1){

     if((int)current_mode >= (int)0 && (int)current_mode <= (int)255){
       /*
        * Mode number
        */
        block->number = (int)current_mode;

        success = TRUE;

        os_readmodevariable((mode_block *)-1, 0, &(block->block.flags));

        os_readmodevariable((mode_block *)-1, 11, &temp);
        block->block.x_res = temp + 1;

        os_readmodevariable((mode_block *)-1, 12, &temp);
        block->block.y_res = temp + 1;

        os_readmodevariable((mode_block *)-1, 9, &temp);
        temp = 1 << temp;
        block->block.depth = ScreenMode_BppToDepth(temp);

        block->block.frame_rate = -1;

        block->block.mode_flags_number = 0;
        os_readmodevariable((mode_block *)-1, block->block.mode_flags_number,
                            &(block->block.mode_flags));

        block->block.colours_number = 3;
        os_readmodevariable((mode_block *)-1, block->block.colours_number,
                            &(block->block.colours));

        block->block.x_eig_factor_number = 4;
        os_readmodevariable((mode_block *)-1, block->block.x_eig_factor_number,
                            &(block->block.x_eig_factor));

        block->block.y_eig_factor_number = 5;
        os_readmodevariable((mode_block *)-1, block->block.y_eig_factor_number,
                            &(block->block.y_eig_factor));

        block->block.terminator = -1;
     }
     else{
       /*
        * Mode block
        */
        block->number = -1;

        success = TRUE;

        block->block.flags = current_mode->flags;

        block->block.x_res = current_mode->x_res;

        block->block.y_res = current_mode->y_res;

        block->block.depth = current_mode->depth;

        block->block.frame_rate = current_mode->frame_rate;

        block->block.mode_flags_number = 0;
        os_readmodevariable((mode_block *)-1, block->block.mode_flags_number,
                            &(block->block.mode_flags));

        block->block.colours_number = 3;
        os_readmodevariable((mode_block *)-1, block->block.colours_number,
                            &(block->block.colours));

        block->block.x_eig_factor_number = 4;
        os_readmodevariable((mode_block *)-1, block->block.x_eig_factor_number,
                            &(block->block.x_eig_factor));

        block->block.y_eig_factor_number = 5;
        os_readmodevariable((mode_block *)-1, block->block.y_eig_factor_number,
                            &(block->block.y_eig_factor));

        block->block.terminator = -1;
     }

  }
  return(success);
}

