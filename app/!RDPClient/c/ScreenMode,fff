static mode_block *os_screenmode_read(void)
{
  void *returnvalue;
  os_error *err;
  _kernel_swi_regs r;
  err = NULL;

  r.r[0] = 1;

  if((err = (os_error *)_kernel_swi( SWI_XOS_Bit | SWI_OS_ScreenMode, &r, &r )) == NULL)
     returnvalue = (mode_block *)r.r[1];
  else{
     returnvalue = (mode_block *)-1;
     error("os_screenmode_read() %i:%s", err->errnum, err->errmess);
  }

  return(returnvalue);
}

/******************************************************************************/

static BOOL os_screenmode_select(mode_block *block)
{
  BOOL success;
  os_error *err;
  _kernel_swi_regs r;
  success = FALSE;
  err = NULL;

  r.r[0] = 0;
  r.r[1] = (int)block;

  if((err = (os_error *)_kernel_swi( SWI_XOS_Bit | SWI_OS_ScreenMode, &r, &r )) == NULL)
     success = TRUE;
  else
     error("os_screenmode_select() %i:%s", err->errnum, err->errmess);

  return(success);
}

/******************************************************************************/

static void os_screenmode_enumerate(int skip_modes, char *buffer, int buffer_size,
                                    int *modes_returned)
{
  os_error *err;
  _kernel_swi_regs r;
  err = NULL;

  r.r[0] = 2;
  r.r[1] = 1;
  r.r[2] = skip_modes;
  r.r[3] = 0;
  r.r[4] = 0;
  r.r[5] = 0;
  r.r[6] = (int)buffer;
  r.r[7] = buffer_size;

  err = (os_error *)_kernel_swi( SWI_XOS_Bit | SWI_OS_ScreenMode, &r, &r );

  if(err != NULL)
     error("os_screenmode_enumerate() %i:%s", err->errnum, err->errmess);

  *modes_returned = -r.r[2];
}

/******************************************************************************/

static void os_readmodevariable(mode_block *modeblock, int variablenumber, int *value)
{
  os_error *err;
  _kernel_swi_regs r;
  err = NULL;

  r.r[0] = (int)modeblock;
  r.r[1] = variablenumber;

  err = (os_error *)_kernel_swi( SWI_XOS_Bit | SWI_OS_ReadModeVariable, &r, &r );

  if(err != NULL)
     error("os_readmodevariable() %i:%s", err->errnum, err->errmess);
     
  *value = r.r[2];

}

/******************************************************************************/

static BOOL os_readvduvariable(int variablenumber, unsigned int *value)
{
  unsigned int block[2];
  BOOL success;
  os_error *err;
  _kernel_swi_regs r;
  err = NULL;

  block[0] = (unsigned int)variablenumber;
  block[1] = -1;

  r.r[0] = (int)&block;
  r.r[1] = (int)&block;

  if((err = (os_error *)_kernel_swi( SWI_XOS_Bit | SWI_OS_ReadVDUVariables, &r, &r )) == NULL){

     *value = block[0];

     success = TRUE;

  }
  else
     error("os_readvduvariable() %i:%s", err->errnum, err->errmess);

  return(success);
}

