extern void ScreenMode_Validate(int query_x_res, int query_y_res, int query_bpp,
                                int query_x_eig, int query_y_eig,
                                BOOL *valid_res, BOOL *valid_bpp)
{
 /*
  * Checks available screenmodes and sets *valid_res to TRUE if the resolution can be used
  * and *valid_bpp if both the resolution and the bpp are available.
  */
  char block[256];
  int blocksize = 256;
  modedef_block *current_mode;
  modelookup_block modeblock;
  int x_eig, y_eig;
  int number_modes;
  int modes_so_far;
  int current_mode_number;
  int query_depth;
  BOOL finished;
  BOOL vf_enabled = FALSE;
  BOOL vf_output_mode = FALSE;
  int vf_mode_count = blocksize / sizeof(vf_mode_block);
  int vf_block_size = vf_mode_count * sizeof(vf_mode_block);
  int vf_blocks_read;
  file_handle vf_mode_file;
  vf_mode_block *vf_mode;
/*
  fprintf(stderr, "ScreenMode_Validate(query_x_res=%i, query_y_res=%i, query_bpp=%i, query_x_eig=%i, query_y_eig=%i)\n", query_x_res, query_y_res, query_bpp, query_x_eig, query_y_eig);
*/
  if(screen_mode_validation){
    *valid_res = FALSE;
    *valid_bpp = FALSE;
  }
  else{
    *valid_res = TRUE;
    *valid_bpp = TRUE;
    return;
  }

  if(mode_validate_cache.x_res == query_x_res && mode_validate_cache.y_res == query_y_res &&
     mode_validate_cache.bpp == query_bpp && mode_validate_cache.x_eig == query_x_eig &&
     mode_validate_cache.y_eig == query_y_eig){

     *valid_res = mode_validate_cache.valid_res;
     *valid_bpp = mode_validate_cache.valid_bpp;
     return;
  }

  query_depth = ScreenMode_BppToDepth(query_bpp);

  finished = FALSE;

  modeblock.terminator = -1;

  os_screenmode_enumerate(0, block, blocksize, &number_modes);
/*
  fprintf(stderr, "returned %i modes\n", number_modes);
*/
  current_mode = (modedef_block *)block;
  modes_so_far = number_modes;

  while(number_modes != 0 && !finished){

     current_mode_number = 1;

     while(current_mode_number <= number_modes && !finished){

        modeblock.flags = current_mode->flags;
        modeblock.x_res = current_mode->x_res;
        modeblock.y_res = current_mode->y_res;
        modeblock.depth = current_mode->depth;
        modeblock.frame_rate = current_mode->frame_rate;
        
        os_readmodevariable((mode_block *)&modeblock, 4, &x_eig);
        os_readmodevariable((mode_block *)&modeblock, 5, &y_eig);
/*
        fprintf(stderr, "x %i  y %i  depth %i  bpp %i  frame %i  x eig %i  y eig %i\n",
                current_mode->x_res, current_mode->y_res, current_mode->depth,
                ScreenMode_DepthToBpp(current_mode->depth), current_mode->frame_rate,
                x_eig, y_eig);
*/
        if(x_eig == query_x_eig && y_eig == query_y_eig){

           if(current_mode->x_res == query_x_res && current_mode->y_res == query_y_res){

              *valid_res = TRUE;

              if(current_mode->depth == query_depth){

                 *valid_bpp = TRUE;

                 finished = TRUE;

              }

           }

        }

        current_mode = (modedef_block *)(((char *)current_mode) + current_mode->size);

        current_mode_number++;
     }

     os_screenmode_enumerate(modes_so_far, block, blocksize, &number_modes);
/*
     fprintf(stderr, "returned %i modes\n", number_modes);
*/
     current_mode = (modedef_block *)block;
     modes_so_far = modes_so_far + number_modes;

  }

  if(!finished){
     Utils_ViewFinderFlags(&vf_enabled, &vf_output_mode);

     if(vf_enabled){

        vf_mode_file = File_Open("Choices:ViewFinder.Modes", file_READ);

        if(vf_mode_file != NULL){
/*
           fprintf(stderr, "reading ViewFinder Modes\n");
*/
           while((vf_blocks_read =
                  ((vf_block_size - File_ReadBytes(vf_mode_file, block, vf_block_size)) /
                  sizeof(vf_mode_block))) > 0 &&
                  !finished){
/*
              fprintf(stderr, "returned %i modes in chunk\n", vf_blocks_read);
*/
              vf_mode = (vf_mode_block *)block;

              while(vf_blocks_read > 0){
/*
                 fprintf(stderr, "x %i  y %i  depth %i  bpp %i  frame %i\n",
                         vf_mode->x_res, vf_mode->y_res,
                         ScreenMode_VFDepthToDepth(vf_mode->depth_flags),
                         ScreenMode_VFDepthToBpp(vf_mode->depth_flags), vf_mode->frame_rate);
*/
                 if(vf_mode->x_res == query_x_res && vf_mode->y_res == query_y_res){

                    *valid_res = TRUE;

                    if(ScreenMode_VFDepthToDepth(vf_mode->depth_flags) == query_depth){

                       *valid_bpp = TRUE;

                       finished = TRUE;
                    }
                 }

                 vf_blocks_read -= 1;
                 vf_mode+= 1;
              }
           }
           File_Close(vf_mode_file);
        }
     }
  }

  mode_validate_cache.x_res = query_x_res;
  mode_validate_cache.y_res = query_y_res;
  mode_validate_cache.bpp = query_bpp;
  mode_validate_cache.x_eig = query_x_eig;
  mode_validate_cache.y_eig = query_y_eig;
  mode_validate_cache.valid_res = *valid_res;
  mode_validate_cache.valid_bpp = *valid_bpp;

/*
  fprintf(stderr, "return res %i  bpp %i\n", *valid_res, *valid_bpp);
*/
}

