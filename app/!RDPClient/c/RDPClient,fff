extern void RDPClient_MenuSetDisplayMode(int display_mode)
{
 /*
  * Set selected display mode in iconbar menu
  */
  int window_ticked, window_shaded;
  int fullwindow_ticked, fullwindow_shaded;
  int fullscreen_ticked, fullscreen_shaded;

  Menu_GetFlags(mainmenu, mainmenu_WINDOW, &window_ticked, &window_shaded);
  Menu_GetFlags(mainmenu, mainmenu_FULLWINDOW, &fullwindow_ticked, &fullwindow_shaded);
  Menu_GetFlags(mainmenu, mainmenu_FULLSCREEN, &fullscreen_ticked, &fullscreen_shaded);

  switch(display_mode)
  {
    case display_mode_WINDOW:
      window_ticked = 1;
      fullwindow_ticked = 0;
      fullscreen_ticked = 0;
      break;

    case display_mode_FULLSCREEN:
      window_ticked = 0;
      fullwindow_ticked = 1;
      fullscreen_ticked = 0;
      break;

    case display_mode_SINGLETASK:
      window_ticked = 0;
      fullwindow_ticked = 0;
      fullscreen_ticked = 1;
      break;
  }

  Menu_SetFlags(mainmenu, mainmenu_WINDOW, window_ticked, window_shaded);
  Menu_SetFlags(mainmenu, mainmenu_FULLWINDOW, fullwindow_ticked, fullwindow_shaded);
  Menu_SetFlags(mainmenu, mainmenu_FULLSCREEN, fullscreen_ticked, fullscreen_shaded);

}

