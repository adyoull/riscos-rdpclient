extern void RDPClient_IconBarSetText(char *newtext)
{
 /*
  * Update text on IconBar Icon
  */
  strncpy(rdpclient_baricon_text, newtext, baricon_TEXT_SIZE);
  rdpclient_baricon_text[baricon_TEXT_SIZE-1] = '\0';

  /*Wimp_SetIconState(window_ICONBAR, bariconhandle, 0, 0);*/

  Event_Release(event_CLICK, -2, bariconhandle, Click_baricon, NULL);

  Wimp_DeleteIcon(window_ICONBAR, bariconhandle);

  bariconhandle = Utils_BarIconText(rdpclient_baricon_validation, rdpclient_baricon_text,
                                    baricon_TEXT_SIZE, iconbar_RIGHT);

  Event_Claim(event_CLICK, -2, bariconhandle, Click_baricon, NULL);
}

/******************************************************************************/

extern void RDPClient_IconBarSetState(BOOL connected)
{
 /*
  * Update sprite on IconBar Icon to reflect connected state
  */

  rdpclient_connected = connected;

  Wimp_SetIconState(-2, bariconhandle, icon_NEEDSHELP, icon_NEEDSHELP);

  if(connected)
     strcpy(rdpclient_baricon_validation, iconbaricon_CONNECTED);
  else
     strcpy(rdpclient_baricon_validation, iconbaricon_NOTCONNECTED);

  Wimp_SetIconState(-2, bariconhandle, 0, icon_NEEDSHELP);


  set_menu_shade(!connected);
}

