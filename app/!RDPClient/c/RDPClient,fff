static BOOL Save_FileSaver(char *filename, void *ref)
{
  int save_type = (int)ref;
  BOOL success = FALSE;

  switch(save_type)
  {
    case save_type_SCREEN:
      success = Display_ScreenSave(filename);
      break;

    case save_type_LOG:
      success = Log_Save(filename);
      break;
  }

  return(success);
}

