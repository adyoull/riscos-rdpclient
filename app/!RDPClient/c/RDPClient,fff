static void build_startupcommand(void)
{
 /*
  * build startup command for DesktopBoot file from resource pathname
  */
  char resourcepath[100];
  _kernel_swi_regs r;

  strcpy(resourcepath, "/");
  strncat(resourcepath, resource_pathname, 38);

 /*
  * remove "." from end of path
  */
  resourcepath[strlen(resourcepath) - 1] = 0;

  r.r[0] = (int) resourcepath;
  r.r[1] = (int) startup_command;
  r.r[2] = 256;
  _kernel_swi( SWI_XOS_Bit | SWI_OS_GSTrans , &r, &r );

}

/******************************************************************************/

static BOOL save_desktop(event_pollblock *event, void *reference)
{
 /*
  * save startup command to DesktopBoot file
  */
  file_handle channel;
  BOOL error;
  message_block message;

  channel = (file_handle) event->data.message.data.words[0];

  error = Error_Check(File_WriteBytes(channel, startup_command, strlen(startup_command)));

  if(!error){
     if(Error_Check(File_WriteByte(channel, '\n')))
        error = TRUE;
  }

  if(error){ /* acknowledge message, never works though.... strange!! */

     message.header.yourref = message.header.myref;
     Wimp_SendMessage(event_USERMESSAGEACK, &message, message.header.sender, NULL);
     
  } 

  return(TRUE);
}

/******************************************************************************/

static void update_underline_icon_size(window_handle window,
                                       icon_handle texticon, icon_handle underlineicon,
                                       BOOL resize_left)
{
  icon_createblock icreate;
  int length;
  icon_handle newunderlineicon;

  icreate.window = window;
  Wimp_GetIconState(window, underlineicon, &icreate.icondata);
  Wimp_DeleteIcon(window, underlineicon);

  length = Utils_WimpTextLength(Icon_GetTextPtr(window, texticon));

  if(length < 4)
     length = 4;

  if(resize_left){
     length += 4;
     icreate.icondata.workarearect.min.x = icreate.icondata.workarearect.max.x - length;
  }
  else{
     /*length += 2;*/
     icreate.icondata.workarearect.max.x = icreate.icondata.workarearect.min.x + length;
  }

  Wimp_CreateIcon(&icreate, &newunderlineicon);
  
}

/******************************************************************************/

static void validate_screen_modes(void)
{
  BOOL valid_res;
  BOOL valid_bpp;
  int fullwindow_ticked, fullwindow_shaded;
  int fullscreen_ticked, fullscreen_shaded;

  if(rdpclient_connected){

     Display_Validate(&valid_res, &valid_bpp);

     Menu_GetFlags(mainmenu, mainmenu_FULLWINDOW, &fullwindow_ticked, &fullwindow_shaded);
     Menu_GetFlags(mainmenu, mainmenu_FULLSCREEN, &fullscreen_ticked, &fullscreen_shaded);

     fullwindow_shaded = (!valid_res ? 1 : 0);

     fullscreen_shaded = (!valid_bpp ? 1 : 0);
  
     Menu_SetFlags(mainmenu, mainmenu_FULLWINDOW, fullwindow_ticked, fullwindow_shaded);
     Menu_SetFlags(mainmenu, mainmenu_FULLSCREEN, fullscreen_ticked, fullscreen_shaded);

  }

}

/******************************************************************************/

static void atexit_handler(void)
{
 /*
  * close Clipboard Store if we are the last RDPClient quitting
  */
  message_block block;
  task_handle taskhandle;

  if(!Utils_IsTaskRunning(event_taskname, event_taskhandle)){

     taskhandle = Utils_TaskHandleFromName(clipboardstore_TASKNAME, 0);

     if(taskhandle != 0){

        block.header.size = sizeof(message_header);
        block.header.yourref = 0;
        block.header.action = message_QUIT;
        Wimp_SendMessage(event_USERMESSAGE, &block, taskhandle, 0);

     }
  }
}
