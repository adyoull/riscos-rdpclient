static BOOL Click_proginfo(event_pollblock *event, void *reference)
{
 /*
  * called when a mouse click on the Program Info window is made
  */
  char url_text[100];
  BOOL launch;
  dialog2_block *dialog2 = (dialog2_block *)reference;

  launch = FALSE;

  switch(event->data.mouse.icon)
  {
    case icon_RDPCLIENTWEBSITE:
      Msgs_Lookup("info.rdpclurl", url_text, 90);
      launch = TRUE;
      break;

    case icon_RDESKTOPWEBSITE:
      Msgs_Lookup("info.rdeskurl", url_text, 90);
      launch = TRUE;
      break;
  }

  if(launch){
     Url_Launch(url_text, NULL, NULL);
     if(!event->data.mouse.button.data.adjust)
        Dialog2_CloseDialog(dialog2);
  }

  return(TRUE);
}

/******************************************************************************
 *                           menu choice handlers                             *
 ******************************************************************************/

static BOOL MenuChoice_mainmenu(event_pollblock *event, void *reference)
{
 /*
  * called when menu selection of the iconbar menu is made
  */
  mouse_block ptr;

  if(menu_currentopen != mainmenu){
     /* Only respond to the mainmenu  */
     return(FALSE);
  }

  switch(event->data.selection[0])
  {
    case mainmenu_WINDOW:
      Display_SetDisplayMode(display_mode_WINDOW);
      break;

    case mainmenu_FULLWINDOW:
      Display_SetDisplayMode(display_mode_FULLSCREEN);
      break;

    case mainmenu_FULLSCREEN:
      Display_SetDisplayMode(display_mode_SINGLETASK);
      break;

    case mainmenu_STATUS:
      Status_Open();
      break;

    case mainmenu_VIEWLOG:
      Log_OpenWindow();
      break;

   /*
    * (C) 2026 Andrew Youll -- Scroll settings submenu.
    */
    case mainmenu_SCROLL:
      switch(event->data.selection[1])
      {
        case scrollmenu_INVERT:
          Mouse_SetWheelInvert(!Mouse_GetWheelInvert());
          Menu_SetFlags(scrollmenu, scrollmenu_INVERT,
                        (Mouse_GetWheelInvert() ? 1 : 0), 0);
          break;

        case scrollmenu_SLOWER:
          Mouse_WheelSpeedSlower();
          break;

        case scrollmenu_FASTER:
          Mouse_WheelSpeedFaster();
          break;
      }
      break;

    case mainmenu_QUIT:
      rdpclient_quit = TRUE;
      quit_by_menu = TRUE;
      break;
  }

  Wimp_GetPointerInfo(&ptr);               /* If ADJUST was used to select, */
  if (ptr.button.data.adjust)              /* then we keep the menu open.   */
    Menu_ShowLast();

  return(TRUE);
}

/******************************************************************************
 *                                    main()                                  *
 ******************************************************************************/

int main(int argc, char *argv[])
{
  char          appname[100];
  unsigned int  polltime;
/*  event_pollmask event_nonullmask; */
  event_pollblock event_fakenull;

  quit_by_menu = FALSE;

 /* 
  * resources in <RDPClient$Dir>
  */
  Resource_Initialise("RDPClient");

 /*
  * create startup command for Desktop Boot file
  */
  build_startupcommand();

 /*
  * load messages file and look up application name
  */
  Msgs_LoadFile("messages");
  Msgs_Lookup("app.name", appname, 64);

 /*
  * initialise event and messages systems
  */
  Event_Initialise(appname);
  EventMsg_Initialise();

  Debug_Initialise();

 /*
  * initialise shifting heap memory manager
  */
  /* this is defered until the options have been read */

 /*
  * store current screen description and install event hander to keep it updated
  */
  Screen_CacheModeInfo();
  EventMsg_Claim(message_MODECHANGE, event_ANY, Handler_MyModeChange, NULL);

 /*
  * install default event handlers
  */
  Event_Claim(event_REDRAW, event_ANY, event_ANY, Handler_NullRedraw, NULL);
  Event_Claim(event_OPEN, event_ANY, event_ANY, Handler_OpenWindow, NULL);

 /*
  * install savedesktop file message handler to insert startup command into
  * Desktop Boot file
  */
  EventMsg_Claim(message_SAVEDESK, event_ANY, save_desktop, NULL);

 /*
  * load window definitions
  */
  setup_templates();

 /*
  * event handler to close windows and beep if I have messed the code up
  */
  Event_Claim(event_CLOSE, event_ANY, event_ANY, CloseWindow, NULL);

 /*
  * event handler to set rdpclient_quit to TRUE when program receives quit message
  */
  EventMsg_Claim(message_QUIT, event_ANY, Handler_Quit, NULL);

 /*
  * build menus
  */
  setup_menus();

 /*
  * initialise the other files
  */
  Choices_Init();
  Utils_Init();
  Net_Init();
  SpriteLib_Init();
  ScreenMode_Init();
  Display_Init();
  UI_Init();
  Keyboard_Init();
  Mouse_Init();
  Pointer_Init();
  Status_Init();
  RDesktop_Init();
  MemMan_Init();
  Sound_Init();
  Log_Init();
  CacheIO_Init();
  Clipboard_Init();
  
  setup_save_window();

  atexit(atexit_handler);

 /*
  * check to see if we were started by double-clicking on a file and so load that file
  */
/*
  if(!rdpclient_quit)
     LoadSave_CheckStartupLoad(argc, argv);
*/

 /*
  * Need to run this after intialising flex() otherwise memory is removed
  * before it gets accessed!
  */
  /*
  Die_Init();
  */


 /*
  * start up rdesktop
  * returns when finished
  */
  RDesktop_Main(argc, argv);

 /*
  * Gets here when finished
  */
  if(rdpclient_quit && !quit_by_menu){

     if(Log_WindowOpen()){

        rdpclient_quit = FALSE;

        Log_SetQuitOnClose(TRUE);

     }

  }
        
  polltime = Time_Monotonic() + idletime;

  event_fakenull.type = event_NULL;

  /*  Main event handling loop.
   */
  while (!rdpclient_quit){

    Wimp_Poll(event_mask, &event_lastevent);

/*  Wimp_PollIdle(event_mask, &event_lastevent, polltime); */

/*
    if(event_lastevent.type == event_NULL)
       Sound_SysBeep();
*/

    Event_Process(&event_lastevent);

    MemMan_PollMemoryManagement();

    Clipboard_Poll();
    
    polltime = Time_Monotonic() + idletime;

  }

  Template_ClearAll();

  Sound_Closedown();

  return(0);
}

