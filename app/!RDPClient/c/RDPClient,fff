static void setup_menus(void)
{
 /*
  * build iconbar menu
  */
  char menudescription[300];
  char menutitle[40];

  Msgs_Lookup("title.main", menutitle, 15);

  Msgs_Lookup("menu.main", menudescription, 260);
  mainmenu  = Menu_New(menutitle, menudescription);

 /*
  * (C) 2026 Andrew Youll -- build the Scroll settings submenu in code and
  * attach it to the ">Scroll" entry of the iconbar menu. "Invert" toggles the
  * scroll direction; "Slower"/"Faster" step the scroll speed.
  */
  scrollmenu = Menu_New("Scroll", "Invert|Slower,Faster");
  if(scrollmenu != NULL){
     Menu_AddSubMenu(mainmenu, mainmenu_SCROLL, scrollmenu);
     Menu_SetFlags(scrollmenu, scrollmenu_INVERT,
                   (Mouse_GetWheelInvert() ? 1 : 0), 0);
  }

  Menu_Warn(mainmenu, event_ANY, TRUE, Menuwarn_mainmenu, NULL);

  dialog2_proginfo = Dialog2_CreateDialogBlock("ProgInfo", 42, 42, Popup_proginfo, NULL, NULL);

  Event_Claim(event_MENU,  event_ANY, event_ANY, MenuChoice_mainmenu, NULL);

  set_menu_shade(TRUE);
}

/******************************************************************************/

static void setup_templates(void)
{
 /*
  * load window and icon definition files
  * install icon on icon bar
  */
  char spritefile[100];

  Template_Initialise();
  /* Template_UseOutlineFonts(); */

  threedlook = TRUE; /* only 3d now */
  Template_LoadFile("Templates");

  strncpy(spritefile, resource_pathname, 39);
  if(screen_eig.y == screen_eig.x)
     strcat(spritefile, "Sprites22");
  else
     strcat(spritefile, "Sprites");
  usericonsprites = Sprite_LoadFile(spritefile);

  rdpclient_baricon_validation = malloc(baricon_VALIDATION_SIZE);
  if(rdpclient_baricon_validation == '\0')
    Error_OutOfMemory(TRUE, "IconBar Icon");

  rdpclient_baricon_text = malloc(baricon_TEXT_SIZE);
  if(rdpclient_baricon_text == '\0'){
    free(rdpclient_baricon_validation);
    Error_OutOfMemory(TRUE, "IconBar Icon");
  }

  strcpy(rdpclient_baricon_validation, iconbaricon_NOTCONNECTED);
  strcpy(rdpclient_baricon_text, "-");

  rdpclient_connected = FALSE;

  bariconhandle = Utils_BarIconText(rdpclient_baricon_validation, rdpclient_baricon_text,
                                    baricon_TEXT_SIZE, iconbar_RIGHT);

  Template_UseSpriteArea(usericonsprites);

  Event_Claim(event_CLICK, -2, bariconhandle, Click_baricon, NULL);
}

/******************************************************************************/

static void setup_save_window(void)
{
 /*
  * setup save window
  */
  int save_message_list[] = {message_DATASAVE, message_DATASAVEACK, message_DATALOAD,
                             message_DATALOADACK, message_RAMFETCH, message_RAMTRANSMIT,
                             0};

  save_window = Window_Create("Save", template_TITLEMIN);

  saveblock = Save_InitSaveWindowHandler(save_window, TRUE, TRUE, FALSE,
                                         icon_SAVE_ICON, icon_SAVE_OK, icon_SAVE_CANCEL,
                                         icon_SAVE_FILENAME, Save_FileSaver, NULL, NULL,
                                         0, filetype_SPRITE, NULL);

 /*
  * Make sure that the Save library receives the messages
  */
  Wimp_AddMessages(save_message_list);
}

