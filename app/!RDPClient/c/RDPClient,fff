/******************************************************************************/

static BOOL Menuwarn_mainmenu(event_pollblock *event, void *reference)
{
 /*
  * called to display "about this program" window or "save" window
  */

  if(menu_currentopen != mainmenu)
     return(FALSE);

  if(event->data.message.data.menuwarn.selection[0] == mainmenu_INFO){
     Dialog2_OpenDialogMenuLeaf(event, dialog2_proginfo);
     return(TRUE);
  }

  if(event->data.message.data.menuwarn.selection[0] == mainmenu_SAVESCREEN){
     if(save_window != NULL){
        Popup_save();
        Wimp_CreateSubMenu((menu_ptr)save_window,
                           event->data.message.data.menuwarn.openpos.x,
                           event->data.message.data.menuwarn.openpos.y);
        return(TRUE);
     }
     else
        return(FALSE);
  }

 /*
  * (C) 2026 Andrew Youll -- let DeskLib open the code-attached Scroll submenu
  * itself (do not claim its submenu-warning).
  */
  if(event->data.message.data.menuwarn.selection[0] == mainmenu_SCROLL)
     return(FALSE);

  return(TRUE);
}

