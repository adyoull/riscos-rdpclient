extern event_type RDPClient_PollNull(void)
{
 /*
  * Call WimpPoll and return immediately
  */
  event_pollmask event_nonullmask;

  event_nonullmask.value = event_mask.value & 0xFFFFFFFE;

  Wimp_PollIdle(event_nonullmask, &event_lastevent, Time_Monotonic());

  Event_Process(&event_lastevent);

  MemMan_PollMemoryManagement();

  Clipboard_Poll();
  
  return(event_lastevent.type);
}

/******************************************************************************/

extern event_type RDPClient_PollNullLoop(int null_polls)
{
 /*
  * Call WimpPoll and return after null_polls number of NULL events
  */
  int index = null_polls;
  event_type event;

  while(index > 0){

     event = RDPClient_PollNull();

     if(event == event_NULL)
        index--;
  }

  return(event);
}

