static void Popup_proginfo(dialog2_block *dialog2)
{
 /*
  * called when "about this program" window is displayed to set the correct
  * version text
  */
  char version[100];

  Msgs_Lookup("info.version", version, 90);
  Icon_SetText(dialog2->window, icon_PROGVERSION, version);

  Msgs_Lookup("info.rversion", version, 90);
  Icon_SetText(dialog2->window, icon_RDESKTOPVERSION, version);

  update_underline_icon_size(dialog2->window,
                             icon_RDPCLIENTWEBSITE, icon_RDPCLIENTUNDERLINE, FALSE);
  update_underline_icon_size(dialog2->window,
                             icon_RDESKTOPWEBSITE, icon_RDESKTOPUNDERLINE, TRUE);

  Event_Claim(event_CLICK, dialog2->window, event_ANY, Click_proginfo, dialog2);
}

