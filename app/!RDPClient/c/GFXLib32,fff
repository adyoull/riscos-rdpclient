extern void GFXLib_PlotDataToSprite_32_Copy(int source_linebytes,
                                            int dest_linebytes,
                                            int plot_length,
                                            int plot_lines,
                                            unsigned char **source_area,
                                            int source_start,
                                            unsigned char **dest_area,
                                            int dest_start)
{
  unsigned char *source_ptr = (*source_area) + source_start;
  unsigned char *source_ptr2 = source_ptr;
  unsigned char *dest_ptr = (*dest_area) + dest_start;
  unsigned char *dest_ptr2 = dest_ptr;
  int y_counter = plot_lines;
  int x_counter;
  unsigned int pixel;

  while(y_counter > 0){

     x_counter = plot_length;

     while(x_counter > 0){

       /* (C) 2026 Andrew Youll -- assemble the source pixel from individual
          bytes rather than one word read, so we never perform an unaligned
          load (which faults when CPU alignment checking is on -- the RISC OS
          default on ARMv7). Dest is word-aligned sprite memory. Source bytes
          are B,G,R,(A); output is RISC OS &00BbGgRr order, as before. */
       pixel = ((unsigned int)source_ptr[0] << 16) |
               ((unsigned int)source_ptr[1] << 8)  |
                (unsigned int)source_ptr[2];

       *((unsigned int *)(dest_ptr)) = pixel;

       source_ptr += 4;
       dest_ptr += 4;

       x_counter--;

     }

     source_ptr2 += source_linebytes;
     source_ptr = source_ptr2;
        
     dest_ptr2 += dest_linebytes;
     dest_ptr = dest_ptr2;

     y_counter--;

  }

}

/******************************************************************************/

extern void GFXLib_PlotDataToSprite_FlipVertical_32_Copy(int source_linebytes,
                                                         int dest_linebytes,
                                                         int plot_length,
                                                         int plot_lines,
                                                         unsigned char **source_area,
                                                         int source_start,
                                                         unsigned char **dest_area,
                                                         int dest_start)
{
  unsigned char *source_ptr = (*source_area) + source_start +
                              ((plot_lines - 1) * source_linebytes);
  unsigned char *source_ptr2 = source_ptr;
  unsigned char *dest_ptr = (*dest_area) + dest_start;
  unsigned char *dest_ptr2 = dest_ptr;
  int y_counter = plot_lines;
  int x_counter;
  unsigned int pixel;

  while(y_counter > 0){

     x_counter = plot_length;

     while(x_counter > 0){

       /* (C) 2026 Andrew Youll -- byte-assemble to avoid an unaligned load
          (see GFXLib_PlotDataToSprite_32_Copy above). */
       pixel = ((unsigned int)source_ptr[0] << 16) |
               ((unsigned int)source_ptr[1] << 8)  |
                (unsigned int)source_ptr[2];

       *((unsigned int *)(dest_ptr)) = pixel;

       source_ptr += 4;
       dest_ptr += 4;

       x_counter--;

     }

     source_ptr2 -= source_linebytes;
     source_ptr = source_ptr2;
        
     dest_ptr2 += dest_linebytes;
     dest_ptr = dest_ptr2;

     y_counter--;

  }

}
