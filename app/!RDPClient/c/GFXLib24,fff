extern void GFXLib_PlotRectangleToSprite_24_Invert(int linebytes,
                                                   int plot_length,
                                                   int plot_lines,
                                                   unsigned char **sprite_area,
                                                   int start)
{
  unsigned char *image_ptr = (*sprite_area) + start;
  unsigned char *image_ptr2 = image_ptr;
  int y_counter = plot_lines;
  int x_counter;

  while(y_counter > 0){

     x_counter = plot_length;

     while(x_counter > 0){

        *((unsigned int *)(image_ptr)) = *((unsigned int *)(image_ptr)) ^ 0x00FFFFFF;
                                        
        image_ptr += 4;

        x_counter--;

     }

     image_ptr2 += linebytes;
     image_ptr = image_ptr2;

     y_counter--;
  }

}

