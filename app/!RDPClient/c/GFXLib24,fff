extern void GFXLib_PlotDataToSprite_24_Copy(int source_linebytes,
                                            int dest_linebytes,
                                            int plot_length,
                                            int plot_lines,
                                            unsigned char **source_area,
                                            int source_start,
                                            unsigned char **dest_area,
                                            int dest_start)
{
  unsigned char *source_ptr = (*source_area) + source_start;
  unsigned char *source_ptr2 = source_ptr;
  unsigned char *dest_ptr = (*dest_area) + dest_start;
  unsigned char *dest_ptr2 = dest_ptr;
  int y_counter = plot_lines;
  int x_counter;
  unsigned int pixel;

  while(y_counter > 0){

     x_counter = plot_length;

     while(x_counter > 0){

       pixel = *source_ptr++ << 16;   /* Blue */
       pixel |= *source_ptr++ << 8;   /* Green */
       pixel |= *source_ptr++;        /* Red */

       *((unsigned int *)(dest_ptr)) = pixel;

       dest_ptr += 4;

       x_counter--;
       
     }

     source_ptr2 += source_linebytes;
     source_ptr = source_ptr2;
        
     dest_ptr2 += dest_linebytes;
     dest_ptr = dest_ptr2;

     y_counter--;

  }

}

/******************************************************************************/

extern void GFXLib_PlotDataToSprite_FlipVertical_24_Copy(int source_linebytes,
                                                         int dest_linebytes,
                                                         int plot_length,
                                                         int plot_lines,
                                                         unsigned char **source_area,
                                                         int source_start,
                                                         unsigned char **dest_area,
                                                         int dest_start)
{
  unsigned char *source_ptr;
  unsigned int *dest_ptr;
  int y_index;
  int x_index;
  unsigned int pixel;

  for(y_index = 0; y_index < plot_lines; y_index++){

     source_ptr = (*source_area) + source_start +
                  ((plot_lines - y_index - 1) * source_linebytes);
     dest_ptr = (unsigned int *)((*dest_area) + dest_start + (y_index * dest_linebytes));

     for(x_index = 0; x_index < plot_length; x_index++){

       pixel = *source_ptr++ << 16;   /* Blue */
       pixel |= *source_ptr++ << 8;   /* Green */
       pixel |= *source_ptr++;        /* Red */

       *dest_ptr++ = pixel;

     }

  }

}

