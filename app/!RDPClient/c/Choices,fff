extern FILE *Choices_OpenFileRead(char *filename, char *subdir, BOOL raw)
{
 /*
  * Open choices file called 'filename' for reading.
  * If file does not exist then NULL is returned.
  * If 'subdir' is supplied then the file is read from a sub directory off the
  * application's choices directory. If 'subdir' is NULL then the file is read
  * from the choices directory.
  * If 'raw' is TRUE then the file is opened for raw byte access.
  */
  char filepath[512];

  if(subdir == NULL)
     sprintf(filepath, "Choices:%s.%s", event_taskname, filename);
  else
     sprintf(filepath, "Choices:%s.%s.%s", event_taskname, subdir, filename);

  return(fopen(filepath, (raw ? "rb" : "r")));
}

/******************************************************************************/

extern FILE *Choices_OpenFileWrite(char *filename, char *subdir, BOOL raw, BOOL append)
{
 /*
  * Open choices file called 'filename' for writing.
  * The path is created if it does not exist.
  * If file could not be opened then NULL is returned.
  * If 'subdir' is supplied then the file is written to a sub directory off the
  * application's choices directory. If 'subdir' is NULL then the file is written
  * to the choices directory.
  * If 'raw' is TRUE then the file is opened for raw byte access.
  * IF 'append' is TRUE then the file is appended to rather than overwritten.
  */
  char filepath[512];
  char mode[4];
  FILE *channel;

 /*
  * Create application choices directory if it does not
  * already exist.
  */
  sprintf(filepath, "<Choices$Dir>.%s", event_taskname);
  if(!File_IsDirectory(filepath)){
     if(File_CreateDir(filepath) != NULL)
        return(NULL);
  }

 /*
  * Create sub directory in application choices directory
  * if required and it does not already exist.
  */
  if(subdir != NULL){
     sprintf(filepath, "<Choices$Dir>.%s.%s", event_taskname, subdir);
     if(!File_IsDirectory(filepath)){
        if(File_CreateDir(filepath) != NULL)
           return(NULL);
     }
  }

 /*
  * Open file for writing
  */
  if(subdir == NULL)
     sprintf(filepath, "<Choices$Dir>.%s.%s", event_taskname, filename);
  else
     sprintf(filepath, "<Choices$Dir>.%s.%s.%s", event_taskname, subdir, filename);

  mode[0] = (append ? 'a' : 'w');
  mode[1] = (raw ? 'b' : '\0');
  mode[2] = '\0';

  channel = fopen(filepath, mode);

  if(channel != NULL)
     File_SetType(filepath, filetype_TEXT);

  return(channel); 
}

/******************************************************************************/

extern int Choices_FileSize(char *filename, char *subdir)
{
 /*
  * Returns the size of the choices file
  */
  char filepath[512];

  if(subdir == NULL)
     sprintf(filepath, "Choices:%s.%s", event_taskname, filename);
  else
     sprintf(filepath, "Choices:%s.%s.%s", event_taskname, subdir, filename);

  return(File_Size(filepath));
}

