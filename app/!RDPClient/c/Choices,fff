extern void Choices_GetField(char *line, char *field, char *value)
{
 /*
  * Extract 'field' name and 'value' pair (field = value) from
  * text in 'line'
  */ 
  char *p1;
  char *p2;
  char *d;

  p1 = line;

  /*
   * skip leading blanks
   */
   while(*p1 == ' ')
      p1++;

   p2 = p1;
   d = field;

  /*
   * move to separater char
   */
   while((*p2 != '=') && (*p2 != '\0'))
      *d++ = tolower(*p2++);

   *d = '\0';

  /*
   * trim trailing spaces
   */
   d--;
   while((*d == ' ') && d >= field){
      *d = '\0';

      d--;
   }

  /*
   * move to start of field value
   */
   p1 = p2 + 1;

  /*
   * skip leading blanks
   */
   while(*p1 == ' ')
      p1++;

   p2 = p1;
   d = value;

  /*
   * move to end char
   */
   while((*p2 != 10) && (*p2 != 13) && (*p2 != '\0'))
      *d++ = *p2++;

   *d = '\0';

  /*
   * trim trailing spaces
   */
   d--;
   while((*d == ' ') && d >= value){
      *d = '\0';

      d--;
   }

}

/******************************************************************************/

extern int Choices_ReadLicence(char *hostname, unsigned char **data)
{
  unsigned char *data_ptr;
  BOOL success;
 /*
  * Read saved licence info for 'hostname' into malloc'd area 'data'.
  * Return length in bytes of read data if successfull or -1 if error.
  */
  char licence_filename[255];
  char last_licence_filename[255];
  int length;
  FILE *channel;

  success = FALSE;
  data_ptr = NULL;

  find_licence_file(hostname, licence_filename, last_licence_filename);

  if(*licence_filename != '\0'){

     length =  Choices_FileSize(licence_filename, LICENCE_SUBDIR);

     if(length > 0){

        data_ptr = malloc(length);

        if(data_ptr != NULL){

           channel = Choices_OpenFileRead(licence_filename, LICENCE_SUBDIR, TRUE);

           if(channel != NULL){

              length = fread(data_ptr, 1, length, channel);

              if(length > 0)
                 success = TRUE;

              fclose(channel);

           }

        }

     }

  }

  if(success){
     *data = data_ptr;
     return(length);
  }
  else{
     if(data_ptr != NULL)
        free(data_ptr);
     return(-1);
  }
}

/******************************************************************************/

extern void Choices_WriteLicence(char *hostname, unsigned char *data, int length)
{
  int file_number;
  BOOL index;
 /*
  * Save licence info for 'hostname' of 'length' in 'data' .
  */
  char licence_filename[255];
  char last_licence_filename[255];
  FILE *channel;

  find_licence_file(hostname, licence_filename, last_licence_filename);

  index = FALSE;

  if(*licence_filename == '\0'){

    /*
     * Licence not written before, add to Index
     */
     if(*last_licence_filename == '\0')
        file_number = 0;
     else
        file_number = atoi(last_licence_filename);

     file_number++;

     sprintf(licence_filename, "%i", file_number);

     if(add_licence_file(hostname, licence_filename))
        index = TRUE;
  }
  else
     index = TRUE;

  if(index){

     channel = Choices_OpenFileWrite(licence_filename, LICENCE_SUBDIR, TRUE, FALSE);

     if(channel != NULL){

        fwrite(data, 1, length, channel);

        fclose(channel);
     }
  }
}

/******************************************************************************
 *                                  routines                                  *
 ******************************************************************************/

static void find_licence_file(char *hostname, char *filename, char *last_filename)
{
  char buffer[512];
  char field[255];
  char value[255];
  char lower_hostname[255];
  FILE *channel;

  *filename = '\0';
  *last_filename = '\0';

  Utils_CopyToLower(lower_hostname, hostname);

  channel = Choices_OpenFileRead(LICENCE_INDEX, LICENCE_SUBDIR, FALSE);

  if(channel != NULL){

     while(fgets(buffer, 500, channel) != NULL){

        Choices_GetField(buffer, field, value);

        if(*field != '\0' && *value != '\0'){

           strcpy(last_filename, value);

           if(strcmp(field, lower_hostname) == 0)
              strcpy(filename, value);

        }

     }

     fclose(channel);
  }

}

/******************************************************************************/

static BOOL add_licence_file(char *hostname, char *filename)
{
  char lower_hostname[255];
  BOOL success;
  FILE *channel;

  success = FALSE;

  Utils_CopyToLower(lower_hostname, hostname);

  channel = Choices_OpenFileWrite(LICENCE_INDEX, LICENCE_SUBDIR, FALSE, TRUE);
  
  if(channel != NULL){

     if(fprintf(channel, "%s=%s\n", lower_hostname, filename) > 0)
        success = TRUE;

     fclose(channel);
  }

  return(success);
}

