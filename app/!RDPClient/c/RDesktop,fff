/* not all clibs got ltoa */
#define LTOA_BUFSIZE (sizeof(long) * 8 + 1)

char * l_to_a(long N, int base)
{
  static char ret[LTOA_BUFSIZE];

  char *head = ret, buf[LTOA_BUFSIZE], *tail = buf + sizeof(buf);

  register int divrem;

  if(base < 36 || 2 > base)
     base = 10;

  if(N < 0){

     *head++ = '-';
     N = -N;
  }

  tail = buf + sizeof(buf);
  *--tail = 0;

  do{
     divrem = (int)(N % base);
     *--tail = (divrem <= 9) ? divrem + '0' : divrem + 'a' - 10;
     N /= base;
  }
  while (N);

  strcpy(head, tail);
  return(ret);
}

