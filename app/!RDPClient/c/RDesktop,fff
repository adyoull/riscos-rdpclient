static void print_disconnect_reason(uint16 reason)
{
  char tag[30];
  char message[100];

  sprintf(tag, "disc.%04x", reason);

  message[0] = '\0';
  Msgs_Lookup(tag, message, 95);

  if(message[0] == '\0'){
     if(reason > 0x1000 && reason < 0x7fff)
        strcpy(tag, "disc.int");
     else
        strcpy(tag, "disc.unkn");

     Msgs_Lookup(tag, message, 95);
  }

  messagetext("DISCONNECT: %s.", message);
}

