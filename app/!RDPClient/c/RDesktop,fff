extern void generate_random(uint8 * random)
{
  unsigned long random_number;
  unsigned long index;
  unsigned long *random_ptr;
 /*
  * Generate a 32-byte random for the secure transport code.
  */
  SSL_MD5 md5;

  random_ptr = (unsigned long *)random;

  for(index = 0; index < (SEC_RANDOM_SIZE >> 2); index++){

     random_number = Utils_RandomNumberULng();

     *random_ptr++ = random_number;
  }

 /*
  * Hash both halves with MD5 to obscure possible patterns
  */
  ssl_md5_init(&md5);
  ssl_md5_update(&md5, random, 16);
  ssl_md5_final(&md5, random);
  ssl_md5_update(&md5, random + 16, 16);
  ssl_md5_final(&md5, random + 16);
}

/******************************************************************************/

extern void *xmalloc(int size)
{
 /*
  * malloc; exit if out of memory
  */
  void *mem = malloc(size);
  if(mem == NULL){
     error("xmalloc %d\n", size);
     exit(1);
  }
  return(mem);
}

/******************************************************************************/

extern char *xstrdup(const char *s)
{
 /*
  * strdup; exit if out of memory
  */
  char *mem = malloc(strlen(s) + 1);
  if(mem == NULL){
     error("strdup");
     exit(1);
  }
  strcpy(mem, s);
  return(mem);
}

/******************************************************************************/

extern void *xrealloc(void *oldmem, size_t size)
{
 /*
  * realloc; exit if out of memory
  */
  void *mem;

  if(size < 1)
     size = 1;
  mem = realloc(oldmem, size);
  if(mem == NULL){
     error("xrealloc %d\n", size);
     exit(1);
  }
  return(mem);
}

/******************************************************************************/

extern void xfree(void *mem)
{
 /*
  * free
  */
  free(mem);
}

/******************************************************************************/

extern void error(char *format, ...)
{
  char *ptr;
 /*
  * report an error
  */
/*
  va_list ap;

  fprintf(stderr, "ERROR: ");

  va_start(ap, format);
  vfprintf(stderr, format, ap);
  va_end(ap);
*/
  va_list ap;

  ptr = message_buffer + sprintf(message_buffer, "ERROR: ");

  va_start(ap, format);
  vsprintf(ptr, format, ap);
  va_end(ap);

  Log_AddMessage(message_type_ERROR, message_buffer);
}

