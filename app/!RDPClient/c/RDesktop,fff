static void to_lower(char *text)
{
  char *p;

  p = text;

  while(*p != '\0'){
     *p = tolower(*p);
     p++;
  }
}

/******************************************************************************/

static int keymapname_to_keylayout(char *keymapname)
{
  int keylayout;

  to_lower(keymapname);

  keylayout = lookup_keymap(keymapname);

  if(keylayout == 0){
     strcpy(keymapname, default_KEYMAPNAME);
     
     keylayout = lookup_keymap(keymapname);

     if(keylayout == 0)
        keylayout = default_KEYLAYOUT;  /* Defaults to UK keyboard layout */
  }

  return(keylayout);
}

/******************************************************************************/

static int lookup_keymap(char *mapname)
{
  char tag[30];
  char result[35];
  int number;

  *result = '\0';
  number = 0;

  strcpy(tag, "keymap.");
  strncpy(&tag[7], mapname, 7);
  tag[15] = '\0';

  Msgs_Lookup(tag, result, 30);

  if(*result != '\0')
     sscanf(result, "%i", &number);

  return(number);
}

