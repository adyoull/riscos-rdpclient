extern int RDesktop_Main(int argc, char *argv[])
{
 /*
  * Main entrypoint to rdesktop
  */
  char server[64];
  char fullhostname[64];
  char domain[16];
  char password[64];
  char shell[256];
  char directory[256];
  RD_BOOL deactivated;
  uint32 flags, ext_disc_reason = 0;
  char *p;
  int c;
  int username_option = 0;
#ifdef WITH_RDPSND
  char *rdpsnd_optarg = NULL;
#endif

  char *optarg;
  int optind;
  BOOL use_dynamic_areas = TRUE;
  int screen_x = 800;
  int screen_y = 600;
  int screen_bpp = 8;
  BOOL valid_res;
  BOOL valid_bpp;
  int index;

  flags = RDP_LOGON_NORMAL;
  domain[0] = password[0] = shell[0] = directory[0] = 0;
  strcpy(g_keymapname, default_KEYMAPNAME);

  Status_SetRDPCompression(FALSE);
  Status_SetSoundOption(status_SOUND_OPTION_OFF);

  display_mode = display_mode_WINDOW;
  Display_SetDisplayMode(display_mode);

  g_num_devices = 0;
  
  optind = 0;

  /* Enable protocol trace from a system variable too (Obey: Set RDPClient$Debug 1) */
  if(getenv("RDPClient$Debug") != NULL)
     g_debug_trace = True;

  ScreenMode_ReadCurrentResBpp(&screen_x, &screen_y, &screen_bpp);

 /*
  * Original options
  * "u:d:s:c:p:n:k:g:fbeEmCDKS:T:Na:r:045h?"
  */
  while((c = Utils_GetOptions(argc, argv, "C:u:d:D:s:c:p:n:k:g:ft:beEm:a:x:r:045h?qAizPMvS",
                              &optarg, &optind)) != 0){
     switch (c)
     {
        case 'C':
           STRNCPY(g_connectionname, optarg, sizeof(g_connectionname));
           break;

        case 'u':
           g_username = (char *) xmalloc(strlen(optarg) + 1);
           STRNCPY(g_username, optarg, strlen(optarg) + 1);
           username_option = 1;
           break;

        case 'd':
           STRNCPY(domain, optarg, sizeof(domain));
           break;

        case 's':
           STRNCPY(shell, optarg, sizeof(shell));
           break;

        case 'c':
           STRNCPY(directory, optarg, sizeof(directory));
           break;

        case 'p':
           STRNCPY(password, optarg, sizeof(password));
           flags |= RDP_LOGON_AUTO;

           /* try to overwrite argument so it won't appear in ps */
           p = optarg;
           while(*p)
              *(p++) = 'X';
           break;

        case 'n':
           STRNCPY(g_hostname, optarg, sizeof(g_hostname));
           break;

        case 'k':
           STRNCPY(g_keymapname, optarg, sizeof(g_keymapname));
           break;

        case 'g':
           if(strncmp("screen", optarg, 1) == 0){
              g_width = screen_x;
              g_height = screen_y;
           }
           else{
              g_width = (int)strtol(optarg, &p, 10);

              if(*p == 'x')
                 g_height = (int)strtol(p + 1, NULL, 10);
           }
           
           if(g_width <= 0 || g_height <= 0){
              opt_error("01");
              Log_OpenWindowIfAnyQuitOnClose();
              free_usernames();
              return(1);
           }
           break;

        case 'D':
           if(strncmp("window", optarg, 6) == 0){
              display_mode = display_mode_WINDOW;
           }
           else if(strncmp("fullwindow", optarg, 10) == 0){
              display_mode = display_mode_FULLSCREEN;
           }
           else if(strncmp("fullscreen", optarg, 10) == 0){
              display_mode = display_mode_SINGLETASK;
           }
           else if(strncmp("w", optarg, 1) == 0){
              display_mode = display_mode_WINDOW;
           }
           else if(strncmp("f", optarg, 1) == 0){
              display_mode = display_mode_FULLSCREEN;
           }
           else if(strncmp("s", optarg, 1) == 0){
              display_mode = display_mode_SINGLETASK;
           }
           else{
              display_mode = display_mode_WINDOW;
           }
           break;

        case 'b':
           g_bitmap_cache = False;
           break;

        case 'e':
           g_encryption = False;
           break;

        case 'E':
           g_packet_encryption = False;
           break;

        case 'm':
           g_sendmotion = False;
           break;

        case 'a':
           if(strncmp("screen", optarg, 1) == 0){
              g_server_depth = screen_bpp;
              if(g_server_depth < 8)
                 g_server_depth = 8;
           }
           else{
              g_server_depth = (int)strtol(optarg, NULL, 10);
           }
           if(g_server_depth != 8 && g_server_depth != 16 && g_server_depth != 15 &&
              g_server_depth != 24 && g_server_depth != 32){
              opt_error("02");
              Log_OpenWindowIfAnyQuitOnClose();
              free_usernames();
              return(1);
           }
           break;

        case 'f':
           Display_SetFullscreenBringToFront(fullscreen_bringtofront_KEYPRESS);
           break;

        case 't':
           index = keyboard_shortcut_MIN;
           while(index <= keyboard_shortcut_MAX && (p = next_arg(optarg, ',')) != NULL){
              if(!Keyboard_SetKeyShortcut(optarg, index))
                 opt_invalid_keyname(optarg);
              index++;
              optarg = p;
           }
           break;

        case 'z':
           DEBUG(("rdp compression enabled\n"));
           flags |= (RDP_LOGON_COMPRESSION | RDP_LOGON_COMPRESSION2);
           Status_SetRDPCompression(TRUE);
           break;

        case 'v':
           g_debug_trace = True;
           break;

        case 'x':
           if(strncmp("modem", optarg, 1) == 0){
              g_rdp5_performanceflags = RDP5_NO_WALLPAPER | RDP5_NO_FULLWINDOWDRAG |
                                        RDP5_NO_MENUANIMATIONS | RDP5_NO_THEMING;
           }
           else if(strncmp("broadband", optarg, 1) == 0){
              g_rdp5_performanceflags = RDP5_NO_WALLPAPER;
           }
           else if(strncmp("lan", optarg, 1) == 0){
              g_rdp5_performanceflags = RDP5_DISABLE_NOTHING;
           }
           else{
              g_rdp5_performanceflags = (int)strtol(optarg, NULL, 16);
           }
           break;

        case 'P':
           g_bitmap_cache_persist_enable = True;
           break;

        case 'r':
           if(strncmp("sound", optarg, 5) == 0){

              optarg += 5;

              if(*optarg == ':'){

                 *optarg++;
                 while((p = next_arg(optarg, ',')) != NULL){

                    if(strncmp("remote", optarg, 6) == 0){
                       flags |= RDP_LOGON_LEAVE_AUDIO;
                       Status_SetSoundOption(status_SOUND_OPTION_REMOTE);
                    }

                    if(strncmp("local", optarg, 5) == 0){
#ifdef WITH_RDPSND
                       if(load_sound_support()){

                          rdpsnd_optarg = next_arg(optarg, ':');

                          g_rdpsnd = True;

                          Status_SetSoundOption(status_SOUND_OPTION_LOCAL);
                       }
                       else
                          Status_SetSoundOption(status_SOUND_OPTION_OFF);
#else
                       opt_warning("03");
#endif
                    }

                    if(strncmp("off", optarg, 3) == 0){
                       g_rdpsnd = False;

                       Status_SetSoundOption(status_SOUND_OPTION_OFF);
                    }

                    optarg = p;
                 }
              }
              else{
#ifdef WITH_RDPSND
                 if(load_sound_support()){
                    g_rdpsnd = True;

                    Status_SetSoundOption(status_SOUND_OPTION_LOCAL);
                 }
                 else
                    Status_SetSoundOption(status_SOUND_OPTION_OFF);
#else
                 opt_warning("03");
#endif
              }
           }
           else if(strncmp("clipboard", optarg, 9) == 0){

              optarg += 9;

              if(*optarg == ':'){

                 *optarg++;

                 if(strncmp("active", optarg, 6) == 0){
                    g_rdpclip = True;
                    Clipboard_SetMode(clipboard_ACTIVE);
                 }
//                 else if(strncmp("passive", optarg, 7) == 0)
//                    Clipboard_SetMode(clipboard_PASSIVE);
                 else if(strncmp("off", optarg, 3) == 0){
                    g_rdpclip = False;
                    Clipboard_SetMode(clipboard_PASSIVE);
                 }

                 p = next_arg(optarg, ',');

                 if(p != NULL){
                    if(strlen(p) > 0)
                       Clipboard_SetBufferSize(atoi(p));

                    optarg = p;
                 }
              }
              else{
                 Clipboard_SetMode(clipboard_ACTIVE);
              }
           }
           else if(strncmp("disk", optarg, 4) == 0){
              /* -r disk:h:=/mnt/floppy */
//              disk_enum_devices(&g_num_devices, optarg + 4);
           }
           else if(strncmp("comport", optarg, 7) == 0){
//              serial_enum_devices(&g_num_devices, optarg + 7);
           }
           else if(strncmp("lptport", optarg, 7) == 0){
//              parallel_enum_devices(&g_num_devices, optarg + 7);
           }
           else if(strncmp("printer", optarg, 7) == 0){
//              printer_enum_devices(&g_num_devices, optarg + 7);
           }
           else if(strncmp("clientname", optarg, 10) == 0){
              g_rdpdr_clientname = xmalloc(strlen(optarg + 11) + 1);
              strcpy(g_rdpdr_clientname, optarg + 11);
           } 
           else{
              opt_warning("04");
           }
           break;

        case '0':
           g_console_session = True;
           break;

        case '4':
           g_use_rdp5 = False;
           break;

        case '5':
           g_use_rdp5 = True;
           break;

        case 'q':
           g_quit_on_finish = True;
           break;

        case 'A':
           use_dynamic_areas = FALSE;
           break;

        case 'S':
           g_force_standard = True;   /* do not offer TLS; standard RDP security only */
           break;

        case 'i':
           SpriteLib_SetIyonix15bppColourSwap(TRUE);
           break;

        case 'M':
           ScreenMode_ScreenModeValidationSetEnabled(FALSE);
           break;

        case 1:
           /* ignore stand alone args */
           break;

        case -1:
        case 'h':
        case '?':
        default:
           g_quit_on_finish = True;
           usage(argv[0]);
           Log_OpenWindowIfAnyQuitOnClose();
           free_usernames();
           return(1);
     }
  }

  if(argc != optind || argc == 1){
    /*
     * invalid argument
     */
     g_quit_on_finish = True;
     usage(argv[0]);
     Log_OpenWindowIfAnyQuitOnClose();
     free_usernames();
     return(1);
  }

 /*
  * Validate selected display mode
  */
  if(display_mode == display_mode_FULLSCREEN || display_mode == display_mode_SINGLETASK){

     ScreenMode_Validate(g_width, g_height, g_server_depth, 1,  1, &valid_res, &valid_bpp);

     if(display_mode == display_mode_FULLSCREEN && !valid_res){

        display_mode = display_mode_WINDOW;

        opt_invalid_res(g_width, g_height);
     }

     if(display_mode == display_mode_SINGLETASK && !valid_bpp){

        display_mode = display_mode_WINDOW;

        opt_invalid_res_bpp(g_width, g_height, g_server_depth);
     }
  }

  Display_SetDisplayMode(display_mode);
  
  Status_SetConnectionname(g_connectionname);
  
 /*
  * For RISC OS we always have our own colourmap
  */
  g_owncolmap = True;

  MemMan_InitMemoryManagement(use_dynamic_areas);

 /*
  * Need to do this here so that the atexit handler runs before flex's
  */
  Die_Init();

  STRNCPY(server, argv[optind - 1], sizeof(server));
  parse_server_and_port(server);
  to_lower(server);

  /*
  if(!username_option){
     error("could not determine username, use -u\n");
     g_quit_on_finish = True;
     Log_OpenWindowIfAnyQuitOnClose();
     free_usenames();
     return(1);
  }
  */

  if(g_hostname[0] == 0){

     if(Net_GetHostName(fullhostname, sizeof(fullhostname)) == -1){
        opt_error("05");
        g_quit_on_finish = True;
        Log_OpenWindowIfAnyQuitOnClose();
        free_usernames();
        return(1);
     }

     p = strchr(fullhostname, '.');
     if(p != NULL)
        *p = 0;

     STRNCPY(g_hostname, fullhostname, sizeof(g_hostname));
  }

  Status_SetHostname(g_hostname);

  if(g_connectionname[0] == '\0')
     sprintf(g_title, "%s - %s", event_taskname, server);
  else
     sprintf(g_title, "%s - %s (%s)", event_taskname, server, g_connectionname);

  g_keylayout = keymapname_to_keylayout(g_keymapname);

  Status_SetKeymapname(g_keymapname);

  if(!ui_init()){
     g_quit_on_finish = True;
     Log_OpenWindowIfAnyQuitOnClose();
     free_usernames();
     return(1);
  }

  if(!Clipboard_Startup()){
     g_quit_on_finish = True;
     Log_OpenWindowIfAnyQuitOnClose();
     free_usernames();
     return(1);
  }

#ifdef WITH_RDPSND
  if(g_rdpsnd){
     if(!rdpsnd_init(rdpsnd_optarg))
        Status_SetSoundOption(status_SOUND_OPTION_OFF);
  }
#endif

/*
  if(g_lspci_enabled)
     lspci_init();
*/

  rdpdr_init();

  RDPClient_IconBarSetText(server);

  Status_SetConnected(FALSE);


  while(1){

     rdesktop_reset_state();

     if(g_redirect){
        STRNCPY(domain, g_redirect_domain, sizeof(domain));
        xfree(g_username);
        g_username = (char *) xmalloc(strlen(g_redirect_username) + 1);
        STRNCPY(g_username, g_redirect_username, strlen(g_redirect_username) + 1);
        STRNCPY(password, g_redirect_password, sizeof(password));
        STRNCPY(server, g_redirect_server, sizeof(server));
        flags |= RDP_LOGON_AUTO;
     }

     RDPClient_IconBarSetText(server);
     Status_SetServername(server);
     Status_SetUsername(g_username);
     Status_SetDomain(domain);


     ui_init_connection();

     if(!rdp_connect(server, flags, domain, password, shell, directory, g_redirect)){
        RD_BOOL connected = False;

        /* Auto-fallback: the server refused the TLS offer with
         * SSL_NOT_ALLOWED_BY_SERVER (RDP negotiation failure code 2) -- it does
         * Standard RDP Security only. Retry once without offering TLS instead of
         * failing.  (C) 2026 Andrew Youll */
        if(g_neg_ssl_not_allowed && !g_force_standard){
           warning("Server does not allow TLS; retrying with standard RDP security.\n");
           g_force_standard = True;
           g_neg_ssl_not_allowed = False;
           rdesktop_reset_state();
           ui_init_connection();
           connected = rdp_connect(server, flags, domain, password, shell, directory, g_redirect);
        }

        if(!connected){
           Log_OpenWindowIfAnyQuitOnClose();
           return(1);
        }
     }


     Status_SetConnected(TRUE);
     RDPClient_IconBarSetState(TRUE);

    /*
     * By setting encryption to False here, we have an encrypted login
     * packet but unencrypted transfer of other packets
     */
     if(!g_packet_encryption)
        g_encryption = False;


     DEBUG(("Connection successful.\n"));
     memset(password, 0, sizeof(password));

     if(!g_redirect){
        if(!ui_create_window()){
           Log_OpenWindowIfAnyQuitOnClose();
           return(1);
        }
     }

     g_redirect = False;

     Clipboard_ConnectToServer();
     rdp_main_loop(&deactivated, &ext_disc_reason);

     DEBUG(("Disconnecting...\n"));
     rdp_disconnect();

     if(g_redirect)
        continue;

     if((!UI_CalledPoll() || !Display_Called()) && Log_TextSize() == 0)
        opt_error("06");

     ui_destroy_window();
     break;
  }

  cache_save_state();
  ui_deinit();


  Status_SetConnected(FALSE);
  RDPClient_IconBarSetState(FALSE);


  if(ext_disc_reason >= 2)
     print_disconnect_reason(ext_disc_reason);


  Log_OpenWindowIfErrorsSetQuitOnClose(g_quit_on_finish);


  if(deactivated){
     /* clean disconnect */
     return 0;
  }
  else{
     if(ext_disc_reason == exDiscReasonAPIInitiatedDisconnect ||
        ext_disc_reason == exDiscReasonAPIInitiatedLogoff){
        /* not so clean disconnect, but nothing to worry about */
        return(0);
     }
     else{
        /* return error */
        return(2);
     }
  }
}

