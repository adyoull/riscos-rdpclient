extern int Net_GetHostName(char *hostname, int maxsize)
{
 /*
  * Gets host name and fills hostname (up to maxsize).
  * Returns 0 on success and -1 on failure
  */
  int success = -1;

  if(OS_ReadVarVal("Inet$HostName", hostname, maxsize))
    success = 0;
  else{
    /* try and return IP address if hostname not found */

    if(OS_ReadVarVal("Inet$EtherIPAddr", hostname, maxsize))
      success = 0;
  }

  return(success);
}

/******************************************************************************/

extern BOOL Net_SetNonBlockingSocket(int socket, BOOL nonblocking)
{
 /*
  * Set non blocking flag according to 'nonblocking'
  * Return TRUE if successful or FALSE if not
  */
  int nonblocking_flag;

  if(nonblocking)
     nonblocking_flag = 1;
  else
     nonblocking_flag = 0;

  if(socketioctl(socket, FIONBIO, &nonblocking_flag) < 0)
     return(FALSE);
  else
     return(TRUE);
}



