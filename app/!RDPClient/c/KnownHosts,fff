#define filetype_TEXT 0xFFF

/* Bounded formatter used instead of the C99 snprintf().  snprintf lives in a
   newer SharedCLibrary stub chunk (chunk 5) that older ROM SharedCLibrary
   builds cannot initialise -> the app crashes at launch (LibInit fails, sp=0).
   vsprintf is the classic C89 entry (chunk 2) and is already linked, so this
   keeps output bounded without pulling in the extra chunk. */
static void kh_snprintf(char *buf, int size, const char *fmt, ...)
{
   char tmp[512];
   va_list ap;
   int n;
   if(size <= 0) return;
   va_start(ap, fmt);
   n = vsprintf(tmp, fmt, ap);
   va_end(ap);
   if(n < 0) { buf[0] = '\0'; return; }
   if(n > size - 1) n = size - 1;
   memcpy(buf, tmp, (unsigned) n);
   buf[n] = '\0';
}


/* ==================================================================== *
 *  SHA-256  (FIPS 180-4).  Self-contained; the linked OpenSSL subset    *
 *  offers only SHA-1, which is too weak to present as a "fingerprint".  *
 * ==================================================================== */

typedef struct
{
   unsigned int  state[8];
   unsigned int  bytelen;      /* total bytes hashed (ample for our inputs) */
   unsigned char buf[64];
   int           buflen;       /* bytes currently buffered */
} sha256_ctx;

static const unsigned int sha256_k[64] =
{
   0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,0x923f82a4u,0xab1c5ed5u,
   0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,
   0xe49b69c1u,0xefbe4786u,0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
   0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,0x06ca6351u,0x14292967u,
   0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,
   0xa2bfe8a1u,0xa81a664bu,0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
   0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,0x5b9cca4fu,0x682e6ff3u,
   0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u
};

#define ROTR(x,n)  (((x) >> (n)) | ((x) << (32 - (n))))

static void sha256_transform(sha256_ctx *c, const unsigned char *p)
{
   unsigned int w[64], a, b, cc, d, e, f, g, h, t1, t2, s0, s1, ch, maj;
   int i;

   for(i = 0; i < 16; i++)
      w[i] = ((unsigned int) p[i*4]     << 24) |
             ((unsigned int) p[i*4 + 1] << 16) |
             ((unsigned int) p[i*4 + 2] <<  8) |
             ((unsigned int) p[i*4 + 3]);
   for(i = 16; i < 64; i++)
   {
      s0 = ROTR(w[i-15], 7) ^ ROTR(w[i-15], 18) ^ (w[i-15] >> 3);
      s1 = ROTR(w[i-2], 17) ^ ROTR(w[i-2], 19) ^ (w[i-2] >> 10);
      w[i] = w[i-16] + s0 + w[i-7] + s1;
   }

   a = c->state[0]; b = c->state[1]; cc = c->state[2]; d = c->state[3];
   e = c->state[4]; f = c->state[5]; g = c->state[6]; h = c->state[7];

   for(i = 0; i < 64; i++)
   {
      s1  = ROTR(e, 6) ^ ROTR(e, 11) ^ ROTR(e, 25);
      ch  = (e & f) ^ ((~e) & g);
      t1  = h + s1 + ch + sha256_k[i] + w[i];
      s0  = ROTR(a, 2) ^ ROTR(a, 13) ^ ROTR(a, 22);
      maj = (a & b) ^ (a & cc) ^ (b & cc);
      t2  = s0 + maj;
      h = g; g = f; f = e; e = d + t1; d = cc; cc = b; b = a; a = t1 + t2;
   }

   c->state[0] += a; c->state[1] += b; c->state[2] += cc; c->state[3] += d;
   c->state[4] += e; c->state[5] += f; c->state[6] += g; c->state[7] += h;
}

static void sha256_init(sha256_ctx *c)
{
   c->state[0] = 0x6a09e667u; c->state[1] = 0xbb67ae85u;
   c->state[2] = 0x3c6ef372u; c->state[3] = 0xa54ff53au;
   c->state[4] = 0x510e527fu; c->state[5] = 0x9b05688cu;
   c->state[6] = 0x1f83d9abu; c->state[7] = 0x5be0cd19u;
   c->bytelen = 0;
   c->buflen  = 0;
}

static void sha256_update(sha256_ctx *c, const unsigned char *data, int len)
{
   int i;
   for(i = 0; i < len; i++)
   {
      c->buf[c->buflen++] = data[i];
      if(c->buflen == 64)
      {
         sha256_transform(c, c->buf);
         c->buflen = 0;
      }
   }
   c->bytelen += (unsigned int) len;
}

static void sha256_final(sha256_ctx *c, unsigned char out[32])
{
   unsigned int hi, lo;
   int pad, i;

   hi = c->bytelen >> 29;         /* high 32 bits of (bytelen * 8) */
   lo = c->bytelen << 3;          /* low  32 bits                  */

   pad = c->buflen;
   c->buf[pad++] = 0x80;
   if(pad > 56)
   {
      while(pad < 64) c->buf[pad++] = 0;
      sha256_transform(c, c->buf);
      pad = 0;
   }
   while(pad < 56) c->buf[pad++] = 0;
   c->buf[56] = (unsigned char)(hi >> 24); c->buf[57] = (unsigned char)(hi >> 16);
   c->buf[58] = (unsigned char)(hi >>  8); c->buf[59] = (unsigned char)(hi);
   c->buf[60] = (unsigned char)(lo >> 24); c->buf[61] = (unsigned char)(lo >> 16);
   c->buf[62] = (unsigned char)(lo >>  8); c->buf[63] = (unsigned char)(lo);
   sha256_transform(c, c->buf);

   for(i = 0; i < 8; i++)
   {
      out[i*4]     = (unsigned char)(c->state[i] >> 24);
      out[i*4 + 1] = (unsigned char)(c->state[i] >> 16);
      out[i*4 + 2] = (unsigned char)(c->state[i] >>  8);
      out[i*4 + 3] = (unsigned char)(c->state[i]);
   }
}

/* ==================================================================== */

extern void KnownHosts_Fingerprint(const unsigned char *data, int len,
                                    char *out, int outsize)
{
   static const char hexd[] = "0123456789ABCDEF";
   unsigned char digest[32];
   sha256_ctx c;
   int i, n = 0;

   if(outsize <= 0) return;
   sha256_init(&c);
   if(data != NULL && len > 0)
      sha256_update(&c, data, len);
   sha256_final(&c, digest);

   for(i = 0; i < 32; i++)
   {
      if(i > 0 && n < outsize - 1) out[n++] = ':';
      if(n < outsize - 1) out[n++] = hexd[(digest[i] >> 4) & 0xf];
      if(n < outsize - 1) out[n++] = hexd[digest[i] & 0xf];
   }
   out[n] = '\0';
}

/* ---- small helpers ------------------------------------------------- */

static void kh_copy(char *dst, const char *src, int size)
{
   if(size <= 0) return;
   strncpy(dst, src, size - 1);
   dst[size - 1] = '\0';
}

/* Copy, replacing control characters (incl. TAB / newline) with spaces so a
   value can never break the tab-separated record format. */
static void kh_copy_clean(char *dst, const char *src, int size)
{
   int i = 0;
   if(size <= 0) return;
   while(src[i] != '\0' && i < size - 1)
   {
      unsigned char ch = (unsigned char) src[i];
      dst[i] = (ch < 0x20 || ch == 0x7f) ? ' ' : (char) ch;
      i++;
   }
   dst[i] = '\0';
}

static void kh_now(char *buf, int size)
{
   time_t t;
   struct tm *tm;
   if(size <= 0) return;
   buf[0] = '\0';
   t = time(NULL);
   tm = localtime(&t);
   if(tm != NULL)
      kh_snprintf(buf, size, "%04d-%02d-%02d %02d:%02d",
               tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday,
               tm->tm_hour, tm->tm_min);
}

/* Strip trailing CR/LF, then split 'line' on TABs into up to maxf fields
   (in place).  Returns the number of fields. */
static int kh_split(char *line, char *fields[], int maxf)
{
   int n = 0, len;
   char *p;

   if(maxf <= 0) return 0;
   len = (int) strlen(line);
   while(len > 0 && (line[len-1] == '\n' || line[len-1] == '\r'))
      line[--len] = '\0';

   fields[n++] = line;
   for(p = line; *p != '\0'; p++)
   {
      if(*p == '\t')
      {
         *p = '\0';
         if(n < maxf) fields[n++] = p + 1;
      }
   }
   return n;
}

static const char *kh_disc_mode(int mode)   /* on-disc token */
{
   return (mode == knownhosts_MODE_TLS) ? "TLS" : "RC4";
}

extern const char *KnownHosts_ModeName(int mode)   /* display name */
{
   return (mode == knownhosts_MODE_TLS) ? "TLS" : "Standard";
}

/* ---- whole-store access -------------------------------------------- */

extern int KnownHosts_Load(knownhosts_record *recs, int maxrecs)
{
   FILE *f;
   char  line[512];
   int   count = 0;

   f = fopen(knownhosts_FILE, "r");
   if(f == NULL) return 0;

   while(count < maxrecs && fgets(line, sizeof(line), f) != NULL)
   {
      char *fld[6];
      int   nf;
      knownhosts_record *r;

      if(line[0] == '#' || line[0] == '\n' || line[0] == '\r' || line[0] == '\0')
         continue;

      nf = kh_split(line, fld, 6);
      if(nf < 3) continue;                 /* need host, mode, fingerprint */

      r = &recs[count];
      memset(r, 0, sizeof(*r));
      kh_copy(r->host, fld[0], knownhosts_HOSTLEN);
      r->mode = (strcmp(fld[1], "TLS") == 0) ? knownhosts_MODE_TLS
                                             : knownhosts_MODE_RC4;
      kh_copy(r->fingerprint, fld[2], knownhosts_FPLEN);
      if(nf > 3) kh_copy(r->cn,        fld[3], knownhosts_CNLEN);
      if(nf > 4) kh_copy(r->firstseen, fld[4], knownhosts_DATELEN);
      if(nf > 5) kh_copy(r->lastseen,  fld[5], knownhosts_DATELEN);
      count++;
   }

   fclose(f);
   return count;
}

extern BOOL KnownHosts_Save(const knownhosts_record *recs, int count)
{
   FILE *f;
   int   i;

   f = fopen(knownhosts_FILE, "w");
   if(f == NULL) return FALSE;

   fprintf(f, "#RDPClient KnownHosts v1 -- server identity fingerprints (SHA-256)\n");
   fprintf(f, "#host:port\tmode\tfingerprint\tcert-CN\tfirst-seen\tlast-seen\n");
   for(i = 0; i < count; i++)
      fprintf(f, "%s\t%s\t%s\t%s\t%s\t%s\n",
              recs[i].host, kh_disc_mode(recs[i].mode), recs[i].fingerprint,
              recs[i].cn, recs[i].firstseen, recs[i].lastseen);

   fclose(f);
   File_SetType(knownhosts_FILE, filetype_TEXT);
   return TRUE;
}

/* ---- per-connection helpers ---------------------------------------- */

extern int KnownHosts_Check(const char *host, int mode, const char *fingerprint,
                            char *stored_fp, int stored_fp_size)
{
   knownhosts_record recs[knownhosts_MAXHOSTS];
   int n, i;

   if(stored_fp != NULL && stored_fp_size > 0) stored_fp[0] = '\0';
   n = KnownHosts_Load(recs, knownhosts_MAXHOSTS);
   for(i = 0; i < n; i++)
   {
      if(recs[i].mode == mode && strcmp(recs[i].host, host) == 0)
      {
         if(stored_fp != NULL && stored_fp_size > 0)
            kh_copy(stored_fp, recs[i].fingerprint, stored_fp_size);
         return (strcmp(recs[i].fingerprint, fingerprint) == 0)
                   ? knownhosts_MATCH : knownhosts_CHANGED;
      }
   }
   return knownhosts_NEW;
}

extern BOOL KnownHosts_Record(const char *host, int mode,
                              const char *fingerprint, const char *cn)
{
   knownhosts_record recs[knownhosts_MAXHOSTS];
   char now[knownhosts_DATELEN];
   int  n, i, found = -1;

   n = KnownHosts_Load(recs, knownhosts_MAXHOSTS);
   kh_now(now, sizeof(now));

   for(i = 0; i < n; i++)
      if(recs[i].mode == mode && strcmp(recs[i].host, host) == 0)
      {
         found = i;
         break;
      }

   if(found < 0)
   {
      if(n >= knownhosts_MAXHOSTS) return FALSE;      /* store full */
      found = n++;
      memset(&recs[found], 0, sizeof(recs[found]));
      kh_copy(recs[found].host, host, knownhosts_HOSTLEN);
      recs[found].mode = mode;
      kh_copy(recs[found].firstseen, now, knownhosts_DATELEN);
   }

   kh_copy(recs[found].fingerprint, fingerprint, knownhosts_FPLEN);
   if(cn != NULL) kh_copy_clean(recs[found].cn, cn, knownhosts_CNLEN);
   else           recs[found].cn[0] = '\0';
   kh_copy(recs[found].lastseen, now, knownhosts_DATELEN);

   return KnownHosts_Save(recs, n);
}

extern BOOL KnownHosts_Forget(const char *host, int mode)
{
   knownhosts_record recs[knownhosts_MAXHOSTS];
   int  n, i, w = 0;
   BOOL removed = FALSE;

   n = KnownHosts_Load(recs, knownhosts_MAXHOSTS);
   for(i = 0; i < n; i++)
   {
      if(recs[i].mode == mode && strcmp(recs[i].host, host) == 0)
      {
         removed = TRUE;
         continue;                        /* drop it */
      }
      if(w != i) recs[w] = recs[i];
      w++;
   }
   if(!removed) return FALSE;
   return KnownHosts_Save(recs, w);
}

