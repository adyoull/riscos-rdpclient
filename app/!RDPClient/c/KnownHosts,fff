#define SWI_Wimp_ReportError 0x400DF   /* SWI number; not in DeskLib headers */

static window_handle     kh_window    = NULL;
static knownhosts_record kh_disp[knownhosts_MAXHOSTS];
static int               kh_dispcount = 0;
static int               kh_sel       = -1;

/* (C) 2026 Andrew Youll -- indirected-icon backing store for the code-built
   manager window (no Wimp template is used, so nothing external can go stale
   or be missing at start-up). */
static char kh_valid[]  = "";
static char kh_hdrbuf[256];
static char kh_rowbuf[knownhosts_NUMROWS][80];
static char kh_btnbuf[3][16];   /* Forget / Details / Close labels */

/* OK/Cancel confirmation (mirrors the connection manager's). */
static BOOL kh_confirm(const char *msg)
{
   _kernel_swi_regs r;
   struct { int errnum; char text[240]; } eb;

   eb.errnum = 0;
   strncpy(eb.text, msg, sizeof(eb.text) - 1);
   eb.text[sizeof(eb.text) - 1] = '\0';
   r.r[0] = (int) &eb;
   r.r[1] = 0x1 | 0x2 | 0x8;          /* OK + Cancel, no beep */
   r.r[2] = (int) "RDPClient";
   if(_kernel_swi(SWI_XOS_Bit | SWI_Wimp_ReportError, &r, &r) != NULL)
      return FALSE;
   return (r.r[1] == 1);              /* 1 = OK, 2 = Cancel */
}

static void kh_fmt_row(const knownhosts_record *r, char *out, int size)
{
   char fp[20];
   int  i;
   for(i = 0; i < 16 && r->fingerprint[i] != '\0'; i++) fp[i] = r->fingerprint[i];
   fp[i] = '\0';
   kh_snprintf(out, size, "%-22s  %-8s  %s...  %s",
            r->host, KnownHosts_ModeName(r->mode), fp, r->lastseen);
}

static void kh_populate(void)
{
   char buf[256];
   int  i;

   kh_dispcount = KnownHosts_Load(kh_disp, knownhosts_MAXHOSTS);
   kh_sel = -1;
   for(i = 0; i < knownhosts_NUMROWS; i++)
   {
      if(i < kh_dispcount)
      {
         kh_fmt_row(&kh_disp[i], buf, sizeof(buf));
         Icon_SetText(kh_window, knownhosts_ICON_ROW0 + i, buf);
      }
      else
         Icon_SetText(kh_window, knownhosts_ICON_ROW0 + i, "");
      Icon_SetSelect(kh_window, knownhosts_ICON_ROW0 + i, 0);
   }
   if(kh_dispcount == 0)
      strcpy(buf, "No known hosts recorded yet.");
   else
      kh_snprintf(buf, sizeof(buf), "%d known host%s%s", kh_dispcount,
               (kh_dispcount == 1) ? "" : "s",
               (kh_dispcount > knownhosts_NUMROWS) ? "  (showing first 14)" : "");
   Icon_SetText(kh_window, knownhosts_ICON_COUNT, buf);
}

static BOOL kh_click(event_pollblock *event, void *reference)
{
   int icon = event->data.mouse.icon;

   if(icon >= knownhosts_ICON_ROW0 &&
      icon <  knownhosts_ICON_ROW0 + knownhosts_NUMROWS)
   {
      int row = icon - knownhosts_ICON_ROW0;
      if(row < kh_dispcount)
      {
         if(kh_sel >= 0)
            Icon_SetSelect(kh_window, knownhosts_ICON_ROW0 + kh_sel, 0);
         kh_sel = row;
         Icon_SetSelect(kh_window, icon, 1);
      }
      return TRUE;
   }

   switch(icon)
   {
      case knownhosts_ICON_CLOSE:
         Window_Hide(kh_window);
         return TRUE;

      case knownhosts_ICON_FORGET:
         if(kh_sel >= 0 && kh_sel < kh_dispcount)
         {
            char q[200];
            kh_snprintf(q, sizeof(q),
               "Forget known host '%s'?  RDPClient will treat it as new and "
               "ask you to confirm its identity next time.",
               kh_disp[kh_sel].host);
            if(kh_confirm(q))
            {
               KnownHosts_Forget(kh_disp[kh_sel].host, kh_disp[kh_sel].mode);
               kh_populate();
            }
         }
         else
            Error_Report(0, "Select a host in the list first.");
         return TRUE;

      case knownhosts_ICON_DETAILS:
         if(kh_sel >= 0 && kh_sel < kh_dispcount)
         {
            knownhosts_record *r = &kh_disp[kh_sel];
            Error_Report(0,
               "%s  (%s security)\n"
               "Fingerprint (SHA-256):\n%s\n"
               "Certificate name: %s\n"
               "First seen: %s\nLast seen: %s",
               r->host, KnownHosts_ModeName(r->mode), r->fingerprint,
               (r->cn[0] != '\0') ? r->cn : "(none)",
               r->firstseen, r->lastseen);
         }
         else
            Error_Report(0, "Select a host in the list first.");
         return TRUE;
   }
   return FALSE;
}

/* ---- code-built manager window (no Wimp template needed) -------------- *
 * (C) 2026 Andrew Youll.  The window and every icon are created in code via
 * Wimp_CreateWindow / Wimp_CreateIcon, so the application carries no extra
 * binary template and cannot fail to start because one is missing/invalid.
 * Icons are created in ascending order, so the Wimp assigns them exactly the
 * numbers the click handler expects: COUNT=0, ROW0..ROW0+NUMROWS-1, then
 * FORGET, DETAILS, CLOSE.                                                  */

#define KH_W        1000        /* work-area width (OS units) */
#define KH_ROWH       44        /* row / button height        */
#define KH_MARGIN      8

static icon_handle kh_add_icon(int x0, int y0, int x1, int y1,
                               unsigned int flags,
                               const char *text, char *indbuf, int indlen,
                               const char *valid)
{
   icon_createblock ic;
   icon_handle h;

   ic.window = kh_window;
   ic.icondata.workarearect.min.x = x0;
   ic.icondata.workarearect.min.y = y0;
   ic.icondata.workarearect.max.x = x1;
   ic.icondata.workarearect.max.y = y1;
   ic.icondata.flags.value = flags;

   if(flags & icon_INDIRECTED)
   {
      ic.icondata.data.indirecttext.buffer      = indbuf;
      ic.icondata.data.indirecttext.validstring = (char *) (valid ? valid : kh_valid);
      ic.icondata.data.indirecttext.bufflen     = indlen;
      if(text) { strncpy(indbuf, text, indlen - 1); indbuf[indlen - 1] = '\0'; }
      else     indbuf[0] = '\0';
   }
   else
   {
      strncpy(ic.icondata.data.text, text ? text : "", wimp_MAXNAME - 1);
      ic.icondata.data.text[wimp_MAXNAME - 1] = '\0';
   }
   h = -1;
   Wimp_CreateIcon(&ic, &h);
   return h;
}

static BOOL kh_build_window(void)
{
   window_block win;
   int i, bottom, top;

   bottom = -(KH_MARGIN + KH_ROWH                     /* header row */
              + knownhosts_NUMROWS * KH_ROWH          /* host rows  */
              + KH_MARGIN + KH_ROWH + KH_MARGIN);     /* button row */

   memset(&win, 0, sizeof(win));
   win.screenrect.min.x = 300;         win.screenrect.min.y = 300;
   win.screenrect.max.x = 300 + KH_W;  win.screenrect.max.y = 300 - bottom;
   win.scroll.x = 0;  win.scroll.y = 0;
   win.behind   = (window_handle) -1;                 /* open in front */
   win.flags.value = 0;
   win.flags.data.moveable   = 1;
   win.flags.data.autoredraw = 1;
   win.flags.data.titlebar   = 1;
   win.flags.data.closeicon  = 1;
   win.flags.data.backicon   = 1;
   win.flags.data.newflags   = 1;
   win.colours.cols.titlefore   = 7;
   win.colours.cols.titleback   = 2;
   win.colours.cols.workfore    = 7;
   win.colours.cols.workback    = 1;
   win.colours.cols.scrollouter = 3;
   win.colours.cols.scrollinner = 1;
   win.colours.cols.titlefocus  = 12;
   win.colours.cols.extflags    = 0;
   win.workarearect.min.x = 0;     win.workarearect.max.y = 0;
   win.workarearect.max.x = KH_W;  win.workarearect.min.y = bottom;
   win.titleflags.value = icon_TEXT | icon_HCENTRE | icon_VCENTRE |
                          icon_FILLED | icon_BORDER;
   win.workflags.value  = 0;
   win.spritearea = (void *) 1;                       /* Wimp sprite area */
   win.minsize.x = 200;  win.minsize.y = 100;
   strncpy(win.title.text, "Known hosts", wimp_MAXNAME - 1);
   win.title.text[wimp_MAXNAME - 1] = '\0';
   win.numicons = 0;

   kh_window = NULL;
   if(Wimp_CreateWindow(&win, &kh_window) != NULL || kh_window == NULL)
      return FALSE;

   /* icon 0 : header / count line (indirected, left, no clicks) */
   top = -KH_MARGIN;
   kh_add_icon(KH_MARGIN, top - KH_ROWH, KH_W - KH_MARGIN, top,
               icon_TEXT | icon_INDIRECTED | icon_VCENTRE | (7u << 24),
               "", kh_hdrbuf, (int) sizeof(kh_hdrbuf), kh_valid);

   /* icons 1..NUMROWS : selectable host rows (indirected text, CLICK) */
   for(i = 0; i < knownhosts_NUMROWS; i++)
   {
      top = -(KH_MARGIN + KH_ROWH) - i * KH_ROWH;
      kh_add_icon(KH_MARGIN, top - KH_ROWH, KH_W - KH_MARGIN, top,
                  icon_TEXT | icon_INDIRECTED | icon_VCENTRE | icon_FILLED |
                  (iconbtype_CLICK << 12) | (7u << 24) | (1u << 28),
                  "", kh_rowbuf[i], (int) sizeof(kh_rowbuf[i]), kh_valid);
   }

   /* icons NUMROWS+1..NUMROWS+3 : Forget / Details / Close buttons */
   {
      unsigned int bf = icon_TEXT | icon_INDIRECTED | icon_HCENTRE |
                        icon_VCENTRE | icon_FILLED | icon_BORDER |
                        (iconbtype_CLICK << 12) | (7u << 24) | (1u << 28);
      top = -(KH_MARGIN + KH_ROWH) - knownhosts_NUMROWS * KH_ROWH - KH_MARGIN;
      kh_add_icon(KH_MARGIN,               top - KH_ROWH, KH_MARGIN + 190, top,
                  bf, "Forget",  kh_btnbuf[0], (int) sizeof(kh_btnbuf[0]), "R5,3");
      kh_add_icon(KH_MARGIN + 200,         top - KH_ROWH, KH_MARGIN + 390, top,
                  bf, "Details", kh_btnbuf[1], (int) sizeof(kh_btnbuf[1]), "R5,3");
      kh_add_icon(KH_W - KH_MARGIN - 190,  top - KH_ROWH, KH_W - KH_MARGIN,  top,
                  bf, "Close",   kh_btnbuf[2], (int) sizeof(kh_btnbuf[2]), "R5,3");
   }
   return TRUE;
}

extern void KnownHostsUI_Init(void)
{
   /* The window is built lazily on first open (KnownHostsUI_Open), so nothing
      here can affect application start-up. */
   kh_window = NULL;
}

extern void KnownHostsUI_Open(void)
{
   if(kh_window == NULL)
   {
      if(!kh_build_window())
      {
         Error_Report(0, "Could not create the Known Hosts window.");
         return;
      }
      Event_Claim(event_CLICK, kh_window, event_ANY, kh_click, NULL);
   }
   kh_populate();
   Window_Show(kh_window, open_CENTERED);
}
