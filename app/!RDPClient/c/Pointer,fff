     set_pointer_shape(hardware_pointer_bank);
}

/******************************************************************************/

extern pointer_block *Pointer_Create(int width, int height, int origin_x, int origin_y,
                                     BOOL has_mask)
{
 /*
  * Initialise pointer environment for image of size width, height
  */
  pointer_block *pointerblock;
  
  pointerblock = (pointer_block *)malloc(sizeof(pointer_block));

  if(pointerblock == NULL)
     return(NULL);

  pointerblock->origin.x = origin_x;
  pointerblock->origin.y = origin_y;
  pointerblock->plot_mask = has_mask;

 /*
  * Pointer as supplied is a 24bit image with a 1bpp plot mask if required
  */
  pointerblock->base_sprite = SpriteLib_Create(width, height, 24, FALSE, has_mask);

  if(pointerblock->base_sprite == NULL){
     free(pointerblock);
     return(NULL);
  }

 /*
  * Set up 2bpp equivalent sprite for hardware cursor
  */
  pointerblock->hardware_sprite = NULL; /* built on demand */


  return(pointerblock);
}

/******************************************************************************/

extern void Pointer_Destroy(pointer_block *pointerblock)
{
 /*
  * Destroy everything
  */
  if(pointerblock != NULL){

     if(pointerblock->base_sprite != NULL){
        SpriteLib_Destroy(pointerblock->base_sprite);
        pointerblock->base_sprite = NULL;
     }

     if(pointerblock->hardware_sprite != NULL){
        SpriteLib_Destroy(pointerblock->hardware_sprite);
        pointerblock->hardware_sprite = NULL;
     }

     free(pointerblock);
  }

}

/******************************************************************************/

extern unsigned char *Pointer_PrepMaskData(int width, int height, unsigned char *mask_data,
                                           BOOL flip_vertical)
{
 /*
  * Prepare 1bpp mask data for use with Sprite Mask.
  * If all mask bits are 0, NULL is returned as no mask is present.
  * Returned pointer needs to be free()ed after use.
  */
  unsigned char *mask_buffer, *mask_buffer_p, *mask_data_p;
  int bit, byte, line;
  int mask_linebytes;
  unsigned int source, dest;
  BOOL mask_present;

  mask_linebytes = (width + 7) / 8;

  mask_buffer = (unsigned char *)malloc(mask_linebytes * height);
  if(mask_buffer == NULL)
     return(NULL);

  mask_present = FALSE;

 /*
  * Reverse bit ordering in bytes
  * Invert bits so that:
  * 1 = plot cursor   0 = don't plot cursor
  */
  mask_buffer_p = mask_buffer;

  for(line = 0; line < height; line++){

     if(flip_vertical)
        mask_data_p = mask_data + ((height - line - 1) * mask_linebytes);
     else
        mask_data_p = mask_data + (line * mask_linebytes);

     for(byte = 0; byte < mask_linebytes; byte++){

        source = (unsigned int)*mask_data_p++;

        dest = (0x1 & source);

        if((0x1 & source) == 0)
           mask_present = TRUE; /* bits are inverted at this stage */

        for(bit = 1; bit < 8; bit++){
        
           dest = dest << 1;
           source = source >> 1;
           dest = dest | (0x1 & source);

           if((0x1 & source) == 0)
              mask_present = TRUE; /* bits are inverted at this stage */

        }

        *mask_buffer_p++ = ~(unsigned char)dest;

     }        

  }

  if(!mask_present){

     free(mask_buffer);
     mask_buffer = NULL;
  }

  return(mask_buffer);
}
 
