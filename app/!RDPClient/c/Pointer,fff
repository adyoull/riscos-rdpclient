extern int Pointer_PlotArea(pointer_block *last_pointer, wimp_point *last_pos,
                            pointer_block *next_pointer, wimp_point *next_pos,
                            wimp_rect *area1, wimp_rect *area2)
{
 /*
  * Calculate update areas for pointer movement
  */
  int top_left_1_x, top_left_1_y, bottom_right_1_x, bottom_right_1_y;
  int top_left_2_x, top_left_2_y, bottom_right_2_x, bottom_right_2_y;
  int area_count;
  int area_index;
  BOOL overlap;

  area_count = 0;
  area_index = 0;
  
  if(last_pointer == NULL && next_pointer == NULL){
     return(0); /* nothing needs updating */
  }

  if(last_pointer != NULL){
     top_left_1_x = last_pos->x - last_pointer->origin.x;
     top_left_1_y = last_pos->y - last_pointer->origin.y;
     bottom_right_1_x = top_left_1_x + (last_pointer->base_sprite)->size.x;
     bottom_right_1_y = top_left_1_y + (last_pointer->base_sprite)->size.y;

     area_count++; /* first rectangle needs updating */
     area_index = 1;
  }

  if(next_pointer != NULL){
     top_left_2_x = next_pos->x - next_pointer->origin.x;
     top_left_2_y = next_pos->y - next_pointer->origin.y;
     bottom_right_2_x = top_left_2_x + (next_pointer->base_sprite)->size.x;
     bottom_right_2_y = top_left_2_y + (next_pointer->base_sprite)->size.y;

     area_count++; /* second rectangle needs updating */
     area_index = 2;
  }

//fprintf(stderr, "Pointer_PlotArea()  area_count=%i  area_index=%i\n", area_count, area_index);

  if(area_count == 1){
     if(area_index == 1){
        area1->min.x = top_left_1_x;
        area1->min.y = top_left_1_y;
        area1->max.x = bottom_right_1_x;
        area1->max.y = bottom_right_1_y;
     }
     else{
        area1->min.x = top_left_2_x;
        area1->min.y = top_left_2_y;
        area1->max.x = bottom_right_2_x;
        area1->max.y = bottom_right_2_y;
     }
  }
  else if(area_count == 2){
    /*
     * If rectangles overlap, do one update on rectangle covering both,
     * otherwise do two updates with both rectangles
     */
     overlap = FALSE;

//fprintf(stderr, "top_left_1_x=%i  top_left_1_y=%i  bottom_right_1_x=%i  bottom_right_1_y=%i\ntop_left_2_x=%i  top_left_2_y=%i  bottom_right_2_x=%i  bottom_right_2_y=%i\n", top_left_1_x, top_left_1_y, bottom_right_1_x, bottom_right_1_y, top_left_2_x, top_left_2_y, bottom_right_2_x, bottom_right_2_y);

     if(top_left_1_x >= top_left_2_x && top_left_1_x <= bottom_right_2_x &&
        top_left_1_y >= top_left_2_y && top_left_1_y <= bottom_right_2_y)
        overlap = TRUE;
     else if(bottom_right_1_x >= top_left_2_x && bottom_right_1_x <= bottom_right_2_x &&
             bottom_right_1_y >= top_left_2_y && bottom_right_1_y <= bottom_right_2_y)
        overlap = TRUE;
     else if(top_left_1_x >= top_left_2_x && top_left_1_x <= bottom_right_2_x &&
             bottom_right_1_y >= top_left_2_y && bottom_right_1_y <= bottom_right_2_y)
        overlap = TRUE;
     else if(bottom_right_1_x >= top_left_2_x && bottom_right_1_x <= bottom_right_2_x &&
             top_left_1_y >= top_left_2_y && top_left_1_y <= bottom_right_2_y)
        overlap = TRUE;

//fprintf(stderr, "overlap=%i\n", overlap);

     if(overlap){
        if(top_left_1_x < top_left_2_x)
           area1->min.x = top_left_1_x;
        else
           area1->min.x = top_left_2_x;

        if(top_left_1_y < top_left_2_y)
           area1->min.y = top_left_1_y;
        else
           area1->min.y = top_left_2_y;

        if(bottom_right_1_x > bottom_right_2_x)
           area1->max.x = bottom_right_1_x;
        else
           area1->max.x = bottom_right_2_x;

        if(bottom_right_1_y > bottom_right_2_y)
           area1->max.y = bottom_right_1_y;
        else
           area1->max.y = bottom_right_2_y;

        area_count = 1;
     }
     else{
        area1->min.x = top_left_1_x;
        area1->min.y = top_left_1_y;
        area1->max.x = bottom_right_1_x;
        area1->max.y = bottom_right_1_y;

        area2->min.x = top_left_2_x;
        area2->min.y = top_left_2_y;
        area2->max.x = bottom_right_2_x;
        area2->max.y = bottom_right_2_y;
     }
  }

  return(area_count);
}

/******************************************************************************/

extern BOOL Pointer_SetHardwarePointer(pointer_block *pointerblock)
{
 /*
  * Programs hardware pointer with sprite in pointerblock
  */
  if(pointerblock == NULL){
    /*
     * turn off pointer
     */
     set_pointer_shape(0);
  }
  else{
    /*
     * program 3 colour pointer into hardware
     */

     if(hardware_pointer_bank == 3)
        hardware_pointer_bank = 4;
     else     
        hardware_pointer_bank = 3;

     if(pointerblock->hardware_sprite == NULL)
        create_hardware_sprite(pointerblock);

     if(pointerblock->hardware_sprite != NULL){
        os_spriteop_setpointer(pointerblock->hardware_sprite,
                               hardware_pointer_bank,
                               pointerblock->origin.x, pointerblock->origin.y);
     }
  }

  return(TRUE);
}

/******************************************************************************/

extern void Pointer_MoveHardwarePointer(int x, int y)
{
 /*
  * Moves hardware pointer to supplied coordinates
  * origin (0, 0) is on top left
  */
  wimp_point coord;

  Display_DisplayToScreenCoords(&coord, &coord);

  set_pointer_position(coord.x, coord.y);
}

