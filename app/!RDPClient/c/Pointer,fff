static void populate_histogram(pointer_block *pointerblock)
{
  spritelib_block *base_sprite = pointerblock->base_sprite;
  BOOL use_mask = (pointerblock->base_sprite)->has_mask;
  BOOL use_colour;
  unsigned char *image_24_ptr;
  unsigned char *image_24_ptr2;
  unsigned char *mask_ptr;
  unsigned char *mask_ptr2;
  unsigned int pixel_24;
  int mask;
  unsigned int mask_pixel;
  int y_counter;
  int x_counter;
  int index;
  int bar;

  clear_histogram(histogram_bars);

  image_24_ptr = (unsigned char *)base_sprite->spritearea + base_sprite->image;
  image_24_ptr2 = image_24_ptr;
  if(use_mask){
     mask_ptr = (unsigned char *)base_sprite->spritearea + base_sprite->mask;
     mask_ptr2 = mask_ptr;
  }

  y_counter = base_sprite->size.y;

  while(y_counter > 0){

     x_counter = base_sprite->size.x;

     if(use_mask){
        mask = 0;
        mask_pixel = *((unsigned int *)(mask_ptr));
        mask_ptr += 4;
     }

     while(x_counter > 0){

        pixel_24 = *((unsigned int *)(image_24_ptr));

        pixel_24 = pixel_24 << 8; /* convert into palette format */

        use_colour = FALSE;

        if(use_mask){
           if((mask_pixel & 0x1) == 1)
              use_colour = TRUE;
        }
        else{
           if(pixel_24 != 0x00000000){
              pixel_24 = ~pixel_24 & 0xFFFFFF00;
              use_colour = TRUE;
           }
        }

        if(use_colour){

           bar = -1;

           if(histogram_bars > 0){

              for(index = 0; index < histogram_bars; index++){

                  if(histogram_colour[index].value == pixel_24){
                     bar = index;
                     break;
                  }
              }
           }

           if(bar == -1 && histogram_bars < HISTOGRAM_BARS){

              histogram_colour[histogram_bars].value = pixel_24;
              histogram_value[histogram_bars] += 1;

              histogram_bars++;
           }
           else{

              histogram_value[bar] += 1;

           }

        }

        if(use_mask){
           mask++;

           mask_pixel = mask_pixel >> 1;

           if(mask == 32){

              mask_pixel = *((unsigned int *)(mask_ptr));
              mask_ptr += 4;

              mask = 0;
           }
        }

        image_24_ptr += 4;

        x_counter--;

     }

     image_24_ptr2 += base_sprite->linebytes;
     image_24_ptr = image_24_ptr2;

     if(use_mask){
        mask_ptr2 += base_sprite->masklinebytes;
        mask_ptr = mask_ptr2;
     }

     y_counter--;
  }
/*
  if(histogram_bars > 0){

     fprintf(stderr, "bar count %i\n", histogram_bars);

     fprintf(stdout, "bar count %i\n", histogram_bars);

     for(index = 0; index < histogram_bars; index++){

         fprintf(stderr, "r %i g %i b %i  count %i\n",
                 histogram_colour[index].data.red,
                 histogram_colour[index].data.green,
                 histogram_colour[index].data.blue,
                 histogram_value[index]);

         fprintf(stdout, "r %i g %i b %i  count %i\n",
                 histogram_colour[index].data.red,
                 histogram_colour[index].data.green,
                 histogram_colour[index].data.blue,
                 histogram_value[index]);

     }

     fprintf(stderr, "\n\n");

     fprintf(stdout, "\n\n");

  }
*/
}

/******************************************************************************/

static void make_palette(palette_entry *palette)
{
  int index;
  palette_entry colour;
  int count;
  int max_index_1;
  int max_index_2;

  for(index = 0; index < 4; index++){
     palette[index].value = 0;
  }

  if(histogram_bars > 0){

    /*
     * find most popular colour for colour 1
     */
     count = 0;
     colour.value = 0;
     max_index_1 = -1;

     for(index = 0; index < histogram_bars; index++){

        if(histogram_value[index] > count){
           count = histogram_value[index];
           colour.value = histogram_colour[index].value;
           max_index_1 = index;
        }

     }
     palette[1].value = colour.value;
  }

  if(histogram_bars > 1){

    /*
     * Find next most popular colour for colour 2
     */
     count = 0;
     colour.value = 0;
     max_index_2 = -1;
     
     for(index = 0; index < histogram_bars; index++){

        if(index != max_index_1 &&
           histogram_value[index] > count){
           count = histogram_value[index];
           colour.value = histogram_colour[index].value;
           max_index_2 = index;
        }

     }
     palette[2].value = colour.value;
  }

  if(histogram_bars > 2){

    /*
     * Find next most popular colour for colour 3
     */
     count = 0;
     colour.value = 0;

     for(index = 0; index < histogram_bars; index++){

        if(index != max_index_1 && index != max_index_2 &&
           histogram_value[index] > count){
           count = histogram_value[index];
           colour.value = histogram_colour[index].value;
        }

     }
     palette[3].value = colour.value;
  }

  palette[0].value = palette[1].value;
/*
  fprintf(stderr, "palette\n");
  fprintf(stdout, "palette\n");

  for(index = 0; index < 4; index++){

    fprintf(stderr, "r %i g %i b %i\n", palette[index].data.red, palette[index].data.green,
            palette[index].data.blue);
    fprintf(stdout, "r %i g %i b %i\n", palette[index].data.red, palette[index].data.green,
            palette[index].data.blue);

  }

  fprintf(stderr, "\n\n");
  fprintf(stdout, "\n\n");
*/
}

/******************************************************************************/

static void create_hardware_sprite(pointer_block *pointerblock)
{
  BOOL use_mask;
  BOOL use_colour;
  palette_entry palette[4];
  int index;
  spritelib_block *base_sprite;
  spritelib_block *hardware_sprite;
  int size_x = (pointerblock->base_sprite)->size.x;
  int size_y = (pointerblock->base_sprite)->size.y;
  palette_entry *sprite_palette;
  palette_entry *sprite_palette_ptr;
  unsigned char *image_24_ptr;
  unsigned char *image_24_ptr2;
  unsigned char *mask_ptr;
  unsigned char *mask_ptr2;
  unsigned char *image_2_ptr;
  unsigned char *image_2_ptr2;
  int y_counter;
  int x_counter;
  unsigned int pixel_24;
  unsigned char pixel_8;
  int colour_index;
  int nibble;
  int mask;
  unsigned int mask_pixel;
  _kernel_swi_regs r;
  use_mask = (pointerblock->base_sprite)->has_mask;

 /*
  * Create 4 colour sprite
  */
  hardware_sprite = SpriteLib_Create(size_x, size_y, 2, TRUE, FALSE);

  if(hardware_sprite == NULL)
     return;

  pointerblock->hardware_sprite = hardware_sprite;
  base_sprite = pointerblock->base_sprite;

 /*
  * Create palette of most popular 3 colours
  */
  populate_histogram(pointerblock);

  make_palette(palette);

 /*
  * Set palette of sprite
  */
  sprite_palette = (palette_entry *)((unsigned char *)hardware_sprite->spritearea +
                                     hardware_sprite->palette);
  sprite_palette_ptr = sprite_palette;
  
  for(index = 0; index < 4; index++){
     sprite_palette_ptr->value = palette[index].value;
     sprite_palette_ptr++;
     sprite_palette_ptr->value = palette[index].value;
     sprite_palette_ptr++;
  }

  image_24_ptr = (unsigned char *)base_sprite->spritearea + base_sprite->image;
  image_24_ptr2 = image_24_ptr;
  if(use_mask){
     mask_ptr = (unsigned char *)base_sprite->spritearea + base_sprite->mask;
     mask_ptr2 = mask_ptr;
  }
  image_2_ptr = (unsigned char *)hardware_sprite->spritearea + hardware_sprite->image;
  image_2_ptr2 = image_2_ptr; 
  
  y_counter = base_sprite->size.y;

  while(y_counter > 0){

     x_counter = base_sprite->size.x;

     nibble = 0;
     pixel_8 = 0;
     if(use_mask){
        mask = 0;
        mask_pixel = *((unsigned int *)(mask_ptr));
        mask_ptr += 4;
     }

     while(x_counter > 0){

        pixel_24 = *((unsigned int *)(image_24_ptr));

        pixel_24 = pixel_24 << 8; /* convert into palette format */
        
        colour_index = 0;

        use_colour = FALSE;

        if(use_mask){
           if((mask_pixel & 0x1) == 1)
              use_colour = TRUE;
        }
        else{
           if(pixel_24 != 0x00000000){
              pixel_24 = ~pixel_24 & 0xFFFFFF00;
              use_colour = TRUE;
           }
        }

        if(use_colour){

          /*
           * find colour if already in palette
           */
           for(index = 1; index <= 3; index++){
              if(palette[index].value == pixel_24){
                 colour_index = index;
                 break;
              }
           }

           if(colour_index == 0){
             /*
              * if exact match not found, find nearest colour
              */
              r.r[0] = (int)pixel_24;
              r.r[1] = 19; /* 4 colour mode */
              r.r[2] = (int)sprite_palette;
              if(_kernel_swi(SWI_XOS_Bit | SWI_ColourTrans_ReturnColourNumberForMode, &r, &r)
                 == NULL){
                 colour_index = r.r[0];
              }
              if(colour_index <= 0)
                 colour_index = 1;
              if(colour_index > 3)
                 colour_index = 1;
           }
        }

        if(use_mask){
           mask++;

           mask_pixel = mask_pixel >> 1;

           if(mask == 32){

              mask_pixel = *((unsigned int *)(mask_ptr));
              mask_ptr += 4;

              mask = 0;
           }
        }

       /*
        * colour_index is the palette number of the colour
        */

        nibble++;

        pixel_8 = pixel_8 >> 2;
        pixel_8 = pixel_8 | ((colour_index & 0x3) << 6);

        if(nibble == 4){

           *image_2_ptr = pixel_8;
           image_2_ptr++;

           nibble = 0;
           pixel_8 = 0;
        }

        image_24_ptr += 4;

        x_counter--;

     }

     if(nibble > 0)
        *image_2_ptr = pixel_8;

     image_24_ptr2 += base_sprite->linebytes;
     image_24_ptr = image_24_ptr2;

     if(use_mask){
        mask_ptr2 += base_sprite->masklinebytes;
        mask_ptr = mask_ptr2;
     }

     image_2_ptr2 += hardware_sprite->linebytes;
     image_2_ptr = image_2_ptr2;

     y_counter--;
  }

}

/******************************************************************************/

static BOOL os_spriteop_setpointer(spritelib_block *sprite,
                                   int hardware_bank, int origin_x, int origin_y)
{
  sprite_header *header;
  BOOL success;
  _kernel_swi_regs r;
  success = FALSE;

  header = (void *) ((char *)sprite->spritearea + (sprite->spritearea)->firstoffset);

  r.r[0] = 36 + 512;
  r.r[1] = (int)sprite->spritearea;
  r.r[2] = (int)header;
  r.r[3] = hardware_bank;
  r.r[4] = origin_x;
  r.r[5] = origin_y;
  r.r[6] = 0;
  r.r[7] = 0;
  if(_kernel_swi( SWI_XOS_Bit | SWI_OS_SpriteOp, &r, &r ) == NULL)
     success = TRUE;

  return(success);
}

/******************************************************************************/

static void set_pointer_shape(int shape)
{
  int r1out, r2out, r1in;
  int shape_masked;

  shape_masked = shape & 0x7;

  OS_Byte(osbyte_SELECTPOINTER, -1, 0, &r1out, &r2out);
  
  r1in = ~0x7 & r1out; /* reset point shape bits (this turns off the pointer) */

  r1in = r1in | shape_masked; /* enable pointer shape */

  OS_Byte(osbyte_SELECTPOINTER, r1in, 0, &r1out, &r2out);
}

/******************************************************************************/

static int get_pointer_shape(void)
{
  int r1out, r2out;

  OS_Byte(osbyte_SELECTPOINTER, -1, 0, &r1out, &r2out);

  return(0x7 & r1out);
}

/******************************************************************************/

static void link_mouse_to_pointer(void)
{
  int r1out, r2out, r1in;

  OS_Byte(osbyte_SELECTPOINTER, -1, 0, &r1out, &r2out);
  
  r1in = ~0x80 & r1out; /* reset enable bit 7 (this links mouse to pointer) */

  OS_Byte(osbyte_SELECTPOINTER, r1in, 0, &r1out, &r2out);
}

/******************************************************************************/

static void set_pointer_position(int x, int y)
{
  unsigned char block[5];

  block[0] = 3; /* set mouse position */
  block[1] = x & 0x00FF;
  block[2] = (x & 0xFF00) >> 8;
  block[3] = y & 0x00FF;
  block[4] = (y & 0xFF00) >> 8;

  OS_Word(osword_DEFINEPOINTERANDMOUSE, &block);
}

/******************************************************************************/

static void clear_histogram(int bars)
{
  memset(histogram_value, 0, bars * sizeof(int));

  memset(histogram_colour, 0, bars * sizeof(palette_entry));

  histogram_bars = 0;
}
