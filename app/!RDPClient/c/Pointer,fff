extern BOOL Pointer_SetData(pointer_block *pointerblock,
                            int image_bpp, unsigned char *image_data,
                            unsigned char *mask_data)
{
  palette_entry *pointer_palette;
 /*
  * Fill pointer sprite with image data and 1bpp mask data
  */
  if(pointerblock == NULL)
     return(FALSE);

  pointer_palette = NULL;

  if(image_bpp == 8){
     pointer_palette = Display_GetCustomPalette();
  }

 /*
  * Fill 24bit sprite with image and mask data
  */
  SpriteLib_SetImageDataTrans(pointerblock->base_sprite, image_bpp,
                              (unsigned char *)image_data, pointer_palette,
                              (image_bpp != 1)); /* only 1bpp image is not inverted */

  if(mask_data != NULL)
     SpriteLib_SetMaskData(pointerblock->base_sprite, (unsigned char *)mask_data, FALSE);

