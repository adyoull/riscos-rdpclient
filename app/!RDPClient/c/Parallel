static RD_NTSTATUS Parallel_Create(uint32 device_id, uint32 access, uint32 share_mode,
                                uint32 disposition, uint32 flags,
                                char *filename, RD_NTHANDLE *handle)
{
 /*
  * Initialise connection to parallel port
  */
  fprintf(stderr, "Called Parallel_Create(device_id=%li, access=%li, share_mode=%li, disposition=%li, flags=%li, filename='%s', handle=%li, *handle=%li)\n", device_id, access, share_mode, disposition, flags, filename, handle, *handle);

 /* return STATUS_ACCESS_DENIED */

 /*
  * Return success state
  */
//  *handle = 0;
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Parallel_Close(RD_NTHANDLE handle)
{
 /*
  * Close connetion to parallel port
  */
  fprintf(stderr, "Called Parallel_Close(handle=%li)\n", handle);

  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Parallel_Read(RD_NTHANDLE handle, uint8 *data, uint32 length, uint32 offset,
                                 uint32 *result)
{
 /*
  * Read up to 'length' bytes from parallel port into 'data'.
  * Return number of bytes read in 'result'
  */
  fprintf(stderr, "Called Parellel_Read(handle=%li, data=%li, *data=%c, length=%li, offset=%li)\n", handle, data, *data, length, offset);

  *result = 0;
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Parallel_Write(RD_NTHANDLE handle, uint8 *data, uint32 length, uint32 offset,
                                  uint32 *result)
{
 /*
  * Write up to 'length' bytes to serial port from 'data'.
  * Return number of bytes written in 'result'
  */
  fprintf(stderr, "Called Parallel_Write(handle=%li, data=%li, length=%li, offset=%li)\n", handle, data, length, offset);

  *result = 0;
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Parallel_DeviceControl(RD_NTHANDLE handle, uint32 request,
                                          STREAM in, STREAM out)
{
 /*
  * Read and Write various configuration parameters
  */
  fprintf(stderr, "Called Parallel_DeviceControl(handle=%li, request=%li)\n", handle, request);

  return(RD_STATUS_SUCCESS);
}

