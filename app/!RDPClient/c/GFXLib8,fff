/******************************************************************************/

static void PlotSpriteTiledToSprite_8_Copy_line(int source_start,
                                                int source_width,
                                                unsigned char **source_area,
                                                int source_initial_x,
                                                unsigned char **dest_area,
                                                int dest_start,
                                                int plot_length)
{
  unsigned char *source_ptr;
  unsigned char *dest_ptr;
  int source_x;
  int dest_x_counter;
  
  source_ptr = (*source_area) + source_start + source_initial_x;
  dest_ptr = (*dest_area) + dest_start;

  source_x = source_initial_x;
  dest_x_counter = plot_length;

  while(dest_x_counter > 0){

     *dest_ptr = *dest_ptr = *source_ptr;
     source_ptr++;
     dest_ptr++;

     dest_x_counter--;
     
     source_x++;
 
     if(source_x >= source_width){
        source_ptr = (*source_area) + source_start;
        source_x = 0;
     }
  }

}

