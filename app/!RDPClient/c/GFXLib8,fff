extern void GFXLib_PlotSpriteToSprite_8_AndInverted(int source_linebytes,
                                                    int dest_linebytes,
                                                    int plot_length,
                                                    int plot_lines,
                                                    unsigned char **source_area,
                                                    int source_start,
                                                    unsigned char **dest_area,
                                                    int dest_start)
{
  unsigned char *source_ptr = (*source_area) + source_start;
  unsigned int *source_ptr32;
  unsigned char *source_ptr2 = source_ptr;
  unsigned char *dest_ptr = (*dest_area) + dest_start;
  unsigned int *dest_ptr32;
  unsigned char *dest_ptr2 = dest_ptr;
  int dest_y_counter = plot_lines;
  int dest_x_counter;
  unsigned int source_pixel;

  if(((unsigned int)source_ptr & 0x3) == ((unsigned int)dest_ptr & 0x3)){
    /*
     * both source and dest are aligned the same
     */

     while(dest_y_counter > 0){

        dest_x_counter = plot_length;

        while(dest_x_counter > 0 && ((unsigned int)dest_ptr & 0x3) != 0){

           *dest_ptr = *dest_ptr & (~ *source_ptr);
           source_ptr++;
           dest_ptr++;

           dest_x_counter--;

        }

        if(dest_x_counter >= 4){
           source_ptr32 = (unsigned int *)source_ptr;
           dest_ptr32 = (unsigned int *)dest_ptr;

           do{

              *dest_ptr32 = *dest_ptr32 & (~ *source_ptr32);
              source_ptr32++;
              dest_ptr32++;

              dest_x_counter -= 4;

           }while(dest_x_counter >= 4);

           if(dest_x_counter > 0){
              source_ptr = (unsigned char *)source_ptr32;
              dest_ptr = (unsigned char *)dest_ptr32;
           }
        }

        while(dest_x_counter > 0){

           *dest_ptr = *dest_ptr & (~ *source_ptr);
           source_ptr++;
           dest_ptr++;

           dest_x_counter--;

        }

        source_ptr2 += source_linebytes;
        source_ptr = source_ptr2;
        
        dest_ptr2 += dest_linebytes;
        dest_ptr = dest_ptr2;

        dest_y_counter--;
     }
  }
  else{
    /*
     * source and dest are not aligned
     */
     while(dest_y_counter > 0){

        dest_x_counter = plot_length;

        while(dest_x_counter > 0 && ((unsigned int)dest_ptr & 0x3) != 0){

           *dest_ptr = *dest_ptr & (~ *source_ptr);
           source_ptr++;
           dest_ptr++;

           dest_x_counter--;

        }

        if(dest_x_counter >= 4){
           dest_ptr32 = (unsigned int *)dest_ptr;

           do{

              source_pixel = *source_ptr++;
              source_pixel = source_pixel | (*source_ptr++ << 8);
              source_pixel = source_pixel | (*source_ptr++ << 16);
              source_pixel = source_pixel | (*source_ptr++ << 24);

              *dest_ptr32 = *dest_ptr32 & (~ source_pixel);
              dest_ptr32++;

              dest_x_counter -= 4;

           }while(dest_x_counter >= 4);

           if(dest_x_counter > 0){
              dest_ptr = (unsigned char *)dest_ptr32;
           }
        }

        while(dest_x_counter > 0){

           *dest_ptr = *dest_ptr & (~ *source_ptr);
           source_ptr++;
           dest_ptr++;

           dest_x_counter--;

        }

        source_ptr2 += source_linebytes;
        source_ptr = source_ptr2;
        
        dest_ptr2 += dest_linebytes;
        dest_ptr = dest_ptr2;

        dest_y_counter--;
     }
  }

}

