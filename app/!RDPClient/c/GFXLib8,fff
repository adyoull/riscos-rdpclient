extern void GFXLib_PlotSpriteToSprite_8_Copy(int source_linebytes,
                                             int dest_linebytes,
                                             int plot_length,
                                             int plot_lines,
                                             unsigned char **source_area,
                                             int source_start,
                                             unsigned char **dest_area,
                                             int dest_start)
{
  unsigned char *source_ptr = (*source_area) + source_start;
  unsigned char *dest_ptr = (*dest_area) + dest_start;
  int y_index;

  for(y_index = 0; y_index < plot_lines; y_index++){

     memcpy(dest_ptr, source_ptr, plot_length);

     source_ptr += source_linebytes;
     dest_ptr += dest_linebytes;

  }

}

