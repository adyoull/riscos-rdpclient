static void multi_line_text_plot(char *text, int x, int y, int lines)
{
 /*
  * Plot multi line text
  */
  int max_width = logblock->current_window_size.x - plot_BORDER_X - plot_BORDER_X;
  int width = 0; /* width of text on previous lines */
  int index = 0; /* currect character index */
  int separator_index = 0; /* index of separator on current line */
  int last_separator_index = 0; /* index of separator on previous line */
  int length = strlen(text);
  char character;
  int plot_y = y + ((lines - 1) * plot_LINE_HEIGHT);

  while(index < length){

    character = text[index];

    if(character == ' ' || character == '\t' || character == '\n')
       separator_index = index;

    if(wimp_textop_width(text, index + 1) - width > max_width){
      /*
       * width of text after all previous lines is greater than line width
       */

       if(separator_index > last_separator_index){
         /*
          * there is a separator character in this line so make it the
          * last character in the line and move the scan point back to it
          */

          index = separator_index;
       }
       else{
         /*
          * otherwise separator point is the previous character as no
          * actual separators are in the line
          */

          index -= 1;
       }

      /*
       * always make the end of this line, the separator
       */
       separator_index = index;

      /*
       * plot this line
       */
       if(last_separator_index == 0){
          if(index + 1 <= buffer_SIZE){
             strncpy(buffer, text, index + 1);
             buffer[index + 1] = '\0';
          }
          else
             buffer[0] = '\0';
       }
       else{
          if(index - last_separator_index <= buffer_SIZE){
             strncpy(buffer, text + last_separator_index + 1, index - last_separator_index);
             buffer[index - last_separator_index] = '\0';
          }
          else
             buffer[0] = '\0';
       }

       wimp_textop_plot(buffer, x, plot_y);

       plot_y -= plot_LINE_HEIGHT;


       last_separator_index = index;

      /*
       * update width to be all lines including this one
       */
       width = wimp_textop_width(text, index + 1);

     }

     index += 1;
  }

  if(length - last_separator_index <= buffer_SIZE){
     strncpy(buffer, text + last_separator_index + 1, length - last_separator_index);
     buffer[length - last_separator_index] = '\0';

     wimp_textop_plot(buffer, x, plot_y);
  }

}

/******************************************************************************/

static void enable_fontchange_message(void)
{
  int message_list[] = {message_WIMPFONTCHANGE, 0};

  Wimp_AddMessages(message_list);
}

/******************************************************************************/

static void wimp_textop_colours(unsigned int foreground, unsigned int background)
{
 /*
  * Sets text colours
  */
  _kernel_swi_regs r;

  r.r[0] = 0;
  r.r[1] = (int)foreground;
  r.r[2] = (int)background;

  _kernel_swi(SWI_XOS_Bit | SWI_Wimp_TextOp, &r, &r);
}

/******************************************************************************/

static int wimp_textop_width(char *text, int length)
{
  int plot_length;
 /*
  * Calculates width of a single line of text of up to length characters.
  * If length is 0 then whole string is calculated.
  */
  _kernel_swi_regs r;
  plot_length = 0;

  r.r[0] = 1;
  r.r[1] = (int)text;
  r.r[2] = length;

  if(_kernel_swi(SWI_XOS_Bit | SWI_Wimp_TextOp, &r, &r) == NULL){

     plot_length = r.r[0];

  }

  return(plot_length);
}

/******************************************************************************/

static void wimp_textop_plot(char *text, int x, int y)
{
 /*
  * Plot text left justified at x and y coordinates
  */
  _kernel_swi_regs r;

  r.r[0] = 2;
  r.r[1] = (int)text;
  r.r[2] = -1;
  r.r[3] = -1;
  r.r[4] = x;
  r.r[5] = y;

  _kernel_swi(SWI_XOS_Bit | SWI_Wimp_TextOp, &r, &r);
}
