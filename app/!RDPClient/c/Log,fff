static void set_quit_on_close(BOOL quit_on_close, BOOL force)
{
  char text[100];

  if((logblock->quit_on_close != quit_on_close || force) &&
     logblock->main_window != NULL){

     logblock->quit_on_close = quit_on_close;
     
     if(quit_on_close)
        Msgs_Lookup("mlog.quit", text, 90);
     else
        Msgs_Lookup("mlog.close", text, 90);

     Icon_SetText(logblock->main_window, icon_CLOSE, text);

  }

}

