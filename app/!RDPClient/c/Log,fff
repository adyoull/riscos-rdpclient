extern BOOL Log_OpenWindow(void)
{
 /*
  * Open log window
  */

  if(logblock != NULL){

     if(logblock->main_window != NULL)
        Pane2_Show(logblock->main_window, open_CENTERED);

     return(TRUE);
  }

  return(FALSE);
}

/******************************************************************************/

extern BOOL Log_OpenWindowIfAnyQuitOnClose(void)
{
 /*
  * Open log window if any messages are present and sets quit on close
  * or quits straight away of no messages
  */

  if(logblock != NULL){

     if(logblock->main_window != NULL){

        if(logblock->messages > 0){

           Log_SetQuitOnClose(TRUE);

           Pane2_Show(logblock->main_window, open_CENTERED);

        }
        else{

           rdpclient_quit = TRUE;

        }

     }

     return(TRUE);
  }
  else
     rdpclient_quit = TRUE;

  return(FALSE);
}

/******************************************************************************/

extern BOOL Log_OpenWindowIfErrorsSetQuitOnClose(BOOL quit_on_close)
{
 /*
  * Open log window if any errors are present and sets quit on close
  * or quits straight away if no error messages
  */
  BOOL open = FALSE;
  log_text_block *item;
  BOOL success = FALSE;

  if(logblock != NULL){

     if(logblock->main_window != NULL){

        if(logblock->messages > 0){

           item = LinkList_NextItem(&(logblock->text_blocks));

           while(item != NULL && !open){

              if(item->message_type == message_type_ERROR)
                 open = TRUE;

              item = LinkList_NextItem(&(item->header));

           }

        }

     }

     success = TRUE;
  }

  if(open){

     Log_SetQuitOnClose(quit_on_close);

     Pane2_Show(logblock->main_window, open_CENTERED);

  }
  else if(!rdpclient_quit)
     rdpclient_quit = quit_on_close;

  return(success);
}

/******************************************************************************/

extern void Log_CloseWindow(void)
{
 /*
  * Close log window
  */
  if(logblock != NULL){

     if(logblock->main_window != NULL){
        Pane2_Hide(logblock->main_window);

        RDPClient_HideSaveWindow();
     }

     if(logblock->quit_on_close)
        rdpclient_quit = TRUE;
  }

}

/******************************************************************************/

extern BOOL Log_AddMessage(int message_type, char *text)
{
 /*
  * Add a message of text and message_type
  */
  log_text_block *item;
  int length;
  int index;

  if(logblock == NULL)
     return(FALSE);

  if(logblock->messages >= log_MAX_MESSAGES)
     remove_last_message();
     
  item = malloc(sizeof(log_text_block));

  if(item == NULL)
     return(FALSE);

  LinkList_InitItem(&(item->header));

  item->message_type = message_type;

  length = strlen(text);

  if(length > 0){

     if(text[length - 1] == '\n')
        length -= 1;

  }

  item->text = malloc(length + 1);

  if(item->text == NULL){
     free(item);
     return(FALSE);
  }

  strncpy(item->text, text, length);
  (item->text)[length] = '\0';

  for(index = 0; index < length; index++){

     if((item->text)[index] == '\n')
        (item->text)[index] = ' ';

  }

  text_height(item->text, &(item->height), &(item->lines));

  LinkList_AddToHead(&(logblock->text_blocks), &(item->header));

  logblock->messages++;

  update_window_height(item->height);

  if(message_type == message_type_ERROR){

     if(!Log_WindowOpen())
        Log_OpenWindow();

  }

  refresh_text();

  return(TRUE);
}

/******************************************************************************/

extern void Log_SetQuitOnClose(BOOL quit_on_close)
{
 /*
  * If quit_on_close is TRUE then app quits when log window is next
  * closed
  */
  if(logblock != NULL){

     set_quit_on_close(quit_on_close, FALSE);

  }

}

/******************************************************************************/

extern BOOL Log_Save(char *filename)
{
  BOOL success;
  log_text_block *item;
 /*
  * Save contents of log as text
  */
  FILE *channel;
  success = FALSE;

  channel = fopen(filename, "w");

  if(channel != NULL){

     success = TRUE;

     File_SetType(filename, filetype_TEXT);

     if(logblock != NULL){

        if(logblock->messages > 0){

           item = LinkList_NextItem(&(logblock->text_blocks));

           while(item != NULL){

              fprintf(channel, "%s\n", item->text);

              item = LinkList_NextItem(&(item->header));

           }

        }

     }

     fclose(channel);
  }

  return(success);
}

/******************************************************************************/

extern int Log_TextSize(void)
{
 /*
  * Returns length of all text in the log
  */
  int size = 0;
  log_text_block *item;

  if(logblock != NULL){

     if(logblock->messages > 0){

        item = LinkList_NextItem(&(logblock->text_blocks));

        while(item != NULL){

           size += strlen(item->text) + 1;

           item = LinkList_NextItem(&(item->header));

        }

     }

  }

  return(size);
}

/******************************************************************************/

extern BOOL Log_WindowOpen(void)
{
  BOOL open;
 /*
  * Returns TRUE if Log window is open
  */
  window_state windowstate;
  open = FALSE;

  if(logblock != NULL){

     if(logblock->main_window != NULL){

        if(Wimp_GetWindowState(logblock->main_window, &windowstate) == 0){

           if(windowstate.flags.data.open == 1)
              open = TRUE;

        }

     }

  }

  return(open);
}

/******************************************************************************/

extern BOOL Log_OpenWindowBehind(BOOL on_top, window_handle *open_behind)
{
  BOOL open;
 /*
  * Return handle for behind state to ensure that
  * no windows open above the log window
  */
  window_state windowstate;
  open = FALSE;

  if(logblock != NULL){

     if(logblock->main_window != NULL){

        if(Wimp_GetWindowState(logblock->text_window, &windowstate) == 0){

           if(windowstate.flags.data.open == 1){

              open = TRUE;

              if(on_top){

                 if(windowstate.openblock.behind != -1)
                    Pane2_Show(logblock->main_window, open_WHEREVER);

              }

              *open_behind = logblock->main_window;

           }

        }

     }

  }

  return(open);
}

