/******************************************************************************/

static void redraw_loop(window_redrawblock *redraw, log_block *block)
{
 /*
  * called to redraw the log window
  */
  BOOL more;
  log_text_block *item;
  int plot_x;
  int plot_top_y;
  int plot_bottom_y;
  BOOL intersect;
  BOOL finished;

  more = TRUE;

  while(more){

     if(logblock != NULL){

        wimp_textop_colours(colour32_BLACK, colour32_WHITE);
        GFX_CLG();

        plot_x = redraw->rect.min.x - redraw->scroll.x + logblock->plot_offset.x;
        plot_top_y = redraw->rect.max.y - redraw->scroll.y - logblock->plot_offset.y;

        intersect = FALSE;
        finished = FALSE;

        item = LinkList_NextItem(&(logblock->text_blocks));

        while(item != NULL){

           plot_bottom_y = plot_top_y - item->height;

           if(redraw->cliprect.max.y >= plot_bottom_y && redraw->cliprect.min.y <= plot_top_y){

              intersect = TRUE;

              set_text_colours(item->message_type);

              if(item->lines == 1)
                 wimp_textop_plot(item->text, plot_x, plot_bottom_y + plot_BASELINE_OFFSET);
              else
                 multi_line_text_plot(item->text, plot_x, plot_bottom_y + plot_BASELINE_OFFSET,
                                      item->lines);

#ifdef LINE_BORDER
              GFX_Move(redraw->rect.min.x - redraw->scroll.x, plot_top_y);
              GFX_Draw(redraw->rect.max.x - redraw->scroll.x, plot_top_y);

              GFX_Move(redraw->rect.min.x - redraw->scroll.x, plot_bottom_y);
              GFX_Draw(redraw->rect.max.x - redraw->scroll.x, plot_bottom_y);
#endif
           }
           else{

              if(intersect)
                 finished = TRUE;

           }

           plot_top_y = plot_bottom_y;

           item = LinkList_NextItem(&(item->header));

        }
/*
     fprintf(stderr, "min x %i  max x %i  min y %i  max y %i  scroll x %i  scroll y %i\n"
                     "clip min x %i  clip max x %i  clip min y %i  clip max y %i\n"
                     "topleft x %i  topleft y %i\n",
             redraw->rect.min.x, redraw->rect.max.x, redraw->rect.min.y, redraw->rect.max.y,
             redraw->scroll.x, redraw->scroll.y,
             redraw->cliprect.min.x, redraw->cliprect.max.x, redraw->cliprect.min.y,
             redraw->cliprect.max.y,
             redraw->rect.min.x - redraw->scroll.x, redraw->rect.max.y - redraw->scroll.y);
*/
     }
                     
     Wimp_GetRectangle(redraw, &more);
  }

}

