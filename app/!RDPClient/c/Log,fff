static void set_text_colours(int message_type)
{
  switch(message_type)
  {
    case message_type_TEXT:
      wimp_textop_colours(colour32_BLACK, colour32_WHITE);
      break;

    case message_type_WARNING:
      wimp_textop_colours(colour32_BLUE, colour32_WHITE);
      break;

    case message_type_ERROR:
      wimp_textop_colours(colour32_RED, colour32_WHITE);
      break;
  }
}

