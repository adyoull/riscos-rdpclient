static void text_height(char *text, int *height, int *lines)
{
 /*
  * Calculate height of wrapped text area based on current desktop font
  */
  int max_width = logblock->current_window_size.x - plot_BORDER_X - plot_BORDER_X;
  int width = 0; /* width of text on previous lines */
  int index = 0; /* currect character index */
  int separator_index = 0; /* index of separator on current line */
  int last_separator_index = 0; /* index of separator on previous line */
  int length = strlen(text);
  char character;

  *lines = 1;

  while(index < length){

    character = text[index];

    if(character == ' ' || character == '\t' || character == '\n')
       separator_index = index;

    if(wimp_textop_width(text, index + 1) - width > max_width){
      /*
       * width of text after all previous lines is greater than line width
       */

       if(separator_index > last_separator_index){
         /*
          * there is a separator character in this line so make it the
          * last character in the line and move the scan point back to it
          */

          index = separator_index;
       }
       else{
         /*
          * otherwise separator point is the previous character as no
          * actual separators are in the line
          */

          index -= 1;
       }

      /*
       * always make the end of this line, the separator
       */
       last_separator_index = index;
       separator_index = index;

      /*
       * update width to be all lines including this one
       */
       width = wimp_textop_width(text, index + 1);

       *lines += 1;

     }

     index += 1;
  }

  *height = *lines * plot_LINE_HEIGHT;

}

/******************************************************************************/

static void update_window_height(int height)
{
 /*
  * Update window height to accomodate extra text
  */

  logblock->total_height += height;

  if(logblock->total_height + plot_BORDER_Y + plot_BORDER_Y !=
     logblock->current_window_size.y){

     set_window_height();
  }
}

/******************************************************************************/

static void set_window_height(void)
{
 /*
  * Update text window height
  */
  int new_height;

  wimp_box newworkarea;

  new_height = logblock->total_height + plot_BORDER_Y + plot_BORDER_Y;

  if(new_height < logblock->min_window_size.y)
     new_height = logblock->min_window_size.y;

  if(new_height != logblock->current_window_size.y){

     newworkarea.min.x = 0;
     newworkarea.max.x = logblock->current_window_size.x;
     newworkarea.min.y = 0 - new_height;
     newworkarea.max.y = 0;

     Wimp_SetExtent(logblock->text_window, &newworkarea);

  }  
}

/******************************************************************************/

static void recalculate_all_heights(void)
{
 /*
  * Recalculate all heights (e.g. on font change)
  */
  log_text_block *item;

  item = LinkList_NextItem(&(logblock->text_blocks));

  logblock->total_height = 0;

  while(item != NULL){

     text_height(item->text, &(item->height), &(item->lines));

     logblock->total_height += item->height;

     item = LinkList_NextItem(&(item->header));

  }

  set_window_height();
}

/******************************************************************************/

static void remove_last_message(void)
{
 /*
  * Remove last message from the log if present
  */
  log_text_block *item;

  item = LinkList_LastItem(&(logblock->text_blocks));

  if(item != NULL){

     logblock->total_height -= item->height;
     
     LinkList_Unlink(&(logblock->text_blocks), &(item->header));

     free(item->text);

     free(item);

  }

}

