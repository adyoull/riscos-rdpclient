extern void Log_Init(void)
{
 /*
  * initialisation to be done on startup
  */
  wimp_point paneoffset;
  wimp_point panesize;
  window_info windowinfo;

  logblock = malloc(sizeof(log_block));

  if(logblock == NULL){
     Error_OutOfMemory(TRUE, "Message Log");
     return;
  }

  logblock->main_window = NULL;
  logblock->text_window = NULL;
  logblock->messages = 0;
  logblock->plot_offset.x = 0;
  logblock->plot_offset.y = 0;
  logblock->min_window_size.x = 0;
  logblock->min_window_size.y = 0;
  logblock->current_window_size.x = 0;
  logblock->current_window_size.y = 0;

  logblock->main_window = Pane2_CreateAndAddMain("Log", template_TITLEMIN);

  if(logblock->main_window == NULL)
     return;

  Pane2_ReadIcon(logblock->main_window, 0, "LogMessages", &paneoffset, &panesize);
  logblock->text_window = Pane2_CreateAndAddPane("LogMessages",
                                                 template_TITLEMIN,
                                                 logblock->main_window,
                                                 &paneoffset, &panesize,
                                                 pane2_FIXED|pane2_MAINTOP|pane2_PANETOP);
  if(logblock->text_window == NULL){
     Pane2_Delete(logblock->main_window);
     logblock->main_window = NULL;
     return;
  }

  Event_Claim(event_REDRAW, logblock->text_window, event_ANY, Redraw, logblock);
  Event_Claim(event_CLOSE, logblock->main_window, event_ANY, CloseWindow, logblock);
  Event_Claim(event_OPEN, logblock->main_window, event_ANY, OpenWindow, logblock);
  Event_Claim(event_CLICK, logblock->main_window, event_ANY, Click, logblock);
  Event_Claim(event_KEY, logblock->main_window, event_ANY, Key, logblock);

 /*
  * Set up text control
  */
  logblock->messages = 0;

  logblock->plot_offset.x = plot_BORDER_X;
  logblock->plot_offset.y = plot_BORDER_Y;

  Window_GetInfo(logblock->text_window, &windowinfo);

  logblock->min_window_size.x = windowinfo.block.workarearect.max.x -
                                windowinfo.block.workarearect.min.x;
  logblock->min_window_size.y = windowinfo.block.workarearect.max.y -
                                windowinfo.block.workarearect.min.y;

  logblock->current_window_size.x = logblock->min_window_size.x;
  logblock->current_window_size.y = logblock->min_window_size.y;

  logblock->total_height = 0;

  set_quit_on_close(FALSE, TRUE);

  LinkList_InitItem(&(logblock->text_blocks));

  Event_Claim(event_USERMESSAGE, event_ANY, event_ANY, UserMessage, logblock);

  enable_fontchange_message();
}

