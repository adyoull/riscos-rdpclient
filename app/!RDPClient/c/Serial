  */
  fprintf(stderr, "Called Serial_Create(device_id=%li, access=%li, share_mode=%li, disposition=%li, flags_and_attributes=%li, filename='%s', handle=%li, *handle=%li)\n", device_id, access, share_mode, disposition, flags_and_attributes, filename, handle, *handle);

 /* return STATUS_ACCESS_DENIED */

 /*
  * Return success state
  */
//  *handle = 0;
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Serial_Close(RD_NTHANDLE handle)
{
 /*
  * Close connetion to serial port
  */
  fprintf(stderr, "Called Serial_Close(handle=%li)\n", handle);

  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Serial_Read(RD_NTHANDLE handle, uint8 *data, uint32 length, uint32 offset,
                               uint32 *result)
{
 /*
  * Read up to 'length' bytes from serial port into 'data'.
  * Return number of bytes read in 'result'
  */
  fprintf(stderr, "Called Serial_Read(handle=%li, data=%li, *data=%c, length=%li, offset=%li)\n", handle, data, *data, length, offset);

  *result = 0;
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Serial_Write(RD_NTHANDLE handle, uint8 *data, uint32 length, uint32 offset,
                                uint32 *result)
{
 /*
  * Write up to 'length' bytes to serial port from 'data'.
  * Return number of bytes written in 'result'
  */
  fprintf(stderr, "Called Serial_Write(handle=%li, data=%li, length=%li, offset=%li)\n", handle, data, length, offset);

  *result = 0;
  return(RD_STATUS_SUCCESS);
}

/******************************************************************************/

static RD_NTSTATUS Serial_DeviceControl(RD_NTHANDLE handle, uint32 request,
                                        STREAM in, STREAM out)
{
 /*
  * Read and Write various configuration parameters
  */
  fprintf(stderr, "Called Serial_DeviceControl(handle=%li, request=%li)\n", handle, request);

  return(RD_STATUS_SUCCESS);
}

