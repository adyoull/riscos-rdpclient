/******************************************************************************/

static int sm_bufferstats(int stream)
{
  int bytes_left;
  _kernel_swi_regs r;
  bytes_left = 0;

  r.r[0] = (int)stream;

  if(_kernel_swi(SWI_XOS_Bit | SWI_StreamManager_BufferStats, &r, &r) == 0)
     bytes_left = r.r[0] - r.r[1];

 /*
  * r0 = added
  * r1 = played
  * r2 = freed
  */
  
  return(bytes_left);
}

