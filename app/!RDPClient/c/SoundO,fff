extern void Sound_Init(void)
{
 /*
  * initialisation to be done on startup
  */
  int index;

  sound_initialised = FALSE;
  sound_handle = 0;
  sound_stream = 0;
  installed_atexit = FALSE;
  sound_channels = 0;
  sound_bits = 0;

  sound_queue_length = 0;
  sound_queue_played = 0;

  sound_global_buffer_data = NULL;
  sound_global_buffer_length = 0;

  sound_delayed_start = FALSE;
  sound_delayed_start_time = 0;

  for(index = 0; index < SOUND_QUEUE_TOTAL_LENGTH; index++){
     sound_queue[index].data = NULL;
     sound_queue[index].length = 0;
  }

  sound_queue_flush_time = 0;
  sound_queue_dealloc = FALSE;
}

/******************************************************************************/

extern void Sound_Startup(void)
{
 /*
  * Start up sound system (only when configured to play sound)
  */
  if(!sound_initialised){

     if(!installed_atexit){
        atexit(Sound_Closedown);
        installed_atexit = TRUE;
     }

     sm_setdalimits(SOUND_DA_MAX_SIZE, SOUND_HEAP_MAX_SIZE);
     
     if(ssb_openstream(event_taskname, TRUE, SOUND_BLOCK_SIZE, &sound_handle)){

        if(ssb_returnstreamhandle(sound_handle, &sound_stream)){

           sm_setbuffer(sound_stream, SOUND_BUFFER_SIZE);

           ssb_volume(sound_handle, 0xFFFFFFFF);

           ssb_pause(sound_handle, TRUE);

           sound_channels = 2;
           sound_bits = 16;

           sound_initialised = TRUE;

        }
        else{

           ssb_closestream(sound_handle);

        }

     }

     if(!sound_initialised){

        sound_handle = 0;
        sound_stream = 0;

     }

  }
}

/******************************************************************************/

extern void Sound_Closedown(void)
{
 /*
  * shut down sound system
  */
  if(sound_initialised){

     ssb_closestream(sound_handle);

     sound_initialised = FALSE;
  }
}

/******************************************************************************/

extern void Sound_Poll(void)
{
 /*
  * Called frequently
  */

  flush_sound_queue();

  trigger_delayed_start(FALSE);

  dealloc_sound_queue();
}

