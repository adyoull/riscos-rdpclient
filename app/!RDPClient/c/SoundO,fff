static BOOL ssb_returnstreamhandle(int handle, int *stream)
{
  BOOL success;
  _kernel_swi_regs r;
  success = FALSE;

  *stream = 0;

  r.r[0] = (int)handle;

  if(_kernel_swi(SWI_XOS_Bit | SWI_SharedSoundBuffer_ReturnStreamHandle, &r, &r) == 0)
     success = TRUE;

  *stream = r.r[0];

  return(success);
}

