static void set_delayed_start(void)
{
  unsigned int time;
  
  if(sound_initialised){

     if(sm_bufferstats(sound_stream) == 0){

        while((time = Time_Monotonic()) == 0);

        sound_delayed_start_time = time + SOUND_DELAYED_START_TIME;

        sound_delayed_start = TRUE;

        ssb_pause(sound_handle, TRUE);

     }
     else
        ssb_pause(sound_handle, FALSE);
  }
}

/******************************************************************************/

static void trigger_delayed_start(BOOL immediate)
{
  unsigned int time;
  if(!sound_delayed_start)
     return;

  time = 0;

  if(sound_initialised){

     if(!immediate)
        while((time = Time_Monotonic()) == 0);

     if(immediate || time > sound_delayed_start_time){

        sound_delayed_start = FALSE;

        ssb_pause(sound_handle, FALSE);

     }
  }
}

/******************************************************************************/

static BOOL add_to_sound_queue(unsigned char *data, int length, uint16 tick, uint8 index)
{
  BOOL success = FALSE;
  int buffer_length;

  if(sound_queue_length < SOUND_QUEUE_TOTAL_LENGTH){

     sound_queue_dealloc = FALSE;

     buffer_length = sound_buffer_length(length);
     
     if(sound_queue[sound_queue_length].length != buffer_length){

        if(sound_queue[sound_queue_length].length != 0){
           MemMan_Free((memman_ptr) &(sound_queue[sound_queue_length].data));
           sound_queue[sound_queue_length].length = 0;
        }

        MemMan_Alloc((memman_ptr) &(sound_queue[sound_queue_length].data), buffer_length);
#ifdef SOUND_DEBUG
        fprintf(stderr, "buffer alloc ptr %i  size %i\n", sound_queue[sound_queue_length].data,
                buffer_length);
#endif
        if(sound_queue[sound_queue_length].data != NULL)
           sound_queue[sound_queue_length].length = buffer_length;

     }

     if(sound_queue[sound_queue_length].length != 0){

        copy_sound_to_buffer(data,
                             &(sound_queue[sound_queue_length].data),
                             sound_queue[sound_queue_length].length);

        sound_queue[sound_queue_length].tick = (int)tick;
        sound_queue[sound_queue_length].index = (int)index;

        sound_queue_length++;
#ifdef SOUND_DEBUG
        fprintf(stderr, "queue length %i\n", sound_queue_length);
#endif
        success = TRUE;
     }
  }
#ifdef SOUND_DEBUG
  else
    fprintf(stderr, "Sound queue add FAILED\n");
#endif

  return(success);
}

/******************************************************************************/

static int sound_buffer_length(int length)
{
  int buffer_length;

  buffer_length = length;

  if(sound_bits == 8)
     buffer_length *= 2;

  if(sound_channels == 1)
     buffer_length *= 2;

  return(buffer_length);
}

/******************************************************************************/

static void copy_sound_to_buffer(unsigned char *source, unsigned char **dest, int length)
{
  if(sound_channels == 1){

     if(sound_bits == 8){

        fprintf(stderr, "8bit sound is not supported\n");

     }
     else if(sound_bits == 16){

        copy_sound_to_buffer_c1_b16(source, dest, length);
        
     }

  }
  else if(sound_channels == 2){

     if(sound_bits == 8){

        fprintf(stderr, "8bit sound is not supported\n");

     }
     else if(sound_bits == 16){

        memcpy(*dest, source, length);
#ifdef SOUND_DEBUG
        fprintf(stderr, "buffer copy   ptr %i, length %i\n", *dest, length);
#endif
     }
  }
}

/******************************************************************************/

static void copy_sound_to_buffer_c1_b16(unsigned char *source, unsigned char **dest, int length)
{
 /*
  * Expand 1 channel 16bit sound to 2 channels
  */
  int counter = length;
  unsigned char *source_ptr = source;
  unsigned char *dest_ptr = *dest;
  unsigned int source32;
  unsigned int dest32;

  while(counter > 0){

     while(counter >= 8){

        source32 = *((unsigned int *)source_ptr);
        source_ptr += 4;

        dest32 = source32 & 0x0000FFFF;
        dest32 = dest32 | (dest32 << 16);

        *((unsigned int *)dest_ptr) = dest32;
        dest_ptr += 4;


        dest32 = source32 & 0xFFFF0000;
        dest32 = dest32 | (dest32 >> 16);

        *((unsigned int *)dest_ptr) = dest32;
        dest_ptr += 4;

        counter -= 8;
     }

     if(counter == 4){

        source32 = *((unsigned int *)source_ptr);

        dest32 = source32 & 0x0000FFFF;
        dest32 = dest32 | (dest32 << 16);

     }
  }
}

/******************************************************************************/

static void flush_sound_queue(void)
{
  BOOL success;
  int index;
  if(sound_queue_length == 0)
     return;

  success = TRUE;

  if(sound_initialised){

     while(success && sound_queue_played < sound_queue_length){

        success = sm_addblock_flex(sound_stream,
                                   &(sound_queue[sound_queue_played].data),
                                   sound_queue[sound_queue_played].length);

        if(success){
           sound_queue_played++;
#ifdef SOUND_DEBUG
           fprintf(stderr, "sound queue played %i\n", sound_queue_played);
#endif
        }

     }

     if(sound_queue_played == sound_queue_length){

        for(index = 0; index < sound_queue_length; index++){

#ifdef SOUND_DEBUG
           fprintf(stderr, "Flush sound queue tick=%i, index=%i, item=%i, total=%i\n",
                   sound_queue[index].tick, sound_queue[index].index, index, sound_queue_length);
#endif

           rdpsnd_send_completion((uint16)sound_queue[index].tick,
                                  (uint8)sound_queue[index].index);
        }

        sound_queue_length = 0;
        sound_queue_played = 0;

        sound_queue_dealloc = TRUE;
        while((sound_queue_flush_time = Time_Monotonic()) == 0);
     }
  }
}

/******************************************************************************/

static void dealloc_sound_queue(void)
{
  unsigned int time;
  int index;
  if(!sound_queue_dealloc)
     return;


  while((time = Time_Monotonic()) == 0);

  if(sound_queue_flush_time + SOUND_QUEUE_DEALLOC_TIME < time){

     if(sound_queue_length == 0){

        for(index = 0; index < SOUND_QUEUE_TOTAL_LENGTH; index++){

           if(sound_queue[index].length != 0){
#ifdef SOUND_DEBUG
  fprintf(stderr, "dealloc sound queue  ptr %i, length %i, item %i\n",
          sound_queue[index].data, sound_queue[index].length, index);
#endif          
              MemMan_Free((memman_ptr) &(sound_queue[index].data));
              sound_queue[index].length = 0;
           }
        }

        sound_queue_dealloc = FALSE;
     }
  }
}

/******************************************************************************/

static BOOL ssb_openstream(char *name, BOOL set_expected_size, int expected_size,
                           int *handle)
{
  BOOL success;
  int flags;
  _kernel_swi_regs r;
  success = FALSE;

  flags = 0;

  if(set_expected_size)
     flags = flags | 0x2;

  r.r[0] = (int)flags;
  r.r[1] = (int)name;
  if(set_expected_size)
     r.r[2] = expected_size;
  else
     r.r[2] = 0;

  if(_kernel_swi(SWI_XOS_Bit | SWI_SharedSoundBuffer_OpenStream, &r, &r) == NULL)
     success = TRUE;

  *handle = (unsigned int)r.r[0];

  return(success);
}

/******************************************************************************/

static void ssb_closestream(int handle)
{
  _kernel_swi_regs r;

  r.r[0] = (int)handle;

  _kernel_swi(SWI_XOS_Bit | SWI_SharedSoundBuffer_CloseStream, &r, &r);

}

