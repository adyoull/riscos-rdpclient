           *  Green  0 00000 11111 00000 0 00000 00000 00000 = 0x 03E0 0000
           *  Blue   0 00000 00000 11111 0 00000 00000 00000 = 0x 001F 0000
           */

           dest_pixel = *((unsigned int *)(dest_ptr));

           *((unsigned int *)(dest_ptr)) = dest_pixel | source_pixel;

           source_ptr += 4;
           dest_ptr += 4;

           dest_x_counter--;

        }

        if(dest_x_counter >= 2){

           do{

             /*
              *  Source
              *  Red    0 00000 00000 11111 0 00000 00000 11111 = 0x 001F 001F
              *  Green  0 00000 11111 00000 0 00000 11111 00000 = 0x 03E0 03E0
              *  Blue   0 11111 00000 00000 0 11111 00000 00000 = 0x 7C00 7C00
              */

              source_pixel = *((unsigned int *)(source_ptr));

              source_pixel = ((source_pixel & 0x001F001F) << 10) |
                             ((source_pixel & 0x7C007C00) >> 10) |
                             (source_pixel & 0x03E003E0);

             /*
              *  Destination
              *  Red    0 11111 00000 00000 0 11111 00000 00000 = 0x 7C00 7C00
              *  Green  0 00000 11111 00000 0 00000 11111 00000 = 0x 03E0 03E0
              *  Blue   0 00000 00000 11111 0 00000 00000 11111 = 0x 001F 001F
              */

              *((unsigned int *)(dest_ptr)) = *((unsigned int *)(dest_ptr)) | source_pixel;

              source_ptr += 4;
              dest_ptr += 4;

              dest_x_counter -= 2;

           }while(dest_x_counter >= 2);

        }

        if(dest_x_counter > 0){

           source_pixel = *((unsigned int *)(source_ptr));

          /*
           *  Source
           *  Red    0 00000 00000 00000 0 00000 00000 11111 = 0x 0000 001F
           *  Green  0 00000 00000 00000 0 00000 11111 00000 = 0x 0000 03E0
           *  Blue   0 00000 00000 00000 0 11111 00000 00000 = 0x 0000 7C00
           */

           source_pixel = ((source_pixel & 0x0000001F) << 10) |
                          ((source_pixel & 0x00007C00) >> 10) |
                          (source_pixel & 0x000003E0);

          /*
           *  Destination
           *  Red    0 00000 00000 00000 0 11111 00000 00000 = 0x 0000 7C00
           *  Green  0 00000 00000 00000 0 00000 11111 00000 = 0x 0000 03E0
           *  Blue   0 00000 00000 00000 0 00000 00000 11111 = 0x 0000 001F
           */

           dest_pixel = *((unsigned int *)(dest_ptr));

           *((unsigned int *)(dest_ptr)) = dest_pixel | source_pixel;

        }

        source_ptr2 += source_linebytes;
        source_ptr = source_ptr2;
        
        dest_ptr2 += dest_linebytes;
        dest_ptr = dest_ptr2;

        dest_y_counter--;
     }
  }
  else{
    /*
     * source and dest are not aligned
     */
     while(dest_y_counter > 0){

        dest_x_counter = plot_length;

        if(dest_x_counter > 0){

           if(((unsigned int)dest_ptr & 0x3) != 0){
             /*
              * Source is word aligned
              * Dest is not word aligned
              */

              dest_ptr -= 2;

              source_pixel = *((unsigned int *)(source_ptr));

             /*
              *  Source
              *  Red    0 00000 00000 00000 0 00000 00000 11111  = 0x 0000 001F
              *  Green  0 00000 00000 00000 0 00000 11111 00000  = 0x 0000 03E0
              *  Blue   0 00000 00000 00000 0 11111 00000 00000  = 0x 0000 7C00
              */

              next_source_pixel = ((source_pixel & 0x0000001F) << 10) |
                                  ((source_pixel & 0x00007C00) >> 10) |
                                  (source_pixel & 0x00003E0);

              next_source_pixel = next_source_pixel << 16;

              next_source_pixel = next_source_pixel & 0xFFFF0000;

             /*
              *  Destination
              *  Red    0 11111 00000 00000 0 00000 00000 00000 = 0x 7C00 0000
              *  Green  0 00000 11111 00000 0 00000 00000 00000 = 0x 03E0 0000
              *  Blue   0 00000 00000 11111 0 00000 00000 00000 = 0x 001F 0000
              */

              dest_pixel = *((unsigned int *)(dest_ptr));

              *((unsigned int *)(dest_ptr)) = dest_pixel | next_source_pixel;

              source_ptr += 4;
              dest_ptr += 4;

              dest_x_counter--;

           }
           else{
             /*
              * Source is not word aligned
              * Dest is word aligned
              */

              source_ptr -= 2;

              source_pixel = *((unsigned int *)(source_ptr));

              source_ptr += 4;

           }

           source_pixel = source_pixel >> 16;

        }

        if(dest_x_counter >= 2){

           do{

             /*
              *  Source
              *  Red    0 00000 00000 11111 0 00000 00000 11111 = 0x 001F 001F
              *  Green  0 00000 11111 00000 0 00000 11111 00000 = 0x 03E0 03E0
              *  Blue   0 11111 00000 00000 0 11111 00000 00000 = 0x 7C00 7C00
              */
              next_source_pixel = *((unsigned int *)(source_ptr));

              source_pixel = source_pixel | (next_source_pixel << 16);

              source_pixel = ((source_pixel & 0x001F001F) << 10) |
                             ((source_pixel & 0x7C007C00) >> 10) |
                             (source_pixel & 0x03E003E0);

             /*
              *  Destination
              *  Red    0 11111 00000 00000 0 11111 00000 00000 = 0x 7C00 7C00
              *  Green  0 00000 11111 00000 0 00000 11111 00000 = 0x 03E0 03E0
              *  Blue   0 00000 00000 11111 0 00000 00000 11111 = 0x 001F 001F
              */
              *((unsigned int *)(dest_ptr)) = *((unsigned int *)(dest_ptr)) | source_pixel;

              source_ptr += 4;
              dest_ptr += 4;

              dest_x_counter -= 2;

              source_pixel = next_source_pixel >> 16;

           }while(dest_x_counter >= 2);

        }

        if(dest_x_counter > 0){

          /*
           *  Source
           *  Red    0 00000 00000 00000 0 00000 00000 11111 = 0x 0000 001F
           *  Green  0 00000 00000 00000 0 00000 11111 00000 = 0x 0000 03E0
           *  Blue   0 00000 00000 00000 0 11111 00000 00000 = 0x 0000 7C00
           */

           dest_pixel = *((unsigned int *)(dest_ptr));

           source_pixel = ((source_pixel & 0x0000001F) << 10) |
                          ((source_pixel & 0x00007C00) >> 10) |
                          (source_pixel & 0x000003E0);

           source_pixel = source_pixel & 0x0000FFFF;

          /*
           *  Destination
           *  Red    0 00000 00000 00000 0 11111 00000 00000 = 0x 0000 7C00
           *  Green  0 00000 00000 00000 0 00000 11111 00000 = 0x 0000 03E0
           *  Blue   0 00000 00000 00000 0 00000 00000 11111 = 0x 0000 001F
           */

           *((unsigned int *)(dest_ptr)) = dest_pixel | source_pixel;

        }

        source_ptr2 += source_linebytes;
        source_ptr = source_ptr2;
        
        dest_ptr2 += dest_linebytes;
        dest_ptr = dest_ptr2;

        dest_y_counter--;
     }
  }
