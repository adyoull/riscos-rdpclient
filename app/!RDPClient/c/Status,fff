/******************************************************************************/

extern void Status_Open(void)
{
 /*
  * Open status window on screen
  */

  if(status_dialog == NULL){

     status_dialog = TabDialog_Create("Status",
                                     icon_STATUS_TAB_MIN,
                                     icon_STATUS_TAB_MAX,
                                     icon_STATUS_TAB_BACK,
                                     status_dialog_default_tab,
                                     "S_Network", "S_Connectn", "S_Display"); 

     s_network_window = status_dialog->tabwindow[tab_STATUS_NETWORK-1];
     s_connection_window = status_dialog->tabwindow[tab_STATUS_CONNECTION-1];
     s_display_window = status_dialog->tabwindow[tab_STATUS_DISPLAY-1];

     if(s_connection_window != NULL){

        status_slider.window = s_connection_window;
        status_slider.icon = icon_S_CONNECTION_SOUND_BUFFER;
        status_slider.value = SLIDER_MAX + 1;
        status_slider.limits.min = 0;
        status_slider.limits.max = status_SOUND_BUFFER_MAX;
        status_slider.colour.foreground = colour_GREY5 /* colour_BLACK */;
        status_slider.colour.background = colour_WHITE;
        status_slider.border.x = 0;
        status_slider.border.y = 0;
        status_slider.knob.spritearea = NULL;
        status_slider.knob.sprite = NULL;
        status_slider.flags.vertical = 0; /* horizontal */
        status_slider.flags.rgb = 0; /* WIMP colours */
        status_slider.flags.dragging = 0;
        status_slider.flags.clickstop = 0; /* smooth drag */
        status_slider.flags.reserved = 0;
        status_slider.update = NULL;
        status_slider.reference = 0;

        status_sound_buffer_scale = Sound_BufferSize() / status_SOUND_BUFFER_MAX;
        if(status_sound_buffer_scale == 0)
           status_sound_buffer_scale = 1;

//fprintf(stderr, "sound buffer size %i  scale %i\n", Sound_BufferSize(), status_sound_buffer_scale); 

        Slider_SetValue(&status_slider, 0, NULL, NULL);

        Event_Claim(event_REDRAW, s_connection_window, event_ANY, Redraw_connection, NULL);
        
     }

     next_update_time = Time_Monotonic() + status_UPDATETIME;


     Event_Claim(event_CLOSE, status_dialog->mainwindow, event_ANY, Close_status, NULL);
     Event_Claim(event_NULL, event_ANY, event_ANY, Null_status, NULL);

  }

  if(status_dialog != NULL){

     update_status(TRUE);

     TabDialog_Show(status_dialog, open_WHEREVER);

  }

}

/******************************************************************************/

extern void Status_Close(void)
{
 /*
  * Close status window
  */

  if(status_dialog != NULL){

     Event_Release(event_NULL, event_ANY, event_ANY, Null_status, NULL);

     TabDialog_Delete(status_dialog);

     status_slider.window = NULL;
     
     status_dialog = NULL;
     s_network_window = NULL;
     s_connection_window = NULL;
     s_display_window = NULL;

  }
}

/******************************************************************************
 *                               close handlers                               *
 ******************************************************************************/

static BOOL Close_status(event_pollblock *event, void *reference)
{

  Status_Close();
  
  return(TRUE);
}

/******************************************************************************
 *                                null handlers                               *
 ******************************************************************************/

static BOOL Null_status(event_pollblock *event, void *reference)
{
  if(Time_Monotonic() >= next_update_time){

     update_status(FALSE);

     next_update_time = Time_Monotonic() + status_UPDATETIME;

  }

  return(FALSE);
}

/******************************************************************************
 *                             redraw handlers                                *
 ******************************************************************************/

static BOOL Redraw_connection(event_pollblock *event, void *reference)
{
  window_redrawblock redraw;
  BOOL more;

  redraw.window = event->data.openblock.window;
  Wimp_RedrawWindow(&redraw, &more);

  while (more)
  {
    if(status_slider.window != NULL) {
       Slider_Redraw(&status_slider, &redraw.cliprect);
//fprintf(stderr, "redraw\n");
    }       
    Wimp_GetRectangle(&redraw, &more);
  }

  return(TRUE);
}

