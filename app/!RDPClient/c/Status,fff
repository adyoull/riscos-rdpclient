 ******************************************************************************/

static void update_status(BOOL force)
{
  char input[40];
  char temp[40];
  char output[100];
  int value;
  BOOL state;
  
  if(s_network_window != NULL){

     if(force || status_connected_changed){

        sprintf(input, "statnet.status%i", (status_connected ? 1 : 0));
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_network_window, icon_S_NETWORK_STATUS, output);

        status_connected_changed = FALSE;
     }

     if(force || status_username_changed){

        Icon_SetText(s_network_window, icon_S_NETWORK_USERNAME, status_username);

        status_username_changed = FALSE;
     }

     if(force || status_domain_changed){

        Icon_SetText(s_network_window, icon_S_NETWORK_DOMAIN, status_domain);

        status_domain_changed = FALSE;
     }

     if(force || status_servername_changed){

        Icon_SetText(s_network_window, icon_S_NETWORK_SERVERNAME, status_servername);

        status_servername_changed = FALSE;
     }

     if(force || status_serveraddress_changed){

        Icon_SetText(s_network_window, icon_S_NETWORK_SERVERADDRESS, status_serveraddress);

        status_serveraddress_changed = FALSE;
     }

     if(force || g_tcp_port_rdp != status_tcp_port_rdp){

        Icon_SetInteger(s_network_window, icon_S_NETWORK_SERVERPORT, g_tcp_port_rdp);

        status_tcp_port_rdp = g_tcp_port_rdp;
     }

     if(force || status_hostname_changed){

        Icon_SetText(s_network_window, icon_S_NETWORK_HOSTNAME, status_hostname);

        status_hostname_changed = FALSE;
     }
     
  }

  if(s_connection_window != NULL){

     if(force || status_connectionname_changed){

        if(status_connectionname[0] == '\0'){
           Msgs_Lookup("statcon.namena", output, 90);
           Icon_SetText(s_connection_window, icon_S_CONNECTION_NAME, output);
        }
        else
           Icon_SetText(s_connection_window, icon_S_CONNECTION_NAME, status_connectionname);

        status_connectionname_changed = FALSE;
     }

     if(force || g_licence_issued != status_licence_issued){
     
        sprintf(input, "statcon.licence%i", (g_licence_issued ? 1 : 0));
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_connection_window, icon_S_CONNECTION_LICENCE, output);

        status_licence_issued = g_licence_issued;
     }

     if(force || g_bitmap_compression != status_bitmap_compression ||
        status_rdp_compression_changed){

        value = 0;
        if(g_bitmap_compression)
           value = 1;
        if(status_rdp_compression)
           value = 2;

        sprintf(input, "statcon.compres%i", value);
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_connection_window, icon_S_CONNECTION_COMPRESSION, output);

        status_bitmap_compression = g_bitmap_compression;
        status_rdp_compression_changed = FALSE;
     }


     if(force || g_packet_encryption != status_packet_encryption ||
                 g_encryption != status_encyption ||
                 tcp_tls_active() != status_tls){

        if(tcp_tls_active())
           value = 3;
        else if(g_packet_encryption && g_encryption)
           value = 2;
        else if(!g_packet_encryption && !g_encryption)
           value = 1;
        else
           value = 0;

        sprintf(input, "statcon.encrypt%i", value);
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_connection_window, icon_S_CONNECTION_ENCRYPTION, output);

        status_packet_encryption = g_packet_encryption;
        status_encyption = g_encryption;
        status_tls = tcp_tls_active();
     }

     if(force || g_use_rdp5 != status_use_rdp5){

        sprintf(input, "statcon.protoco%i", (g_use_rdp5 ? 1 : 0));
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_connection_window, icon_S_CONNECTION_PROTOCOL, output);

        status_use_rdp5 = g_use_rdp5;
     }

     if(force || status_keymapname_changed){

        Icon_SetText(s_connection_window, icon_S_CONNECTION_KEYMAPNAME, status_keymapname);

        status_keymapname_changed = FALSE;
     }

     if(force || status_clipboard_mode_changed || status_clipboard_buffer_size_changed){

        sprintf(input, "statcon.clip%i", status_clipboard_mode);
        Msgs_Lookup(input, output, 90);

        if(status_clipboard_mode != clipboard_OFF && status_clipboard_buffer_size != 0){
           sprintf(temp, " (%iK)", status_clipboard_buffer_size);
           strcat(output, temp);
        }
        
        Icon_SetText(s_connection_window, icon_S_CONNECTION_CLIPBOARD, output);

        status_clipboard_mode_changed = FALSE;
        status_clipboard_buffer_size_changed = FALSE;
     }

     if(force || status_sound_option_changed || status_sound_channels_changed ||
                 status_sound_bits_changed || status_sound_rate_changed){

        if(status_sound_option == status_SOUND_OPTION_LOCAL && status_sound_called){

           /* <nn>bit <mono|stereo> nnnnnHz */
           sprintf(output, "%i", status_sound_bits);

           Msgs_Lookup("statcon.soundbit", temp, 35);
           strcat(output, temp);
           strcat(output, " ");

           sprintf(input, "statcon.soundc%i", status_sound_channels);
           Msgs_Lookup(input, temp, 35);
           strcat(output, temp);
           strcat(output, " ");

           sprintf(temp, "%i", status_sound_rate);
           strcat(output, temp);
           Msgs_Lookup("statcon.soundhz", temp, 35);
           strcat(output, temp);

           Icon_SetText(s_connection_window, icon_S_CONNECTION_SOUND, output);
        }
        else{

           sprintf(input, "statcon.sound%i", status_sound_option);
           Msgs_Lookup(input, output, 90);
           Icon_SetText(s_connection_window, icon_S_CONNECTION_SOUND, output);
        }

        status_sound_option_changed = FALSE;
        status_sound_channels_changed = FALSE;
        status_sound_bits_changed = FALSE;
        status_sound_rate_changed = FALSE;
     }


     value = Sound_BufferUsed() / status_sound_buffer_scale;

     if(force | value != status_sound_buffer){

        status_sound_buffer = value;

//fprintf(stderr, "buffer used %i   scaled %i\n", value, value / status_sound_buffer_scale);     

        Slider_SetValue(&status_slider, value, NULL, NULL);

     }

  }

  if(s_display_window != NULL){

     if(force || g_width != status_width){

        Icon_SetInteger(s_display_window, icon_S_DISPLAY_WIDTH, g_width);

        status_width = g_width;
     }

     if(force || g_height != status_height){

        Icon_SetInteger(s_display_window, icon_S_DISPLAY_HEIGHT, g_height);

        status_height = g_height;
     }

     if(force || g_server_depth != status_server_bpp){

        if(g_server_depth == 8 || g_server_depth == 15 ||
           g_server_depth == 16 || g_server_depth == 24 ||
           g_server_depth == 32){
           sprintf(input, "statdis.colour%i", g_server_depth);
           Msgs_Lookup(input, output, 90);
           Icon_SetText(s_display_window, icon_S_DISPLAY_COLOURS, output);
        }

        status_server_bpp = g_server_depth;
     }

     value = Display_GetDisplayMode();
     if(force || value != status_display_mode){

        sprintf(input, "statdis.display%i", value);
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_display_window, icon_S_DISPLAY_MODE, output);

        status_display_mode = value;
     }

     state = Display_GetUpdatePalette();
     if(force || state != status_set_palette){
        sprintf(input, "statdis.palette%i", (state ? 1 : 0));
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_display_window, icon_S_DISPLAY_PALETTE, output);

        status_set_palette = state;
     }

     if(force || g_bitmap_cache != status_bitmap_cache){

        sprintf(input, "statdis.cache%i", (g_bitmap_cache ? 1 : 0));
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_display_window, icon_S_DISPLAY_BITMAP_CACHE, output);

        status_bitmap_cache = g_bitmap_cache;
     }

     if(force || g_bitmap_cache_persist_enable != status_bitmap_cache_persist_enable){

        sprintf(input, "statdis.persist%i", (g_bitmap_cache_persist_enable ? 1 : 0));
        Msgs_Lookup(input, output, 90);
        Icon_SetText(s_display_window, icon_S_DISPLAY_PERSISTENT_CACHE, output);

        status_bitmap_cache_persist_enable = g_bitmap_cache_persist_enable;
     }

     value = SpriteLib_TotalSprites1bpp();
     if(force || value != status_total_sprites1bpp){
        Icon_SetInteger(s_display_window, icon_S_DISPLAY_GLYPHCACHE, value);

        status_total_sprites1bpp = value;
     }

     value = SpriteLib_TotalSprites() - value;
     if(force || value != status_total_spritesnot1bpp){
        Icon_SetInteger(s_display_window, icon_S_DISPLAY_IMAGECACHE, value);

        status_total_spritesnot1bpp = value;
     }

  }

}
