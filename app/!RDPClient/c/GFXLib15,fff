extern unsigned int GFXLib_TranslateColour_15(unsigned int windows_colour)
{
  unsigned int riscos_colour;

  riscos_colour = ((windows_colour & 0x0000001F) << 10) |
                  ((windows_colour & 0x00007C00) >> 10) |
                  (windows_colour & 0x000003E0);

  return(riscos_colour);
}

