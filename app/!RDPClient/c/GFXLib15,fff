extern void GFXLib_PlotRectangleToSprite_15_Invert(int linebytes,
                                                   int plot_length,
                                                   int plot_lines,
                                                   unsigned char **sprite_area,
                                                   int start)
{
  unsigned char *image_ptr = (*sprite_area) + start;
  unsigned char *image_ptr2 = image_ptr;
  int y_counter = plot_lines;
  int x_counter;

  while(y_counter > 0){

     x_counter = plot_length;

     if(x_counter > 0 && ((unsigned int)image_ptr & 0x3) != 0){

        image_ptr -= 2;

        *((unsigned int *)(image_ptr)) = *((unsigned int *)(image_ptr)) ^ 0x7FFF0000;
                                        
        image_ptr += 4;

        x_counter--;

     }

     if(x_counter >= 2){

        do{

           *((unsigned int *)(image_ptr)) = *((unsigned int *)(image_ptr)) ^ 0x7FFF7FFF;

           image_ptr += 4;

           x_counter -= 2;

        }while(x_counter >= 2);

     }

     if(x_counter > 0){

        *((unsigned int *)(image_ptr)) = *((unsigned int *)(image_ptr)) ^ 0x00007FFF;

     }

     image_ptr2 += linebytes;
     image_ptr = image_ptr2;

     y_counter--;
  }

}

