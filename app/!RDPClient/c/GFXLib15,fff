/******************************************************************************/

extern void GFXLib_PlotSpriteToSprite_15_AndInverted(int source_linebytes,
                                                     int dest_linebytes,
                                                     int plot_length,
                                                     int plot_lines,
                                                     unsigned char **source_area,
                                                     int source_start,
                                                     unsigned char **dest_area,
                                                     int dest_start)
{
  unsigned char *source_ptr = (*source_area) + source_start;
  unsigned char *source_ptr2 = source_ptr;
  unsigned char *dest_ptr = (*dest_area) + dest_start;
  unsigned char *dest_ptr2 = dest_ptr;
  int dest_y_counter = plot_lines;
  int dest_x_counter;
  unsigned int next_source_pixel;
  unsigned int source_pixel;
  unsigned int dest_pixel;

  if(((unsigned int)source_ptr & 0x3) == ((unsigned int)dest_ptr & 0x3)){
    /*
     * both source and dest are aligned the same
     */
     while(dest_y_counter > 0){

        dest_x_counter = plot_length;

        if(dest_x_counter > 0 && ((unsigned int)dest_ptr & 0x3) != 0){

           source_ptr -= 2;
           dest_ptr -= 2;

           source_pixel = *((unsigned int *)(source_ptr));

           source_pixel = (~ source_pixel) & 0x7FFF0000;

           dest_pixel = *((unsigned int *)(dest_ptr));

           source_pixel = source_pixel & (dest_pixel & 0xFFFF0000);

           *((unsigned int *)(dest_ptr)) = (dest_pixel & 0x0000FFFF) | source_pixel;

           source_ptr += 4;
           dest_ptr += 4;

           dest_x_counter--;

        }

        if(dest_x_counter >= 2){

           do{

              source_pixel = *((unsigned int *)(source_ptr));

              source_pixel = (~ source_pixel) & 0x7FFF7FFF;

              *((unsigned int *)(dest_ptr)) = *((unsigned int *)(dest_ptr)) & source_pixel;

              source_ptr += 4;
              dest_ptr += 4;

              dest_x_counter -= 2;

           }while(dest_x_counter >= 2);

        }

        if(dest_x_counter > 0){

           source_pixel = *((unsigned int *)(source_ptr));

