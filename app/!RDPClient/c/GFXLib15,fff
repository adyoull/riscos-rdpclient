extern void GFXLib_PlotRectangleToSprite_15_Set(int linebytes,
                                                int plot_length,
                                                int plot_lines,
                                                unsigned char **sprite_area,
                                                int start)
{
  unsigned char *image_ptr = (*sprite_area) + start;
  unsigned char *image_ptr2 = image_ptr;
  int y_counter = plot_lines;
  int x_counter;
  unsigned int colour_low;
  unsigned int colour_high;
  unsigned int colour32;

  colour_low = 0x00007FFF;
  colour_high = 0x7FFF0000;
  colour32 = colour_low | colour_high;

  while(y_counter > 0){

     x_counter = plot_length;

     if(x_counter > 0 && ((unsigned int)image_ptr & 0x3) != 0){

        image_ptr -= 2;

        *((unsigned int *)(image_ptr)) = (*((unsigned int *)(image_ptr)) & 0x0000FFFF) |
                                         colour_high;
                                        
        image_ptr += 4;

        x_counter--;

     }

     if(x_counter >= 2){

        do{

           *((unsigned int *)(image_ptr)) = colour32;

           image_ptr += 4;

           x_counter -= 2;

        }while(x_counter >= 2);

     }

     if(x_counter > 0){

        *((unsigned int *)(image_ptr)) = (*((unsigned int *)(image_ptr)) & 0xFFFF0000) |
                                         colour_low;

     }

     image_ptr2 += linebytes;
     image_ptr = image_ptr2;

     y_counter--;
  }

}

