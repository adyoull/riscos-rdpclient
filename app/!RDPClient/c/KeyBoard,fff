extern void Keyboard_KeyPress(key_press keycode, int deepkeys)
{
 /*
  * Process KeyPress events
  */
  int physical_key;
  int scancode;
  uint32 ev_time;
  keyboard_modifier_block modifiers;
  BOOL singletask = Display_SingleTask();
  BOOL ignore = FALSE;

  if(singletask){

     physical_key = lookup_keycode_to_physical(keycode);

     modifiers.value = scan_modifiers();

  }
  else{

     physical_key = (deepkeys & 0xFFFF0000) >> 16;

     modifiers.value = (deepkeys & 0x1FF);
  }

 /*
  * Ensure that state keys are correct
  */
  update_state(scan_state(), FALSE);

 /*
  * Send modifier keys
  */
  update_modifiers(modifiers.value, FALSE);

/*
  if(modifiers.data.left_shift)
     fprintf(stderr, "Left Shift ");

  if(modifiers.data.right_shift)
     fprintf(stderr, "Right Shift ");

  if(modifiers.data.left_ctrl)
     fprintf(stderr, "Left Ctrl ");

  if(modifiers.data.right_ctrl)
     fprintf(stderr, "Right Ctrl ");

  if(modifiers.data.left_alt)
     fprintf(stderr, "Left Alt ");

  if(modifiers.data.right_alt)
     fprintf(stderr, "Right Alt ");

  if(modifiers.data.left_logo)
     fprintf(stderr, "Left Logo ");

  if(modifiers.data.right_logo)
     fprintf(stderr, "Right Logo ");

  if(modifiers.data.menu)
     fprintf(stderr, "Menu ");
*/

  if(singletask){
     if(keycode == -1)
        return;
  }
  else{

     if(keycode == 0x1C0 || keycode == 0x1D0 || keycode == 0x1E0){
        /* Logo keys generate a KeyPress event even though they are a modifier */
        return;
     }
  }

 /*
  * Special RDPClient key presses
  */
  if((modifiers.data.left_shift == 1 || modifiers.data.right_shift == 1) &&
     (modifiers.data.left_ctrl == 1 || modifiers.data.right_ctrl == 1)){

     if(physical_key == keyboard_configuration.shortcut.desktop){
       /*
        * Return to the Desktop
        */
        ignore = goto_desktop();
     }
     else if(physical_key == keyboard_configuration.shortcut.window){
       /*
        * Go to Window mode
        */
        ignore = goto_window();
     }
     else if(physical_key == keyboard_configuration.shortcut.fullscreen){
       /*
        * Go to Fullscreen mode
        */
        goto_fullscreen();
     }
     else if(physical_key == keyboard_configuration.shortcut.singletasking){
       /*
        * Go to Single tasking mode
        */
        goto_singletask();
     }
     else if(physical_key == keyboard_configuration.shortcut.bringtofront){
       /*
        * Bring window to front
        */
        if(Display_EnsureWindowOnTopWhenFullscreen(fullscreen_bringtofront_KEYPRESS))
           ignore = TRUE;
     }
  }
//fprintf(stderr, "keycode %i   physical_key %i\n", keycode, physical_key);

  if(!ignore){

     if(!send_special_keys(physical_key, modifiers.value)){

       /*
        * Send normal keypress (after modifiers)
        */
        scancode = lookup_physical_to_scancode(physical_key);

        if(scancode != -1){

           ev_time = time(NULL);
           rdp_send_scancode(ev_time, RDP_KEYPRESS, scancode);

           rdp_send_scancode(ev_time, RDP_KEYRELEASE, scancode);
        }
     }
  }

//fprintf(stderr, "Keypress %X '%c' ", keycode, keycode);
//
//fprintf(stderr, "  physical = %i\n", physical_key);

}

/******************************************************************************/

extern void Keyboard_Poll(void)
{
 /*
  * Called at various times to handle checking for keys being released
  */
  int keycode;
  BOOL singletask = Display_SingleTask();

  if(Display_HasInputFocus()){

     keycode = -1;

     if(singletask)
        keycode = keyboard_buffer_write();
        
     if(keycode != -1){
       /*
        * Waiting keypress event from single task mode
        */
        Keyboard_KeyPress((key_press)keycode, 0);
     }
     else{
       /*
        * Multitask mode or no single task keypress event
        */

       /*
        * Update state keys to allow them to be pressed and released
        * on their own
        */
        update_state(scan_state(), FALSE);

       /*
        * Update modifiers to allow them to be pressed and released
        * on their own
        */
        update_modifiers(scan_modifiers(), FALSE);
     }
  }
  else{
    /*
     * If we don't have input focus, ensure that all modifier keys are not pressed
     * Note: the state keys are left alone
     */
     update_modifiers(0, FALSE);
  }
}

/******************************************************************************/

extern void Keyboard_LooseFocus(void)
{
 /*
  * Called when the Display looses input focus
  */

 /*
  * When losing focus, force all modifier keys to be not pressed
  */
  update_modifiers(0, TRUE);

//fprintf(stderr, "LooseFocus\n");
}

/******************************************************************************/

extern void Keyboard_GainFocus(void)
{
 /*
  * Called when the Display gains input focus
  */

 /*
  * When gaining focus, force all state keys to be up first
  */
  /* NO!
  update_state(0, TRUE);
  */
  
 /*
  * and then set the correct state
  */  
  update_state(scan_state(), FALSE);

 /*
  * When gaining focus, force all modifiers to be up first
  */
  update_modifiers(0, TRUE);

 /*
  * and then set the correct state
  */  
  update_modifiers(scan_modifiers(), FALSE);
  
//fprintf(stderr, "GainFocus\n");
}

