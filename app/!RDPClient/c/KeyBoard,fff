extern BOOL Keyboard_SetKeyShortcut(char *keyname, int keyboard_shortcut)
{
//fprintf(stderr, "Called Keyboard_SetKeyShortcut(keyname='%s', keyboard_shortcut=%i)\n",
//        keyname, keyboard_shortcut);
 /*
  * Set keyboard_shortcut to keyname.
  * Return TRUE if keyname and keyboard_shortcut are valid
  */
  int physical_key = -1;
  char buffer[50];

  if(keyboard_shortcut != keyboard_shortcut_DESKTOP &&
     keyboard_shortcut != keyboard_shortcut_WINDOW &&
     keyboard_shortcut != keyboard_shortcut_FULLSCREEN &&
     keyboard_shortcut != keyboard_shortcut_SINGLETASKING &&
     keyboard_shortcut != keyboard_shortcut_BRINGTOFRONT)
     return(FALSE);

  if(strlen(keyname) < sizeof(buffer) - 1){

     Utils_CopyToLower(buffer, keyname);

     physical_key = decode_keyname_to_physical(buffer);

  }

  if(physical_key != -1){

     switch(keyboard_shortcut){
        case keyboard_shortcut_DESKTOP:
          keyboard_configuration.shortcut.desktop = physical_key;
          break;

        case keyboard_shortcut_WINDOW:
          keyboard_configuration.shortcut.window = physical_key;
          break;

        case keyboard_shortcut_FULLSCREEN:
          keyboard_configuration.shortcut.fullscreen = physical_key;
          break;

        case keyboard_shortcut_SINGLETASKING:
          keyboard_configuration.shortcut.singletasking = physical_key;
          break;

        case keyboard_shortcut_BRINGTOFRONT:
          keyboard_configuration.shortcut.bringtofront = physical_key;
          break;
     }
  }

  return(physical_key != -1);
}

/******************************************************************************/

extern void Keyboard_SingleTask(void)
{
 /*
  * Set up keyboard for single tasking mode
  */
  int r1out;
  int r2out;

  read_keyboard_autorepeat();

  keyboard_buffer_clear();

 /*
  * Open a Wimp Command Window to stop the window manager reading keypresses
  */
  open_command_window();

 /*
  * Disable the keyboard buffer
  */
  OS_Byte(osbyte_RW_KEYBOARDDISABLEFLAG, 0x01, 0x00, &r1out, &r2out);

}

/******************************************************************************/

extern void Keyboard_MultiTask(void)
{
 /*
  * Set up keyboard for multi tasking mode
  */
  int r1out;
  int r2out;

  close_command_window();

 /*
  * Enable the keyboard buffer
  */
  OS_Byte(osbyte_RW_KEYBOARDDISABLEFLAG, 0x00, 0x00, &r1out, &r2out);

}

