/******************************************************************************/

static void build_translate_tables(void)
{
  int index;
  int result;

  for(index = 0; index < translate_SIZE; index++){

     result = map_keycode_to_physical(index);

     if(result < 0 || result > 255)
        result = 255;

     translate_keycode_to_physical[index] = (unsigned char)result;
  }

  for(index = 0; index < translate_SIZE; index++){

     result = map_physical_to_scancode(index);

     if(result < 0 || result > 255)
        result = 255;

     translate_physical_to_scancode[index] = (unsigned char)result;
  }
}

/******************************************************************************/

static int lookup_keycode_to_physical(int keycode)
{
  int physical_key = -1;

  if(keycode >= 0 && keycode < translate_SIZE){

     physical_key = translate_keycode_to_physical[keycode];

     if(physical_key == 255)
        physical_key = -1;
  }

  return(physical_key);
}

/******************************************************************************/

static int lookup_physical_to_scancode(int physical_key)
{
  int scancode = -1;

  if(physical_key >= 0 && physical_key < translate_SIZE){

     scancode = translate_physical_to_scancode[physical_key];

     if(scancode == 255)
        scancode = -1;
  }

  return(scancode);
}

/******************************************************************************/

static void keyboard_buffer_clear(void)
{
  int index;

  for(index = 0; index < keyboard_BUFFER_SIZE; index++)
     keyboard_buffer_keycode[index] = -1;

  keyboard_buffer_autorepeat_keycode = -1;

  keyboard_buffer_count = 0;
}

/******************************************************************************/

static int keyboard_buffer_write(void)
{
 /*
  * Scan keyboard and fill keyboard buffer
  */
  int keycode;
  unsigned int time;
  int keys_pressed;
  int index1;
  int index2;
  BOOL found;
  int empty_index;
  int key_pressed_keycode;
  unsigned int min_time;
  unsigned int key_time;

  while((time = Time_Monotonic()) == 0);

  keys_pressed = 0;

  key_pressed_keycode = -1;

  keycode = keyboard_scan(16);

  while(keycode != 0xFF && keys_pressed < keyboard_BUFFER_SIZE){

     keyboard_current_keycode[keys_pressed] = keycode;
     keys_pressed++;

     keycode = keyboard_scan(keycode + 1);
  }

  if(keys_pressed > 0){

    /*
     * Remove keys that are no longer pressed from buffer
     */
     for(index1 = 0; index1 < keyboard_BUFFER_SIZE; index1++){

        keycode = keyboard_buffer_keycode[index1];

        if(keycode != -1){

           found = FALSE;

           for(index2 = 0; index2 < keys_pressed; index2++){

              if(keycode == keyboard_current_keycode[index2]){
                 found = TRUE;
                 break;
              }
           }

           if(!found){

              keyboard_buffer_keycode[index1] = -1;

              if(keycode == keyboard_buffer_autorepeat_keycode)
                 keyboard_buffer_autorepeat_keycode = -1;

              keyboard_buffer_count--;
           }
        }
     }

    /*
     * Add new keys to buffer
     */
     for(index1 = 0; index1 < keys_pressed; index1++){

        keycode = keyboard_current_keycode[index1];

        empty_index = -1;

        found = FALSE;
        
        for(index2 = 0; index2 < keyboard_BUFFER_SIZE; index2++){

           if(keyboard_buffer_keycode[index2] == -1)
              empty_index = index2;
           else if(keycode == keyboard_buffer_keycode[index2]){
              found = TRUE;
           }
           
        }

        if(!found && empty_index != -1){

           keyboard_buffer_keycode[empty_index] = keycode;
           keyboard_buffer_time[empty_index] = time;

           keyboard_buffer_count++;

           if(key_pressed_keycode == -1){

              keyboard_buffer_autorepeat_keycode = keycode;
              keyboard_buffer_autorepeat_time = time + keyboard_autorepeat_time;

              key_pressed_keycode = keycode;
           }
        }
     }

    /*
     * If no current key, add one that is pressed
     */
     if(key_pressed_keycode == -1 && keyboard_buffer_autorepeat_keycode == -1 &&
        keyboard_buffer_count > 0){

        min_time = UINT_MAX;

        for(index1 = 0; index1 < keyboard_BUFFER_SIZE; index1++){

            keycode = keyboard_buffer_keycode[index1];

            if(keycode != -1){

               key_time = keyboard_buffer_time[index1];

               if(key_time < min_time){
                  key_pressed_keycode = keycode;
                  min_time = key_time;
               }
            }
         }

         if(key_pressed_keycode != -1){

            keyboard_buffer_autorepeat_keycode = key_pressed_keycode;
            keyboard_buffer_autorepeat_time = time + keyboard_autorepeat_time;
        }
     }
  }
  else{
    /*
     * No keys pressed so clear buffer
     */
     keyboard_buffer_clear();
     keyboard_buffer_autorepeat_keycode = -1;
  }

 /*
  * Autorepeat
  */
  if(key_pressed_keycode == -1 && keyboard_buffer_autorepeat_keycode != -1){

     if(time >= keyboard_buffer_autorepeat_time){

        key_pressed_keycode = keyboard_buffer_autorepeat_keycode;

        keyboard_buffer_autorepeat_time += keyboard_autorepeat_interval;

        while(time >= keyboard_buffer_autorepeat_time)
           keyboard_buffer_autorepeat_time += keyboard_autorepeat_interval;

     }
  }

  return(key_pressed_keycode);
}

/******************************************************************************/

static int keyboard_scan(int start_key)
{
 /*
  * Return key that is currently being pressed or 0xFF if no key is pressed
  */
  int r1out;
  int r2out;

  OS_Byte(osbyte_KEYBOARDSCAN, start_key, 0x00, &r1out, &r2out);

  return(r1out);
}

/******************************************************************************/

static void open_command_window(void)
{
  _kernel_swi_regs r;

  r.r[0] = 1;
  _kernel_swi(SWI_XOS_Bit | SWI_Wimp_CommandWindow, &r, &r);

  r.r[0] = 13;
  _kernel_swi(SWI_XOS_Bit | SWI_OS_WriteC, &r, &r);  
}

/******************************************************************************/

static void close_command_window(void)
{
  _kernel_swi_regs r;

  r.r[0] = -1;
  _kernel_swi(SWI_XOS_Bit | SWI_Wimp_CommandWindow, &r, &r);

}


/******************************************************************************/

static BOOL key_down(int keynumber)
{
 /*
  * Return TRUE if the key corresponding to the supplied keynumber is pressed
  */
  int r1out;
  int r2out;

  OS_Byte(osbyte_SCANFORKEY, keynumber, 0xFF, &r1out, &r2out);

  return(r1out == 255);
}

/******************************************************************************/

static int scan_modifiers(void)
{
  keyboard_modifier_block modifiers;

  modifiers.value = 0;

  if(key_down(keynumber_LEFT_SHIFT))
     modifiers.data.left_shift = 1;

  if(key_down(keynumber_RIGHT_SHIFT))
     modifiers.data.right_shift = 1;

  if(key_down(keynumber_LEFT_CTRL))
     modifiers.data.left_ctrl = 1;

  if(key_down(keynumber_RIGHT_CTRL))
     modifiers.data.right_ctrl = 1;

  if(key_down(keynumber_LEFT_ALT))
     modifiers.data.left_alt = 1;

  if(key_down(keynumber_RIGHT_ALT))
     modifiers.data.right_alt = 1;

  if(key_down(keynumber_LEFT_LOGO))
     modifiers.data.left_logo = 1;

  if(key_down(keynumber_RIGHT_LOGO))
     modifiers.data.right_logo = 1;

  if(key_down(keynumber_MENU))
     modifiers.data.menu = 1;

  return(modifiers.value);
}

/******************************************************************************/

static int scan_state(void)
{
  keyboard_state_block state;
  int r1out;
  int r2out;

  state.value = 0;

  OS_Byte(osbyte_RW_KEYBOARDSTATUSBYTE, 0x00, 0xFF, &r1out, &r2out);

  if((r1out & 0x02) > 0)
     state.data.scroll_lock = 1;

  if((r1out & 0x04) == 0)
     state.data.num_lock = 1;

  if((r1out & 0x10) == 0)
     state.data.caps_lock = 1;

  return(state.value);
}

/******************************************************************************/

static void read_keyboard_autorepeat(void)
{
 /*
  * Read keyboard autorepeat values
  */
  int r1out = 0;
  int r2out = 0;

  OS_Byte(osbyte_RW_KEYREPEATDELAY, 0x00, 0xFF, &r1out, &r2out);

  keyboard_autorepeat_time = r1out;
  keyboard_autorepeat_interval = r2out;

}

/******************************************************************************/

static void update_modifiers(int modifiers, BOOL force)
{
  keyboard_modifier_block current_modifiers;
  uint32 ev_time;
  if(!force && modifiers == saved_modifiers.value)
     return;


  ev_time = time(NULL);

  current_modifiers.value = modifiers;

  if(current_modifiers.data.left_shift != saved_modifiers.data.left_shift || force){
     rdp_send_scancode(ev_time,
                       current_modifiers.data.left_shift == 1 ? RDP_KEYPRESS : RDP_KEYRELEASE,
                       SCANCODE_CHAR_LSHIFT);
  }

  if(current_modifiers.data.right_shift != saved_modifiers.data.right_shift || force){
     rdp_send_scancode(ev_time,
                       current_modifiers.data.right_shift == 1 ? RDP_KEYPRESS : RDP_KEYRELEASE,
                       SCANCODE_CHAR_RSHIFT);
  }

  if(current_modifiers.data.left_ctrl != saved_modifiers.data.left_ctrl || force){
     rdp_send_scancode(ev_time,
                       current_modifiers.data.left_ctrl == 1 ? RDP_KEYPRESS : RDP_KEYRELEASE,
                       SCANCODE_CHAR_LCTRL);
  }

  if(current_modifiers.data.right_ctrl != saved_modifiers.data.right_ctrl || force){
     rdp_send_scancode(ev_time,
                       current_modifiers.data.right_ctrl == 1 ? RDP_KEYPRESS : RDP_KEYRELEASE,
                       SCANCODE_CHAR_RCTRL);
  }

  if(current_modifiers.data.left_alt != saved_modifiers.data.left_alt || force){
     rdp_send_scancode(ev_time,
                       current_modifiers.data.left_alt == 1 ? RDP_KEYPRESS : RDP_KEYRELEASE,
                       SCANCODE_CHAR_LALT);
  }

  if(current_modifiers.data.right_alt != saved_modifiers.data.right_alt || force){
     rdp_send_scancode(ev_time,
                       current_modifiers.data.right_alt == 1 ? RDP_KEYPRESS : RDP_KEYRELEASE,
                       SCANCODE_CHAR_RALT);
  }

  if(current_modifiers.data.left_logo != saved_modifiers.data.left_logo || force){
     send_winkey(ev_time,
                 current_modifiers.data.left_logo == 1 ? TRUE : FALSE,
                 TRUE);
  }

  if(current_modifiers.data.right_logo != saved_modifiers.data.right_logo || force){
     send_winkey(ev_time,
                 current_modifiers.data.right_logo == 1 ? TRUE : FALSE,
                 FALSE);
  }

  /* don't reset menu key on force as it causes the menu to open */
  if(current_modifiers.data.menu != saved_modifiers.data.menu){
     rdp_send_scancode(ev_time,
                       current_modifiers.data.menu == 1 ? RDP_KEYPRESS : RDP_KEYRELEASE,
                       SCANCODE_CHAR_APPLICATION);
  }

  saved_modifiers.value = current_modifiers.value;
  
}

/******************************************************************************/

static void update_state(int state, BOOL force)
{
  keyboard_state_block current_state;
  uint32 ev_time;
  if(!force && state == saved_state.value)
     return;


  ev_time = time(NULL);

  current_state.value = state;

  if(current_state.data.scroll_lock != saved_state.data.scroll_lock){
//fprintf(stderr, "Send ScrollLock\n");
     rdp_send_scancode(ev_time, RDP_KEYPRESS, SCANCODE_CHAR_SCROLLLOCK);
     rdp_send_scancode(ev_time, RDP_KEYRELEASE, SCANCODE_CHAR_SCROLLLOCK);
  }

  if(current_state.data.num_lock != saved_state.data.num_lock){
//fprintf(stderr, "Send NumLock\n");
     rdp_send_scancode(ev_time, RDP_KEYPRESS, SCANCODE_CHAR_NUMLOCK);
     rdp_send_scancode(ev_time, RDP_KEYRELEASE, SCANCODE_CHAR_NUMLOCK);
  }

  if(current_state.data.caps_lock != saved_state.data.caps_lock || force){
//fprintf(stderr, "Send CapsLock\n");
     rdp_send_scancode(ev_time, RDP_KEYPRESS, SCANCODE_CHAR_CAPSLOCK);
     rdp_send_scancode(ev_time, RDP_KEYRELEASE, SCANCODE_CHAR_CAPSLOCK);
  }

  saved_state.value = current_state.value;
  
}

/******************************************************************************/

static BOOL send_special_keys(int physical_key, int modifiers)
{
  BOOL sent = TRUE;
  uint32 ev_time;
  keyboard_modifier_block current_modifiers;

  current_modifiers.value = modifiers;

  ev_time = time(NULL);

  switch(physical_key)
  {
    /* Print Screen */
    case 13:

      if((current_modifiers.data.left_ctrl == 0 || current_modifiers.data.right_ctrl == 0) &&
         (current_modifiers.data.left_shift == 1 || current_modifiers.data.right_shift == 1)){
        /*
         * As I cannot get a Alt PrintScreen to work, I will send this on Ctrl PrintScreen.
         * Therefore, Ctrl or Shift PrintScreen will only be sent for Shift PrintScreen
         */
         rdp_send_scancode(ev_time, RDP_KEYPRESS, (SCANCODE_EXTENDED | 0x2a));

         rdp_send_scancode(ev_time, RDP_KEYRELEASE, (SCANCODE_EXTENDED | 0x2a));
      }
      else if(current_modifiers.data.left_ctrl == 1 || current_modifiers.data.right_ctrl == 1){
        /*
         * Send Alt PrintScreen sequence triggered by Ctrl PrintScreen
         */
         rdp_send_scancode(ev_time, RDP_KEYPRESS, SCANCODE_CHAR_LALT);         
         rdp_send_scancode(ev_time, RDP_KEYPRESS, 0x54);

         rdp_send_scancode(ev_time, RDP_KEYRELEASE, 0x54);
         rdp_send_scancode(ev_time, RDP_KEYRELEASE, SCANCODE_CHAR_LALT);
      }
      else{
        /*
         * PrintScreen sequence with no modifiers
         */
         rdp_send_scancode(ev_time, RDP_KEYPRESS, (SCANCODE_EXTENDED | 0x2a));
         rdp_send_scancode(ev_time, RDP_KEYPRESS, (SCANCODE_EXTENDED | 0x37));

         rdp_send_scancode(ev_time, RDP_KEYRELEASE, (SCANCODE_EXTENDED | 0x2a));
         rdp_send_scancode(ev_time, RDP_KEYRELEASE, (SCANCODE_EXTENDED | 0x37));
      }
      break;

    /* Break / Pause */
    case 15:
      /* Send Break sequence E0 46 E0 C6 */
      /*
      rdp_send_scancode(ev_time, RDP_KEYPRESS, (SCANCODE_EXTENDED | 0x46));
      rdp_send_scancode(ev_time, RDP_KEYPRESS, (SCANCODE_EXTENDED | 0xc6));
      */

      /* According to MS Keyboard Scan Code
         Specification, pressing Pause should result
         in E1 1D 45 E1 9D C5. I'm not exactly sure
         of how this is supposed to be sent via
         RDP. The code below seems to work, but with
         the side effect that Left Ctrl stays
         down. Therefore, we release it when Pause
         is released. */

      rdp_send_input(ev_time, RDP_INPUT_SCANCODE, RDP_KEYPRESS, 0xe1, 0);
      rdp_send_input(ev_time, RDP_INPUT_SCANCODE, RDP_KEYPRESS, 0x1d, 0);
      rdp_send_input(ev_time, RDP_INPUT_SCANCODE, RDP_KEYPRESS, 0x45, 0);
      rdp_send_input(ev_time, RDP_INPUT_SCANCODE, RDP_KEYPRESS, 0xe1, 0);
      rdp_send_input(ev_time, RDP_INPUT_SCANCODE, RDP_KEYPRESS, 0x9d, 0);
      rdp_send_input(ev_time, RDP_INPUT_SCANCODE, RDP_KEYPRESS, 0xc5, 0);

      /* Release Left Ctrl */
      rdp_send_input(ev_time, RDP_INPUT_SCANCODE, RDP_KEYRELEASE, 0x1d, 0);
      break;

    default:
      sent = FALSE;
      break;
  }

  return(sent);
}

/******************************************************************************/

static void send_winkey(uint32 ev_time, BOOL pressed, BOOL leftkey)
{
	uint8 winkey;

	if (leftkey)
		winkey = SCANCODE_CHAR_LWIN;
	else
		winkey = SCANCODE_CHAR_RWIN;

	if (pressed)
	{
		if (g_use_rdp5)
		{
			rdp_send_scancode(ev_time, RDP_KEYPRESS, winkey);
		}
		else
		{
			/* RDP4 doesn't support winkey. Fake with Ctrl-Esc */
			rdp_send_scancode(ev_time, RDP_KEYPRESS, SCANCODE_CHAR_LCTRL);
			rdp_send_scancode(ev_time, RDP_KEYPRESS, SCANCODE_CHAR_ESC);
		}
	}
	else
	{
		/* key released */
		if (g_use_rdp5)
		{
			rdp_send_scancode(ev_time, RDP_KEYRELEASE, winkey);
		}
		else
		{
			rdp_send_scancode(ev_time, RDP_KEYRELEASE, SCANCODE_CHAR_ESC);
			rdp_send_scancode(ev_time, RDP_KEYRELEASE, SCANCODE_CHAR_LCTRL);
		}
	}
}

/******************************************************************************/

/* Send keyboard input */
extern void rdp_send_scancode(uint32 time, uint16 flags, uint8 scancode)
{
//	update_modifier_state(scancode, !(flags & RDP_KEYRELEASE));

	if (scancode & SCANCODE_EXTENDED)
	{
		DEBUG_KBD(("Sending extended scancode=0x%x, flags=0x%x\n",
			   scancode & ~SCANCODE_EXTENDED, flags));
		rdp_send_input(time, RDP_INPUT_SCANCODE, flags | KBD_FLAG_EXT,
			       scancode & ~SCANCODE_EXTENDED, 0);
	}
	else
	{
		DEBUG_KBD(("Sending scancode=0x%x, flags=0x%x\n", scancode, flags));
		rdp_send_input(time, RDP_INPUT_SCANCODE, flags, scancode, 0);
	}
}
