static BOOL goto_desktop(void)
{
 /*
  * Return to the Desktop
  */
  int display_mode = Display_GetDisplayMode();
  BOOL ignore = FALSE;
  
  if(display_mode == display_mode_FULLSCREEN || display_mode == display_mode_SINGLETASK){
     Display_CloseWindow();
     ignore = TRUE;
  }

  return(ignore);
}

/******************************************************************************/

static BOOL goto_window(void)
{
 /*
  * Go to Window mode
  */
  int display_mode = Display_GetDisplayMode();
  BOOL ignore = FALSE;

  if(display_mode != display_mode_WINDOW){
     Display_SetDisplayMode(display_mode_WINDOW);
     ignore = TRUE;
  }

  return(ignore);
}

/******************************************************************************/

static BOOL goto_fullscreen(void)
{
 /*
  * Go to Fullscreen mode
  */
  int display_mode = Display_GetDisplayMode();
  BOOL ignore = FALSE;
  BOOL valid_res;
  BOOL valid_bpp;

  if(display_mode != display_mode_FULLSCREEN){
  
     Display_Validate(&valid_res, &valid_bpp);

     if(valid_res){
        Display_SetDisplayMode(display_mode_FULLSCREEN);
        ignore = TRUE;
     }
  }

  return(ignore);
}

/******************************************************************************/

static BOOL goto_singletask(void)
{
 /*
  * Go to Single tasking mode
  */
  int display_mode = Display_GetDisplayMode();
  BOOL ignore = FALSE;
  BOOL valid_res;
  BOOL valid_bpp;

  if(display_mode != display_mode_SINGLETASK){

     Display_Validate(&valid_res, &valid_bpp);

     if(valid_bpp){
        Display_SetDisplayMode(display_mode_SINGLETASK);
        ignore = TRUE;
     }
  }

  return(ignore);
}

