extern void Keyboard_Init(void)
{
 /*
  * initialisation to be done on startup
  */
  saved_modifiers.value = 0;
  saved_state.value = scan_state();

 /*
  * Default key shortcuts
  */
  keyboard_configuration.shortcut.desktop = decode_keyname_to_physical("d");
  keyboard_configuration.shortcut.window = decode_keyname_to_physical("w");
  keyboard_configuration.shortcut.fullscreen = decode_keyname_to_physical("f");
  keyboard_configuration.shortcut.singletasking = decode_keyname_to_physical("s");
  keyboard_configuration.shortcut.bringtofront = decode_keyname_to_physical("t");

  
  read_keyboard_autorepeat();

  keyboard_buffer_clear();

  build_translate_tables();
}

