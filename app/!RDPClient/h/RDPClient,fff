#define baricon_VALIDATION_SIZE 100
#define baricon_TEXT_SIZE       100

#define save_type_SCREEN        0
#define save_type_LOG           1

 /*
  * pointer to icon sprite area
  */
extern sprite_area usericonsprites;

 /*
  * wimp poll idle time
  */
extern unsigned int idletime;


 /*
  * true when RDPClient quitted correctly
  */ 
extern BOOL rdpclient_quit;


 /*
  * TRUE if connected to a server
  */
extern BOOL rdpclient_connected;


 /*
  * true when 3D windows are being used
  */
extern BOOL threedlook;


 /*
  * validation string for iconbar icon
  */
extern char *rdpclient_baricon_validation;

 /*
  * text string for iconbar icon
  */
extern char *rdpclient_baricon_text;

 /*
  * Update text on IconBar Icon
  */
extern void RDPClient_IconBarSetText(char *newtext);

 /*
  * Update sprite on IconBar Icon to reflect connected state
  */
extern void RDPClient_IconBarSetState(BOOL connected);

 /*
  * Set selected display mode in iconbar menu
  */
extern void RDPClient_MenuSetDisplayMode(int display_mode);

