#ifndef ACORNSSLIF_H
#define ACORNSSLIF_H

#include "stdlib.h"
#include "socklib.h"
#include "kernel.h"

#ifdef __cplusplus
extern "C" {
#endif

int ssl_connect(int sslhandle, const struct sockaddr *name, int namelen);

int ssl_getpeername(int sslhandle, struct sockaddr *name, int *namelen);
int ssl_getsockname(int sslhandle, struct sockaddr *name, int *namelen);
int ssl_getsockopt(int sslhandle, int level, int optname,
		      void *optval, int *optlen);
int ssl_recv(int sslhandle, void *buf, size_t len, int flags);
int ssl_send(int sslhandle, const void *msg, size_t len, int flags);
int ssl_setsockopt(int sslhandle, int level, int optname, const void *optval, int optlen);
int ssl_shutdown(int sslhandle, int how);
int ssl_socketclose(int sslhandle);
int ssl_socket(int domain, int type, int protocol);        /* returns sslhandle (or -1 on error) */
int ssl_socketstat(int sslhandle, struct stat *buf);
int ssl_socketioctl(int sslhandle, unsigned long cmd, ...);
int ssl_socketread(int sslhandle, void *buf, unsigned int len);
int ssl_socketwrite(int sslhandle, const void *buf, unsigned int len);
int ssl_socketversion(void);
int ssl_createsession(int socket, int reason_code, int reuse_sslhandle);

#ifdef __cplusplus
}
#endif

#endif
