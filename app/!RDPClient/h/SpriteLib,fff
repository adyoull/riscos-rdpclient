 /*
  * Graphics operations
  */
#define SpriteLib_GXclear          0x0       /* 0 */
#define SpriteLib_GXnor            0x1       /* NOT src AND NOT dst */
#define SpriteLib_GXandInverted    0x2       /* NOT src AND dst */
#define SpriteLib_GXcopyInverted   0x3       /* NOT src */
#define SpriteLib_GXandReverse     0x4       /* src AND NOT dst */
#define SpriteLib_GXinvert         0x5       /* NOT dst */
#define SpriteLib_GXxor            0x6       /* src XOR dst */
#define SpriteLib_GXnand           0x7       /* NOT src OR NOT dst */
#define SpriteLib_GXand            0x8       /* src AND dst */
#define SpriteLib_GXequiv          0x9       /* NOT src XOR dst */
#define SpriteLib_GXnoop           0xA       /* dst */
#define SpriteLib_GXorInverted     0xB       /* NOT src OR dst */
#define SpriteLib_GXcopy           0xC       /* src */
#define SpriteLib_GXorReverse      0xD       /* src OR NOT dst */
#define SpriteLib_GXor             0xE       /* src OR dst */
#define SpriteLib_GXset            0xF       /* 1 */
 


 /*
  * spritelib information
  */
typedef struct {
    sprite_area       spritearea;
    int               header;                 /* offset from start of spritearea to header */
    int               palette;                /* offset from start of spritearea to palette */
    int               image;                  /* offset from start of spritearea to image */
    int               linebytes;              /* number of bytes in an image line */
    int               mask;                   /* offset from start of spritearea to mask */
    int               masklinebytes;          /* number of bytes in the mask line */
    wimp_point        size;                   /* size of image in pixels */
    wimp_point        clip_origin;            /* top left origin of clip area */
    wimp_point        clip_size;              /* size of clip area */
    int               bpp;                    /* image bits per pixel */
    BOOL              has_palette;            /* does this image have a palette? */
    BOOL              has_mask;               /* does this image have a mask? */
    unsigned long     custom_palette_version; /* version of custom palette */
} spritelib_block;


