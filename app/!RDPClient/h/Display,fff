extern void Display_ResetClipArea(void);


 /*
  * Plot area of sprite from source_x, source_y to source_width, source_height
  * to display at coords dest_x, dest_y
  */
extern void Display_PlotSprite(int gfx_op,
                               int dest_x, int dest_y,
                               spritelib_block *source_sprite,
                               int source_x, int source_y,
                               int source_width, int source_height);


 /*
  * Plot area of source_data from top left to source_width, source_height
  * to display at coordinate dest_x, dest_y (top left)
  */
extern void Display_PlotData(int gfx_op,
                             int dest_x, int dest_y,
                             unsigned char *source_data,
                             int source_x, int source_y,
                             int source_width, int source_height,
                             int source_image_width, int source_image_height);


 /*
  * Plot rectangle of colour 'colour'
  */
extern void Display_PlotRectangle(int gfx_op,
                                  int x, int y,
                                  int width, int height,
                                  int colour,
                                  BOOL update);


 /*
  * Plot a single pixel wide line of colour 'colour'
  */
extern void Display_PlotLine(int gfx_op,
                             int start_x, int start_y,
                             int finish_x, int finish_y,
                             int colour,
                             BOOL update);


 /*
  * Plot 1 bit per pixel source_sprite to Display.
  * source_sprite is tiled to fill the space dest_x, dest_y to plot_width, plot_height.
  * The top left of source_sprite is lined up with plot_origin_x, plot_origin_y which
  * may not be in the plot area.
  * Where the source_sprite is 1, the dest_sprite is set to foreground_colour.
  * If set_background is TRUE, where the source_sprite is 0, the dest_sprite is set
  * to background_colour.
  */
extern void Display_PlotSpriteBitMask(int gfx_op,
                                      int dest_x, int dest_y,
                                      spritelib_block *source_sprite,
                                      int source_x, int source_y,
                                      int plot_origin_x, int plot_origin_y,
                                      int plot_width, int plot_height,
                                      int foreground_colour,
                                      int background_colour, BOOL set_background,
                                      BOOL update);


 /*
  * Plot source_sprite to Display.
  * source_sprite is tiled to fill the space dest_x, dest_y to plot_width, plot_height.
  * The top left of source_sprite is lined up with plot_origin_x, plot_origin_y which
  * may not be in the plot area.
  */
extern void Display_PlotSpriteTiled(int gfx_op,
                                    int dest_x, int dest_y,
                                    spritelib_block *source_sprite,
                                    int source_x, int source_y,
                                    int plot_origin_x, int plot_origin_y,
                                    int plot_width, int plot_height,
                                    BOOL update);


 /*
  * Copy rectangle area of screen to another place
  */
extern void Display_CopyRectangle(int gfx_op,
                                  int dest_x, int dest_y,
                                  int source_x, int source_y,
                                  int width, int height);


 /*
  * Refresh rectangle of Display from Sprite
  */
extern void Display_Update(int x, int y,
                           int width, int height);


 /*
