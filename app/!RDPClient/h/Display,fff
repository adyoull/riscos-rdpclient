#define display_mode_WINDOW     0
#define display_mode_FULLSCREEN 1
#define display_mode_SINGLETASK 2

#define fullscreen_bringtofront_MOUSECLICK 0
#define fullscreen_bringtofront_KEYPRESS   1

 /*
  * display information
  */
typedef struct {
    char                *spritearea;
    int                 image;
    int                 linebytes;
} display_dsa_block;

typedef struct {
    int                 display_mode;
    BOOL                update_palette;
    window_handle       current_window;
    window_handle       window;
    window_handle       fullscreen;
    BOOL                window_open;
    BOOL                window_opened_before;
    BOOL                input_focus;
    mode_select_block   wimpmode;
    BOOL                requested_modechange;
    spritelib_block     *sprite;             /* updates go here */
    spritelib_block     *display_sprite;     /* display buffer sprite */
    spritelib_block     *screen_sprite;      /* direct screen access sprite */
    
    BOOL                singletask;
    unsigned char       *cache;
    int                 cache_size;
    wimp_point          plotcoord;           /* coord to plot at in window */
    sprite_scalefactors screenscale;         /* scale factors used on screen */
    char                *pixtranstable;      /* ptr to pixel trans table or 0 if not needed */
    char                *pixtransbuffer;     /* dynamically-sized pixel trans table buffer */
    int                 pixtransbuffer_size; /* bytes currently allocated at pixtransbuffer */
    wimp_point          pointer_coord;
    pointer_block       *pointer;
    char                *pointer_pixtranstable; /* ptr to pixel trans table or 0 if not needed */
    char                *pointer_pixtransbuffer; /* dynamically-sized pixel trans table buffer */
    int                 pointer_pixtransbuffer_size; /* bytes allocated at pointer_pixtransbuffer */
} display_block;

typedef struct {
    BOOL                used;
    unsigned int        number;
    wimp_point          top_left;
    wimp_point          bottom_right;
    wimp_point          size;
    int                 area;
    unsigned int        time;
} redraw_rectangle_block;


 /*
